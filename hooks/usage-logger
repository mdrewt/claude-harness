#!/usr/bin/env node
// PostToolUse hook: append every Skill / Agent invocation to ~/.claude/usage-log.csv.
//
// Canonical source lives in the harness repo (hooks/usage-logger); `just setup-claude`
// symlinks ~/.claude/hooks/usage-logger to it. Wired in ~/.claude/settings.json under
// PostToolUse with matcher "Skill|Agent|Task". Never blocks and never errors out the
// tool call: always exits 0. Read back by scripts/audit-usage.mjs.
//
// Node, not python: asdf has no global python pin, so a python3 shebang dies (exit 126)
// in every cwd without a .tool-versions python entry — which silently dropped all
// interactive-session rows while cron-spawned runs (system python3 on PATH) kept
// logging. nodejs IS pinned globally and /usr/bin/node covers cron. CommonJS, not ESM:
// cron's /usr/bin/node is v18, which cannot auto-detect module syntax in an
// extensionless file.
//
// Security: the skill/agent name and project come from model-controlled tool input, so
// each field is sanitized before it lands in the CSV — control chars are flattened (so a
// field can't break the row) and a leading =,+,-,@ is escaped so the value can never be
// interpreted as a formula if the log is opened in a spreadsheet (CSV-injection guard).

'use strict';
const { appendFileSync, existsSync, readFileSync } = require('node:fs');
const { homedir } = require('node:os');
const { basename, join } = require('node:path');

const LOG = join(homedir(), '.claude', 'usage-log.csv');
const HEADER = 'timestamp,kind,name,session,project';

// Neutralize CSV/formula injection from untrusted (model/path-derived) fields.
const safe = (value) => {
  let s = String(value).replace(/[\r\n\t]/g, ' ');
  if (/^[=+\-@]/.test(s)) s = "'" + s;
  return s;
};

// Minimal CSV field encoder (matches python csv.writer semantics: quote when the
// field contains a comma, quote, or newline; double internal quotes).
const csvField = (s) => (/[",\n\r]/.test(s) ? '"' + s.replace(/"/g, '""') + '"' : s);

const main = () => {
  let data;
  try {
    data = JSON.parse(readFileSync(0, 'utf8'));
  } catch {
    return;
  }
  const tool = data.tool_name;
  const inp = data.tool_input || {};
  let kind;
  let name;
  if (tool === 'Skill') {
    kind = 'skill';
    name = inp.skill || '(unknown)';
  } else if (tool === 'Agent' || tool === 'Task') {
    kind = 'agent';
    name = inp.subagent_type || '(unknown)';
  } else {
    return;
  }
  const cwd = String(data.cwd || '').replace(/\/+$/, '');
  const row = [
    new Date().toISOString(),
    kind,
    safe(name),
    String(data.session_id || ''),
    cwd ? safe(basename(cwd)) : '',
  ]
    .map(csvField)
    .join(',');
  const prefix = existsSync(LOG) ? '' : HEADER + '\n';
  appendFileSync(LOG, prefix + row + '\n');
};

try {
  main();
} catch {
  /* never fail the tool call */
}
process.exit(0);
