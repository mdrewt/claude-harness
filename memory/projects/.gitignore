# runtime state — written every tick/run; tracking them churns every commit (untracked 2026-07-26)
.blocked-on-human
.last-tick-spawn-epoch
.native-supervisor-disabled
.native-supervisor-heartbeat
.native-supervisor-last-failure
.native-supervisor-last-failure-epoch
.native-supervisor-last-success
.native-supervisor-tick-alive
.ollama-last
.situation-cache.json
pending-events/
# lp-01 rate-limit telemetry rows — appended by production several times an hour (tick + every live-slice standdown); tracking it would conflict on every parallel slice branch
mr-rate-limit-telemetry.jsonl
# lp-queue / lp-handoff-rotate — mr-record's own flock lock files, and crash-orphaned rotation temp
# files (a process killed between os.replace()'s temp-write and rename leaves one of these behind,
# uniquely pid-suffixed so it never collides with or blocks a later run)
*.lock
*.tmp.[0-9]*
# lp-gates — per-slice acceptance ledgers, the Stop-hook instrument log and its state, plus the
# residual registry. All written by production runs (a ledger per slice, a stoplog line per stop,
# a registry row per DEFER); tracking them would conflict on every parallel slice branch, exactly
# as mr-rate-limit-telemetry.jsonl does. The DURABLE record of a residual is its promoted spec
# section, which IS tracked — the registry is the routing layer, not the archive.
gates/
mr-residuals.jsonl
