        chk.check("G5/skip_markers_added", 0, _st_get(b, "skip_markers_added"))
        chk.check("G5/verdict", "FLAGGED", _st_get(b, "verdict"))
        _st_g_common(chk, "G5", b)

        # ---- G6/G6b/G6c: unusable advisory inputs -> mandatory read (AM4) -------------------
        # This is mr-audit:3's own AUDIT-ERROR-treated-as-FLAGGED convention, carried forward as
        # a structural key instead of a verdict token. Without it a typo'd --repo becomes a
        # SILENT PROCEED: gating_advisory is advisory, so nothing else stops the merge.
        ERR = "repo/base/head missing or repo not a dir"
        out, b = run("G6", shas[0], shas[1], repo_path=os.path.join(tmp, "not-a-repo"))
        chk.check("G6/verdict", "AUDIT-ERROR", _st_get(b, "verdict"))
        chk.check("G6/reason", ERR, _st_get(b, "reason"))
        chk.check("G6/mandatory_read", True, _st_get(out, "mandatory_read"))
        chk.check("G6/read_reason", ["advisory-inputs-unavailable"], _st_get(out, "read_reason"))
        _st_g_common(chk, "G6", b)

        out, b = run("G6b", shas[0], shas[1], omit_repo=True)
        chk.check("G6b/verdict", "AUDIT-ERROR", _st_get(b, "verdict"))
        chk.check("G6b/reason", ERR, _st_get(b, "reason"))
        chk.check("G6b/mandatory_read", True, _st_get(out, "mandatory_read"))
        chk.check("G6b/read_reason", ["advisory-inputs-unavailable"], _st_get(out, "read_reason"))
        _st_g_common(chk, "G6b", b)

        out, b = run("G6c", shas[0], shas[1], tier="hard", omit_repo=True)
        chk.check("G6c/read_reason", ["hard-tier", "advisory-inputs-unavailable"],
                  _st_get(out, "read_reason"),
                  "AM5 seeds the list before the try; audit_gating APPENDS — both reasons, in "
                  "that order, and neither one overwrites the other")
        chk.check("G6c/mandatory_read", True, _st_get(out, "mandatory_read"))
        _st_g_common(chk, "G6c", b)

        # ---- G7: the quiet case ------------------------------------------------------------
        out, b = run("G7", shas[0], shas[1])
        chk.check("G7/verdict", "CLEAN", _st_get(b, "verdict"))
        chk.check("G7/changed_test_files", [], _st_get(b, "changed_test_files"))
        chk.check("G7/deleted_test_files", [], _st_get(b, "deleted_test_files"))
        chk.check("G7/removed_or_modified_asserts", 0,
                  _st_get(b, "removed_or_modified_asserts"))
        chk.check("G7/skip_markers_added", 0, _st_get(b, "skip_markers_added"))
        chk.check("G7/suppressions_added", 0, _st_get(b, "suppressions_added"))
        chk.check("G7/mandatory_read", False, _st_get(out, "mandatory_read"))
        chk.check("G7/read_reason", [], _st_get(out, "read_reason"))
        chk.check("G7/no-hunks", False, "test_diff_hunks" in b)
        _st_g_common(chk, "G7", b)

        # ---- G8/G8b: AM7's re-gate, proven as a PAIR ----------------------------------------
        # Same benign test-file diff, two tiers. Without AM7 the evidence embed follows the
        # verdict alone, so deleting the hard-tier flag ALSO deletes the pre-filtered diff
        # exactly where the mandatory read still applies. The routine half is what proves the
        # new condition is a re-gate and not just `if True`.
        out, b = run("G8", shas[5], shas[6], tier="hard")
        chk.check("G8/verdict", "CLEAN", _st_get(b, "verdict"))
        chk.check("G8/mandatory_read", True, _st_get(out, "mandatory_read"))
        chk.check("G8/hunks-present", True, "test_diff_hunks" in b,
                  "mandatory_read is True, so the evidence embed must survive a CLEAN verdict")
        _st_g_common(chk, "G8", b)

        out, b = run("G8b", shas[5], shas[6])
        chk.check("G8b/verdict", "CLEAN", _st_get(b, "verdict"))
        chk.check("G8b/mandatory_read", False, _st_get(out, "mandatory_read"))
        chk.check("G8b/hunks-absent", False, "test_diff_hunks" in b,
                  "CLEAN and no mandatory read: nothing to pre-filter for anybody")
        _st_g_common(chk, "G8b", b)

        # ---- G-exc (AM17): the exception raised by the GATING half ---------------------------
        # A --repo that IS a directory but is not a usable repo takes the :42 branch and then
        # raises at :44, so the handler fires with a SUCCESSFULLY COMPUTED orchestration block
        # already in `out`. Two things are pinned that nothing else covers:
        #   1. the handler's `out.get("orchestration", <default>)` must PRESERVE that block, not
        #      overwrite a real CLEAN verdict with the bare default;
        #   2. read_reason carries "advisory-inputs-unavailable" EXACTLY ONCE. The else-branch
        #      at :69 was never reached on this path, so a second entry means something appended
        #      twice — the nearest cheap approximation of AM17's no-duplicate clause, which
        #      cannot be provoked head-on through the public interface without contortion.
        # Runs inside the git-env context so a leaked GIT_DIR cannot decide the outcome; the
        # bogus revs make rc != 0 unavoidable even if git resolves some enclosing repo.
        notrepo = _st_mkdir(tmp, "not-a-git-repo")
        out = _st_run(["--slice", "gexc", "--log", L["clean"], "--repo", notrepo,
                       "--base", "0" * 40, "--head", "1" * 40])
        chk.check("G-exc/orchestration-preserved", "CLEAN",
                  _st_get(_st_get(out, "orchestration"), "verdict"),
                  "the log was fine and was already read; the handler must not clobber it")
        chk.check("G-exc/gating-verdict", "AUDIT-ERROR",
                  _st_get(_st_get(out, "gating_advisory"), "verdict"))
        chk.check("G-exc/mandatory_read", True, _st_get(out, "mandatory_read"))
        chk.check("G-exc/read_reason-exactly-once", ["advisory-inputs-unavailable"],
                  _st_get(out, "read_reason"))

        return {"repo": repo, "shas": shas, "home": home}


