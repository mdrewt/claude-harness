def _st_corpus(root, files):
    os.makedirs(root)
    for rel, text in files:
        _st_w(os.path.join(root, *rel.split("/")), text)
    return root


def _st_clean_case(chk, fid, root, files, why=""):
    """The shape shared by every zero-findings fixture: no findings, and status is the exact
    'OK' — not merely 'not FINDINGS'."""
    blk = scan_dispositions(_st_corpus(root, files))
    chk.check(fid + "/findings", [], _st_get(blk, "findings"), why)
    chk.check(fid + "/status", "OK", _st_get(blk, "status"), why)
    return blk


