              "an absolute path here leaks the runner's tempdir into every PR body")

    # ---- D14: specs/**/adr/** is out of scope (AM8) -------------------------------------------
    blk = _st_clean_case(chk, "D14", d("14"), [
        ("a.spec.md", "# Spec: fixture adr exclusion\n\nNothing parked here.\n"),
        ("adr/0001-a-decision.md", _ST_D1)],
        "53 ADR files are decision records, not specs; auditing them is the draft's over-reach")
    chk.check("D14/files", 1, _st_get(_st_get(blk, "scanned"), "files"),
              "the adr/ file must not even be opened")

    # ---- D15: the §8 table HEADER row is not a park -------------------------------------------
    # A measured false positive of the rejected draft's parser.
    d15 = ("## 8. Id dispositions - orphan closure\n\n"
           "| parked id | where it was disclosed | disposition |\n"
           "|---|---|---|\n"
           "| `pt-fx-1` | plan §2 | parked -> `pt-fx-2` |\n\n"
           "### pt-fx-2 - the queued follow-up\n")
    _st_clean_case(chk, "D15", d("15"), [("a.spec.md", d15)],
                   "the literal words `parked id` in a table header are a column name")

    # ---- D16: the whole-file GREEDY bold form must not be the rule -----------------------------
    # `\*\*[^*]*PARKED[^*]*\*\*` happily spans from one span's CLOSING ** to the next span's
    # OPENING **, so it reads the prose BETWEEN two bold spans as if it were inside one. The
    # **-parity split is immune; the greedy form flags this item and then reports it as
    # dispositionless.
    d16 = ("# Spec: fixture greedy control\n\n"
           "- **DONE - item 101, the greedy-form control.** The renderer work shipped; whether\n"
           "  item 088 stays PARKED belongs to the other spec, and this item ends with\n"
           "  **a second bold span** that closes it.\n")
    blk = _st_clean_case(chk, "D16", d("16"), [("a.spec.md", d16)],
                         "PARKED here sits BETWEEN two bold spans, i.e. in an even segment")
    chk.check("D16/park_items", 0, _st_get(_st_get(blk, "scanned"), "park_items"))

    # ---- D17: the corpus's dominant closure style is `**Parked ...**`, not shouted -------------
    d17 = ("# Spec: fixture case folding\n\n"
           "**pt-fx DELIVERED** (ADR-9998): shipped. **Parked - the follow-up nobody named.**\n")
    blk = scan_dispositions(_st_corpus(d("17"), [("a.spec.md", d17)]))
    f = _st_get(blk, "findings")
    chk.check("D17/count", 1, len(f) if isinstance(f, list) else -1,
              "the PARK test is case-insensitive; `**Parked ...**` with no marker is a finding")
    if isinstance(f, list) and len(f) == 1:
        chk.check("D17/kind", "missing_disposition", _st_get(f[0], "kind"))


# ------------------------------------------------------------------------------------------
# S — EARS 1: "The two halves SHALL be separately addressable, with the advisory half emitting
# to a distinct field." Separately addressable is structural here: two distinct top-level keys
# produced by two distinct functions, with the POLICY signal hoisted out of both.
# ------------------------------------------------------------------------------------------
def _st_s_battery(chk, tmp, L, ginfo):
    if not ginfo:
        chk.check("S1", "a usable fixture repo", "the G battery could not build one")
        chk.check("S2", "a usable fixture repo", "the G battery could not build one")
    else:
        with _st_git_env_ctx(ginfo["home"]):
            out = _st_run(["--slice", "s1", "--tier", "hard", "--log", L["clean"],
                           "--repo", ginfo["repo"], "--base", ginfo["shas"][0],
                           "--head", ginfo["shas"][1]])
        chk.check("S1/orchestration-present", True, "orchestration" in out)
        chk.check("S1/gating_advisory-present", True, "gating_advisory" in out)
        chk.check("S1/legacy-key-absent", False, "gating" in out,
                  "AM3: a reader reaching for `gating.verdict` gets a visible absence, not a "
                  "silently stale block")
        chk.check("S1/advisory-flag", True, _st_get(_st_get(out, "gating_advisory"), "advisory"))
        # The POLICY half is not advisory and must not pretend to be. If orchestration ever
        # grows `advisory: true` the pre-code gauntlet becomes optional by annotation.
        chk.check("S1/policy-half-not-advisory", False,
                  "advisory" in _st_get(out, "orchestration"))
        chk.check("S1/policy-half-no-contract", False,
                  "contract" in _st_get(out, "orchestration"))
        # ---- S2: the policy signal is TOP LEVEL, not buried in an advisory block ----------
        chk.check("S2/mandatory_read", True, _st_get(out, "mandatory_read"))
        chk.check("S2/read_reason", ["hard-tier"], _st_get(out, "read_reason"))
        chk.check("S2/not-in-gating", False, "mandatory_read" in _st_get(out, "gating_advisory"))
        chk.check("S2/reason-not-in-gating", False,
                  "read_reason" in _st_get(out, "gating_advisory"))
        chk.check("S2/not-in-orchestration", False,
                  "mandatory_read" in _st_get(out, "orchestration"))

    # ---- S1 tail: the disposition block's own contract ------------------------------------
    # Asserted against the scanner directly. That the block is ALSO attached to `out` under the
    # top-level key `disposition` is proven externally by mr-selfcheck's probe — an in-process
    # assertion here would just be re-reading a dict this battery had assembled itself.
    blk = scan_dispositions(_st_corpus(os.path.join(tmp, "corpus-s"), [("keep.spec.md", _ST_KEEPER)]))
    chk.check("S1/disposition-advisory", True, _st_get(blk, "advisory"))
    chk.check("S1/disposition-status-vocabulary", "OK", _st_get(blk, "status"),
              "AM11: OK | FINDINGS | AUDIT-ERROR, deliberately NOT verdict/FLAGGED")

    # ---- S3 (AM5 + AM17): the SPLIT survives the exception path ------------------------------
    # :71-73 is where distinguishing a mandatory read matters MOST — the run has just told you it
    # could not look. P10/P10h pin the VALUES there; S3 pins the STRUCTURE: both halves still
    # emit as distinct top-level keys under the renamed key, and the policy signal is still
    # beside them rather than inside either advisory block.
    #
    # TESTER CORRECTION (from the spec, not from the code): this fixture originally expected
    # read_reason == ["hard-tier"] here, which encoded the very defect the RED-phase report
    # flagged and AM17 then closed. The expectation is corrected to the AM5-seeded + AM17-
    # appended list. It STRENGTHENS: the old value passes a handler that never appends, the new
    # one does not, and it still fails any handler that drops or reorders the init's seed.
    out = _st_run(["--slice", "s3", "--tier", "hard", "--log", _st_mkdir(tmp, "dirlog2")])
    chk.check("S3/orchestration-verdict", "AUDIT-ERROR",
              _st_get(_st_get(out, "orchestration"), "verdict"))
    chk.check("S3/gating_advisory-present", True, "gating_advisory" in out)
    chk.check("S3/legacy-key-absent", False, "gating" in out,
              "AM3 governs the handler too; the error path must not emit the old key name")
    chk.check("S3/mandatory_read", True, _st_get(out, "mandatory_read"))
    chk.check("S3/read_reason", ["hard-tier", "advisory-inputs-unavailable"],
              _st_get(out, "read_reason"))
    chk.check("S3/policy-not-in-gating", False,
              "mandatory_read" in _st_get(out, "gating_advisory"))
    chk.check("S3/policy-not-in-orchestration", False,
              "mandatory_read" in _st_get(out, "orchestration"))


# ------------------------------------------------------------------------------------------
# X — the contracts the whole tool rests on.
# ------------------------------------------------------------------------------------------
def _st_x_battery(chk, tmp, L):
    out = _st_run(["--slice", "x1", "--log", L["clean"]])

    # ---- X1: emit() never raises, never exits, and PRINTS BEFORE it writes ------------------
    # mr-audit is rc=0 ALWAYS (its header is a promise the supervisor's prompt relies on), and
    # the artifact write is best-effort. If emit() raises on an unwritable artifact dir, an
    # unrelated /tmp problem silently deletes the audit from the merge conversation.
    good = _st_mkdir(tmp, "emit-ok")
    missing_dir = os.path.join(tmp, "emit-nonexistent", "deeper")
    for fid, target in (("X1/writable", good), ("X1/unwritable", missing_dir)):
        buf = io.StringIO()
        try:
            with contextlib.redirect_stdout(buf):
                emit(out, artifact_dir=target)
        except NameError:
            raise
        except SystemExit as e:
            chk.check(fid, "emit() returns", "emit() called sys.exit(%r) — the exit belongs to "
                      "the caller, not to the emitter" % (e.code,))
            continue
        except BaseException as e:
            chk.check(fid, "emit() returns", "%s: %s" % (type(e).__name__, e),
                      "emit() must swallow artifact-write failures, not propagate them")
            continue
        chk.check(fid + "/printed", json.dumps(out, indent=1) + "\n", buf.getvalue(),
                  "stdout is the PRIMARY channel and is indent=1, not indent=2; it must be "
                  "written before the best-effort artifact write can fail")
    art = os.path.join(good, "mr_audit_x1.json")
    chk.check("X1/artifact-written", ["mr_audit_x1.json"], sorted(os.listdir(good)))
    if os.path.isfile(art):
        with open(art) as fh:
            chk.check("X1b/artifact-matches-stdout", json.dumps(out, indent=1), fh.read(),
                      "the artifact and stdout are the same bytes; a reader must not have to "
                      "reconcile two renderings of one verdict")
    else:
        chk.check("X1b/artifact-matches-stdout", "an artifact to compare", "no artifact written")
    chk.check("X1b/unwritable-left-nothing", False, os.path.isdir(missing_dir))

    # ---- X2 (AM14): prove the battery CAN fail ----------------------------------------------
    # A7: a tooth that cannot fail is a decoration. Precedent: mr-selfcheck's PYGUARD asserts
    # BOTH directions (guarded => the hazard does not fire, unguarded => it does). This drives
    # the battery's OWN comparison helper on a throwaway recorder with one matching pair, one
    # mismatched pair and one type-confusion pair, and requires exactly TWO registered failures.
    probe = _StChk(quiet=True)
    probe.check("control-match", 1, 1)
    probe.check("control-mismatch", "CLEAN", "FLAGGED")
    probe.check("control-type-confusion", True, 1)
    chk.check("X2/registered-failures", 2, probe.fails,
              "the matched pair must pass, the mismatched pair must fail, and True must not "
              "compare equal to 1 — if this is not exactly 2 the recorder is inert and every "
              "green above is meaningless")
    chk.check("X2/ids-counted-by-prefix", 3, probe.ran())


def selftest():
    """The lp-04 gating battery. rc 0 = pass, 1 = fail. Prints AUDIT-SELFTEST-OK <n> on pass."""
    chk = _StChk()
    before = _st_tmp_artifacts()
    with tempfile.TemporaryDirectory(prefix="mr-audit-selftest-") as tmp:
        logs = _st_logs(_st_mkdir(tmp, "logs"))
        _st_p_battery(chk, tmp, logs)
        ginfo = _st_g_battery(chk, tmp, logs)
        _st_d_battery(chk, tmp)
        _st_s_battery(chk, tmp, logs, ginfo)
        _st_x_battery(chk, tmp, logs)

    # ---- X3: the selftest writes NOTHING under /tmp -------------------------------------------
    # Every emit() above is handed an artifact_dir inside the tempdir. A single missed argument
    # would have this battery scribbling /tmp/mr_audit_g1.json ... on every daily tick, and one
    # of those names is `/tmp/mr_audit_?.json`, which is a real production artifact name.
    after = _st_tmp_artifacts()
    leaked = sorted([p for p in after if p not in before or after[p] != before.get(p)])
    chk.check("X3/tmp-artifacts", [], leaked,
              "new or modified /tmp/mr_audit_*.json during --selftest. The only known false "
              "positive is a REAL mr-audit run racing this one, which is worth the noise")

    n = chk.ran()
    if n < _ST_COUNT_FLOOR:
        chk.check("X3/battery-size", True, n >= _ST_COUNT_FLOOR,
                  "only %d fixtures ran; the floor is %d and mr-selfcheck enforces it too"
                  % (n, _ST_COUNT_FLOOR))
    if chk.fails:
        print("AUDIT-SELFTEST-FAILED %d assertion(s) across %d fixtures" % (chk.fails, n))
        return 1
    print("AUDIT-SELFTEST-OK %d" % n)
    return 0


# ================================== MAIN (dispatch) ======================================
# Placed LAST: python binds names as execution reaches them, so dispatch above the selftest
# section would NameError on `selftest` itself.
argv = json.loads(os.environ["A_ARGS"])
a = parse_args(argv)
if a.get("selftest") == "1":
    # --selftest is a SEPARATE mode and may exit 1.  The rc=0-always contract covers audit runs;
    # a gate wired to a mode that can never fail is a decoration, not a gate.
    sys.exit(selftest())
_mr, _rr = mandatory_read_init(a)
out = {"slice": a.get("slice", "?"), "tier": a.get("tier", "routine"),
       "policy": POLICY_FLAGGED if _mr else POLICY_CLEAN,
       "mandatory_read": _mr, "read_reason": _rr}
try:
    # ONE shared try, unchanged from pre-lp-04: a log that cannot be read (a directory, say —
    # the guard is os.path.exists, not isfile) takes the advisory half down with it, and that is
    # the CONSERVATIVE behaviour.  Per-function error handling would quietly compute a CLEAN
    # gating verdict from inputs nothing had successfully looked at.
    audit_orchestration(a, out)
    audit_gating(a, out)
except Exception as e:
    out["orchestration"] = out.get("orchestration", {"verdict": "AUDIT-ERROR"})
    # Preserve a successfully computed advisory block for the same reason the line above preserves
    # orchestration: a later failure must not erase earlier evidence.
    out["gating_advisory"] = out.get("gating_advisory",
                                     {"advisory": True, "contract": ADVISORY_CONTRACT,
                                      "verdict": "AUDIT-ERROR", "reason": str(e)[:200]})
    force_read(out, "advisory-inputs-unavailable")
# The corpus sweep sits OUTSIDE the shared try on purpose. It is effectively total (os.walk on a
# missing root yields nothing; per-file reads are caught; the status ladder is a complete failure
# vocabulary), and inside the try any raise in it would have clobbered a perfectly good
# gating_advisory and reported "advisory inputs unavailable" when the advisory inputs were fine.
try:
    out["disposition"] = scan_dispositions(
        os.path.normpath(os.path.join(os.environ["A_MEM"], "..", "..", "specs")))
except Exception as e:
    out["disposition"] = {"advisory": True, "contract": DISPOSITION_CONTRACT,
                          "status": "AUDIT-ERROR", "reason": str(e)[:200],
                          "findings": [], "unreadable": []}
# F-C / red-team M-2: "I could not look at the corpus" must force the read too. Before this, a
# missing or unreadable specs tree reported AUDIT-ERROR while mandatory_read stayed false --
# exactly the permissive failure class AM4 exists to close, reached through the new detector.
if out["disposition"].get("status") == "AUDIT-ERROR":
    force_read(out, "disposition-corpus-unreadable")
emit(out)
sys.exit(0)
