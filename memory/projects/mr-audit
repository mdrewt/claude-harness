import contextlib
import glob as _st_glob
import io
import tempfile

_ST_MISSING = "<key-absent>"
_ST_COUNT_FLOOR = 24          # mirrored in mr-selfcheck's wiring; a shrinking battery must red


class _StChk(object):
    """Assertion recorder.

    Every assertion is an EXACT value comparison AND a type comparison: `0`, `False`, `None` and
    a missing key are four different answers here. lp-01 shipped a fabricated-counters cheat that
    a truthiness assertion waves through (anti-pattern A3), and `True == 1` in Python, so the
    type check is load-bearing, not decoration.

    Fixture ids may carry a `/sub-assertion` suffix; the RAN count is over the prefix, so the
    number printed in the OK line is the number of FIXTURES, not the number of asserts.
    """

    def __init__(self, quiet=False):
        self.quiet = quiet
        self.fails = 0
        self.ids = set()

    def check(self, fid, want, got, why=""):
        self.ids.add(fid.split("/")[0])
        if want == got and type(want) is type(got):
            return True
        self.fails += 1
        msg = "AUDIT-SELFTEST-FAIL %s: %r != %r" % (fid, want, got)
        if why:
            msg = msg + "  -- " + why
        if not self.quiet:
            print(msg)
        return False

    def ran(self):
        return len(self.ids)


def _st_get(d, k):
    """d[k], or the MISSING sentinel. Never None-for-absent: the whole point is that a key that
    is absent and a key whose value is 0/None/[] are different findings."""
    if isinstance(d, dict) and k in d:
        return d[k]
    return _ST_MISSING


def _st_mkdir(*parts):
    p = os.path.join(*parts)
    if not os.path.isdir(p):
        os.makedirs(p)
    return p


def _st_w(path, text):
    d = os.path.dirname(path)
    if d and not os.path.isdir(d):
        os.makedirs(d)
    with open(path, "w") as fh:
        fh.write(text)
    return path


def _st_run(argv):
    """MIRROR of the tool's main path, assembled from the frozen functions.

    The `except NameError: raise` arm is not a nicety. Without it the mirrored handler below
    would swallow a missing/renamed implementation into a tidy `AUDIT-ERROR` and the whole P
    battery would pass against a tool that has no audit_gating at all — a vacuous green of
    exactly the class this file exists to prevent (A5).

    The handler body is the AM17 shape the implementer must reproduce at :71-73. Note what that
    means for the exception-path fixtures: the APPEND itself is mirrored here, so mr-selfcheck's
    lp04-probe-directory-log is where that half actually bites. What P10/P10h/G-exc still prove
    in process is everything around it and it is not small — that audit_orchestration really
    raises on a directory instead of handling it locally, that mandatory_read_init really seeded
    "hard-tier" before the try, that the seed is not lost, and that a successfully computed
    orchestration block is not clobbered.
    """
    a = parse_args(argv)
    out = {"slice": a.get("slice", "?"), "tier": a.get("tier", "routine")}
    mr, reasons = mandatory_read_init(a)
    out["mandatory_read"] = mr
    out["read_reason"] = list(reasons)
    try:
        audit_orchestration(a, out)
        audit_gating(a, out)
    except NameError:
        raise
    except Exception as e:
        out["orchestration"] = out.get("orchestration", {"verdict": "AUDIT-ERROR"})
        out["gating_advisory"] = {"verdict": "AUDIT-ERROR", "reason": str(e)[:200]}
        out["mandatory_read"] = True                                        # AM17
        if "advisory-inputs-unavailable" not in out["read_reason"]:
            out["read_reason"].append("advisory-inputs-unavailable")
    return out


def _st_tmp_artifacts():
    snap = {}
    for p in _st_glob.glob("/tmp/mr_audit_*.json"):
        try:
            s = os.stat(p)
            snap[p] = (s.st_mtime_ns, s.st_size)
        except OSError:
            snap[p] = None
    return snap


# ------------------------------------------------------------------------------------------
# P — orchestration goldens. AM1 freezes :22-38 byte-identical modulo indentation, so every
# expectation here was captured from the PRE-SLICE tool and is transcribed verbatim. They are
# NOT to be "corrected" to match a rewrite: a divergence is the rewrite's bug, by construction.
# Compared as json.dumps(..., sort_keys=False) so KEY ORDER is pinned too — a dict-literal
# compare would let a reordered/rebuilt block through.
# ------------------------------------------------------------------------------------------
def _st_logs(d):
    """Byte-exact fixture logs. Written with open(...,"wb") because byte-exactness IS the
    fixture in P13 (CRLF) and P14 (invalid UTF-8); a text-mode write normalises both away and
    leaves those two inert."""
    def wb(name, data):
        p = os.path.join(d, name)
        with open(p, "wb") as fh:
            fh.write(data)
        return p
    A = b'{"name":"Agent","input":{"subagent_type":"%s"}}\n'
    AM = b'{"name":"Agent","input":{"subagent_type":"%s"},"model":"%s"}\n'
    return {
        # deliberately NOT created — P1/P8 need a path that does not exist
        "missing": os.path.join(d, "nope.jsonl"),
        "empty": wb("empty.jsonl", b""),
        "noagent": wb("noagent.jsonl",
                      b'{"type":"user","content":"hello"}\n'
                      b'{"type":"result","subtype":"success"}\n'),
        "tester_only": wb("tester_only.jsonl", AM % (b"tester", b"claude-opus-5")),
        "clean": wb("clean.jsonl",
                    (AM % (b"tester", b"claude-opus-5"))
                    + (AM % (b"reviewer", b"claude-sonnet-5"))),
        "twoblocks": wb("twoblocks.jsonl",
                        b'[{"name":"Agent","input":{"subagent_type":"preview"}},'
