_ST_G_IDS = ("G1", "G2", "G3", "G4", "G5", "G6", "G6b", "G6c", "G7", "G8", "G8b", "G-exc",
             "G-hermetic")


def _st_git_env(home):
    """AM15. An ALLOWLIST, built fresh — never dict(os.environ) plus updates.

    The draft's scrub list omitted GIT_DIR/GIT_WORK_TREE/GIT_INDEX_FILE/GIT_OBJECT_DIRECTORY/
    GIT_COMMON_DIR/GIT_NAMESPACE/GIT_CEILING_DIRECTORIES, and `git -C <tmp>` does NOT override
    GIT_DIR. Followed literally, the red-team's PoC committed the operator's entire dirty tree
    into the live harness repo. Anything not named here does not reach git, today or after the
    next git release adds a variable nobody has heard of yet.
    """
    return {"PATH": os.environ.get("PATH", "/usr/bin:/bin"),
            "HOME": home,
            "GIT_CONFIG_NOSYSTEM": "1",
            "GIT_CONFIG_GLOBAL": os.devnull,
            "GIT_TERMINAL_PROMPT": "0",
            "GIT_AUTHOR_NAME": "lp04 fixture", "GIT_AUTHOR_EMAIL": "lp04@fixture.invalid",
            "GIT_COMMITTER_NAME": "lp04 fixture", "GIT_COMMITTER_EMAIL": "lp04@fixture.invalid"}


@contextlib.contextmanager
def _st_git_env_ctx(home):
    """audit_gating shells out to git WITHOUT passing env=, so the child inherits this process's
    environment. Swapping os.environ wholesale is the only way the allowlist actually reaches
    it — passing env= to our own fixture-builder calls alone would leave the code under test
    running against the operator's real git configuration."""
    saved = dict(os.environ)
    try:
        os.environ.clear()
        os.environ.update(_st_git_env(home))
        yield
    finally:
        os.environ.clear()
        os.environ.update(saved)


def _st_git(repo, args, env, timeout=60):
    return subprocess.run(["git", "-C", repo] + list(args),
                          capture_output=True, text=True, env=env, timeout=timeout)


def _st_build_repo(repo, env):
    """Returns (shas, error). Commit chain, one purpose per commit:
       c0 base · c1 non-test edit · c2 delete a test file · c3 add skip markers ·
       c4 remove asserts · c5 add suppressions · c6 benign test-file edit
    Non-test paths deliberately contain neither 'test' nor 'spec' anywhere, because the tool's
    testpat (:45) searches the WHOLE path case-insensitively."""
    os.makedirs(repo)
    r = subprocess.run(["git", "--version"], capture_output=True, text=True, env=env, timeout=60)
    if r.returncode != 0:
        # A5/AM15: `git` unusable is a FAIL, never a skip. A skipped gate reports green.
        return [], "git is unusable here: %s" % ((r.stderr or "").strip()[:120],)
    r = subprocess.run(["git", "-c", "init.defaultBranch=main", "-c", "commit.gpgsign=false",
                        "-c", "diff.renames=false", "init", repo],
                       capture_output=True, text=True, env=env, timeout=60)
    if r.returncode != 0:
        return [], "git init failed: %s" % ((r.stderr or "").strip()[:120],)
    for args in (["config", "user.name", "lp04 fixture"],
                 ["config", "user.email", "lp04@fixture.invalid"],
                 ["config", "commit.gpgsign", "false"],
                 # Pinned in the repo config as well as the env: the tool's own git children run
                 # plain `git -C repo diff` with no -c flags, and diff.renames=true would fold an
                 # add+delete pair into one rename record and change the counters this battery
                 # asserts by value.
                 ["config", "diff.renames", "false"]):
        r = _st_git(repo, args, env)
        if r.returncode != 0:
            return [], "git %s failed: %s" % (args[1], (r.stderr or "").strip()[:120])

    shas = []

    def commit(msg):
        for args in (["add", "-A"], ["commit", "-m", msg]):
            r = _st_git(repo, args, env)
            if r.returncode != 0:
                return "git %s failed: %s" % (args[0], (r.stderr or "").strip()[:160])
        r = _st_git(repo, ["rev-parse", "HEAD"], env)
        if r.returncode != 0:
            return "git rev-parse failed: %s" % ((r.stderr or "").strip()[:160],)
        shas.append(r.stdout.strip())
        return None

    j = os.path.join
    _st_w(j(repo, "src", "alpha.rs"), "a0\na1\na2\n")
    _st_w(j(repo, "docs", "notes.md"), "n0\n")
    # `evals` is a literal pathspec in the tool's second git call (:51); keep one file under it
    # so the pathspec always resolves, and never touch it so it never enters a diff.
    _st_w(j(repo, "evals", "keep.mjs"), "k0\n")
    _st_w(j(repo, "tests", "alpha_test.py"), "x = 1\nx = 2\n")
    _st_w(j(repo, "tests", "beta_test.py"), "y = 1\n")
    _st_w(j(repo, "tests", "gamma_test.py"),
          "assert x == 1\nplain line one\nassert y == 2\nplain line two\n"
          "assert z == 3\nassert w == 4\n")
    _st_w(j(repo, "tests", "delta.test.ts"), "const a = 1;\n")
    _st_w(j(repo, "tests", "epsilon_test.py"), "z = 1\n")
    err = commit("c0 base")
    if err:
        return shas, err

    _st_w(j(repo, "src", "alpha.rs"), "a0\na1\na2\na3\n")
    err = commit("c1 non-test edit only")
    if err:
        return shas, err

    os.remove(j(repo, "tests", "alpha_test.py"))
    err = commit("c2 delete a test file")
    if err:
        return shas, err

    # Three ADDED lines, each matching exactly one arm of the skip regex (:56) and none of the
    # suppression regex (:57) — the two counters must not double-count one line.
    _st_w(j(repo, "tests", "beta_test.py"),
          "y = 1\nit.skip(\"one\", () => {});\nit.skip(\"two\", () => {});\n#[ignore]\n")
    err = commit("c3 add skip markers")
    if err:
        return shas, err

    # Pure deletion of exactly two assert-bearing lines; nothing is added, so every counted `-`
    # line is one this fixture chose.
    _st_w(j(repo, "tests", "gamma_test.py"),
          "assert x == 1\nplain line one\nplain line two\nassert w == 4\n")
    err = commit("c4 remove two asserts")
    if err:
        return shas, err

    _st_w(j(repo, "tests", "delta.test.ts"),
          "const a = 1;\n// @ts-expect-error fixture\n// eslint-disable-next-line no-console\n")
    err = commit("c5 add suppressions")
    if err:
        return shas, err

    _st_w(j(repo, "tests", "epsilon_test.py"), "z = 1\nz = 2\n")
    err = commit("c6 benign test-file edit")
    return shas, err


