import datetime
import os
import re
import shutil
import sys

CANONICAL = (
    "/home/mdrewt/projects/ai-apps/claude-harness/memory/projects/monster-realm-usage-ledger.jsonl",
    "/home/mdrewt/projects/ai-apps/claude-harness/memory/projects/monster-realm-handoff.md",
    # lp-gates: the residual registry is append-only, gitignored, and is the ONLY record of a
    # deferred criterion between the DEFER line and its promoted spec section. Losing it loses the
    # routing for work that has already been declared — the precise failure this mechanism exists
    # to end. Same argument as the usage ledger, which is why it joins the same canonical set.
    "/home/mdrewt/projects/ai-apps/claude-harness/memory/projects/mr-residuals.jsonl",
)
RETENTION = 14
DAY_RE = re.compile(r"^\d{8}$")


def _canon():
    """Resolved canonical paths + their basenames, recomputed per call so the selftest can rebind
    CANONICAL to a disposable fixture instead of pointing a test at the real ledger."""
    return [os.path.realpath(p) for p in CANONICAL], [os.path.basename(p) for p in CANONICAL]


def _err(msg):
    sys.stderr.write("mr-backup: ERROR %s\n" % msg)


def _root():
    r = os.environ.get("MR_BACKUP_ROOT")
    if not r:
        base = os.environ.get("XDG_STATE_HOME") or os.path.join(
            os.environ.get("HOME") or os.path.expanduser("~"), ".local", "state")
        r = os.path.join(base, "mr-backup")
    return os.path.realpath(r)


def _root_illegal(root):
    """The reason this root may not be used, or None. NEVER creates anything: a skipped snapshot
    must leave no root behind for a later reader to mistake for a backup."""
    if os.path.basename(root) != "mr-backup":
        return ("refusing root %s: a backup root's basename must be literally `mr-backup` (the "
                "prune unlinks 8-digit directories under it -- see the header)" % root)
    p = root
    while True:
        if os.path.exists(os.path.join(p, ".git")):
            return ("refusing root %s: it is inside the git working tree at %s -- a backup that "
                    "`git clean -xfd` deletes is not a backup" % (root, p))
        parent = os.path.dirname(p)
        if parent == p:
            return None
        p = parent


def _copy(src, dst):
    """tmp + os.replace: a crash mid-copy must never leave a truncated file that LOOKS like a
    backup (the pattern mr-record's rotation and mr-state.json's writer already use)."""
    tmp = "%s.tmp.%d" % (dst, os.getpid())
    try:
        shutil.copyfile(src, tmp)
        os.replace(tmp, dst)
    except BaseException:
        # Best-effort sweep of the partial file. An interrupted copy (mr-record's own 10s kill is
        # the realistic case) otherwise leaves a `<dst>.tmp.<pid>` orphan that _prune never
        # collects -- it only ever touches whole day-directories. BaseException, not Exception, so
        # a signal-driven SystemExit/KeyboardInterrupt cleans up too.
        try:
            os.remove(tmp)
        except OSError:
            pass
        raise


def _prune(root):
    """Direct children only, `^\\d{8}$` only, real directories only, symlinks neither followed nor
    removed. Everything else under the root is left strictly alone -- no unguarded recursive
    delete (the standing corpus rule mr-unlock exists for)."""
    if not os.path.isdir(root):
        return
    days = []
    for n in os.listdir(root):
        p = os.path.join(root, n)
        if not DAY_RE.match(n) or os.path.islink(p) or not os.path.isdir(p):
            continue
        try:
            datetime.datetime.strptime(n, "%Y%m%d")
        except ValueError:
            # ASYMMETRY, on purpose: an `^\d{8}$` name that is not a real calendar date is neither
            # DELETED (it is not ours to remove) nor COUNTED. Counting it would be the actual bug:
            # `99999999` sorts lexicographically newest, so it would hold a retention slot forever
            # and silently break the stated 14-day/~20 MB bound while every other check stayed green.
            continue
        days.append(n)
    for name in sorted(days, reverse=True)[RETENTION:]:
        try:
            shutil.rmtree(os.path.join(root, name))
        except OSError as exc:
            # Reported, never fatal. Silently swallowing this (the old ignore_errors=True) let a
            # sustained permission/disk failure grow the root without bound with no operator-visible
            # signal -- the only failure path in this tool that produced no diagnostic at all.
            _err("could not prune %s: %s -- the %d-day retention bound is not being held"
                 % (os.path.join(root, name), exc, RETENTION))


def snapshot(files):
    root = _root()
    illegal = _root_illegal(root)
    if illegal:
        _err(illegal)
        return 2
    fixture_mode = bool(os.environ.get("MR_BACKUP_ROOT"))
    canon_paths, _names = _canon()
    day = datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%d")
    for src in (files or list(CANONICAL)):
        real = os.path.realpath(src)
        if not fixture_mode and real not in canon_paths:
            sys.stderr.write("skip: not a canonical source (MR_BACKUP_ROOT unset): %s\n" % src)
            continue
        if not os.path.isfile(real):
            sys.stderr.write("skip: not a readable regular file: %s\n" % src)
            continue
        try:
            os.makedirs(os.path.join(root, day), exist_ok=True)
            dst = os.path.join(root, day, os.path.basename(real))
            _copy(real, dst)
        except OSError as exc:
            _err("could not write the snapshot of %s: %s" % (src, exc))
            return 2
        print("snapshot: %s -> %s" % (real, dst))
    _prune(root)
    return 0


def restore(name, to):
    """The NEWEST snapshot of a canonical basename. `name` is a CLOSED VOCABULARY -- those two
    basenames and nothing else -- which is also what makes separators and `..` unreachable; the
    explicit re-check is belt-and-braces against a future edit that widens the vocabulary without
    remembering why it was closed."""
    canon_paths, canon_names = _canon()
    if name not in canon_names or "/" in name or os.sep in name or ".." in name:
        _err("refusing --file %r: allowed values are exactly %s" % (name, canon_names))
        return 2
    root = _root()
    illegal = _root_illegal(root)
    if illegal:
        _err(illegal)
        return 2
    src = None
    if os.path.isdir(root):
        for day in sorted((d for d in os.listdir(root) if DAY_RE.match(d)), reverse=True):
            if os.path.isfile(os.path.join(root, day, name)):
                src = os.path.join(root, day, name)
                break
    if src is None:
        _err("no snapshot of %s exists under %s" % (name, root))
        return 2
    dst = os.path.join(os.path.realpath(to), name)
    # Checked BEFORE the write, never after: the ledger is append-only, so a restore landing on top
    # of the live file is the one irreversible harm this tool can do.
    if dst in canon_paths:
        _err("refusing to restore onto the live canonical source %s -- restore into a scratch "
             "directory and diff it by hand" % dst)
        return 2
    try:
        os.makedirs(os.path.dirname(dst), exist_ok=True)
        _copy(src, dst)
    except OSError as exc:
        _err("could not write %s: %s" % (dst, exc))
        return 2
    print("restored: %s -> %s" % (src, dst))
    return 0


def main(argv):
    if argv[:1] == ["--selftest"]:
        return selftest()
    if argv[:1] == ["snapshot"]:
        files, rest = [], argv[1:]
        while rest:
            if rest[0] != "--file" or len(rest) < 2:
                _err("usage: mr-backup snapshot [--file PATH]...")
                return 2
            files.append(rest[1])
            rest = rest[2:]
        return snapshot(files)
    if argv[:1] == ["restore"]:
        a = dict(zip(argv[1::2], argv[2::2]))
        if len(argv) % 2 == 0 or len(a) != 2 or set(a) != {"--file", "--to"}:
            _err("usage: mr-backup restore --file <basename> --to <dir>")
            return 2
        return restore(a["--file"], a["--to"])
    _err("usage: mr-backup snapshot|restore|--selftest (see the header)")
    return 2


def selftest():
    """A real in-process fixture battery at a tmp root: it never touches the real root (every case
    either sets MR_BACKUP_ROOT under the tempdir or points HOME there) and leaves nothing behind.
    mr-selfcheck parses BOTH the marker and this COUNT -- a bare `|| BAD=1` passes identically
    against a ten-line stub, and a battery that quietly shrinks must red."""
    import contextlib
    import io
    import tempfile
    global CANONICAL
    n = [0, 0]                                      # [cases, failures]

    def run(argv, **envset):
        """Drives real main() through real argv, with an env overlay restored afterwards."""
        old = dict((k, os.environ.get(k)) for k in envset)
        for k, v in envset.items():
            os.environ.pop(k, None) if v is None else os.environ.update({k: v})
        out, err = io.StringIO(), io.StringIO()
        try:
            with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
                rc = main(argv)
        finally:
            for k, v in old.items():
                os.environ.pop(k, None) if v is None else os.environ.update({k: v})
        return rc, out.getvalue(), err.getvalue()

    def check(name, cond, detail=""):
        n[0] += 1
        if not cond:
            n[1] += 1
            print("FAIL %s %s" % (name, detail))

    with tempfile.TemporaryDirectory(prefix="mr-backup-selftest-") as T:
        root, home = os.path.join(T, "mr-backup"), os.path.join(T, "home")
        src = os.path.join(T, "src", "monster-realm-usage-ledger.jsonl")
        os.makedirs(os.path.dirname(src)); os.makedirs(home)
        # Non-ASCII plus a trailing partial line with no newline: a size-only or text-mode compare
        # passes on identical files but fails on these, so the byte-compare below has real teeth.
        blob = ("".join('{"i": %d, "n": "café ☃"}\n' % i for i in range(200))
                + '{"partial": true').encode("utf-8")
        open(src, "wb").write(blob)

        rc, _o, err = run(["snapshot", "--file", src], MR_BACKUP_ROOT=root)
        out_dir = os.path.join(T, "restored")
        rc2, _o2, _e2 = run(["restore", "--file", "monster-realm-usage-ledger.jsonl",
                             "--to", out_dir], MR_BACKUP_ROOT=root)
        got = open(os.path.join(out_dir, os.path.basename(src)), "rb").read() if rc2 == 0 else b""
        check("roundtrip-byte-identical", (rc, rc2, got) == (0, 0, blob),
              "rc=%s/%s err=%r identical=%s" % (rc, rc2, err[:120], got == blob))

        run(["snapshot", "--file", src], MR_BACKUP_ROOT=root)
        dirs = [d for d in os.listdir(root) if DAY_RE.match(d)]
        check("idempotent-one-day-dir",
              len(dirs) == 1 and len(os.listdir(os.path.join(root, dirs[0]))) == 1, "%r" % (dirs,))

        for i in range(1, 21):
            os.makedirs(os.path.join(root, "202001%02d" % i))
        open(os.path.join(root, "20260199"), "w").write("decoy file")
        os.makedirs(os.path.join(root, "keepme"))
        run(["snapshot", "--file", src], MR_BACKUP_ROOT=root)
        kept = sorted(d for d in os.listdir(root)
                      if DAY_RE.match(d) and os.path.isdir(os.path.join(root, d)))
        check("prune-keeps-newest-14", len(kept) == RETENTION, "kept %r" % (kept,))
        check("prune-spares-non-day-entries",
              os.path.isfile(os.path.join(root, "20260199"))
              and os.path.isdir(os.path.join(root, "keepme")),
              "an 8-digit FILE or a non-matching directory was deleted")

        # `backup-scratch`, not `notbackup`: a near-miss that a substring/token match would WAVE
        # THROUGH is the only fixture that actually pins literal-name equality.
        bad_root = os.path.join(T, "backup-scratch")
        rc, _o, _e = run(["snapshot", "--file", src], MR_BACKUP_ROOT=bad_root)
        check("illegal-root-basename-not-literal", rc != 0 and not os.path.exists(bad_root),
              "rc=%s exists=%s" % (rc, os.path.exists(bad_root)))

        in_tree = os.path.join(T, "repo", "mr-backup")
        os.makedirs(os.path.join(T, "repo", ".git"))
        rc, _o, _e = run(["snapshot", "--file", src], MR_BACKUP_ROOT=in_tree)
        check("illegal-root-in-git-tree", rc != 0 and not os.path.exists(in_tree),
              "rc=%s exists=%s" % (rc, os.path.exists(in_tree)))

        rc, out, err = run(["snapshot", "--file", os.path.join(T, "src")],
                           MR_BACKUP_ROOT=None, XDG_STATE_HOME=None, HOME=home)
        check("production-skips-non-canonical",
              rc == 0 and "skip:" in err and "snapshot:" not in out
              and not os.path.exists(os.path.join(home, ".local", "state", "mr-backup")),
              "rc=%s out=%r err=%r" % (rc, out[:80], err[:120]))

        for label, fname in (("restore-rejects-foreign-name", "some-other-name.md"),
                             ("restore-rejects-traversal", "../../etc/passwd"),
                             ("restore-without-snapshot", "monster-realm-handoff.md")):
            check(label, run(["restore", "--file", fname, "--to", T], MR_BACKUP_ROOT=root)[0] != 0)

        # The destination guard needs a --to that RESOLVES ONTO a canonical source, so the constant
        # is rebound to a disposable fixture for this one case: a battery that pointed --to at the
        # real ledger to get a true positive would BE the defect it is testing for.
        saved = CANONICAL
        try:
            CANONICAL = (src, CANONICAL[1])
            rc, _o, _e = run(["restore", "--file", "monster-realm-usage-ledger.jsonl",
                              "--to", os.path.dirname(src)], MR_BACKUP_ROOT=root)
            check("restore-refuses-canonical-destination",
                  rc != 0 and open(src, "rb").read() == blob,
                  "rc=%s live-file-changed=%s" % (rc, open(src, "rb").read() != blob))
        finally:
            CANONICAL = saved

    if n[1]:
        print("BACKUP-SELFTEST-FAIL %d/%d" % (n[1], n[0]))
        return 1
    print("BACKUP-SELFTEST-OK %d" % n[0])
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
