#!/bin/bash
# mr-ci-watch <pr-number> <slice> — zero-token CI watcher. Launch DETACHED: setsid bash mr-ci-watch PR SLICE & disown
#   or: mr-ci-watch --run <run-id> — same, for one workflow run (the master push run after a merge or a rerun).
# Distinguishes checks-concluded vs gh-error (retry<=3 backoff -> INCONCLUSIVE). Fires a tick via pending-event.
set -u
exec 9>&- 2>/dev/null || true   # drop inherited tick-flock fd (prevents lock wedge)
unset MR_FORCE MR_TICK_DRYRUN MR_OPERATOR_RUN MR_EVENT_SRC 2>/dev/null || true   # forced-ness must not propagate to the ticks we spawn
MEM=/home/mdrewt/projects/ai-apps/claude-harness/memory/projects
RUN=""
if [ "${1:-}" = "--run" ]; then
  RUN="${2:?run-id}"; case "$RUN" in *[!0-9]*) echo "mr-ci-watch: run id must be numeric" >&2; exit 2;; esac
  S="master-$RUN"; REF="run=$RUN"
else
  PR="${1:?pr}"; S="${2:?slice}"; REF="pr=$PR"
fi
[ -f "$MEM/.native-supervisor-disabled" ] && exit 0
[ "${MR_NO_EVENT_BRIDGE:-0}" = "1" ] && exit 0
LOCKD="/tmp/mr_ciwatch_$S.lock.d"
mkdir "$LOCKD" 2>/dev/null || { OP=$(cat "$LOCKD/pid" 2>/dev/null); [ -n "$OP" ] && kill -0 "$OP" 2>/dev/null && grep -q mr-ci-watch "/proc/$OP/cmdline" 2>/dev/null && exit 0; rm -rf "$LOCKD"; mkdir "$LOCKD" || exit 0; }
echo $$ > "$LOCKD/pid"
trap 'rm -rf "$LOCKD"' EXIT
fire(){ # $1=state $2=detail (may be multi-line)
  EV="$MEM/pending-events/$S.ci.md"
  { echo "EVENT src=ci slice=$S $REF state=$1 at=$(date -u +%Y-%m-%dT%H:%M:%SZ)"; printf '%s\n' "$2"; } > "$EV"
  MR_EVENT_SRC=ci setsid /bin/bash "$MEM/mr-native-tick.sh" "$EV" >/dev/null 2>&1 &
}
red_details(){ # pre-filtered failure evidence for the event; best-effort, bounded, never fails
  local TBL LINK RID OUT=""
  TBL=$(timeout 30 gh pr checks "$PR" -R mdrewt/monster-realm 2>/dev/null | head -20)
  OUT="--- checks table ---
${TBL:-(checks table unavailable)}"
  LINK=$(timeout 30 gh pr checks "$PR" -R mdrewt/monster-realm --json name,state,link -q 'first(.[]|select(.state=="FAILURE" or .state=="fail")).link' 2>/dev/null)
  RID=$(printf '%s' "$LINK" | grep -oE '/runs/[0-9]+' | grep -oE '[0-9]+' | head -1)
  if [ -n "$RID" ]; then
    OUT="$OUT
--- failed step log tail (run $RID) ---
$(timeout 45 gh run view "$RID" -R mdrewt/monster-realm --log-failed 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g' | tail -n 60 | head -c 4000)"
  else
    OUT="$OUT
(failed-run log unavailable: no run id resolved)"
  fi
  printf '%s' "$OUT"
}
run_state(){ timeout 30 gh run view "$RUN" -R mdrewt/monster-realm --json status,conclusion -q '.status+" "+.conclusion' 2>/dev/null; }
if [ -n "$RUN" ]; then
  # A rerun requested a moment ago can still read as the concluded previous attempt; give it a minute to requeue.
  for _ in 1 2 3 4 5 6; do case "$(run_state)" in completed*) sleep 10;; *) break;; esac; done
  for TRY in 1 2 3; do
    timeout 3300 gh run watch "$RUN" -R mdrewt/monster-realm --exit-status >/dev/null 2>&1; RC=$?
    CONC=$(run_state)
    case "$CONC" in
      "completed success") fire green "run $RUN passed"; exit 0;;
      "completed cancelled") fire cancelled "run $RUN was cancelled (a newer master push supersedes it)"; exit 0;;
      completed*) fire red "run $RUN concluded ${CONC#completed } (watch rc=$RC)
--- failed step log tail (run $RUN) ---
$(timeout 45 gh run view "$RUN" -R mdrewt/monster-realm --log-failed 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g' | tail -n 60 | head -c 4000)"; exit 0;;
    esac
    sleep $((30*TRY))
  done
  fire inconclusive "CI-WATCH-INCONCLUSIVE after 3 attempts (gh errors or run $RUN still pending past timeout)"
  exit 0
fi
for TRY in 1 2 3; do
  # merged/closed? then no watch needed
  ST=$(timeout 30 gh pr view "$PR" -R mdrewt/monster-realm --json state,mergedAt 2>/dev/null)
  case "$ST" in *'"MERGED"'*|*'"CLOSED"'*) exit 0;; esac
  if timeout 3300 gh pr checks "$PR" -R mdrewt/monster-realm --watch >/dev/null 2>&1; then
    fire green "all checks passed"; exit 0
  else
    RC=$?
    # rc=8 means checks pending timeout w/ gh<2.x variants; non-zero can also mean failed checks (concluded)
    CONC=$(timeout 30 gh pr checks "$PR" -R mdrewt/monster-realm 2>/dev/null | grep -cE "fail|pass" || true)
    PEND=$(timeout 30 gh pr checks "$PR" -R mdrewt/monster-realm 2>/dev/null | grep -c "pending" || true)
    if [ "${PEND:-0}" = "0" ] && [ "${CONC:-0}" != "0" ]; then fire red "checks concluded with failures (watch rc=$RC)
$(red_details)"; exit 0; fi
    sleep $((30*TRY))
  fi
done
fire inconclusive "CI-WATCH-INCONCLUSIVE after 3 attempts (gh errors or still pending past timeout)"
exit 0
