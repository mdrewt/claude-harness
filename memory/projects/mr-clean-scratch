#!/usr/bin/python3
''''exec /usr/bin/python3 "$0" "$@" # '''
# ^ POLYGLOT INTERPRETER GUARD. Run as a shell script, this file would be interpreted as shell and
# any backticked prose in it executed as commands. Python reads the line as a no-op string; sh/bash
# re-execs the file under python3 before reaching any other line. mr-selfcheck enforces it.
# The guard line above is the module's first string, so the usage text is bound by name.
USAGE = """mr-clean-scratch — remove scratch directories and stale git worktrees without a recursive rm.

    mr-clean-scratch PATH...            dry run: print each target, its size and the action
    mr-clean-scratch --apply PATH...    perform it
    mr-clean-scratch --stale [--apply]  sweep the allowlisted roots for candidates
    mr-clean-scratch --selftest

The Bash guard hook blocks every recursive rm by text match, and a headless session that hits a
block stops to ask a human who is not there. This tool is the sanctioned route: the safety lives in
code here, so the guard stays as strict as it is.

WHAT MAY BE REMOVED. A target is judged by its real path and must lie under one of:
    /tmp/claude-<uid>/**/scratchpad/<anything below the scratchpad directory>
    /tmp/mr-*/            the directory or anything below it
    /tmp/tmp.*/           (mktemp) the directory or anything below it
    /tmp/<name>.<random>/ only a registered git worktree of the harness or game repo
Everything else is REFUSED, and so is: a path that passes through a symlink, a main checkout, any
path inside (or containing) either repo checkout or $HOME, a path inside a registered worktree, a
directory that contains one, and any path naming the kill switch, a runner lock or the event queue.

A REGISTERED WORKTREE is removed only by git worktree remove (never forced) followed by prune, and
only when it is unlocked, has no modified or untracked-unignored files, and its HEAD is kept:
reachable from a remote-tracking branch or the default branch, or its branch has a merged PR whose
head contains it. Squash merges put no branch commit on the default branch, so ancestry alone
cannot answer that last question; the PR state does, as in mr-branch-audit.

DELETION never follows a symlink and never leaves the target's filesystem. Nothing is removed while
a live process has its cwd inside the target.

AGE FLOOR. --stale skips anything modified in the last 60 minutes. A path named as an argument is
exempt from the floor and from nothing else.

OUTPUT. One line per target: WOULD-REMOVE / REMOVED / PARTIAL / SKIP / REFUSED / ABSENT. Exit 1 when
a named target was not removable, 2 on a usage or environment error. Every deletion is appended to
mr-clean-scratch.log beside this tool's live copy.
"""
import contextlib
import io
import json
import os
import re
import stat
import subprocess
import sys
import tempfile
import time

HARNESS = "/home/mdrewt/projects/ai-apps/claude-harness"
PROJ = HARNESS + "/projects/monster-realm"
AGE_FLOOR_S = 60 * 60
FORBIDDEN = (".native-supervisor-disabled", ".harness-runner", "pending-events")
SANDBOX_RE = re.compile(r"[^./][^/]*\.[A-Za-z0-9_]{4,}")
GUARD = '''\'\'\'\'exec /usr/bin/python3 "$0" "$@" # \'\'\''''


def git(cwd, *args):
    env = {k: v for k, v in os.environ.items()
           if k not in ("GIT_DIR", "GIT_WORK_TREE", "GIT_INDEX_FILE")}
    return subprocess.run(("git", "-C", cwd) + args, capture_output=True, text=True,
                          timeout=300, env=env)


def pr_covers(prs, sha, is_ancestor):
    """True when a merged PR's head is `sha` or a descendant of it — the squash already carries it."""
    return any(p.get("headRefOid") == sha or is_ancestor(sha, p.get("headRefOid") or "")
               for p in prs)


def gh_pr_merged(repo, branch, sha):
    """Any failure answers False: an unanswerable question keeps the worktree."""
    m = re.search(r"github\.com[:/]([^/\s]+/[^/\s]+?)(?:\.git)?\s*$",
                  git(repo, "remote", "get-url", "origin").stdout)
    if not m:
        return False
    try:
        r = subprocess.run(("gh", "pr", "list", "-R", m.group(1), "--head", branch, "--state",
                            "merged", "-L", "20", "--json", "number,headRefOid"),
                           capture_output=True, text=True, timeout=60)
        prs = json.loads(r.stdout or "[]") if r.returncode == 0 else []
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return False
    return pr_covers(prs, sha, lambda a, b: bool(b) and git(
        repo, "merge-base", "--is-ancestor", a, b).returncode == 0)


class Cfg:
    """Where the tool looks. --selftest builds its own instance over temp dirs."""

    def __init__(self):
        self.tmp = "/tmp"
        self.uid = os.getuid()
        self.home = os.path.realpath(os.path.expanduser("~"))
        self.repos = [(HARNESS, "main"), (PROJ, "master")]
        self.log = HARNESS + "/memory/projects/mr-clean-scratch.log"
        self.pr_merged = gh_pr_merged
        self.now = time.time


def worktrees(cfg):
    """Every registered worktree of both repos. A repo that cannot be listed aborts the run:
    without the list, a worktree would be mistaken for a plain directory."""
    out = []
    for repo, default in cfg.repos:
        if not os.path.isdir(repo):
            continue
        r = git(repo, "worktree", "list", "--porcelain")
        if r.returncode != 0:
            raise RuntimeError("cannot list worktrees of %s: %s" % (repo, r.stderr.strip()))
        first = True
        for block in r.stdout.strip().split("\n\n"):
            w = {"repo": repo, "default": default, "main": first, "branch": None,
                 "head": None, "locked": False}
            for line in block.splitlines():
                key, _, val = line.partition(" ")
                if key == "worktree":
                    w["path"] = os.path.realpath(val)
                elif key == "HEAD":
                    w["head"] = val
                elif key == "branch":
                    w["branch"] = val.replace("refs/heads/", "", 1)
                elif key == "locked":
                    w["locked"] = True
            if "path" in w:
                out.append(w)
                first = False
    return out


def inside(child, parent):
    return child.startswith(parent.rstrip("/") + "/")


def classify(arg, cfg, wts):
    """-> (kind, real, detail): kind is 'refuse' | 'absent' | 'tree' | 'worktree'."""
    lex = os.path.normpath(os.path.abspath(arg))
    for bad in FORBIDDEN:
        if bad in lex:
            return "refuse", lex, "path names %s" % bad
    if not os.path.lexists(lex):
        return "absent", lex, ""
    real = os.path.realpath(lex)
    if real != lex:
        return "refuse", lex, "passes through a symlink (resolves to %s)" % real
    for label, p in [("$HOME", cfg.home)] + [("a repo checkout", r) for r, _ in cfg.repos]:
        if real == p or inside(p, real):
            return "refuse", real, "is or contains %s" % label
    for w in wts:
        if w["main"] and (real == w["path"] or inside(real, w["path"])):
            return "refuse", real, "is inside the main checkout %s" % w["path"]
    if not inside(real, cfg.tmp):
        return "refuse", real, "outside the allowlisted roots"
    parts = real[len(cfg.tmp.rstrip("/")) + 1:].split("/")
    top = parts[0]
    if top == "claude-%d" % cfg.uid:
        ok = "scratchpad" in parts[1:-1]
    elif (top.startswith("mr-") and len(top) > 3) or (top.startswith("tmp.") and len(top) > 4):
        ok = os.path.isdir(os.path.join(cfg.tmp, top))
    else:
        ok = False
    sandbox = not ok and SANDBOX_RE.fullmatch(top) is not None
    if not ok and not sandbox:
        return "refuse", real, "outside the allowlisted roots"
    for w in wts:
        if real == w["path"]:
            return "worktree", real, w
    for w in wts:
        if inside(real, w["path"]):
            return "refuse", real, "inside registered worktree %s — name the worktree" % w["path"]
    held = [w["path"] for w in wts if inside(w["path"], real)]
    if held:
        return "refuse", real, "contains registered worktree %s — remove it first" % held[0]
    if sandbox:
        return "refuse", real, "a sandbox dir is removable only as a registered worktree"
    return "tree", real, None


def live_cwd(real):
    """pid of a process whose cwd is the target or below it, else None."""
    for name in os.listdir("/proc"):
        if not name.isdigit():
            continue
        try:
            cwd = os.readlink("/proc/%s/cwd" % name)
        except OSError:
            continue
        if cwd == real or inside(cwd, real):
            return int(name)
    return None


def measure(root):
    """-> (bytes on disk, newest mtime, crosses a filesystem). Symlinks are never followed."""
    st = os.lstat(root)
    total, newest, foreign = st.st_blocks * 512, st.st_mtime, False
    stack = [root] if stat.S_ISDIR(st.st_mode) else []
    while stack:
        try:
            it = os.scandir(stack.pop())
        except OSError:
            continue
        with it:
            for e in it:
                try:
                    s = e.stat(follow_symlinks=False)
                except OSError:
                    continue
                if s.st_dev != st.st_dev:
                    foreign = True
                    continue
                total += s.st_blocks * 512
                newest = max(newest, s.st_mtime)
                if stat.S_ISDIR(s.st_mode):
                    stack.append(e.path)
    return total, newest, foreign


def _rm_entry(pfd, name, dev, shown, left):
    try:
        st = os.lstat(name, dir_fd=pfd)
        if st.st_dev != dev:
            left.append("%s (other filesystem)" % shown)
            return
        if not stat.S_ISDIR(st.st_mode):
            os.unlink(name, dir_fd=pfd)
            return
        fd = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=pfd)
    except OSError as e:
        left.append("%s (%s)" % (shown, e.strerror))
        return
    try:
        if os.fstat(fd).st_dev != dev:
            left.append("%s (other filesystem)" % shown)
            return
        with contextlib.suppress(OSError):
            os.fchmod(fd, 0o700)  # a read-only directory cannot have its entries unlinked
        with os.scandir(fd) as it:
            names = [e.name for e in it]
        for n in names:
            _rm_entry(fd, n, dev, shown + "/" + n, left)
    finally:
        os.close(fd)
    try:
        os.rmdir(name, dir_fd=pfd)
    except OSError as e:
        left.append("%s (%s)" % (shown, e.strerror))


def rm_tree(path, dev=None):
    """Delete `path` entry by entry through directory fds opened O_NOFOLLOW, staying on device
    `dev` (default: the target's own). Returns what could not be removed."""
    left = []
    parent, name = os.path.split(path)
    pfd = os.open(parent, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        _rm_entry(pfd, name, os.lstat(name, dir_fd=pfd).st_dev if dev is None else dev, path, left)
    finally:
        os.close(pfd)
    return left


def wt_blocker(w, cfg):
    """Why this worktree must be kept, or None."""
    if w["locked"]:
        return "worktree is locked"
    st = git(w["path"], "--no-optional-locks", "status", "--porcelain")
    if st.returncode != 0:
        return "git status failed: %s" % st.stderr.strip()[:120]
    if st.stdout.strip():
        return "uncommitted or untracked changes (%d paths)" % len(st.stdout.splitlines())
    sha, repo = w["head"], w["repo"]
    if not sha:
        return "no HEAD"
    if git(repo, "for-each-ref", "--count=1", "--contains", sha, "refs/remotes").stdout.strip():
        return None
    if git(repo, "merge-base", "--is-ancestor", sha, w["default"]).returncode == 0:
        return None
    if w["branch"] and cfg.pr_merged(repo, w["branch"], sha):
        return None
    return ("HEAD %s is on no remote-tracking branch, not on %s, and has no merged PR"
            % (sha[:8], w["default"]))


def human(n):
    for unit in ("B", "K", "M", "G"):
        if n < 1024 or unit == "G":
            return ("%d%s" if unit == "B" else "%.1f%s") % (n, unit)
        n /= 1024.0


def process(arg, explicit, cfg, wts, apply):
    """Judge one target and, with apply, remove it. -> 'removed' | 'kept' | 'absent'."""
    kind, real, detail = classify(arg, cfg, wts)
    if kind == "absent":
        print("ABSENT %s" % real)
        return "absent"

    def keep(why, word="SKIP"):
        print("%s %s — %s" % (word, real, why))
        return "kept"

    if kind == "refuse":
        return keep(detail, "REFUSED" if explicit else "SKIP")
    pid = live_cwd(real)
    if pid:
        return keep("process %d has its cwd inside" % pid)
    size, newest, foreign = measure(real)
    age = cfg.now() - newest
    if not explicit and age < AGE_FLOOR_S:
        return keep("modified %d min ago (name it as an argument to remove it anyway)" % (age // 60))
    label = kind if os.path.isdir(real) else "file"
    if kind == "worktree":
        if foreign:
            return keep("contains another filesystem")
        why = wt_blocker(detail, cfg)
        if why:
            return keep(why)
    if not apply:
        print("WOULD-REMOVE %s %s %s" % (label, human(size), real))
        return "removed"
    with open(cfg.log, "a") as log:  # opened first: no audit line, no deletion
        if kind == "worktree":
            r = git(detail["repo"], "worktree", "remove", real)
            if r.returncode != 0:
                return keep("git worktree remove refused: %s" % r.stderr.strip()[:160])
            git(detail["repo"], "worktree", "prune")
            parent = os.path.dirname(real)
            if os.path.dirname(parent) == cfg.tmp and SANDBOX_RE.fullmatch(os.path.basename(parent)):
                with contextlib.suppress(OSError):
                    os.rmdir(parent)  # the emptied sandbox dir; a non-empty one stays
            left = []
        else:
            if os.path.realpath(real) != real:
                return keep("changed under us")
            left = rm_tree(real)
        word = "PARTIAL" if left else "REMOVED"
        log.write("%s pid=%d %s %s bytes=%d %s\n" % (
            time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), os.getpid(), word, label, size, real))
    if left:
        print("PARTIAL %s %s — %d entries left, first: %s" % (label, real, len(left), left[0]))
        return "kept"
    print("REMOVED %s %s %s" % (label, human(size), real))
    return "removed"


def stale_candidates(cfg, wts):
    """Sweep candidates: scratchpad entries, whole mr-*/tmp.* dirs, and worktrees under the tmp root.
    Each still goes through process(), so this list grants nothing."""
    cands = []
    base = os.path.join(cfg.tmp, "claude-%d" % cfg.uid)
    level = [base] if os.path.isdir(base) and not os.path.islink(base) else []
    for _ in range(3):  # <root>/<project>/<session>/scratchpad
        nxt = []
        for d in level:
            with contextlib.suppress(OSError), os.scandir(d) as it:
                for e in it:
                    if not e.is_dir(follow_symlinks=False):
                        continue
                    if e.name == "scratchpad":
                        with contextlib.suppress(OSError), os.scandir(e.path) as kids:
                            cands += [k.path for k in kids]
                    else:
                        nxt.append(e.path)
        level = nxt
    with os.scandir(cfg.tmp) as it:
        for e in it:
            if (e.name.startswith("mr-") or e.name.startswith("tmp.")) and \
                    e.is_dir(follow_symlinks=False) and \
                    not any(inside(w["path"], e.path) for w in wts):
                cands.append(e.path)
    cands += [w["path"] for w in wts if not w["main"] and inside(w["path"], cfg.tmp)]
    return sorted(set(cands))


def run(argv, cfg):
    apply, stale = "--apply" in argv, "--stale" in argv
    paths = [a for a in argv if a not in ("--apply", "--stale")]
    if any(p.startswith("-") for p in paths) or not (paths or stale):
        print(USAGE)
        return 2
    try:
        wts = worktrees(cfg)
    except (RuntimeError, OSError, subprocess.TimeoutExpired) as e:
        print("CLEAN-SCRATCH-ABORT %s" % e)
        return 2
    rc, removed = 0, 0
    try:
        for p in paths:
            got = process(p, True, cfg, wts, apply)
            removed += got == "removed"
            rc = rc or (1 if got == "kept" else 0)
        if stale:
            named = {os.path.normpath(os.path.abspath(p)) for p in paths}
            for p in stale_candidates(cfg, wts):
                if p not in named:
                    removed += process(p, False, cfg, wts, apply) == "removed"
    except OSError as e:
        print("CLEAN-SCRATCH-ABORT %s" % e)
        return 2
    print("CLEAN-SCRATCH %s: %d target(s)%s" % (
        "applied" if apply else "dry-run", removed,
        " removed" if apply else " would be removed — add --apply to do it"))
    return rc


def selftest():
    """Real directories, real git repos and worktrees, all under one temp dir of its own."""
    for k, v in (("GIT_CONFIG_GLOBAL", "/dev/null"), ("GIT_CONFIG_NOSYSTEM", "1"),
                 ("GIT_AUTHOR_NAME", "t"), ("GIT_AUTHOR_EMAIL", "t@t"),
                 ("GIT_COMMITTER_NAME", "t"), ("GIT_COMMITTER_EMAIL", "t@t")):
        os.environ[k] = v
    base = os.path.realpath(tempfile.mkdtemp(prefix="mr-clean-scratch-selftest."))
    fails, n = [], [0]

    def check(name, cond):
        n[0] += 1
        if not cond:
            fails.append(name)
            print("CLEAN-SCRATCH-SELFTEST-FAIL %s" % name)

    def mk(*parts, file=None):
        d = os.path.join(base, *parts)
        os.makedirs(d, exist_ok=True)
        if file:
            with open(os.path.join(d, file), "w") as fh:
                fh.write("x" * 5000)
        return d

    def age(path, secs=3 * 3600):
        t = time.time() - secs
        for root, dirs, files in os.walk(path):
            for x in dirs + files:
                os.utime(os.path.join(root, x), (t, t), follow_symlinks=False)
        os.utime(path, (t, t))

    def g(cwd, *a):
        r = git(cwd, *a)
        assert r.returncode == 0, (a, r.stderr)
        return r.stdout.strip()

    cfg = Cfg()
    cfg.tmp = mk("tmp")
    cfg.home = mk("home", file="keep")
    cfg.log = os.path.join(base, "log")
    merged_branches = set()
    cfg.pr_merged = lambda repo, branch, sha: branch in merged_branches
    uid = cfg.uid
    # "game": main checkout under home, with a real origin so remote-tracking refs exist.
    # "harness": main checkout INSIDE an allowlisted root, to prove a main checkout is never removable.
    origin = mk("home", "origin.git")
    g(origin, "init", "-q", "--bare", "-b", "master")
    game = mk("home", "game", file="tracked")
    harness = mk("tmp", "mr-harness-main", file="tracked")
    for repo, br in ((game, "master"), (harness, "main")):
        g(repo, "init", "-q", "-b", br)
        with open(os.path.join(repo, ".gitignore"), "w") as fh:
            fh.write("ignored/\n")
        g(repo, "add", "-A")
        g(repo, "commit", "-q", "-m", "init")
    g(game, "remote", "add", "origin", origin)
    g(game, "push", "-q", "-u", "origin", "master")
    cfg.repos = [(harness, "main"), (game, "master")]

    def wt(path, *args):
        os.makedirs(os.path.dirname(path), exist_ok=True)
        g(game, "worktree", "add", "-q", *args[:-1], path, args[-1])
        return path

    def commit(path, name):
        with open(os.path.join(path, name), "w") as fh:
            fh.write(name)
        g(path, "add", "-A")
        g(path, "commit", "-q", "-m", name)

    def registered(path):
        return any(w["path"] == path for w in worktrees(cfg))

    def go(*argv):
        buf = io.StringIO()
        with contextlib.redirect_stdout(buf):
            rc = run(list(argv), cfg)
        return rc, buf.getvalue()

    OUTSIDE, SYMLINK, REPO, MAIN = ("outside the allowlisted roots", "passes through a symlink",
                                    "is or contains a repo checkout", "inside the main checkout")

    def refused(name, why, path, survivor=None):
        rc, out = go("--apply", path)
        check("refuse: " + name, rc == 1 and "REFUSED" in out and why in out and "REMOVED" not in out
              and os.path.lexists(survivor or os.path.realpath(path)))

    try:
        # ---- rule 1: the allowlist and its refusals ----
        junk = os.path.dirname(mk("tmp", "mr-a", "junk", "deep", file="f"))
        victim = mk("home", "victim", file="precious")
        pad = mk("tmp", "claude-%d" % uid, "proj", "sess", "scratchpad")
        refused("/", "is or contains $HOME", "/")
        refused("$HOME", "is or contains $HOME", cfg.home)
        refused("a directory under $HOME", OUTSIDE, victim)
        refused("the tmp root itself", REPO, cfg.tmp)
        refused("a repo checkout under $HOME", REPO, game)
        refused("a path inside a repo checkout", MAIN, os.path.join(game, "tracked"))
        refused("a main checkout inside an allowlisted root", REPO, harness)
        refused("a path inside that main checkout", MAIN, os.path.join(harness, "tracked"))
        refused("the claude-<uid> root", OUTSIDE, os.path.join(cfg.tmp, "claude-%d" % uid))
        refused("the scratchpad directory itself", OUTSIDE, pad)
        refused("another uid's scratchpad", OUTSIDE,
                mk("tmp", "claude-%d" % (uid + 1), "p", "s", "scratchpad", "x"))
        refused("claude-<uid> outside a scratchpad", OUTSIDE, mk("tmp", "claude-%d" % uid, "proj", "other"))
        refused("an unlisted tmp directory", OUTSIDE, mk("tmp", "other", "x"))
        refused("an mr-* dir beside the tmp root", OUTSIDE, mk("tmq", "mr-a", "x"))
        refused("a sandbox dir that is no worktree", "only as a registered worktree", mk("tmp", "sand.Ab12cd", "plain"))
        refused(".. escape to $HOME", OUTSIDE,
                os.path.join(cfg.tmp, "mr-a", "..", "..", "home", "victim"), victim)
        os.symlink(victim, os.path.join(cfg.tmp, "mr-a", "link"))
        refused("a symlink out of the root", SYMLINK, os.path.join(cfg.tmp, "mr-a", "link"), victim)
        refused("a path through that symlink", SYMLINK,
                os.path.join(cfg.tmp, "mr-a", "link", "precious"), victim)
        mk("tmp", "mr-real", "x")
        os.symlink(os.path.join(cfg.tmp, "mr-real"), os.path.join(cfg.tmp, "mr-rootlink"))
        refused("a root that is a symlink", SYMLINK, os.path.join(cfg.tmp, "mr-rootlink"),
                os.path.join(cfg.tmp, "mr-real", "x"))
        refused("a path under a symlinked root", SYMLINK, os.path.join(cfg.tmp, "mr-rootlink", "x"),
                os.path.join(cfg.tmp, "mr-real", "x"))
        os.symlink(victim, os.path.join(cfg.tmp, "tmp.homelink"))
        refused("a mktemp-named symlink to $HOME", SYMLINK, os.path.join(cfg.tmp, "tmp.homelink"), victim)
        for bad in (".native-supervisor-disabled", ".harness-runner.x.lock", "pending-events"):
            refused("forbidden name " + bad, "path names " + bad.split(".x")[0], mk("tmp", "mr-a", bad, "e1"))
        check("refusals logged nothing", not os.path.exists(cfg.log))

        # ---- rule 4: dry run is the default ----
        rc, out = go(junk)
        check("dry run removes nothing", rc == 0 and "WOULD-REMOVE tree" in out and os.path.isdir(junk)
              and not os.path.exists(cfg.log))
        check("dry run prints a size", re.search(r"WOULD-REMOVE tree \d+(\.\d)?[BKMG] ", out) is not None)

        # ---- rule 2: deletion follows no symlink and stays on one filesystem ----
        os.symlink(victim, os.path.join(junk, "dirlink"))
        os.symlink(os.path.join(victim, "precious"), os.path.join(junk, "deep", "filelink"))
        ro = mk("tmp", "mr-a", "junk", "readonly", file="f")
        os.chmod(ro, 0o555)
        rc, out = go("--apply", junk)
        check("tree removed", rc == 0 and "REMOVED tree" in out and not os.path.lexists(junk))
        check("symlink targets untouched", os.path.isfile(os.path.join(victim, "precious")))
        check("deletion logged", open(cfg.log).read().count(" REMOVED tree ") == 1)
        xdev = mk("tmp", "mr-a", "xdev", "sub", file="f")
        left = rm_tree(os.path.dirname(xdev), dev=-1)
        check("another filesystem is not entered", left and os.path.isfile(os.path.join(xdev, "f")))
        rc, out = go("--apply", os.path.join(base, "tmp", "mr-a", "nope"))
        check("absent target is not an error", rc == 0 and "ABSENT" in out)
        onefile = os.path.join(mk("tmp", "claude-%d" % uid, "proj", "sess", "scratchpad", file="note"), "note")
        rc, out = go("--apply", onefile)
        check("single file under a scratchpad", rc == 0 and not os.path.exists(onefile) and os.path.isdir(pad))
        whole = mk("tmp", "tmp.Xy12ab", "a", file="f")
        rc, out = go("--apply", os.path.dirname(whole))
        check("whole mktemp dir", rc == 0 and not os.path.exists(os.path.dirname(whole)))

        # ---- rule 3: worktrees ----
        wts_root = os.path.join(cfg.tmp, "mr-wts")
        clean = wt(os.path.join(wts_root, "clean"), "--detach", "origin/master")
        mk("tmp", "mr-wts", "clean", "ignored", file="build-output")
        refused("a directory containing a registered worktree", "contains registered worktree",
                wts_root, clean)
        refused("a path inside a registered worktree", "inside registered worktree", os.path.join(clean, "ignored"))
        proc = subprocess.Popen(["sleep", "60"], cwd=clean)
        try:
            rc, out = go("--apply", clean)
            check("worktree with a live cwd is kept", rc == 1 and "cwd inside" in out and registered(clean))
        finally:
            proc.kill()
            proc.wait()
        busy = mk("tmp", "mr-busy", file="f")
        proc = subprocess.Popen(["sleep", "60"], cwd=busy)
        try:
            rc, out = go("--apply", busy)
            check("tree with a live cwd is kept", rc == 1 and "cwd inside" in out and os.path.isdir(busy))
        finally:
            proc.kill()
            proc.wait()
        g(game, "worktree", "lock", clean)
        rc, out = go(clean)
        check("locked worktree is kept", rc == 1 and "SKIP" in out and "locked" in out)
        g(game, "worktree", "unlock", clean)
        rc, out = go(clean)
        check("worktree dry run", rc == 0 and "WOULD-REMOVE worktree" in out and registered(clean))
        rc, out = go("--apply", clean)
        check("clean worktree on origin's default branch is removed (ignored files and all)",
              rc == 0 and "REMOVED worktree" in out and not os.path.exists(clean) and not registered(clean))
        check("main checkout survives a worktree removal", os.path.isfile(os.path.join(game, "tracked")))

        dirty = wt(os.path.join(wts_root, "dirty"), "--detach", "origin/master")
        with open(os.path.join(dirty, "tracked"), "a") as fh:
            fh.write("edit")
        rc, out = go("--apply", dirty)
        check("modified worktree is kept", rc == 1 and "uncommitted" in out and registered(dirty))
        untracked = wt(os.path.join(wts_root, "untracked"), "--detach", "origin/master")
        mk("tmp", "mr-wts", "untracked", file="new-file")
        rc, out = go("--apply", untracked)
        check("worktree with an untracked file is kept",
              rc == 1 and "uncommitted" in out and os.path.isfile(os.path.join(untracked, "new-file")))

        unmerged = wt(os.path.join(wts_root, "unmerged"), "-b", "slice/unmerged", "origin/master")
        commit(unmerged, "work")
        rc, out = go("--apply", unmerged)
        check("unmerged branch worktree is kept", rc == 1 and "no merged PR" in out and registered(unmerged))
        detached = wt(os.path.join(wts_root, "detached"), "--detach", "origin/master")
        commit(detached, "orphan-work")
        merged_branches.add("slice/unmerged")  # a merged PR for another branch grants nothing here
        rc, out = go("--apply", detached)
        check("detached unpushed HEAD is kept", rc == 1 and registered(detached))
        rc, out = go("--apply", unmerged)
        check("squash-merged branch worktree is removed", rc == 0 and not registered(unmerged))
        pushed = wt(os.path.join(wts_root, "pushed"), "-b", "slice/pushed", "origin/master")
        commit(pushed, "pushed-work")
        g(pushed, "push", "-q", "-u", "origin", "slice/pushed")
        rc, out = go("--apply", pushed)
        check("worktree whose HEAD is on a remote-tracking branch is removed",
              rc == 0 and not registered(pushed))
        local = wt(os.path.join(wts_root, "local-default"), "-b", "slice/local", "master")
        rc, out = go("--apply", local)
        check("worktree at the default branch is removed", rc == 0 and not registered(local))
        sand = wt(os.path.join(cfg.tmp, "bt9-rt.Zx81Qp", "wt"), "--detach", "origin/master")
        rc, out = go("--apply", sand)
        check("sandbox worktree removed, emptied sandbox dir with it",
              rc == 0 and not registered(sand) and not os.path.exists(os.path.dirname(sand)))
        sand2 = wt(os.path.join(cfg.tmp, "bt9-rt.Kk42Lm", "wt"), "--detach", "origin/master")
        mk("tmp", "bt9-rt.Kk42Lm", file="run.log")
        rc, out = go("--apply", sand2)
        check("non-empty sandbox dir stays", rc == 0 and not registered(sand2)
              and os.path.isfile(os.path.join(os.path.dirname(sand2), "run.log")))
        check("pr_covers: exact head", pr_covers([{"headRefOid": "a"}], "a", lambda a, b: False))
        check("pr_covers: head descends from HEAD", pr_covers([{"headRefOid": "b"}], "a", lambda a, b: True))
        check("pr_covers: unrelated head", not pr_covers([{"headRefOid": "b"}], "a", lambda a, b: False))
        check("pr_covers: no merged PR", not pr_covers([], "a", lambda a, b: True))

        # ---- rule 5: the age floor applies to the sweep, not to a named path ----
        fresh = mk("tmp", "tmp.fresh1", file="f")
        old = mk("tmp", "tmp.old001", "sub", file="f")
        old = os.path.dirname(old)
        age(old)
        oldpad = mk("tmp", "claude-%d" % uid, "proj", "sess", "scratchpad", "oldrun", file="f")
        age(oldpad)
        newpad = mk("tmp", "claude-%d" % uid, "proj", "sess", "scratchpad", "newrun", file="f")
        oldwt = wt(os.path.join(cfg.tmp, "bt9-rt.Old111", "wt"), "--detach", "origin/master")
        age(oldwt)
        rc, out = go("--stale")
        check("sweep dry run lists old candidates", "WOULD-REMOVE tree" in out and old in out
              and oldpad in out and ("WOULD-REMOVE worktree" in out and oldwt in out)
              and os.path.isdir(old))
        check("sweep skips fresh ones",
              re.search(r"SKIP %s — modified" % re.escape(fresh), out) is not None
              and re.search(r"SKIP %s — modified" % re.escape(newpad), out) is not None)
        check("sweep never proposes an unlisted directory, a repo or $HOME",
              not re.search(r"WOULD-REMOVE \S+ \S+ (%s|%s|%s|%s)(/|$)" % tuple(
                  re.escape(p) for p in (os.path.join(cfg.tmp, "other"), harness, game, cfg.home)),
                  out, re.M))
        rc, out = go("--stale", "--apply")
        check("sweep applies to old candidates only",
              not os.path.exists(old) and not os.path.exists(oldpad) and not registered(oldwt)
              and os.path.isdir(fresh) and os.path.isdir(newpad) and registered(dirty)
              and registered(detached) and os.path.isdir(harness) and os.path.isfile(os.path.join(victim, "precious")))
        rc, out = go("--apply", fresh)
        check("a named fresh path is removed", rc == 0 and not os.path.exists(fresh))
        logged = open(cfg.log).read()
        check("every deletion is logged", logged.count(" REMOVED ") >= 12 and old in logged and sand in logged)
        check("usage error on no target", go()[0] == 2 and go("--bogus")[0] == 2
              and "mr-clean-scratch --apply PATH" in go()[1])

        # ---- rule 6 ----
        check("polyglot guard on line 2", open(os.path.abspath(__file__)).read().splitlines()[1] == GUARD)
    finally:
        for w in worktrees(cfg):
            if not w["main"]:
                git(w["repo"], "worktree", "remove", "--force", w["path"])
        rm_tree(base)
    check("selftest leaves nothing behind", not os.path.exists(base))
    if fails:
        return 1
    print("CLEAN-SCRATCH-SELFTEST-OK %d" % n[0])
    return 0


def main(argv):
    if "--selftest" in argv:
        return selftest()
    return run(argv, Cfg())


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
