    checkout. NEVER an env-var override -- see the __doc__ anti-patterns list and
    `mr-selfcheck:6-8`."""
    here = os.path.dirname(os.path.abspath(__file__))
    return os.path.normpath(
        os.path.join(here, "..", "..", "specs", "monster-realm-v2", "M-postgate-roster-wave-3.spec.md")
    )


def parse_spec_anchor_tokens(text):
    """Extract the `rw3-scope-rules` token set from an HTML comment anchor block of the
    shape:

        <!-- rw3-scope-rules
        permit: <token>
        ...
        forbid: <token>
        ...
        -->

    Returns {"permit": frozenset(tokens), "forbid": frozenset(tokens)}.
    Raises ValueError if no such comment block is found."""
    m = re.search(r"<!--\s*rw3-scope-rules(.*?)-->", text, re.S)
    if not m:
        raise ValueError("no `<!-- rw3-scope-rules ... -->` anchor block found")
    body = m.group(1)
    permit = frozenset(re.findall(r"^\s*permit:\s*(\S+)\s*$", body, re.M))
    forbid = frozenset(re.findall(r"^\s*forbid:\s*(\S+)\s*$", body, re.M))
    if not permit and not forbid:
        raise ValueError("`rw3-scope-rules` anchor block found but carries no permit:/forbid: lines")
    return {"permit": permit, "forbid": forbid}


