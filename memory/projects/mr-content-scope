def classify(diff_text):
    """Classify a unified diff (as produced by `git diff` / `git show`, one or more
    concatenated `diff --git a/<path> b/<path>` file blocks, each with `---`/`+++`
    headers and one or more `@@ -a,b +c,d @@` hunks) against the amended RW3-08
    allow-list.

    Returns (verdict, reasons):
      verdict: the literal string "PERMIT" or "BITE".
      reasons: a list of (rule_id, path, detail) tuples, rule_id in RULES, path the
        repo-relative path (the `b/<path>` form, or `a/<path>` for a pure deletion)
        this reason concerns, detail a short human-readable string. Populated with
        EVERY P-* match and EVERY V-* match made during this run -- not only
        violations. verdict is "BITE" iff reasons contains at least one entry whose
        rule_id is in VIOLATION_RULES.

    FULL CONTRACT (see the module __doc__ for the complete rationale and the named
    anti-patterns this contract exists to close off):

    0. PATH RESOLUTION. Each file block's OLD and NEW path is resolved from its
       `---`/`+++`, `rename`/`copy`, or `diff --git` headers and normalised
       LEXICALLY exactly once (see the module __doc__ "PATH RESOLUTION AND
       NORMALISATION"). A non-empty input with no file block at all, a block with
       no resolvable path, and a path escaping the repo root each BITE
       (`V-unpermitted-src`) -- this function never skips a file it cannot read.

    1. FILE CLASSIFICATION (decided per `diff --git a/<old> b/<new>` block, before
       any hunk/line analysis of that file):
         - EITHER resolved path in BANNED_PATHS                -> BITE, `V-banned-path`,
           regardless of the hunks' content (so a rename or deletion of a banned
           path bites too). No line analysis for this file at all.
         - not path.endswith(".rs")                             -> NON-RUST, PERMIT,
           no reasons entry needed for this file.
         - `--- /dev/null` (a brand-new file) and (the path is under a `tests/`
           directory component, OR its basename matches `*_test.rs` / `*_tests.rs`)
                                                                  -> NEW-TEST, PERMIT
           wholesale, no per-line analysis, no reasons entry needed.
         - `--- /dev/null` and not NEW-TEST                      -> NEW-OTHER-RS, BITE,
           `V-new-non-test-rs`, once per such file.
         - pre-existing, under a `tests/` directory component     -> EXISTING-TEST,
           apply the LINE RULES below.
         - pre-existing, under `src/`                             -> EXISTING-SRC,
           apply the LINE RULES below.

    2. LINE RULES (per replace-region: a hunk's contiguous run of `-` lines
       immediately followed by a contiguous run of `+` lines; a hunk may contain
       several such regions separated by context `  ` lines):
       See the module __doc__ "LINE RULES" section for the full, exact algorithm
       (comment/blank handling, the multi-line-literal join, the greedy
       maximum-similarity pairing with a 0.55 acceptance threshold, the P-* rule
       order, the V-* fallback order, and the STRUCTURAL WRAP CHECK that stops a
       brace-unbalanced pure addition from wrapping a pre-existing assertion in an
       EXISTING-TEST file). This docstring does not repeat it
       verbatim to avoid the two copies drifting apart; treat the module __doc__ as
       the normative text for this function's line-level behaviour.

    3. `V-test-count` is evaluated once per EXISTING-TEST file across the WHOLE
       diff_text (every hunk touching that file, summed for that file ONLY --
       never combined with any other file's count, and NEW-TEST files are excluded
       entirely). See the module __doc__ "V-test-count" paragraph.

    4. `V-added-weakener` is evaluated independently of every other rule above, on
       every added line in every Rust-file hunk (including inside an
       otherwise-wholesale-PERMIT NEW-TEST file, and inside an otherwise pure and
       PERMITted addition to an EXISTING-TEST file): whitespace-stripped equality
       with `#[ignore]`, or a regex match against `^#\\[cfg\\(feature\\s*=\\s*"`.

    Implementation status: this function is fully implemented (GREEN phase,
    rb-1 T3) against the contract above -- it no longer raises
    NotImplementedError. Every fixture in PERMIT_FIXTURES / BITE_FIXTURES /
    the CLI fixtures calls this function (directly or via the CLI subprocess)
    and is expected to PASS against this implementation; see `selftest()` for
    the battery that proves it.
    """
    reasons = []
    parsed_files = _parse_diff(diff_text)

    # --- (0) FAIL CLOSED ON AN UNPARSEABLE INPUT (gap-07) --------------------
    # A non-empty input that yields no `diff --git` file block is not a diff
    # this tool can see into -- and an allow-list that cannot see a change
    # cannot certify it. An EMPTY input is a legitimate no-op diff (there is
    # nothing to smuggle through it) and stays PERMIT; `permit-08` pins that.
    # `V-unpermitted-src` is the residual "not positively permitted" bucket
    # (RULES is frozen against the spec anchor, so this fires no new id).
    if diff_text.strip() and not parsed_files:
        reasons.append((
            "V-unpermitted-src", "<unparsed-input>",
            "input is non-empty but carries no `diff --git a/<old> b/<new>` file block, so this "
            "tool cannot see which paths it changes -- failing CLOSED rather than PERMITting a "
            "diff it never read"))

    for parsed in parsed_files:
        path = parsed["path"]
        old_path, new_path = parsed["old"], parsed["new"]

        # --- (1) FILE CLASSIFICATION, decided before any line analysis -------
        # Path-only decisions first, and over BOTH sides of the file block.
        escaped = [p for p in (old_path, new_path) if p and _escapes_root(p)]
        if escaped:
            reasons.append((
                "V-unpermitted-src", escaped[0],
                "path climbs out of the repo root after lexical normalisation -- unclassifiable "
                "from a diff alone, so it fails CLOSED"))
            continue
        # BANNED is checked against the OLD path as well as the new one: a
        # `rename from <banned> / rename to <anything>` block is itself a
        # change to a banned path (gap-04), and so is a deletion of one.
        banned_hits = [p for p in dict.fromkeys((old_path, new_path)) if p in BANNED_PATHS]
        if banned_hits:
            for hit in banned_hits:
                reasons.append((
                    "V-banned-path", hit,
                    "RW3-08 forbids ANY change to this path (an `Affinity` / `AbilityEffect` "
                    "declaration site, or the type chart) -- including renaming or deleting it"))
            continue
        if not path:
            # A file block whose path resolves from NEITHER `---`/`+++`, nor a
            # rename/copy header, nor the `diff --git` line. Skipping it is how
            # gap-05 hid a banned-path edit; fail closed instead.
            reasons.append((
                "V-unpermitted-src", "<unresolved-path>",
                "a `diff --git` file block whose path could not be resolved from any header -- "
                "failing CLOSED rather than skipping the file"))
            continue

        file_class = _file_class(path, parsed["new_file"])
        if file_class == "NON-RUST":
            continue  # governed by RW3-01..07 / RW3-09, not by RW3-08

        hunks = [_annotate_string_state(h) for h in parsed["hunks"]]

        # --- (4) V-added-weakener, independent of every other rule -----------
        # Every added line of every Rust file, INCLUDING inside a file this
        # criterion otherwise permits wholesale: an `#[ignore]` smuggled into a
        # slice's own new test file still silences a gate.
        for hunk in hunks:
            for tag, text, _state in hunk:
                if tag == "+" and _is_added_weakener(text):
                    reasons.append((
                        "V-added-weakener", path,
                        "added line carries a test-disabling attribute: %s" % _short(text)))

        if file_class == "NEW-OTHER-RS":
            reasons.append((
                "V-new-non-test-rs", path,
                "a brand-new non-test `.rs` file is not one of RW3-08's three exceptions"))
            continue
        if file_class == "NEW-TEST":
            continue  # exception (b): the slice's own new test files

        # --- (3) V-test-count, per PRE-EXISTING test file, whole-diff --------
        # Never summed across files: that is exactly how a brand-new test file
        # full of decoy `#[test]`s would launder a deletion somewhere else.
        if file_class == "EXISTING-TEST":
            removed_tests = added_tests = 0
            for hunk in hunks:
                for tag, text, _state in hunk:
                    if text.strip() != _TEST_ATTR:
                        continue
                    if tag == "-":
                        removed_tests += 1
                    elif tag == "+":
                        added_tests += 1
            if added_tests < removed_tests:
                reasons.append((
                    "V-test-count", path,
                    "this pre-existing test file loses %d `#[test]` function(s) (removed %d, "
                    "added %d) -- counted for THIS FILE alone"
                    % (removed_tests - added_tests, removed_tests, added_tests)))

        # --- (2) LINE RULES ---------------------------------------------------
        for hunk in hunks:
            for removed, added in _replace_regions(hunk):
                reasons.extend(_classify_region(path, file_class, removed, added))

    verdict = "BITE" if any(rule in VIOLATION_RULES for (rule, _p, _d) in reasons) else "PERMIT"
    return verdict, reasons


