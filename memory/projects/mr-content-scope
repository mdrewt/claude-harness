    )


def parse_spec_anchor_tokens(text):
    """Extract the `rw3-scope-rules` token set from an HTML comment anchor block of the
    shape:

        <!-- rw3-scope-rules
        permit: <token>
        ...
        forbid: <token>
        ...
        -->

    Returns {"permit": frozenset(tokens), "forbid": frozenset(tokens)}.
    Raises ValueError if no such comment block is found."""
    m = re.search(r"<!--\s*rw3-scope-rules(.*?)-->", text, re.S)
    if not m:
        raise ValueError("no `<!-- rw3-scope-rules ... -->` anchor block found")
    body = m.group(1)
    permit = frozenset(re.findall(r"^\s*permit:\s*(\S+)\s*$", body, re.M))
    forbid = frozenset(re.findall(r"^\s*forbid:\s*(\S+)\s*$", body, re.M))
    if not permit and not forbid:
        raise ValueError("`rw3-scope-rules` anchor block found but carries no permit:/forbid: lines")
    return {"permit": permit, "forbid": forbid}


def check_link(spec_path):
    """Returns (ok: bool, detail: str). ok is True iff `spec_path` is readable, contains
    the `rw3-scope-rules` anchor, every token in it is a known key of
    ANCHOR_TOKEN_TO_RULE, and the union of its permit:/forbid: tokens, mapped through
    ANCHOR_TOKEN_TO_RULE, equals RULES exactly (no rule un-anchored, no anchored token
    without a corresponding rule). This is a DELETION ALARM (D1), not independent proof
    of correctness -- see the __doc__ section "THE SSOT LINK"."""
    try:
        with open(spec_path, "r", encoding="utf-8") as f:
            text = f.read()
    except OSError as exc:
        return False, "could not read spec at %s: %s" % (spec_path, exc)
    try:
        tokens = parse_spec_anchor_tokens(text)
    except ValueError as exc:
        return False, str(exc)
    all_tokens = tokens["permit"] | tokens["forbid"]
    unknown = all_tokens - frozenset(ANCHOR_TOKEN_TO_RULE)
    if unknown:
        return False, "anchor token(s) with no entry in ANCHOR_TOKEN_TO_RULE: %s" % sorted(unknown)
    derived = frozenset(ANCHOR_TOKEN_TO_RULE[t] for t in all_tokens)
    if derived != RULES:
        missing = sorted(RULES - derived)
        extra = sorted(derived - RULES)
        return False, "RULES mismatch against the spec anchor: missing=%s extra=%s" % (missing, extra)
    return True, "ok"


