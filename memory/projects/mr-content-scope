# ===========================================================================
# CLI
# ===========================================================================


def _build_arg_parser():
    ap = argparse.ArgumentParser(
        prog="mr-content-scope",
        description="ALLOW-LIST classifier for a content slice's Rust-source diff against RW3-08.",
    )
    ap.add_argument("--diff", metavar="FILE", help="read the unified diff from FILE instead of stdin")
    ap.add_argument(
        "--spec",
        metavar="PATH",
        default=None,
        help="path to the spec carrying the `rw3-scope-rules` anchor "
        "(default: self-located, NEVER an env var)",
    )
    ap.add_argument("--selftest", action="store_true", help="run the fixture battery and exit")
    return ap


def main(argv):
    args = _build_arg_parser().parse_args(argv)

    if args.selftest:
        return selftest()

    spec_path = args.spec if args.spec is not None else default_spec_path()
    link_ok, link_detail = check_link(spec_path)
    if not link_ok:
        sys.stderr.write(
            "mr-content-scope: WARNING RULES/spec-anchor link check failed (%s): %s\n"
            % (spec_path, link_detail)
        )

    if args.diff:
        try:
            with open(args.diff, "r", encoding="utf-8") as f:
                diff_text = f.read()
        except OSError as exc:
            sys.stderr.write("mr-content-scope: ERROR could not read --diff %s: %s\n" % (args.diff, exc))
            return 2
    else:
        diff_text = sys.stdin.read()

    try:
        verdict, reasons = classify(diff_text)
    except NotImplementedError as exc:
        sys.stderr.write("mr-content-scope: ERROR %s\n" % exc)
        return 2

    for rule_id, path, detail in reasons:
        print("%s %s: %s" % (rule_id, path, detail))
    print(verdict)
    return 0 if verdict == "PERMIT" else 1


# ===========================================================================
# --selftest -- the gating fixture battery. Every fixture evaluation is
# wrapped so a stub NotImplementedError (or any other exception) is caught
# and reported as a per-fixture FAIL, never a hard crash of the battery
# itself; the printed counts are incremented ONLY inside a passing
# assertion's branch (never derived from len(FIXTURES)); the OK marker is
# printed iff there were zero failures, all floors are met, and every RULES
# id was exercised by at least one fixture that actually ran and passed.
# ===========================================================================


def selftest():
    counts = {"permit": 0, "bite": 0, "link": 0, "cli": 0}
    failures = []
    covered = set()

    def fail(name, detail):
        failures.append((name, detail))
        print("CONTENT-SCOPE-SELFTEST-FAIL %s %s" % (name, detail))

    # --- PERMIT fixtures ---------------------------------------------------
    for name, diff_text in PERMIT_FIXTURES:
        try:
            verdict, reasons = classify(diff_text)
        except Exception as exc:  # noqa: BLE001 -- a stub/any bug must FAIL this fixture, never crash the battery
            fail(name, "classify() raised %s: %s" % (type(exc).__name__, exc))
            continue
        if verdict != "PERMIT":
            fail(name, "expected verdict PERMIT, got %r; reasons=%r" % (verdict, reasons))
            continue
        fired_permit_rules = {r for (r, _p, _d) in reasons if r in PERMIT_RULES}
        fired_violation_rules = {r for (r, _p, _d) in reasons if r in VIOLATION_RULES}
        if fired_violation_rules:
            fail(
                name,
                "verdict PERMIT but reasons carry violation rule id(s) %s -- contradictory"
                % sorted(fired_violation_rules),
            )
            continue
        counts["permit"] += 1
        covered |= fired_permit_rules

    # --- BITE fixtures -------------------------------------------------------
    for name, diff_text, expected_rule_id in BITE_FIXTURES:
        try:
            verdict, reasons = classify(diff_text)
        except Exception as exc:  # noqa: BLE001
            fail(name, "classify() raised %s: %s" % (type(exc).__name__, exc))
            continue
        if verdict != "BITE":
            fail(name, "expected verdict BITE, got %r; reasons=%r" % (verdict, reasons))
            continue
        fired_violation_rules = {r for (r, _p, _d) in reasons if r in VIOLATION_RULES}
        if expected_rule_id not in fired_violation_rules:
            fail(
                name,
                "expected rule %r to fire, but fired violation rules were %s (reasons=%r)"
                % (expected_rule_id, sorted(fired_violation_rules), reasons),
            )
            continue
        counts["bite"] += 1
        covered.add(expected_rule_id)
        covered |= fired_violation_rules

    # --- LINK fixtures -------------------------------------------------------
    # (a) the LIVE spec at the self-located default path must agree with RULES.
    # NOTE: as of tester authorship the `rw3-scope-rules` anchor does not exist
    # in the live spec yet (the specialist adds it in the GREEN phase amending
    # RW3-08) -- this fixture LEGITIMATELY fails until then. That is an honest
    # RED, not a fixture bug: see the module __doc__ "THE SSOT LINK" section.
    live_ok, live_detail = check_link(default_spec_path())
    if live_ok:
        counts["link"] += 1
    else:
        fail("link-a-live-spec-agrees-with-rules", live_detail)

    # (b) a synthetic spec carrying the FULL correct anchor MINUS ONE TOKEN must
    # be rejected. This exercises check_link()'s own detection logic
    # independently of whether the live spec has been amended yet -- it is
    # real, already-written code (not a stub) and is expected to PASS today.
    with tempfile.TemporaryDirectory(prefix="mr-content-scope-selftest-") as tmp:
        broken_anchor = EXPECTED_ANCHOR_BLOCK.replace("permit: inert-line\n", "", 1)
        assert broken_anchor != EXPECTED_ANCHOR_BLOCK, "the token-deletion fixture must actually delete a line"
        broken_spec_path = os.path.join(tmp, "broken-spec.md")
        with open(broken_spec_path, "w", encoding="utf-8") as f:
            f.write("# fixture spec\n\n- **RW3-08** ...\n\n" + broken_anchor + "\n")
        broken_ok, broken_detail = check_link(broken_spec_path)
        if broken_ok:
            fail(
                "link-b-one-token-deleted-must-fail",
                "check_link() returned ok=True against an anchor missing the `inert-line` token "
                "-- the deletion alarm has no teeth",
            )
        else:
            counts["link"] += 1

    # --- CLI fixtures ---------------------------------------------------------
    # A battery that only calls classify()/check_link() in-process leaves a
    # broken CLI (bad argv handling, a swallowed exception, a wrong exit code)
    # green. Re-spawn `sys.executable __file__` for real.
    this_file = os.path.abspath(__file__)

    def run_cli(stdin_text):
        proc = subprocess.run(
            [sys.executable, this_file],
            input=stdin_text,
            capture_output=True,
            text=True,
            timeout=30,
        )
        return proc.returncode, proc.stdout, proc.stderr

    try:
        rc, out, err = run_cli(PERMIT_FIXTURES[0][1])
    except Exception as exc:  # noqa: BLE001
        fail("cli-permit-exit-0", "subprocess raised %s: %s" % (type(exc).__name__, exc))
    else:
        if rc == 0:
            counts["cli"] += 1
        else:
            fail("cli-permit-exit-0", "expected exit 0 for a PERMIT diff on stdin, got %r; stderr=%r" % (rc, err[-300:]))

    try:
        rc, out, err = run_cli(BITE_FIXTURES[0][1])
    except Exception as exc:  # noqa: BLE001
        fail("cli-bite-exit-1", "subprocess raised %s: %s" % (type(exc).__name__, exc))
    else:
        if rc == 1:
            counts["cli"] += 1
        else:
            fail("cli-bite-exit-1", "expected exit 1 for a BITE diff on stdin, got %r; stderr=%r" % (rc, err[-300:]))

    # --- floors ----------------------------------------------------------------
    if counts["permit"] < 7:
        fail("floor-permit", "only %d PERMIT fixtures actually passed, floor is 7" % counts["permit"])
    if counts["bite"] < 12:
        fail("floor-bite", "only %d BITE fixtures actually passed, floor is 12" % counts["bite"])
    if counts["link"] != 2:
        fail("floor-link", "only %d LINK fixtures actually passed, must be exactly 2" % counts["link"])
    if counts["cli"] != 2:
        fail("floor-cli", "only %d CLI fixtures actually passed, must be exactly 2" % counts["cli"])

    # --- every RULES id must be exercised by at least one PASSING fixture ------
    uncovered = sorted(RULES - covered)
    if uncovered:
        fail(
            "rule-coverage",
            "no PASSING fixture exercised rule id(s) %s -- a rule with no fixture is a decoration"
            % uncovered,
        )

    total = counts["permit"] + counts["bite"] + counts["link"] + counts["cli"]

    if failures:
        return 1

    print(
        "CONTENT-SCOPE-SELFTEST-OK %d fixtures (permit=%d bite=%d link=%d cli=%d)"
        % (total, counts["permit"], counts["bite"], counts["link"], counts["cli"])
    )
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
