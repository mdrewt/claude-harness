def _assert_literal_git_fixture(name, text):
    """Pin a real-`git show` fixture by CONTENT HASH derived FROM git.

    The failure this closes was live in this file: these constants were once
    bare (non-r) triple-quoted strings, and the rw3c diff carries Rust string
    continuations (a trailing backslash before the newline). Python folds
    those, silently fusing diff lines and splicing a stray `-`/`+` mid-line --
    the fixture still LOOKED like a diff and still verdicted PERMIT, but for
    the wrong reason and over hunks it no longer contained. A hash pin makes
    that regression impossible to reintroduce quietly, and unlike a hand-typed
    line count it cannot be "corrected" to match the corruption.

    Comparison is over trailing-whitespace-normalised text: a diff's context
    line for a blank source line is a single space, and editors and pre-commit
    hooks strip it. The fold this guards against changes line COUNT and
    CONTENT, so normalising trailing space costs the guard nothing.

    Runs at IMPORT time -- like the ANCHOR_TOKEN_TO_RULE check above, a fold
    here is a bug in THIS file, not in a fixture, so every entry point
    (`--selftest`, direct `classify()` use, and the CLI subprocess re-spawns)
    fails before a single fixture gets to run.
    """
    want_sha, want_lines, sha, path = GIT_FIXTURE_PINS[name]
    norm = "\n".join(ln.rstrip() for ln in text.split("\n")).strip("\n")
    got = norm.split("\n")
    got_sha = hashlib.sha256(norm.encode("utf-8")).hexdigest()[:32]
    assert got_sha == want_sha, (
        "%s: content hash %s != pinned %s (%d lines, pinned %d). This fixture "
        "must stay a byte-for-byte r-string copy of `git show %s -- %s` in "
        "projects/monster-realm. A SHRUNK line count means the string lost its "
        "`r` prefix and Python folded a backslash-newline Rust line-continuation."
        % (name, got_sha, want_sha, len(got), want_lines, sha, path)
    )
    for i, line in enumerate(got):
        if line == "" or line.startswith(_DIFF_HEADER_PREFIXES):
            continue
        assert line[0] in (" ", "-", "+"), (
            "%s: line %d does not start with a diff marker (' '/'-'/'+'): %r"
            % (name, i, line)
        )


