# FOLD-CORRUPTION GUARD (rb-1 T5 Fix 1). PERMIT fixtures 1-3's own header
# comments claim to be byte-identical `git show` output. That claim is only
# true while the three constants above stay `r"""..."""`. This block makes a
# reversion to a bare `"""..."""` (which silently folds any Rust rustfmt
# `\`-continued string literal in the diff, fusing lines and splicing a
# stray `-`/`+` diff-prefix character into the middle of the survivor) fail
# LOUD instead of passing quietly:
#
#   1. `expected_line_count` pins `text.split("\n")`'s length. A fold
#      strictly DROPS this count (two-or-more physical lines become one) --
#      this is the primary, exact, mechanical guard.
#   2. `must_contain` (PERMIT_3 only, the fixture that actually contains
#      backslash-continued lines) is a handful of independently hand-typed
#      substrings, each spanning ONE known continuation boundary: the
#      literal `\` character immediately followed by the real newline that
#      starts the next diff line, `-`/`+` prefix included. A folded fixture
#      cannot contain any of these (the backslash and the newline between
#      them are gone) -- these are NOT sliced out of the fixture itself,
#      so they cannot be trivially "found" against corrupted text.
#   3. Every non-header line must start with `' '`, `'-'`, `'+'`, or be
#      empty, and none may carry a stray `-`/`+` followed by 8+ spaces past
#      its own leading position -- the shape a swallowed, deeply-indented
#      diff line's own prefix+indentation leaves behind mid-line.
#
# Runs at IMPORT time -- like the ANCHOR_TOKEN_TO_RULE check above, a fold
# here is a bug in THIS file, not a fixture, so every entry point
# (`--selftest`, direct `classify()` use, and the CLI subprocess `selftest()`
# re-spawns) fails before a single fixture gets to run.
# ===========================================================================

_STRAY_MARKER_RE = re.compile(r"[-+] {8,}")
_DIFF_HEADER_PREFIXES = ("diff --git ", "index ", "--- ", "+++ ", "@@")


