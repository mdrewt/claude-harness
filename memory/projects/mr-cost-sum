def _selftest_real_shapes():
    import tempfile
    bad = 0
    here = os.path.join(os.path.dirname(os.path.abspath(__file__)), "fixtures", "run-cost")
    transcripts = os.path.join(here, "transcripts")
    empty = tempfile.mkdtemp(prefix="mr-cost-sum-selftest-")
    try:
        for name, cost, source, log_cost, attempts, unpriced, launch, model in _REAL:
            got = run_of_log(os.path.join(here, name), transcripts)
            want = {"cost": cost, "source": source, "log_cost": log_cost, "attempts": attempts,
                    "unpriced": unpriced, "launch": launch, "model": model}
            diff = {k: (v, got.get(k)) for k, v in want.items() if got.get(k) != v}
            if diff or not got.get("session_id"):
                print("FAIL %-32s (want, got) %r session_id=%r" % (name, diff, got.get("session_id")))
                bad += 1
            # With no transcript the log stands alone.
            alone = run_of_log(os.path.join(here, name), empty)
            if alone["cost"] != log_cost or alone["source"] != ("log" if log_cost is not None else None):
                print("FAIL %-32s without a transcript: %r" % (name, alone))
                bad += 1
        # A priced attempt followed by one killed before its first result, and no transcript:
        # the cost stands as a lower bound and the open invocation is counted. Composed from
        # two of the excerpts above.
        first = open(os.path.join(here, "single-attempt.stream")).read()
        killed = open(os.path.join(here, "killed-no-result.stream")).read().split("\n", 1)[1]
        p = os.path.join(empty, "priced-then-killed")
        with open(p, "w") as f:
            f.write(first + "ATTEMPT=2 MODEL=fable EFFORT=xhigh TS=2026-11-12T02:10:00Z\n" + killed)
        got = run_of_log(p, empty)
        os.unlink(p)
        if (got["cost"], got["source"], got["attempts"], got["unpriced"]) != (28.2911, "log", 2, 1):
            print("FAIL priced-then-killed got=%r" % (got,))
            bad += 1
        missing = run_of_log("/nonexistent/mr-cost-sum/definitely-not-here", empty)
        if missing["cost"] is not None or missing["attempts"] or missing["launch"]:
            print("FAIL missing-file-run got=%r" % (missing,))
            bad += 1
    finally:
        os.rmdir(empty)
    return bad


