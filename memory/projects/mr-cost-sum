        sys.exit(emit_run(sys.argv[2]))
    if len(sys.argv) == 3 and sys.argv[1] == "--session":
        _now = transcript_cost(sys.argv[2])
        sys.stdout.write("-\n" if _now is None else "%.4f\n" % _now)
        sys.exit(0)
    if len(sys.argv) != 2:
        sys.stdout.write("-\n")
        sys.exit(0)
    sys.exit(emit(sys.argv[1]))
