_SHAPE = r"[0-9]+\.[0-9]{4}|-"


def selftest():
    import io
    import re
    import tempfile
    bad = 0
    for name, body, want in _CASES:
        fd, p = tempfile.mkstemp(prefix="mr-cost-sum-selftest-")
        try:
            with os.fdopen(fd, "w") as f:
                f.write(body)
            # Drive emit() through real stdout, not cost_of_log() — the shell-safe output shape
            # and the always-rc-0 promise ARE the contract, and re-implementing the formatting
            # here would leave both untested (a "%.2f" typo in emit would still pass).
            buf, real = io.StringIO(), sys.stdout
            try:
                sys.stdout = buf
                rc = emit(p)
            finally:
                sys.stdout = real
            got = buf.getvalue()
        finally:
            os.unlink(p)
        if rc != 0:
            print("FAIL %-32s nonzero rc=%s" % (name, rc)); bad += 1
        if not got.endswith("\n") or not re.fullmatch(_SHAPE, got[:-1]):
            print("FAIL %-32s output violates the shell-safe contract: %r" % (name, got)); bad += 1
        elif got[:-1] != want:
            print("FAIL %-32s want=%s got=%s" % (name, want, got[:-1])); bad += 1
    # missing file must be "-" and must not raise
    total, saw = cost_of_log("/nonexistent/mr-cost-sum/definitely-not-here")
    if saw:
        print("FAIL missing-file want=- got=%.4f" % total)
        bad += 1
    bad += _selftest_real_shapes()
    bad += _selftest_by_role()
    if bad:
        print("mr-cost-sum SELFTEST FAIL (%d)" % bad)
        return 1
    print("mr-cost-sum SELFTEST OK (%d cases)" % (len(_CASES) + 1 + 2 * len(_REAL) + 5 + 8))
    return 0


def _selftest_by_role():
    """--by-role over the ts-5 subagent transcripts (fixtures/run-cost/README.md) and the pass
    log of the same session. Eight cases."""
    import tempfile
    bad = 0
    here = os.path.join(os.path.dirname(os.path.abspath(__file__)), "fixtures", "run-cost")
    sid = "fa35ac05-b129-4394-a634-ef612da0c7d6"
    got = by_role(sid, os.path.join(here, "single-attempt.stream"), os.path.join(here, "by-role"))

    def case(name, ok, detail=""):
        nonlocal bad
        if not ok:
            print("FAIL by-role/%-24s %s" % (name, detail))
            bad += 1

    check = got["check"] or {}
    # The log's own figure, per model, to the cent: every subagent on that model is in the sum.
