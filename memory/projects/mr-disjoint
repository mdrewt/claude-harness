#!/bin/bash
# mr-disjoint — mechanical fan-out disjointness check (A2, judge-adjudicated 2026-07-26).
# usage: mr-disjoint "sliceA:path1,path2,..." "sliceB:path3,..." [...]
# ALWAYS rc=0; JSON verdict on stdout. NECESSARY-NOT-SUFFICIENT: the supervisor may still
# SERIALIZE on semantic grounds this check cannot see; it may NEVER override toward parallel.
# Operates on DECLARED touches — boyscout deltas live inside declared files by construction and
# are never inputs here (D6 doctrine) — plus the files each NAMED slice's run has widened into
# (mr-touches' record, gates/<slice>.widened.jsonl): name each argument by its slice id so a
# sibling is checked against the set the run really holds. `widened` in the output lists them.
# MR_WIDEN_DIR points the record read at another gates dir (selftests); MR_DISJOINT_NO_GRAPH=1
# skips the advisory coupling annotation (mr-touches needs only the verdict).
set -u
export DJ_WIDEN_DIR="${MR_WIDEN_DIR:-/home/mdrewt/projects/ai-apps/claude-harness/memory/projects/gates}"
export DJ_ARGS=$(/usr/bin/python3 -c 'import json,sys; print(json.dumps(sys.argv[1:]))' "$@")
/usr/bin/python3 <<'PY'
import json, os, fnmatch
argv=json.loads(os.environ["DJ_ARGS"])
STRUCTURAL=["Cargo.lock","package-lock.json","client/src/module_bindings/*","evals/run.mjs","*schema*","*migration*"]
# Doc set: supervisor-reconciled at merge (union/append), so overlap here never forces serial.
DOC_SET={"CHANGELOG.md","ARCHITECTURE.md","docs/DECISIONS.md"}
def widened(name):
    got=[]
    try:
        for l in open(os.path.join(os.environ["DJ_WIDEN_DIR"],name+".widened.jsonl"),errors="replace"):
            try: p=json.loads(l).get("path")
            except Exception: continue
            if p and p not in got: got.append(p)
    except OSError: pass
    return got
slices={}; grown={}
for a in argv:
    if ":" not in a: continue
    name,paths=a.split(":",1)
    declared=[p.strip() for p in paths.split(",") if p.strip()]
    extra=[p for p in widened(name) if p not in declared]
    if extra: grown[name]=extra
    slices[name]=[p for p in declared+extra if p not in DOC_SET]
out={"slices":list(slices),"pairs":[],"structural_hits":{},"verdict":"SAFE"}
if grown: out["widened"]=grown
def hits_structural(p):
    return any(fnmatch.fnmatch(p,pat) or pat.strip("*") in p for pat in STRUCTURAL)
for n,ps in slices.items():
    h=[p for p in ps if hits_structural(p)]
    if h: out["structural_hits"][n]=h
names=list(slices)
for i in range(len(names)):
    for j in range(i+1,len(names)):
        a,b=names[i],names[j]
        inter=set()
        for pa in slices[a]:
            for pb in slices[b]:
                # A directory token (trailing slash) overlaps every path under it.
                under=(pa.endswith("/") and pb.startswith(pa)) or (pb.endswith("/") and pa.startswith(pb))
                if pa==pb or under or fnmatch.fnmatch(pa,pb) or fnmatch.fnmatch(pb,pa): inter.add(pa)
        out["pairs"].append({"pair":[a,b],"overlap":sorted(inter),"disjoint":not inter})
if out["structural_hits"]: out["verdict"]="SERIAL-REQUIRED(structural)"
elif any(not p["disjoint"] for p in out["pairs"]): out["verdict"]="SERIAL-REQUIRED(overlap)"
# ADVISORY coupling annotation (judge-sanctioned trial, 2026-07-26): one-shot CLI queries (~40ms via
# resident daemon). CONTEXT ONLY — a "coupled" note is NOT a verdict (known false-positive: nh4+ux1
# were import-coupled and parallelized cleanly). Supervisor may use it to serialize, never to overrule SERIAL.
import subprocess
PROJ="home-mdrewt-projects-ai-apps-claude-harness-projects-monster-realm"
def coupling(pa_list, pb_list):
    try:
        fa=json.dumps([p for p in pa_list][:6]); fb=json.dumps([p for p in pb_list][:6])
        q=f"MATCH (a)-[r:CALLS|USAGE|IMPORTS]-(b) WHERE a.file_path IN {fa} AND b.file_path IN {fb} RETURN count(r)"
        r=subprocess.run(["codebase-memory-mcp","cli","query_graph",json.dumps({"project":PROJ,"query":q})],
                         capture_output=True,text=True,timeout=10)
        n=json.loads(r.stdout).get("rows",[[0]])[0][0]
        return int(n)
    except Exception:
        return None  # graph unavailable -> annotation absent, never blocking
for pr in ([] if os.environ.get("MR_DISJOINT_NO_GRAPH") else out["pairs"]):
    a,b=pr["pair"]
    c=coupling(slices[a],slices[b])
    if c is not None: pr["advisory_coupling_edges"]=c
out["note"]="SAFE means file-disjoint only. Shared registry/enum/namespace AXES still require PARTITION-THEN-PARALLEL per SSOT 3-state rule; semantic overlap still permits supervisor serialize-override. advisory_coupling_edges is CONTEXT (trial 2026-07-26): >0 means graph sees same-language coupling between the sets — weigh it, never auto-serialize on it, never override SERIAL with it. Content/.ron and cross-language (WASM) coupling are INVISIBLE to it."
print(json.dumps(out,indent=1))
PY
exit 0
