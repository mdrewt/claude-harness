SEEDED_HDR = "# Gates: %s"


def build_gates_text(slice_id, spec_file, criteria, scope, repo, uncaptured, seed,
                     touches=None):
    L = [SEEDED_HDR % slice_id]
    L.append("Spec: %s#%s" % (spec_file or "(none)", slice_id))
    L.append("Seed: %s" % seed)
    L.append("Seeded: %s" % utc_now())
    L.append("Repo: %s" % (repo or "project"))
    L.append("Scope: %s" % _norm(scope or "(not supplied)"))
    L.append("Criteria: %d seeded, %d shall-uncaptured" % (len(criteria), uncaptured))
    if touches:
        L.append("Touches: %s" % ", ".join(touches))
    if not spec_file:
        L.append("Note: SPEC-SECTION-NOT-FOUND — author X* gates for this slice's acceptance.")
    if uncaptured:
        L.append("Note: %d SHALL(s) in the section are in no criterion — add X* gates or explain."
                 % uncaptured)
    L.append("")
    L.append("<!-- Fill CHECK/EXPECT during the PLAN phase. A seeded gate's CHECK must invoke a")
    L.append("     real gate runner (cargo/just/npm/npx/pnpm/node/vitest/pytest or an mr-* tool),")
    L.append("     or be declared MANUAL: with a resolvable `path:line` citation as EVIDENCE.")
    L.append("     Not met? The ONLY legal exit is a DEFER line with a resolvable target:")
    L.append("       DEFER: <gate> -> <existing slice id | backlog | wontfix> — <reason>")
    L.append("     `backlog` is materialised into a real spec section by the supervisor. -->")
    for c in criteria:
        L.append("")
        L.append("- [ ] %s: %s" % (c["id"], c["title"]))
        L.append("  CHECK: ")
        L.append("  EXPECT: ")
        L.append("  EVIDENCE: pending")
    L.append("")
    return "\n".join(L)


def cmd_init(a):
    slice_id = a["slice"]
    spec_file, sec = find_section(slice_id, a.get("_specs"))
    criteria = extract_criteria(sec) if sec else []
    uncap = shall_uncaptured(sec, criteria) if sec else 0
    seed = seed_hash(criteria)
    path = gates_path(slice_id, a.get("_gates_dir"))
    existing = read_gates_file(path)

    if existing is None:
        atomic_write(path, build_gates_text(slice_id, spec_file, criteria, a.get("scope"),
                                            a.get("repo"), uncap, seed,
                                            extract_touches(sec) if sec else []))
        msg = "GATES-SEEDED %s criteria=%d seed=%s spec=%s" % (
            slice_id, len(criteria), seed, spec_file or "NONE")
        if not spec_file:
            msg += " SPEC-SECTION-NOT-FOUND"
        if uncap:
            msg += " shall-uncaptured=%d" % uncap
        if len(criteria) > 10:
            msg += (" SIZE-WARN=%d (right-size: ship the smallest coherent increment and DEFER the "
                    "rest)" % len(criteria))
        print(msg)
        return 0

    # Resume-safe: never destroy evidence, never rewrite Seed (blocker 10).
    header, gates, defers, _errs = parse_gates(existing)
    have = {g.id for g in gates}
    new = [c for c in criteria if c["id"] not in have]
    recorded = header.get("Seed", "")
    drift = bool(recorded) and recorded != seed
    if new:
        add = []
        for c in new:
            add += ["", "- [ ] %s: %s" % (c["id"], c["title"]), "  CHECK: ", "  EXPECT: ",
                    "  EVIDENCE: pending"]
        atomic_write(path, existing.rstrip("\n") + "\n" + "\n".join(add) + "\n")
    print("GATES-PRESENT %s existing=%d added=%d seed_recorded=%s seed_now=%s%s" % (
        slice_id, len(gates), len(new), recorded or "?", seed,
        " SEED-DRIFT (supervisor must run `mr-gates reseed`)" if drift else ""))
    return 0


def cmd_reseed(a):
    """Supervisor-only clearance for a LEGITIMATE spec amendment. Deliberately separate from init:
    if init rewrote Seed on drift, a run could launder a spec edit; if nothing could rewrite it,
    an honest spec fix would FLAG forever and the arming band would be unreachable."""
    slice_id = a["slice"]
    if not a.get("reason"):
        return die("reseed requires --reason")
    path = gates_path(slice_id, a.get("_gates_dir"))
    text = read_gates_file(path)
    if text is None:
        return die("no gates file for %s" % slice_id)
    spec_file, sec = find_section(slice_id, a.get("_specs"))
    criteria = extract_criteria(sec) if sec else []
    seed = seed_hash(criteria)
    header, gates, _d, _e = parse_gates(text)
    old = header.get("Seed", "?")
    lines = text.split("\n")
    for i, ln in enumerate(lines):
        if ln.startswith("Seed:"):
            lines[i] = "Seed: %s" % seed
            break
    else:
        # No Seed line at all -- which is precisely what SEED-MISSING flags. Insert it after the
        # header rather than reporting a success that changed nothing.
        at = 1 if lines and lines[0].startswith("# Gates:") else 0
        lines.insert(at, "Seed: %s" % seed)
    have = {g.id for g in gates}
    add = []
    for c in criteria:
        if c["id"] not in have:
            add += ["", "- [ ] %s: %s" % (c["id"], c["title"]), "  CHECK: ", "  EXPECT: ",
                    "  EVIDENCE: pending"]
    body = "\n".join(lines).rstrip("\n") + ("\n" + "\n".join(add) if add else "") + "\n"
    atomic_write(path, body)
    stoplog(slice_id, "RESEED %s -> %s added=%d reason=%s" % (old, seed, len(add), a["reason"]),
            a.get("_gates_dir"))
    print("GATES-RESEEDED %s %s -> %s added=%d" % (slice_id, old, seed, len(add)))
    return 0


def stoplog(slice_id, msg, gates_dir=None):
    p = os.path.join(gates_dir or GATES_DIR, "%s.stoplog" % slice_id)
    try:
        os.makedirs(os.path.dirname(p), exist_ok=True)
        with open(p, "a") as fh:
            fh.write("%s %s\n" % (utc_now(), msg))
    except OSError:
        pass


