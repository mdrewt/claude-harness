def residual_upsert(source_slice, gate_id, title, target, reason, header, path=None):
    rid = residual_id(source_slice, gate_id)
    folded = fold_residuals(residual_rows(path))
    if rid in folded:
        return None  # already emitted; append-only, do not duplicate
    touches = header.get("Touches", "") if header else ""
    row = {
        "id": rid, "schema": 1,
        "slice_id": None,                 # allocated at promote
        "title": title[:400], "owner": "supervisor",
        "touches": [t.strip() for t in touches.split(",") if t.strip()],
        "severity": "MED", "domain": header.get("Repo", "project") if header else "project",
        "disclosed_at": utc_now(), "adr": None,
        "status": "unpromoted" if target == "backlog" else
                  ("dispositioned" if target in LEGAL_DISPOSITIONS else "targeted"),
        "disposition": target if target in LEGAL_DISPOSITIONS else None,
        "source_slice": source_slice, "gate_id": gate_id,
        "target": target, "reason": reason[:400],
        "defer_count": 1, "promoted_slice": target if target not in
                          ("backlog",) + LEGAL_DISPOSITIONS else None,
    }
    residual_append(row, path)
    return rid


def next_backlog_id(spec_text):
    n = 0
    for m in re.finditer(r"^### rb-(\d+)\b", spec_text, re.M):
        n = max(n, int(m.group(1)))
    return "rb-%d" % (n + 1)


BACKLOG_HEADER = """# M-residual-backlog — the standing drain for deferred acceptance criteria

Generated. Each section below is one criterion a slice DEFERred, promoted here by
`mr-gates residuals promote` so it becomes a real, launchable work item instead of a prose bullet
nothing consumes (postmortem RF-3; mean disclosure->remediation latency was 13.1 days).

The criterion text is verbatim from the spec section it was deferred from — promotion is a
mechanical copy, not spec authoring.

## 2. Slices
"""


def cmd_residuals(a, sub):
    path = a.get("_residuals")
    rows = residual_rows(path)
    if sub == "policy":
        print(json.dumps(POLICY, indent=1, sort_keys=True))
        return 0
    if sub == "list":
        opens = open_residuals(rows)
        if a.get("unclaimed"):
            opens = [r for r in opens if not r.get("promoted_slice")]
        if a.get("json"):
            print(json.dumps({"open": opens,
                              "alarms": ["%s: %s" % (k, v) for k, v in residual_alarms(rows)]},
                             indent=1))
        else:
            for r in opens:
                print("  %-28s %-11s age=%5.1fd  %s -> %s" %
                      (r["id"], r.get("status"), r.get("age_days") or -1,
                       (r.get("title") or "")[:60], r.get("target")))
            for k, v in residual_alarms(rows):
                print("  ALARM %s: %s" % (k, v))
            if not opens:
                print("  (no open residuals)")
        return 0
    if sub == "promote":
        rid = a.get("id")
        if not rid:
            return die("promote requires --id")
        specs = a.get("_specs") or SPECS
        spec_name = a.get("spec_file") or BACKLOG_SPEC
        # Validated FIRST, ahead of every state lookup: the same rule mr-record's queue-add
        # enforces (a spec file is a BARE NAME inside the corpus). Behind the already-promoted
        # early return this check is unreachable on exactly the second call, which is the call an
        # attacker makes.
        if os.path.isabs(spec_name) or "/" in spec_name or ".." in spec_name \
                or not spec_name.endswith(".spec.md"):
            return die("--spec-file must be a bare <name>.spec.md inside the corpus, got %r"
                       % spec_name)
        folded = fold_residuals(rows)
        r = folded.get(rid)
        if not r:
            return die("no residual %r" % rid)
        if r.get("promoted_slice"):
            print("ALREADY-PROMOTED %s -> %s" % (rid, r["promoted_slice"]))
            return 0
        full = os.path.join(specs, spec_name)
        text = read_gates_file(full)
        if text is None:
            text = BACKLOG_HEADER
        new_id = next_backlog_id(text)
        touches = ", ".join(r.get("touches") or []) or "(inherit from source slice — REVIEW)"
        sect = [
            "",
            "### %s — %s (from %s %s, deferred %s)" % (
                new_id, (r.get("title") or "")[:90], r.get("source_slice"), r.get("gate_id"),
                (r.get("disclosed_at") or "")[:10]),
            "`touches: %s`" % touches,
            "`after:` — · source: %s · residual: %s" % (r.get("source_slice"), rid),
            "",
            "Deferred with reason: %s" % r.get("reason"),
            "",
            "EARS: %s" % r.get("title"),
            "Tests: proof-of-teeth — an ordinary Rust/TS test for this criterion must RED before "
            "the fix and pass after (ADR-0224; supersedes ADR-0010 — no new evals/*.eval.mjs).",
        ]
        MARKER = "<!-- PROMOTED SECTIONS APPEND BELOW THIS LINE -->"
        block = "\n".join(sect) + "\n"
        if MARKER in text:
            head, _sep, tail = text.partition(MARKER)
            body = head + MARKER + "\n" + block + tail.lstrip("\n")
        else:
            body = text.rstrip("\n") + "\n" + block
        atomic_write(full, body)
        residual_append(dict(r, status="promoted", slice_id=new_id, promoted_slice=new_id,
                             promoted_at=utc_now()), path)
        print("PROMOTED %s -> %s in %s (queue it with: mr-record queue-add --slice %s "
              "--spec-file specs/monster-realm-v2/%s --reason 'promoted residual %s')"
              % (rid, new_id, spec_name, new_id, spec_name, rid))
        return 0
    if sub == "close":
        sl = a.get("slice")
        if not sl:
            return die("close requires --slice")
        # GATE-PROVED CLOSURE. Closing on "a merge happened with the right branch name" is the
        # weakest possible predicate and would let a residual be retired by a slice that did not
        # actually deliver it — which is the failure this whole mechanism exists to end. So the
        # promoted slice's OWN ledger must be fully resolved before its residuals close.
        # `--force` is the honest escape (e.g. the slice legitimately DEFERred it onward again),
        # and it is recorded on the row rather than silently assumed.
        forced = bool(a.get("force"))
        if forced and not a.get("reason"):
            return die("--force requires --reason: forcing a residual closed without saying why "
                       "is how a sink quietly becomes a graveyard")
        if not forced:
            _pth, parsed = load(sl, a.get("_gates_dir"))
            if parsed is None:
                return die("no ledger for %s: cannot prove the criterion was delivered. Re-run "
                           "after the slice is ledgered, or pass --force with a reason." % sl)
            _h, gs, ds, _e = parsed
            _met, unmet, _def = classify(gs, ds)
            if unmet:
                return die("%s has %d unmet gate(s) (%s): its residuals are NOT proven delivered."
                           % (sl, len(unmet), ", ".join(g.id for g in unmet[:5])))
        folded = fold_residuals(rows)
        n = 0
        for rid, r in sorted(folded.items()):
            if r.get("promoted_slice") == sl and r.get("status") not in ("closed",):
                residual_append(dict(r, status="closed", closed_at=utc_now(),
                                     closed_by_pr=a.get("pr"),
                                     closed_forced=True if forced else None,
                                     closed_forced_reason=a.get("reason") if forced else None),
                                path)
                n += 1
        print("RESIDUALS-CLOSED %d for slice %s%s" % (n, sl, " (FORCED)" if forced else ""))
        return 0
    if sub == "disposition":
        rid, how = a.get("id"), a.get("as")
        if not rid or how not in LEGAL_DISPOSITIONS:
            return die("disposition requires --id and --as %s" % "|".join(LEGAL_DISPOSITIONS))
        if not a.get("reason"):
            return die("disposition requires --reason")
        folded = fold_residuals(rows)
        r = folded.get(rid)
        if not r:
            return die("no residual %r" % rid)
        if (r.get("severity") or "MED").upper() in SEVERITY_OPERATOR_ONLY:
            return die("severity %s cannot be dispositioned by the loop — open an operator "
                       "decision with mr-ask-drew first" % r.get("severity"))
        residual_append(dict(r, status="dispositioned", disposition=how,
                             disposition_reason=a["reason"], dispositioned_at=utc_now()), path)
        print("DISPOSITIONED %s as %s" % (rid, how))
        return 0
    if sub == "add":
        for k in ("slice", "gate", "title", "target", "reason"):
            if not a.get(k):
                return die("add requires --slice --gate --title --target --reason")
        rid = residual_upsert(a["slice"], a["gate"], a["title"], a["target"], a["reason"],
                              {"Repo": a.get("domain", "project")}, path)
        print("RESIDUAL-ADDED %s" % rid if rid else "RESIDUAL-EXISTS")
        return 0
    return die("unknown residuals subcommand %r" % sub)


