### fx-c — no criteria at all
Just prose, no obligations here.
"""


def _st_tmp(chk):
    import shutil
    d = tempfile.mkdtemp(prefix="mr-gates-selftest-")
    return d, lambda: shutil.rmtree(d, ignore_errors=True)


def selftest():
    import contextlib
    import io as _io
    chk = _Chk()
    root, cleanup = _st_tmp(chk)
    try:
        specs = os.path.join(root, "specs")
        gdir = os.path.join(root, "gates")
        os.makedirs(specs)
        os.makedirs(gdir)
        resid = os.path.join(root, "mr-residuals.jsonl")
        with open(os.path.join(specs, "M-fx.spec.md"), "w") as fh:
            fh.write(_FX_EARS)

        # --- A. extraction -------------------------------------------------------------------
        name, sec = find_section("fx-a", specs)
        chk.eq("A1-file", "M-fx.spec.md", name)
        chk.ok("A2-anchored", "decoy" not in (sec or ""),
               "an unanchored lookup for fx-a would swallow fx-ab")
        crit = extract_criteria(sec)
        chk.eq("A3-ears-count", 3, len(crit))
        chk.eq("A4-ids", ["E1", "E2", "E3"], [c["id"] for c in crit])
        chk.ok("A5-verbatim", crit[0]["title"].startswith("WHEN a slice PR opens"))
        chk.ok("A6-lowercase-shall-ignored",
               all("lowercase" not in c["title"] for c in crit))
        chk.eq("A7-uncaptured", 0, shall_uncaptured(sec, crit))

        _n, secb = find_section("fx-b", specs)
        critb = extract_criteria(secb)
        chk.ok("A8-bullet-shape", len(critb) >= 3)
        chk.ok("A9-native-ids", "fx-b-1" in [c["id"] for c in critb],
               "the spec's own criterion id must be reused, not renumbered")
        chk.ok("A10-generated-id", any(c["id"].startswith("B") for c in critb))

        _n, secc = find_section("fx-c", specs)
        chk.eq("A11-no-criteria", 0, len(extract_criteria(secc)))
        chk.eq("A12-missing-section", (None, None), find_section("fx-nope", specs))

        # --- B. seed hash --------------------------------------------------------------------
        s1 = seed_hash(crit)
        chk.eq("B1-stable", s1, seed_hash(extract_criteria(sec)))
        mutated = [dict(crit[0], title=crit[0]["title"].replace("one residual", "zero residual"))] \
            + crit[1:]
        chk.ok("B2-detects-reword", s1 != seed_hash(mutated),
               "rewording a criterion must move the seed")
        chk.ok("B3-detects-drop", s1 != seed_hash(crit[:-1]),
               "dropping a criterion must move the seed")

        # --- C. init / idempotence / reseed ---------------------------------------------------
        A = {"slice": "fx-a", "_specs": specs, "_gates_dir": gdir, "scope": "fixture"}
        cmd_init(A)
        gp = gates_path("fx-a", gdir)
        chk.ok("C1-created", os.path.exists(gp))
        h, g, d, e = parse_gates(read_gates_file(gp))
        chk.eq("C2-gates", 3, len(g))
        chk.eq("C3-seed-recorded", s1, h.get("Seed"))
        chk.eq("C4-parse-errors", [], e)
        chk.ok("C5-all-unmet", all(not x.met() for x in g))

        # hand-fill one gate, then re-init: evidence must survive and Seed must not be rewritten
        txt = read_gates_file(gp).replace("- [ ] E1:", "- [x] E1:", 1) \
                                 .replace("EVIDENCE: pending", "EVIDENCE: 3 passed", 1)
        atomic_write(gp, txt)
        cmd_init(A)
        h2, g2, _d, _e = parse_gates(read_gates_file(gp))
        chk.eq("C6-idempotent", 3, len(g2))
        chk.eq("C7-evidence-survives", True, g2[0].met())
        chk.eq("C8-seed-not-rewritten", s1, h2.get("Seed"))

        # --- D. unmet semantics ----------------------------------------------------------------
        checked_no_ev = "# Gates: x\nSeed: z\n\n- [x] E1: t\n  CHECK: c\n  EXPECT: e\n" \
                        "  EVIDENCE: pending\n"
        _h, gg, dd, _e = parse_gates(checked_no_ev)
        m, u, df = classify(gg, dd)
