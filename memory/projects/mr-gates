def cmd_lint(a):
    path, parsed = load(a["slice"], a.get("_gates_dir"))
    if parsed is None:
        return die("no gates file for %s" % a["slice"])
    _h, gates, defers, errs = parsed
    findings = lint_gates(gates, defers) + [("BLOCK", "-", e) for e in errs]
    if a.get("json"):
        print(json.dumps([{"severity": s, "gate": g, "message": m} for s, g, m in findings],
