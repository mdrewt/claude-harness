# Residual registry — the SINK. The DRAIN is promote/close plus the age policy above.
# ---------------------------------------------------------------------------------------------
def residual_rows(path=None):
    p = path or RESIDUALS
    rows = []
    try:
        with open(p, errors="replace") as fh:
            for ln in fh:
                ln = ln.strip()
                if not ln:
                    continue
                try:
                    rows.append(json.loads(ln))
                except ValueError:
                    continue
    except OSError:
        return []
    return rows


def residual_append(row, path=None):
    p = path or RESIDUALS
    d = os.path.dirname(p) or "."
    try:
        os.makedirs(d, exist_ok=True)
    except OSError:
        pass
    line = json.dumps(row, sort_keys=True)
    json.loads(line)  # verify parse before it reaches an append-only file
    with open(p, "a") as fh:
        fcntl.flock(fh.fileno(), fcntl.LOCK_EX)
        fh.write(line + "\n")
        fh.flush()
        os.fsync(fh.fileno())


def residual_id(source_slice, gate_id):
    return "R-%s-%s" % (source_slice, gate_id)


def fold_residuals(rows):
    """Append-only: later rows for the same id supersede earlier ones (mr-record's CORRECTION
    doctrine — never rewrite, always fold)."""
    folded = {}
    for r in rows:
        rid = r.get("id")
        if not rid:
            continue
        folded[rid] = dict(folded.get(rid, {}), **r)
    return folded


def age_days(iso, now=None):
    # calendar.timegm, NOT time.mktime: every timestamp in this pipeline is UTC, and mktime
    # interprets the struct as LOCAL time — which skews every age by the machine's offset (4h on
    # this host) and silently moves the T1/T2 alarm boundaries. Caught by fixture K1.
    import calendar
    try:
        t = calendar.timegm(time.strptime(iso, "%Y-%m-%dT%H:%M:%SZ"))
    except Exception:
        return None
    return ((now or time.time()) - t) / 86400.0


def utc_now():
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


def open_residuals(rows, now=None):
    out = []
    for rid, r in sorted(fold_residuals(rows).items()):
        if r.get("status") in ("closed", "dispositioned"):
            continue
        r = dict(r)
        r["age_days"] = age_days(r.get("disclosed_at", ""), now)
        out.append(r)
    return out


def residual_alarms(rows, now=None):
    """The anti-rot alarms mr-selfcheck surfaces. Constants come from POLICY — one definition."""
    # AGGREGATED, one line per CLASS — never one line per row. lp-registry's own warning: seeding
    # 304 dispositionless items "makes lp-04's check fire 304 times on its first run, which is how
    # the loop acquired its other decorative gates". A selfcheck that prints 189 failures is not
    # read; it is switched off. The oldest few are named so the line is still actionable.
    alarms = []
    folded = fold_residuals(rows)
    opens = open_residuals(rows, now)

    def _agg(name, picks, why):
        if not picks:
            return
        picks = sorted(picks, key=lambda r: -(r.get("age_days") or 0))
        named = ", ".join("%s(%.0fd)" % (r["id"], r.get("age_days") or 0) for r in picks[:3])
        more = "" if len(picks) <= 3 else " +%d more" % (len(picks) - 3)
        alarms.append((name, "%d residual(s) %s — oldest: %s%s" % (len(picks), why, named, more)))

    _agg("residual-unpromoted",
         [r for r in opens if r.get("status") == "unpromoted"
          and (r.get("age_days") or 0) > POLICY["t1_promote_days"]],
         "unpromoted past t1=%dd (the promote step stalled)" % POLICY["t1_promote_days"])
    _agg("residual-stale",
         [r for r in opens if (r.get("age_days") or 0) > POLICY["t2_stale_days"]],
         "open past t2=%dd" % POLICY["t2_stale_days"])
    # The window is a MATURITY test, not a filter: "nothing has closed yet" is only evidence of
    # a graveyard once something has had time to close. The first version fired on day 0 (one fresh
    # row, nothing closed) and went SILENT on day 40 (the oldest row aged out of the window) —
    # exactly backwards, and it would have occupied the tick's head -3 window for the whole first
    # cycle next to the standing B2 line.
    win = POLICY["graveyard_window_days"]
    ages = [age_days(r.get("disclosed_at", ""), now) or 0 for r in folded.values()]
    closed = [r for r in folded.values() if r.get("status") in ("closed", "dispositioned")]
    emitted = list(folded.values())
    if emitted and not closed and max(ages or [0]) > win:
        alarms.append(("residual-graveyard",
                       "%d residual(s) emitted in the last %dd and 0 closed — the sink has no drain"
                       % (len(emitted), win)))
    if len(opens) > POLICY["open_cap"]:
        alarms.append(("residual-over-cap", "%d open residuals (cap %d, observe-only in slice 1)"
                       % (len(opens), POLICY["open_cap"])))
    return alarms


