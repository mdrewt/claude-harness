    return path, parse_gates(text)


def cmd_status(a):
    path, parsed = load(a["slice"], a.get("_gates_dir"))
    if parsed is None:
        if a.get("json"):
            print(json.dumps({"slice": a["slice"], "verdict": "NO-GATES-FILE"}))
        else:
            print("NO-GATES-FILE %s" % a["slice"])
        return 1
    header, gates, defers, errs = parsed
    met, unmet, deferred = classify(gates, defers)
    if a.get("json"):
        print(json.dumps({
            "slice": a["slice"], "seed": header.get("Seed"), "total": len(gates),
            "met": len(met), "unmet": len(unmet), "deferred": len(deferred),
            "unmet_ids": [g.id for g in unmet], "deferred": {k: v[0] for k, v in defers.items()},
            "parse_errors": errs,
        }, indent=1))
        return 0 if not unmet else 1
    print("%s: %d gates — %d met, %d unmet, %d deferred" %
          (a["slice"], len(gates), len(met), len(unmet), len(deferred)))
    for g in unmet:
        print("  UNMET %s (%s): %s" % (g.id, unmet_reason(g), g.title[:90]))
    for gid, (t, r) in sorted(defers.items()):
        print("  DEFER %s -> %s — %s" % (gid, t, r[:70]))
    for e in errs:
        print("  PARSE-ERROR %s" % e)
    return 0 if not unmet else 1


def cmd_check(a):
    path, parsed = load(a["slice"], a.get("_gates_dir"))
    if parsed is None:
        return die("no gates file for %s (run `mr-gates init --slice %s`)" % (a["slice"], a["slice"]))
    header, gates, defers, errs = parsed
    text = read_gates_file(path)
    lines = text.split("\n")
    cwd = a.get("cwd") or os.getcwd()
    timeout = int(a.get("timeout") or POLICY["check_timeout_s"])
    changed = 0
    for g in gates:
        if g.id in defers or g.met() or not g.check or not g.check.strip():
            continue
        ok, out, _el, why = run_check(g.check, cwd, timeout, a.get("_guard"),
                                      screen=not a.get("_no_guard"))
        if not ok:
            print("  SKIP %s: %s" % (g.id, why))
            continue
        passed = expect_matches(g.expect, out) if g.expect else False
        if passed:
            # WRITE ONLY ON PASS. A red must never be launderable into evidence, and the Stop
            # hook's progress detector must not be gameable by re-running a failing check.
            lines[g.line] = lines[g.line].replace("- [ ]", "- [x]", 1)
            ev = cap_evidence(out, expect=g.expect)
            if g.ev_line != -1:
                indent = re.match(r"^\s*", lines[g.ev_line]).group(0)
                lines[g.ev_line] = "%sEVIDENCE: %s" % (indent, ev)
            changed += 1
            print("  PASS %s: %s" % (g.id, g.title[:70]))
        else:
            print("  FAIL %s: %s\n        %s" % (g.id, g.title[:70], cap_evidence(out)))
    if changed:
        atomic_write(path, "\n".join(lines))
    _h, gates2, defers2, _e = parse_gates(read_gates_file(path))
    met, unmet, deferred = classify(gates2, defers2)
    print("%s: %d/%d met, %d deferred, %d unmet" %
          (a["slice"], len(met), len(gates2), len(deferred), len(unmet)))
    return 0 if not unmet else 1


def acceptance_line(slice_id, header, gates, defers):
    met, unmet, deferred = classify(gates, defers)
    return ("Acceptance: %d/%d met, %d deferred, %d unmet — %s seed:%s"
            % (len(met), len(gates), len(deferred), len(unmet), slice_id,
               header.get("Seed", "?")))


def cmd_render(a):
    path, parsed = load(a["slice"], a.get("_gates_dir"))
    if parsed is None:
        return die("no gates file for %s" % a["slice"])
    header, gates, defers, _e = parsed
    met, unmet, deferred = classify(gates, defers)
    fmt = a.get("format") or "pr"
    if fmt == "pr":
        print(acceptance_line(a["slice"], header, gates, defers))
        for gid, (t, r) in sorted(defers.items()):
            print("Deferred: %s -> %s — %s" % (gid, t, r))
    elif fmt == "park":
        # The resume brief is built FROM THE LEDGER, not from a hand-written memo (plan §9.5).
        print("# %s — park memo (generated by mr-gates)\n" % a["slice"])
        print("## DONE (%d)" % len(met))
        for g in met:
            print("- %s: %s\n  evidence: %s" % (g.id, g.title[:110], (g.evidence or "")[:110]))
        print("\n## REMAINING (%d) — the exact next steps" % len(unmet))
        for g in unmet:
            print("- %s (%s): %s" % (g.id, unmet_reason(g), g.title[:110]))
            if g.check:
                print("  next: %s" % g.check[:150])
        print("\n## DEFERRED (%d)" % len(deferred))
        for gid, (t, r) in sorted(defers.items()):
            print("- %s -> %s — %s" % (gid, t, r))
    elif fmt == "handoff":
        print("%s. %s" % (acceptance_line(a["slice"], header, gates, defers),
                          "Deferred: " + "; ".join("%s->%s" % (k, v[0])
                                                   for k, v in sorted(defers.items()))
                          if defers else "No deferrals."))
    else:
        return die("unknown --format %r" % fmt)
    return 0


def die(msg):
    sys.stderr.write("ERROR: %s\n" % msg)
    return 2


