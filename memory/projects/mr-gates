FLAGS = {"slice", "scope", "repo", "json", "timeout", "format", "reason", "budget", "cwd",
         "force",
         "id", "spec-file", "as", "pr", "unclaimed", "severity", "title", "touches", "gate",
         "target", "source-slice", "domain"}
VALUELESS = {"json", "unclaimed", "force"}


def parse_args(argv):
    a, i = {}, 0
    while i < len(argv):
        tok = argv[i]
        if not tok.startswith("--"):
            return None, "bad arg %r (flags only after the subcommand)" % tok
        k = tok[2:]
        if k not in FLAGS:
            return None, "unknown flag --%s" % k
        if k in VALUELESS:
            a[k.replace("-", "_")] = True
            i += 1
            continue
        if i + 1 >= len(argv) or argv[i + 1].startswith("--"):
            return None, "--%s requires a value" % k
        a[k.replace("-", "_")] = argv[i + 1]
        i += 2
    return a, None


def main(argv):
    if len(argv) < 2:
        sys.stderr.write(__doc__)
        return 2
    sub = argv[1]
    if sub in ("--selftest", "selftest"):
        return selftest()
    if sub in ("--help", "-h", "help"):
        sys.stdout.write(__doc__)
        return 0
    rest = argv[2:]
    rsub = None
    if sub == "residuals":
        if not rest or rest[0].startswith("--"):
            return die("residuals needs a subcommand "
                       "(list|add|promote|close|disposition|policy)")
        rsub, rest = rest[0], rest[1:]
    a, err = parse_args(rest)
    if err:
        return die(err)
    need_slice = ("init", "status", "check", "verify", "render", "reseed", "lint")
    if sub in need_slice and not a.get("slice"):
        return die("%s requires --slice" % sub)
    table = {"init": cmd_init, "status": cmd_status, "check": cmd_check, "render": cmd_render,
             "reseed": cmd_reseed, "lint": cmd_lint, "verify": cmd_verify}
    if sub in table:
        return table[sub](a)
    if sub == "residuals":
        return cmd_residuals(a, rsub)
    return die("unknown subcommand %r" % sub)


