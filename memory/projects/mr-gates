# Command execution (guard-routed)
# ---------------------------------------------------------------------------------------------
def guard_allows(cmd, guard=None):
    """Route a CHECK string through guard-bash.mjs before executing it. ADR-0012 commitment 3:
    a python subprocess never reaches PreToolUse, so verify would otherwise execute run-authored
    shell unguarded inside the supervisor tick. FAILS CLOSED — if the guard cannot be consulted,
    the command is not run."""
    g = guard or GUARD
    if not os.path.exists(g):
        return False, "guard-not-found"
    try:
        r = subprocess.run(["node", g], input=json.dumps({"tool_input": {"command": cmd}}),
                           capture_output=True, text=True, timeout=30)
    except Exception as e:
        return False, "guard-error:%s" % type(e).__name__
    if r.returncode == 2:
        return False, "guard-blocked"
    if r.returncode != 0:
        return False, "guard-rc%d" % r.returncode
    return True, ""


def child_env():
    """MR_* scrubbed so a CHECK cannot read loop state and branch on it — but PATH/HOME/CARGO_HOME
    are INHERITED. cron's PATH is minimal and mr-native-tick.sh installs asdf shims; a truly clean
    env would make every cargo CHECK NOT-REVERIFIED, which fails closed into permanent FLAGGED."""
    env = {k: v for k, v in os.environ.items() if not k.startswith("MR_")}
    env.setdefault("PATH", os.environ.get("PATH", "/usr/bin:/bin"))
    return env


PROTECTED = ("native-supervisor-disabled", "mr-hold", "mr-supervisor-disable",
             "mr-supervisor-enable", "mr-residuals.jsonl", "monster-realm-usage-ledger",
             "monster-realm-handoff")


def run_check(cmd, cwd, timeout, guard=None, screen=True):
    """-> (ok_to_run, output, elapsed, why_not)"""
    # Refused BEFORE guard-bash, because guard-bash allows plenty of shapes that merely NAME these
    # paths and only blocks specific destructive verbs. A gate CHECK has no legitimate reason to
    # mention loop control state at all.
    low = (cmd or "").lower()
    for tok in PROTECTED:
        if tok in low:
            return False, "", 0.0, "refused-touches-loop-state:%s" % tok
    if screen:
        ok, why = guard_allows(cmd, guard)
        if not ok:
            return False, "", 0.0, why
    t0 = time.time()
    try:
        r = subprocess.run(cmd, shell=True, cwd=cwd, env=child_env(), capture_output=True,
                           text=True, timeout=timeout)
        out = (r.stdout or "")
        if r.stderr:
            out = out + ("" if out.endswith("\n") or not out else "\n") + r.stderr
    except subprocess.TimeoutExpired:
        return False, "", time.time() - t0, "timeout"
    except Exception as e:
        return False, "", time.time() - t0, "exec-error:%s" % type(e).__name__
    return True, out, time.time() - t0, ""


def worktree_for(slice_id, repo_root):
    """The slice's worktree, or the repo root. `git -C <missing>` fake-reads empty, so the path is
    confirmed to exist before it is returned (supervisor prompt Gotchas)."""
    try:
        r = subprocess.run(["git", "-C", repo_root, "worktree", "list"],
                           capture_output=True, text=True, timeout=30)
        for ln in (r.stdout or "").splitlines():
            p = ln.split()[0] if ln.split() else ""
            if p and os.path.basename(p) == slice_id and os.path.isdir(p):
                return p
    except Exception:
        pass
    return repo_root if os.path.isdir(repo_root) else None


