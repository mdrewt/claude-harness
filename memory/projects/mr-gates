# verify — the SUPERVISOR's independent re-run (verification-hierarchy layer 3)
# ---------------------------------------------------------------------------------------------
def spotcheck_pick(slice_id, seed, passing_ids):
    """Deterministic, but seeded from slice id + SEED HASH — never from head sha, which the run
    controls and could amend until the draw lands on a favourable gate."""
    if not passing_ids:
        return None
    h = hashlib.sha256(("%s|%s" % (slice_id, seed)).encode("utf-8")).digest()
    return sorted(passing_ids)[h[0] % len(passing_ids)]


def cmd_verify(a):
    slice_id = a["slice"]
    out = {"slice": slice_id, "verdict": "CLEAN", "reasons": []}
    path, parsed = load(slice_id, a.get("_gates_dir"))
    if parsed is None:
        # NOT "FLAGGED": an absent ledger is an absent measurement, not a failed one. Every slice
        # launched before lp-gates has none, and calling those FLAGGED would both cry wolf through
        # the whole transition and make the arming band (which counts CLEAN|FLAGGED over LEDGERED
        # slices) uncomputable. It is still not CLEAN — nothing here reads as a pass.
        out.update(verdict="NO-LEDGER",
                   reasons=["NO-GATES-FILE (slice was never seeded, or its ledger was removed)"])
        return _emit_verify(out, a)
    header, gates, defers, errs = parsed
    met, unmet, deferred = classify(gates, defers)
    out.update(seeded=len([g for g in gates if not g.id.startswith("X")]), total=len(gates),
               met=len(met), unmet=len(unmet), deferred=len(deferred),
               extra=len([g for g in gates if g.id.startswith("X")]),
               unmet_ids=[g.id for g in unmet],
               deferred_targets={k: {"target": v[0], "reason": v[1]}
                                 for k, v in defers.items()})

    # 1. Seed integrity — the criteria must still be the SPEC's criteria.
    spec_file, sec = find_section(slice_id, a.get("_specs"))
    live_seed = seed_hash(extract_criteria(sec)) if sec else None
    recorded = header.get("Seed")
    out["seed_recorded"], out["seed_live"] = recorded, live_seed
    out["seed_drift"] = bool(recorded and live_seed and recorded != live_seed)
    if live_seed and not recorded:
        # Deleting the line is easier than editing the hash, so absent must never read as in-sync.
        out["seed_missing"] = True
        out["reasons"].append("SEED-MISSING (the ledger has no Seed: line; criteria integrity "
                              "cannot be established)")
    if out["seed_drift"]:
        out["reasons"].append("SEED-DRIFT (spec changed since seeding; supervisor must adjudicate "
                              "and run `mr-gates reseed`)")
    if sec is None:
        out["reasons"].append("SPEC-SECTION-NOT-FOUND")
    else:
        # The ledger must still CONTAIN every criterion the spec declares. Without this the Seed
        # line proves only that the spec did not change -- it says nothing about the file whose
        # completeness number we are about to believe.
        want = [c["id"] for c in extract_criteria(sec)]
        have = {g.id for g in gates}
        missing = [i for i in want if i not in have]
        out["criteria_missing"] = missing
        if missing:
            out["reasons"].append(
                "CRITERIA-MISSING: %d seeded criterion/criteria are absent from the ledger (%s). "
                "Deleting a gate is not a way to finish it -- meet it, or DEFER it with a "
                "resolvable target." % (len(missing), ", ".join(missing[:6])))

    # 2/3. Re-execute every CHECK, guard-routed, and compare against recorded evidence.
    repo_root = a.get("repo") or (HARNESS + "/projects/monster-realm")
    cwd = a.get("cwd") or worktree_for(slice_id, repo_root) or repo_root
    out["cwd"] = cwd
    budget = float(a.get("budget") or POLICY["verify_budget_s"])
    spent, reverified, not_reverified, mismatch, drift = 0.0, [], [], [], []
    for g in gates:
        if g.id in defers or not g.check or not g.check.strip():
            continue
        if spent >= budget:
            not_reverified.append({"gate": g.id, "why": "global-budget-exhausted"})
            continue
        ok, o, el, why = run_check(g.check, cwd, POLICY["check_timeout_s"], a.get("_guard"),
                                   screen=not a.get("_no_guard"))
        spent += el
        if not ok:
            not_reverified.append({"gate": g.id, "why": why})
            continue
        passed = expect_matches(g.expect, o) if g.expect else False
        fresh = expect_line(g.expect, o) if g.expect else None
        rec = _norm(g.evidence or "")
        # Normalized SUBSTRING on the deciding line, never a byte-compare of whole output:
        # a byte-compare punishes real runners for timings/ordering and rewards static greps.
        agrees = bool(fresh) and (fresh in rec or rec in fresh or not rec)
        reverified.append({"gate": g.id, "passed": passed, "agrees_with_evidence": agrees,
                           "fresh": (fresh or cap_evidence(o, expect=g.expect))[:160],
                           "seconds": round(el, 1)})
        if g.checked and not passed:
            # THE fraud signal: the box is ticked and an independent re-run does not agree.
            mismatch.append({"gate": g.id, "why": "claimed met; re-run does not match EXPECT",
                             "fresh": (fresh or cap_evidence(o, expect=g.expect))[:160],
                             "recorded": rec[:160]})
        elif g.checked and not agrees:
            # Informational only. Real runners emit counts, timings and orderings that move between
            # runs; the gate still PASSES, so the recorded text differing proves nothing.
            drift.append({"gate": g.id, "recorded": rec[:120], "fresh": (fresh or "")[:120]})
    out["reverified"], out["not_reverified"], out["evidence_mismatch"] = \
        reverified, not_reverified, mismatch
    out["evidence_drift"] = drift
    out["reverified_count"] = len(reverified)
    live_gates = [g for g in gates if g.id not in defers]
    if live_gates and not reverified:
        out["no_check_executed"] = True
        out["reasons"].append(
            "NO-CHECK-EXECUTED: %d live gate(s) and not one command ran. An acceptance ledger "
            "that executes nothing certifies nothing." % len(live_gates))
    out["verify_seconds"] = round(spent, 1)

    # 4. Manual gates: resolve the citation and surface the cited line for the reader.
    manual = []
    for g in gates:
        if g.id in defers or not g.is_manual():
            continue
        resolved = resolve_citation(g.evidence, cwd) if g.has_evidence() else None
        manual.append({"gate": g.id, "has_evidence": g.has_evidence(),
                       "citation_resolves": bool(resolved), "cited_line": resolved})
        if g.checked and not resolved:
            mismatch.append({"gate": g.id, "why": "manual gate checked but its citation does not "
                                                  "resolve"})
    out["manual"] = manual

    # 5. Lint.
    findings = lint_gates(gates, defers) + [("BLOCK", "-", e) for e in errs]
    out["lint"] = [{"severity": s, "gate": g, "message": m} for s, g, m in findings]

    # 6. Adversarial spot-check of ONE passing gate.
    passing = [r["gate"] for r in reverified if r["passed"]]
    pick = spotcheck_pick(slice_id, recorded or "", passing)
    out["spotcheck"] = None
    if pick:
        r = [x for x in reverified if x["gate"] == pick][0]
        gg = [x for x in gates if x.id == pick][0]
        out["spotcheck"] = {"gate": pick, "check": gg.check, "expect": gg.expect,
                            "recorded_evidence": gg.evidence, "fresh": r["fresh"],
                            "agrees": r["agrees_with_evidence"],
                            "read_this": "re-read this gate adversarially and try to refute it"}

    # 7. Residual emission for every DEFER (idempotent).
    emitted = []
    for gid, (target, reason) in sorted(defers.items()):
        gtitle = next((g.title for g in gates if g.id == gid), gid)
        rid = residual_upsert(slice_id, gid, gtitle, target, reason, header,
                              a.get("_residuals"))
        if rid:
            emitted.append(rid)
    out["residuals_emitted"] = emitted
    rows = residual_rows(a.get("_residuals"))
    out["residuals_open"] = len(open_residuals(rows))
    out["residual_alarms"] = ["%s: %s" % (k, v) for k, v in residual_alarms(rows)]

    # Verdict. Fails CLOSED.
    if out["seed_drift"] or out.get("seed_missing") or out.get("criteria_missing") \
            or out.get("no_check_executed") or mismatch or not_reverified or \
            any(f[0] == "BLOCK" for f in findings) or unmet or sec is None \
            or out.get("total", 0) == 0:
        out["verdict"] = "FLAGGED"
    if out.get("total", 0) == 0:
        out["reasons"].append("ZERO-GATES (no criteria extracted for this slice; the run must "
                              "author X* gates or this ledger proves nothing)")
    if mismatch:
        out["reasons"].append("EVIDENCE-MISMATCH on %d gate(s)" % len(mismatch))
    if not_reverified:
        out["reasons"].append("NOT-REVERIFIED on %d gate(s) (fails closed)" % len(not_reverified))
    if unmet:
        out["reasons"].append("%d gate(s) neither met nor DEFERred" % len(unmet))
    if any(f[0] == "BLOCK" for f in findings):
        out["reasons"].append("lint BLOCK")
    out["acceptance_line"] = acceptance_line(slice_id, header, gates, defers)
    return _emit_verify(out, a)


ACCEPTANCE_LOG = MEM + "/mr-acceptance-log.jsonl"


def _record_acceptance(out, path=None):
    """Append-only baseline for the arming decision (lp-gates-arm). Best-effort: a logging failure
    must never change a verdict."""
    try:
        row = {"ts": utc_now(), "slice": out.get("slice"), "verdict": out.get("verdict"),
               "met": out.get("met"), "total": out.get("total"), "unmet": out.get("unmet"),
               "deferred": out.get("deferred"), "reverified": out.get("reverified_count"),
               "reasons": (out.get("reasons") or [])[:4]}
        line = json.dumps(row, sort_keys=True)
        json.loads(line)
        with open(path or ACCEPTANCE_LOG, "a") as fh:
            fcntl.flock(fh.fileno(), fcntl.LOCK_EX)
            fh.write(line + "\n")
    except Exception:
        pass


def _emit_verify(out, a):
    # ADVISORY in slice 1 (R13 + lp-04): evidence for the supervisor's read, never a merge
    # predicate. Promotion to POLICY is slice 2, against the pre-registered 1-4-of-10 band.
    out["advisory"] = True
    out["contract"] = ("ADVISORY EVIDENCE ONLY - never a merge predicate; evidence for an LLM read. "
                       "Unmet or FLAGGED acceptance means READ THE LEDGER and adjudicate; it does "
                       "not mechanically refuse the merge in this slice.")
    _record_acceptance(out, a.get("_acceptance_log"))
    print(json.dumps(out, indent=1))
    return 0


