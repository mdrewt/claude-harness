# ---------------------------------------------------------------------------------------------
# Criterion extraction — TWO SHAPES, both live in the corpus right now.
# Measured over the live spec tree 2026-08-23: 132 of 133 SHALL-bearing sections extract (99%),
# 526 criteria, 242 of them (46%) reusing the spec's own criterion id. A one-shape parser is the lp-08 defect
# ("parse the de-facto convention, not the documented one").
# ---------------------------------------------------------------------------------------------
NEXT_HEAD = re.compile(r"^### ", re.M)
EARS_START = re.compile(r"^EARS:", re.M)
EARS_END = re.compile(r"^(Tests?:|Falsification:|Proof-of-teeth:|#{1,4} |\s*$)", re.M)
BULLET = re.compile(r"^(\s*)[-*+]\s+(.*)$")
IDLEAD = re.compile(r"^\*\*([A-Za-z0-9][A-Za-z0-9.-]{1,39}?):?\*\*:?\s*")
SENT_SPLIT = re.compile(r"(?<=[.;])\s+(?=[A-Z`*(\[])")
SHALL = re.compile(r"\bSHALL\b")
# Words that lead a bold *label*, never a criterion id.
NOT_AN_ID = {"note", "warning", "important", "why", "cap", "scope", "required", "measured",
             "rationale", "caveat", "but", "and", "however", "tests", "ears"}


def _norm(s):
    return " ".join(s.split()).strip()


def head_re(slice_id):
    # Anchored (mr-slice-quality:490): an unanchored search for `lp-02` matches `lp-02b` first.
    return re.compile(r"^### %s(?![\w.-])" % re.escape(slice_id), re.M)


def section_of(text, slice_id):
    m = head_re(slice_id).search(text)
    if not m:
        return None
    n = NEXT_HEAD.search(text, m.end())
    return text[m.start(): n.start()] if n else text[m.start():]


def find_section(slice_id, specs_dir=None):
    """-> (spec_filename, section_text) or (None, None)."""
    specs_dir = specs_dir or SPECS
    try:
        names = sorted(n for n in os.listdir(specs_dir) if n.endswith(".spec.md"))
    except OSError:
        return None, None
    for name in names:
        try:
            with open(os.path.join(specs_dir, name), errors="replace") as fh:
                text = fh.read()
        except OSError:
            continue
        sec = section_of(text, slice_id)
        if sec is not None:
            return name, sec
    return None, None


def _ears_span(sec):
    m = EARS_START.search(sec)
    if not m:
        return None
    e = EARS_END.search(sec, m.end())
    return (m.start(), e.start() if e else len(sec))


def _logical_bullets(block):
    """Fold continuation lines into their bullet so a wrapped criterion is one item."""
    items, cur = [], None
    for ln in block.splitlines():
        b = BULLET.match(ln)
        if b:
            if cur is not None:
                items.append(cur)
            cur = b.group(2).strip()
        elif cur is not None and ln.strip() and not ln.startswith("#"):
            cur += " " + ln.strip()
        elif cur is not None and not ln.strip():
            items.append(cur)
            cur = None
    if cur is not None:
        items.append(cur)
    return items


TOUCHES_LINE = re.compile(r"^`?touches:\s*(.+?)`?\s*$", re.M | re.I)


def extract_touches(sec):
    """The slice's declared `touches:` path-set. Recorded in the ledger header so a residual
    promoted out of this slice inherits a real touches: line — without it every promoted stub says
    "(inherit from source slice — REVIEW)" and a human has to go and look it up, which is the kind
    of small friction that turns a mechanism decorative."""
    m = TOUCHES_LINE.search(sec or "")
    if not m:
        return []
    return [t.strip().strip("`") for t in m.group(1).split(",") if t.strip()]


def extract_criteria(sec):
    """-> [{'id','title','shape'}] . One gate per SHALL-bearing SENTENCE (not per SHALL
    occurrence: mr-slice-quality:481 counts occurrences and the corpus has sentences with three).
    EARS paragraph first, then SHALL-bearing bullets OUTSIDE it — a union, not a fallback, so a
    section carrying both shapes loses nothing."""
    out, seen = [], set()
    span = _ears_span(sec)
    if span:
        para = re.sub(r"^EARS:\s*", "", _norm(sec[span[0]:span[1]]))
        n = 0
        for s in SENT_SPLIT.split(para):
            s = _norm(s)
            if SHALL.search(s):
                n += 1
                gid = "E%d" % n
                seen.add(gid)
                out.append({"id": gid, "title": s, "shape": "ears"})
    rest = (sec[:span[0]] + sec[span[1]:]) if span else sec
    n = 0
    for item in _logical_bullets(rest):
        if not SHALL.search(item):
            continue
        m = IDLEAD.match(item)
        if m and m.group(1).lower() not in NOT_AN_ID:
            gid, title = m.group(1), _norm(item[m.end():])
        else:
            n += 1
            gid, title = "B%d" % n, _norm(item)
        base, k = gid, 2
        while gid in seen:
            gid = "%s.%d" % (base, k)
            k += 1
        seen.add(gid)
        out.append({"id": gid, "title": title, "shape": "bullet"})
    return out


def seed_hash(criteria):
    canon = "\n".join("%s\t%s" % (c["id"], c["title"]) for c in criteria)
    return hashlib.sha256(canon.encode("utf-8")).hexdigest()[:16]


def shall_uncaptured(sec, criteria):
    """SHALLs present in the section but in no extracted criterion. Reported, never silently
    dropped — 5 such cases exist corpus-wide and a third parser shape would cost more in false
    positives than it buys."""
    total = len(SHALL.findall(sec))
    got = sum(len(SHALL.findall(c["title"])) for c in criteria)
    return max(0, total - got)


# ---------------------------------------------------------------------------------------------
# Gate-file model
# ---------------------------------------------------------------------------------------------
GATE_LINE = re.compile(r"^- \[( |x|X)\] (\S+):\s*(.*)$")
ATTR_LINE = re.compile(r"^\s+(CHECK|EXPECT|EVIDENCE|MANUAL):\s?(.*)$")
DEFER_LINE = re.compile(r"^(?:DEFER|ABANDON):\s+(\S+?)\s*(?:->|→)\s*(\S+)\s+(?:—|--)\s+(.+)$")
# ABANDON with no target is unlazy's shape; accepted and normalised to wontfix, reason still required.
ABANDON_BARE = re.compile(r"^ABANDON:\s+(\S+?)\s+(?:—|--)?\s*(.+)$")
HDR = re.compile(r"^([A-Za-z][A-Za-z ]*):\s*(.*)$")


class Gate(object):
    __slots__ = ("id", "title", "checked", "check", "expect", "evidence", "manual",
                 "line", "ev_line")

    def __init__(self, gid, title, checked, line):
        self.id, self.title, self.checked, self.line = gid, title, checked, line
        self.check = self.expect = self.evidence = self.manual = None
        self.ev_line = -1

    def is_manual(self):
        return self.manual is not None or not self.check

    def has_evidence(self):
        return bool(self.evidence) and not re.match(r"^pending$", self.evidence.strip(), re.I)

    def met(self):
        return self.checked and self.has_evidence()


def parse_gates(text):
    """-> (header dict, [Gate], {gate_id: (target, reason)}, [parse errors])"""
    lines = text.split("\n")
    header, gates, defers, errs = {}, [], {}, []
    cur = None
    in_header = True
    for i, line in enumerate(lines):
        g = GATE_LINE.match(line)
        if g:
            in_header = False
            cur = Gate(g.group(2), g.group(3).strip(), g.group(1).lower() == "x", i)
            gates.append(cur)
            continue
        a = ATTR_LINE.match(line) if cur is not None else None
        if a:
            key = a.group(1).lower()
            setattr(cur, key, a.group(2).strip())
            if key == "evidence":
                cur.ev_line = i
            continue
        if line.startswith("DEFER:") or line.startswith("ABANDON:"):
            m = DEFER_LINE.match(line)
            if m:
                defers[m.group(1)] = (m.group(2), m.group(3).strip())
            else:
                m2 = ABANDON_BARE.match(line)
                if m2:
                    defers[m2.group(1)] = ("wontfix", m2.group(2).strip())
                else:
                    errs.append("line %d: unparseable DEFER (want "
                                "`DEFER: <gate> -> <target> — <reason>`): %s" % (i + 1, line[:80]))
            cur = None
            continue
        if in_header:
            h = HDR.match(line)
            if h:
                header[h.group(1).strip()] = h.group(2).strip()
        if not line.strip():
            cur = None
    return header, gates, defers, errs


def classify(gates, defers):
    met, unmet, deferred = [], [], []
    for g in gates:
        if g.id in defers:
            deferred.append(g)
        elif g.met():
            met.append(g)
        else:
            unmet.append(g)
    return met, unmet, deferred


def unmet_reason(g):
    if not g.checked:
        return "unchecked"
    return "checked but EVIDENCE pending"


