_ST_FLOOR = 30


class _Chk(object):
    def __init__(self):
        self.n = 0
        self.bad = 0

    def eq(self, fid, want, got, why=""):
        self.n += 1
        if want != got:
            self.bad += 1
            print("MR-GATES-SELFTEST-FAIL %s: want %r got %r %s" % (fid, want, got, why))

    def ok(self, fid, cond, why=""):
        self.eq(fid, True, bool(cond), why)


_FX_EARS = """## 2. Slices

