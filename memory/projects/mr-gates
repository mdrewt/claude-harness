def atomic_write(path, text):
    d = os.path.dirname(path) or "."
    try:
        os.makedirs(d, exist_ok=True)
    except OSError:
        pass
    fd, tmp = tempfile.mkstemp(dir=d, prefix=".mr-gates.tmp.")
    try:
        with os.fdopen(fd, "w") as fh:
            fh.write(text)
        os.replace(tmp, path)
    except Exception:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def gates_path(slice_id, gates_dir=None):
    return os.path.join(gates_dir or GATES_DIR, "%s.gates.md" % slice_id)


def read_gates_file(path):
    try:
        with open(path, errors="replace") as fh:
            return fh.read()
    except OSError:
        return None


def cap_evidence(output, limit=None, expect=None):
    """The DECIDING line when there is one, else the tail.

    Recording a tail while `verify` compares the EXPECT-matching line makes the recorded and the
    fresh evidence different shapes by construction — the comparison then fails on any command
    whose last lines carry anything besides the match, which is most of them. unlazy's own rule is
    "quote the deciding lines"; this makes that literal."""
    limit = limit or POLICY["evidence_chars"]
    if expect:
        line = expect_line(expect, output)
        if line:
            return line[:limit]
    ls = [l.strip() for l in (output or "").split("\n") if l.strip()]
    return (" | ".join(ls[-2:]) or "(no output)")[:limit]


def expect_matches(expect, output):
    if not expect:
        return None
    rx = re.match(r"^/(.+)/([a-z]*)$", expect)
    if rx:
        flags = re.M          # `/^0$/` and `/1 passed$/` are the natural way to write a
        if "i" in rx.group(2):  # decisive EXPECT; without re.M they can NEVER match, so `check`
            flags |= re.I       # could not flip the box and a hand-flipped one read as a mismatch.
        try:
            return bool(re.search(rx.group(1), output, flags))
        except re.error:
            return False
    return expect in output


def expect_line(expect, output):
    """The deciding line — the one EXPECT actually matched. Used for the normalized
    substring comparison in verify (a byte-compare of whole output punishes real test runners
    for timings and ordering, and rewards static greps)."""
    for ln in (output or "").split("\n"):
        if expect_matches(expect, ln):
            return _norm(ln)
    return None


# ---------------------------------------------------------------------------------------------
# Lint — the anti-vacuity screen. §5 of the plan.
# ---------------------------------------------------------------------------------------------
# An E* gate's CHECK must invoke a real gate runner. CHECKs are authored in the PLAN phase, before
# tests exist, so the only thing writable then is `grep -q "fn foo" src/…` — which passes every
# other rule, re-executes deterministically, matches byte-for-byte, and certifies nothing.
RUNNER_HEADS = {"cargo", "just", "npm", "npx", "pnpm", "node", "vitest", "pytest", "playwright"}
ENVASSIGN = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*=\S*$")


def command_head(cmd):
    toks = (cmd or "").strip().split()
    for t in toks:
        if ENVASSIGN.match(t):
            continue
        return t
    return ""


def is_runner(cmd):
    head = command_head(cmd)
    if not head:
        return False
    base = os.path.basename(head)
    return base in RUNNER_HEADS or base.startswith("mr-")


def lint_gates(gates, defers, specs_dir=None):
    """-> [ (severity, gate_id, message) ]"""
    out = []
    for g in gates:
        # SEEDED = anything init wrote, i.e. anything that is not a run-authored X* gate. Matching
        # on an id PREFIX was the defect: seeded ids are frequently the spec's own (`ptc5a-1`).
        seeded = not g.id.startswith("X")
        if g.check:
            c = g.check
            if seeded and not is_runner(c):
                out.append(("BLOCK", g.id,
                            "seeded gate CHECK must invoke a gate runner (%s) or be MANUAL: with a "
                            "citation; got head %r" % ("|".join(sorted(RUNNER_HEADS)) + "|mr-*",
                                                       command_head(c))))
            if re.search(r"\|\|", c) or re.search(r";\s*true\s*$", c):
                out.append(("BLOCK", g.id, "CHECK cannot fail: trailing `||` / `; true`"))
            if not g.expect:
                out.append(("BLOCK", g.id, "CHECK without EXPECT (exit code alone is too weak "
                                           "for an acceptance gate)"))
            elif g.expect.strip() == "":
                out.append(("BLOCK", g.id, "empty EXPECT"))
            elif _expect_core(g.expect) and _expect_core(g.expect) in c:
                # Compare the INNER pattern: `EXPECT: /1 passed/` never appears verbatim in a
                # CHECK, so testing the delimited form let the exact shape the brief teaches
                # through -- `cargo test --lib nope ; echo "1 passed"` linted clean.
                out.append(("BLOCK", g.id, "EXPECT appears verbatim inside its own CHECK "
                                           "(echo-your-own-answer)"))
            elif seeded and re.search(r";\s*(echo|printf)\b", c):
                # `;` defeats the `||` and `; true` rules and appends a success string after a
                # command that already failed.
                out.append(("BLOCK", g.id, "seeded CHECK appends an echo/printf after `;` -- the "
                                           "command's own result is then irrelevant"))
            else:
                rx = re.match(r"^/(.+)/[a-z]*$", g.expect)
                if rx and "|" in rx.group(1):
                    alts = [a.lower() for a in rx.group(1).split("|")]
                    good = any(re.search(r"pass|ok|success|green|0 failed", a) for a in alts)
                    bad = any(re.search(r"fail|error|red|panic", a) for a in alts)
                    if good and bad:
                        out.append(("BLOCK", g.id,
                                    "EXPECT alternation covers both success and failure tokens"))
        else:
            if not g.manual:
                out.append(("WARN", g.id, "no CHECK and no MANUAL: rationale"))
            if g.has_evidence() and not citation_of(g.evidence):
                out.append(("BLOCK", g.id, "manual gate EVIDENCE must be a resolvable `path:line` "
                                           "citation or a quoted deciding output line"))
    for gid, (target, reason) in defers.items():
        if not reason or len(reason) < 8:
            out.append(("BLOCK", gid, "DEFER needs a real reason"))
        if target not in ("backlog",) and target not in LEGAL_DISPOSITIONS:
            if not re.match(r"^[A-Za-z0-9][A-Za-z0-9.-]*$", target):
                out.append(("BLOCK", gid, "DEFER target %r is not a slice id, `backlog` or "
                                          "`wontfix`" % target))
            elif find_section(target, specs_dir)[1] is None:
                # An id that exists in no spec is exactly the `14r-c-2` class: it lints clean, the
                # row is emitted `status:targeted`, and `residuals list --unclaimed` never shows
                # it. Use `backlog` when no section exists yet — that is what promote is for.
                out.append(("BLOCK", gid, "DEFER target %r exists in no spec section. Use "
                                          "`backlog` (the supervisor promotes it into a real "
                                          "section) or name a section that exists." % target))
    seeded = [g for g in gates if not g.id.startswith("X")]
    seeded_ids = [g.id for g in seeded]
    if seeded_ids:
        ratio = len([i for i in seeded_ids if i in defers]) / float(len(seeded_ids))
        if ratio > POLICY["max_defer_ratio"]:
            out.append(("BLOCK", "-", "%.0f%% of seeded gates DEFERred (cap %.0f%%): this is a "
                                      "sizing failure, not a scheduling one"
                        % (ratio * 100, POLICY["max_defer_ratio"] * 100)))
        # THE MANUAL ESCAPE HATCH, capped. The runner allowlist only binds gates that HAVE a
        # CHECK, so a run could dodge it wholesale by declaring every criterion MANUAL with a
        # plausible-looking citation. unlazy's own rule applies: "if you cannot think of a CHECK,
        # ask whether the outcome is observable at all; if it is not, sharpen it." A minority of
        # manual gates is normal (doc-truth criteria genuinely have no runner); a majority means
        # the criteria are not observable, or the run is avoiding proof.
        live = [g for g in seeded if g.id not in defers]
        # Minimum sample: a "ratio" over one or two gates is noise, and a 1-criterion doc-truth
        # slice is legitimate. Corpus median is 3 criteria, so 3 is the smallest honest sample.
        if len(live) >= 3:
            man = len([g for g in live if g.is_manual()]) / float(len(live))
            if man > POLICY["max_manual_ratio"]:
                out.append(("BLOCK", "-",
                            "%.0f%% of live seeded gates are MANUAL (cap %.0f%%): acceptance "
                            "criteria that no command can check are criteria that are not "
                            "observable -- sharpen them, or this ledger proves nothing"
                            % (man * 100, POLICY["max_manual_ratio"] * 100)))
    return out


def _expect_core(expect):
    """The inner pattern of a `/regex/` EXPECT, else the literal string."""
    m = re.match(r"^/(.+)/[a-z]*$", (expect or "").strip())
    return m.group(1) if m else (expect or "").strip()


CITATION = re.compile(r"^([\w./+-]+):(\d+)(?:-(\d+))?\b")


def citation_of(evidence):
    m = CITATION.match((evidence or "").strip())
    return (m.group(1), int(m.group(2))) if m else None


def resolve_citation(evidence, root):
    c = citation_of(evidence)
    if not c:
        return None
    path, lineno = c
    full = path if os.path.isabs(path) else os.path.join(root, path)
    try:
        with open(full, errors="replace") as fh:
            for i, ln in enumerate(fh, 1):
                if i == lineno:
                    return _norm(ln)[:200]
    except OSError:
        return None
    return None


