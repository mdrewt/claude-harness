        chk.eq("E3-abandon-normalises", "wontfix", dd.get("E1", (None,))[0])
        _h, _g, dd, ee = parse_gates("- [ ] E1: t\n\nDEFER: E1 no arrow at all\n")
        chk.eq("E4-malformed-is-error", 1, len(ee))
        chk.eq("E5-malformed-not-silent", {}, dd)

        # --- F. lint: the proven evasions ----------------------------------------------------
        def L(body, sd=None):
            _h, gs, ds, _e = parse_gates(body)
            return lint_gates(gs, ds, specs_dir=sd)

        blocked = lambda f: [x for x in f if x[0] == "BLOCK"]
