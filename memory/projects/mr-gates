               "assert the REASON, not the verdict: seven rules can produce FLAGGED, so a verdict "
               "assertion greens on whichever neighbour happens to fire")

        # T2: the echo-your-own-answer rule was INERT for the `/regex/` EXPECT the brief teaches,
        # because it tested the delimited string. `;` also defeats the `||` and `; true` rules.
        # The two rules overlap on the obvious fixture, so each is exercised in ISOLATION on a
        # CHECK that can only trip that one.
        # No semicolon here, so ONLY the echo-your-own-answer rule can fire.
        for exp in ("/1 passed/", "1 passed"):
            f = L('- [ ] E1: t\n  CHECK: cargo test --lib -- --nocapture "1 passed"\n'
                  '  EXPECT: %s\n' % exp)
            chk.ok("T2-echo-own-answer[%s]" % exp,
                   any(x[0] == "BLOCK" and "echo-your-own-answer" in x[2] for x in f),
                   "the delimited form must be stripped before the containment test, or the "
                   "`/regex/` shape the brief teaches sails through")
        # EXPECT deliberately absent from the CHECK, so ONLY the semicolon rule can fire.
        f2 = L('- [ ] E1: t\n  CHECK: cargo test --lib nope ; echo ok\n  EXPECT: /passed/\n')
        chk.ok("T2b-semicolon-echo",
               any(x[0] == "BLOCK" and "after `;`" in x[2] for x in f2),
               "`;` defeats the `||` and `; true` rules and appends success after a failure")

        # T3: a ledger where nothing executed reported CLEAN. The manual-ratio cap needs >=3 live
        # gates and the corpus median IS 3, so many slices sit at or under it.
        atomic_write(gates_path("t-2", gdir),
                     "# Gates: t-2\nSeed: z\n\n- [x] X1: a\n  MANUAL: doc\n"
                     "  EVIDENCE: M-t.spec.md:1\n\n- [x] X2: b\n  MANUAL: doc\n"
                     "  EVIDENCE: M-t.spec.md:2\n")
        vn = V("t-2")
        chk.eq("T3-nothing-executed-flags", "FLAGGED", vn["verdict"])
        chk.eq("T3b-count", 0, vn.get("reverified_count"))
        chk.ok("T3c-reason-is-specific",
               any("NO-CHECK-EXECUTED" in r for r in vn["reasons"]),
               "the citations in this fixture also fail to resolve, so a bare FLAGGED assertion "
               "would green with this rule deleted")

        # T4: reseed could not restore an ABSENT Seed line — the exact case SEED-MISSING detects.
        noseed = "\n".join(l for l in read_gates_file(tp).split("\n")
                           if not l.startswith("Seed:"))
        atomic_write(tp, noseed)
        cmd_reseed({"slice": "t-1", "_specs": specs, "_gates_dir": gdir, "reason": "fixture"})
        chk.ok("T4-reseed-restores-absent-seed",
               bool(parse_gates(read_gates_file(tp))[0].get("Seed")),
               "the documented repair must repair the case it exists for")

        # T5: promote appended at EOF, past the file's own append marker.
        bl = os.path.join(specs, BACKLOG_SPEC)
        atomic_write(bl, "# hdr\n\n<!-- PROMOTED SECTIONS APPEND BELOW THIS LINE -->\n\n"
                         "## 5. Explicitly NOT in scope\n- nothing\n")
        rid2 = residual_upsert("t-1", "E9", "THE SYSTEM SHALL land above the marker", "backlog",
                               "fixture reason here", {"Repo": "harness"}, resid)
        cmd_residuals({"id": rid2, "_residuals": resid, "_specs": specs}, "promote")
        bt = read_gates_file(bl)
        chk.ok("T5-promote-respects-marker",
               bt.index("### rb-") < bt.index("## 5. Explicitly NOT in scope"),
               "the file declares an append marker; appending at EOF puts slices after the "
               "out-of-scope section")

        # T6: the arming baseline must be DURABLE — worktrees are deleted at merge, so verify
        # cannot be re-run retrospectively and one reboot would erase it.
        alog = os.path.join(root, "acc.jsonl")
        V("t-2", alog)
        rows = [json.loads(x) for x in open(alog).read().strip().split("\n") if x.strip()]
        chk.ok("T6-acceptance-logged", rows and rows[-1]["slice"] == "t-2" and
               rows[-1]["verdict"] == "FLAGGED",
               "the pre-registered 1-to-4-of-10 band needs the first ten verdicts on disk")

        # --- L. render determinism ------------------------------------------------------------
        _h, gr, dr, _e = parse_gates(read_gates_file(gp))
        line = acceptance_line("fx-a", _h, gr, dr)
        chk.ok("L1-shape", line.startswith("Acceptance: ") and "seed:" in line)
        chk.eq("L2-deterministic", line, acceptance_line("fx-a", _h, gr, dr),
               "mr-audit byte-compares this against the PR body")

        # --- M. degeneracy control --------------------------------------------------------------
        verdicts = {bool(blocked(L('- [ ] E1: t\n  CHECK: grep -q x y\n  EXPECT: /z/\n'))),
                    bool(blocked(L("- [ ] E1: t\n  CHECK: cargo test\n  EXPECT: /1 passed/\n")))}
        chk.eq("M1-lint-discriminates", {True, False}, verdicts,
               "a lint that blocks everything or nothing carries no information (lp-04)")
    finally:
        cleanup()

    if chk.n < _ST_FLOOR:
        chk.bad += 1
        print("MR-GATES-SELFTEST-FAIL battery-size: %d assertions < floor %d" % (chk.n, _ST_FLOOR))
    if chk.bad:
        print("MR-GATES-SELFTEST-FAIL %d of %d" % (chk.bad, chk.n))
        return 1
    print("MR-GATES-SELFTEST-OK %d" % chk.n)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
