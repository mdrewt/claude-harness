#!/usr/bin/python3
''''exec /usr/bin/python3 "$0" "$@" # '''
# ^ POLYGLOT INTERPRETER GUARD: `bash <this file>` re-execs under python3 before reaching any
# other line (mr-hold's header has the reason). Statically enforced by mr-selfcheck.
"""mr-interrupted — the slices a credit stop interrupted, and when they can run again.

A credit stop is a `rate_limit_event` with `status == "rejected"` at the end of a build
session's pass log: the session's next API call is refused until `resetsAt`, whether the
refused window is the short one or the weekly cap. Which slices were stopped, at what tier and
on which CLI session is a fact on disk at that moment, so it is recorded here by the tick
wrapper instead of being inferred by a decision session days later.

  mr-interrupted scan          Called by mr-native-tick.sh before its gates, on every tick (also
                               while held or over budget). For each runner lock whose pass log
                               ends on a rejection it records the slice; when the reset is still
                               ahead it also records every other slice with a live leader,
                               because they draw on the same credit, and trips the cooperative
                               stop flags so each run checkpoints instead of dying mid-step.
                               Prints `STOP new=<slice,...> resets=<epoch> limit=<type>` when
                               it recorded something, else `NONE`.
  mr-interrupted gate          `BLOCKED_UNTIL_<utc>` while every recorded slice still waits for
                               its reset, `DUE n=<k>` once at least one can run, else `CLEAR`.
  mr-interrupted list          JSON array for the situation bundle: slice, cause, limit,
                               stopped_utc, resets_at_utc, due, tier, model, effort,
                               resume_session. A slice that was only stopped alongside a
                               rejected one and then finished (`.done` EXIT=0) is dropped.
  mr-interrupted vars --due | <slice>
                               Writes /tmp/mr_pass_<slice>.vars.json for a resume: the vars the
                               slice was launched with, at the tier/model/effort it was running
                               at, with `resume_session` naming the stopped CLI session. Prints
                               the slices written, comma-joined.
  mr-interrupted drop <slice>  Removes the slice's record. mr-spawn calls it once the slice is
                               launched again; a decision session calls it for a slice whose
                               work turned out to be merged or in an open PR.

The record is `mr-interrupted.json` beside this file, so a copy run from a worktree or a
fixture directory never touches the live loop's record. Each entry is keyed by slice, the
session's launch stamp and the reset time; a dropped key is remembered, because the stopped
session's log stays on disk and the next scan would record it again.

The reset time is the EARLIEST among the rejections the log ends on. A low guess costs one
resume that is refused and recorded again with the later reset; a high guess costs idle days.

Fixtures: MR_INTERRUPTED_TMP replaces /tmp and MR_INTERRUPTED_NOW the clock (epoch seconds).
Always exits 0 except on a usage error (2).
"""
import datetime
import fcntl
import glob
import json
import os
import re
import sys
import time

MEM = os.path.dirname(os.path.realpath(__file__))
TMP = os.environ.get("MR_INTERRUPTED_TMP") or "/tmp"
STATE = os.path.join(MEM, "mr-interrupted.json")
TAIL_LINES = 50          # "ends on a rejection": a session that kept working wrote far more
TAIL_BYTES = 4 << 20
MAX_AHEAD = 14 * 86400   # a reset further out than any real window is a bad value
_SID = re.compile(r'"session_id":"([0-9a-fA-F-]{8,64})"')
_INVOKE = ("ATTEMPT=", "COST-CAP-WRAP start")


def now():
    try:
        return float(os.environ["MR_INTERRUPTED_NOW"])
    except (KeyError, ValueError):
        return time.time()


def utc(epoch):
    return datetime.datetime.fromtimestamp(epoch, datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def load():
    try:
        with open(STATE) as f:
            d = json.load(f)
        if isinstance(d, dict) and isinstance(d.get("entries"), list) and isinstance(d.get("dropped"), list):
            return d
    except Exception:
        pass
    return {"entries": [], "dropped": []}


def locked(fn):
    """Run fn(state) under an exclusive lock; a changed state is written back atomically."""
    with open(STATE + ".lock", "a+") as lk:
        fcntl.flock(lk, fcntl.LOCK_EX)
        state = load()
        before = json.dumps(state, sort_keys=True)
        out = fn(state)
        if json.dumps(state, sort_keys=True) != before:
            tmp = "%s.tmp.%d" % (STATE, os.getpid())
            with open(tmp, "w") as f:
                json.dump(state, f, indent=1)
                f.write("\n")
            os.replace(tmp, STATE)
        return out


def read_log(slice_):
    """(launch stamp, session id, [(resets_at, limit)] the log ends on) for a slice's pass log.
    Only the head (the launch marker) and the last TAIL_BYTES are read: a pass log runs to
    hundreds of megabytes and this is called for every lock on every tick."""
    stamp, sid, tail = None, None, []
    try:
        with open(os.path.join(TMP, "mr_pass_%s.log" % slice_), "rb") as fh:
            m = re.search(r"^ATTEMPT=1\b.*\bTS=(\S+)", fh.read(4096).decode("utf-8", "replace"), re.M)
            stamp = re.sub(r"[^0-9TZ]", "", m.group(1)) if m else None
            fh.seek(0, os.SEEK_END)
            fh.seek(max(0, fh.tell() - TAIL_BYTES))
            lines = fh.read().decode("utf-8", "replace").splitlines()
    except OSError:
        return None, None, []
    for line in lines:
        if line.startswith(_INVOKE):
            tail = []
            continue
        m = _SID.search(line)
        if m:
            sid = m.group(1)
        tail.append(line)
    tail = tail[-TAIL_LINES:]
    rejected = []
    for line in tail:
        if '"rate_limit_event"' not in line or '"rejected"' not in line:
            continue
        try:
            info = json.loads(line).get("rate_limit_info")
        except Exception:
            continue
        if not isinstance(info, dict) or info.get("status") != "rejected":
            continue
        try:
            at = float(info.get("resetsAt"))
        except (TypeError, ValueError):
            continue
        if at > 1e11:
            at /= 1000.0     # epoch milliseconds
        rejected.append((int(at), str(info.get("rateLimitType") or "unknown")[:60]))
    return stamp, sid, rejected


def slices():
    """Every slice with a runner lock: (slice, lock dict, leader alive, .done text)."""
    out = []
    for path in sorted(glob.glob(os.path.join(MEM, ".harness-runner.*.lock"))):
        name = os.path.basename(path)[len(".harness-runner."):-len(".lock")]
        try:
            with open(path) as f:
                lock = json.load(f)
            if not isinstance(lock, dict):
                continue
        except Exception:
            continue
        alive = False
        try:
            os.kill(int(lock.get("session_leader")), 0)
            alive = True
        except Exception:
            pass
        try:
            with open(os.path.join(TMP, "mr_pass_%s.done" % name)) as f:
                done = f.read().strip()
        except OSError:
            done = None
        out.append((name, lock, alive, done))
    return out


def entry(name, lock, stamp, sid, at, limit, cause, t):
    try:
        with open(os.path.join(TMP, "mr_pass_%s.vars.json" % name)) as f:
            launched = json.load(f)
        if not isinstance(launched, dict):
            launched = None
    except Exception:
        launched = None
    return {"key": "%s|%s|%d" % (name, stamp or lock.get("started_utc") or "?", at),
            "slice": name, "cause": cause, "limit": limit,
            "stopped_utc": utc(t), "resets_at": at, "resets_at_utc": utc(at),
            "tier": lock.get("tier") or "routine", "model": lock.get("model") or "opus",
            "effort": lock.get("effort") or "high", "repo": lock.get("repo"),
            "touches": lock.get("touches"), "resume_session": sid, "vars": launched}


def touch(name):
    try:
        open(os.path.join(TMP, name), "a").close()
    except OSError:
        pass


def cmd_scan():
    t = now()
    found = slices()

    def run(state):
        known = set(e.get("key") for e in state["entries"]) | set(state["dropped"])
        new = []
        for name, lock, alive, done in found:
            stamp, sid, rejected = read_log(name)
            rejected = [r for r in rejected if r[0] <= t + MAX_AHEAD]
            if not rejected:
                continue
            at, limit = min(rejected)
            e = entry(name, lock, stamp, sid, at, limit, "rate-limit", t)
            if e["key"] not in known:
                known.add(e["key"])
                new.append(e)
        ahead = [e for e in new if e["resets_at"] > t]
        if ahead:
            first = min(ahead, key=lambda e: e["resets_at"])
            for name, lock, alive, done in found:
                if not alive or done is not None or any(e["slice"] == name for e in new):
                    continue
                stamp, sid, _ = read_log(name)
                e = entry(name, lock, stamp, sid, first["resets_at"], first["limit"],
                          "stopped-with:" + first["slice"], t)
                if e["key"] not in known:
                    known.add(e["key"])
                    new.append(e)
            touch("mr_stop_all")
            for e in new:
                touch("mr_stop_" + e["slice"])
        fresh = set(e["slice"] for e in new)
        state["entries"] = [e for e in state["entries"] if e.get("slice") not in fresh] + new
        return new

    new = locked(run) if found or os.path.exists(STATE) else []
    if not new:
        print("NONE")
        return 0
    ahead = [e for e in new if e["resets_at"] > t] or new
    first = min(ahead, key=lambda e: e["resets_at"])
    print("STOP new=%s resets=%d limit=%s" % (",".join(e["slice"] for e in new), first["resets_at"], first["limit"]))
    return 0


def current():
    """Entries still interrupted; a slice only stopped alongside a rejected one that went on to
    finish is removed."""
    if not os.path.exists(STATE):
        return []
    finished = set(name for name, _lock, _alive, done in slices() if done and done.startswith("EXIT=0"))

    def run(state):
        gone = [e for e in state["entries"]
                if str(e.get("cause", "")).startswith("stopped-with:") and e.get("slice") in finished]
        for e in gone:
            state["entries"].remove(e)
            state["dropped"] = (state["dropped"] + [e.get("key")])[-200:]
        return list(state["entries"])

    return locked(run)


def cmd_gate():
    t = now()
    entries = current()
    due = [e for e in entries if e.get("resets_at", 0) <= t]
    if due:
        print("DUE n=%d" % len(due))
    elif entries:
        print("BLOCKED_UNTIL_" + utc(min(e["resets_at"] for e in entries)))
    else:
        print("CLEAR")
    return 0


def cmd_list():
    t = now()
    keep = ("slice", "cause", "limit", "stopped_utc", "resets_at_utc", "tier", "model", "effort", "resume_session")
    print(json.dumps([dict({k: e.get(k) for k in keep}, due=e.get("resets_at", 0) <= t) for e in current()]))
    return 0


def cmd_vars(which):
    t = now()
    written = []
    for e in current():
        if which == "--due":
            if e.get("resets_at", 0) > t:
                continue
        elif e.get("slice") != which:
            continue
        name = e["slice"]
        v = dict(e.get("vars") or {})
        note = ("CREDIT-STOP RESUME: this slice was stopped by a usage limit at %s, not by a failure. "
                "Continue it from its existing worktree and branch (the `wip:` checkpoint) and "
                "memory/projects/monster-realm-%s-progress.md; re-verify git state first."
                % (e.get("stopped_utc"), name))
        prior = str(v.get("resume_block") or "")
        v.update({"slice": name, "tier": e.get("tier"), "model": e.get("model"), "effort": e.get("effort"),
                  "resume_block": note if note in prior else (prior + "\n" if prior else "") + note})
        v.setdefault("touches", e.get("touches") or "")
        v.setdefault("target_desc", "resume %s per its spec section and park memo" % name)
        if e.get("resume_session"):
            v["resume_session"] = e["resume_session"]
        else:
            v.pop("resume_session", None)
        path = os.path.join(TMP, "mr_pass_%s.vars.json" % name)
        try:
            with open(path + ".tmp", "w") as f:
                json.dump(v, f, indent=1)
            os.replace(path + ".tmp", path)
            written.append(name)
        except OSError:
            pass
    print(",".join(written))
    return 0


def cmd_drop(name):
    if not os.path.exists(STATE):
        print("DROPPED 0")
        return 0

    def run(state):
        gone = [e for e in state["entries"] if e.get("slice") == name]
        state["entries"] = [e for e in state["entries"] if e.get("slice") != name]
        state["dropped"] = (state["dropped"] + [e.get("key") for e in gone])[-200:]
        return len(gone)

    print("DROPPED %d" % locked(run))
    return 0


def main(argv):
    if argv == ["scan"]:
        return cmd_scan()
    if argv == ["gate"]:
        return cmd_gate()
    if argv == ["list"]:
        return cmd_list()
    if len(argv) == 2 and argv[0] == "vars":
        return cmd_vars(argv[1])
    if len(argv) == 2 and argv[0] == "drop" and re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]*", argv[1]):
        return cmd_drop(argv[1])
    sys.stderr.write("usage: mr-interrupted scan | gate | list | vars --due|<slice> | drop <slice>\n")
    return 2


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except Exception as exc:     # the wrapper reads stdout; a crash must not look like a verdict
        sys.stderr.write("mr-interrupted: %s: %s\n" % (type(exc).__name__, exc))
        sys.exit(0)
