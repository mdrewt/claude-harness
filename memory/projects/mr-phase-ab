def _price(cfg_path):
    try:
        return json.load(open(cfg_path)).get("pricing_per_mtok") or {}
    except Exception:
        return {}


def main_thread(ctx, sid, pricing):
    """Main-thread stats of one session from its transcript: turns, context list, cost."""
    if not sid or not re.fullmatch(r"[0-9a-fA-F-]{8,64}", sid):
        return None
    seen = {}
    for p in glob.glob(os.path.join(glob.escape(ctx.transcripts), "*", sid + ".jsonl")):
        try:
            for line in open(p, errors="replace"):
                if '"assistant"' not in line:
                    continue
                try:
                    o = json.loads(line)
                except Exception:
                    continue
                m = o.get("message") if isinstance(o, dict) else None
                if o.get("type") != "assistant" or not isinstance(m, dict) or not m.get("id") or not m.get("usage"):
                    continue
                seen[m["id"]] = (m.get("model") or "", m["usage"])
        except OSError:
            continue
    if not seen:
        return None
    ctxs, cost = [], 0.0
    for model, u in seen.values():
        fam = next((k for k in ("fable", "opus", "sonnet", "haiku") if k in model), "opus")
        pr = pricing.get(fam) or {}
        cr, cw, i, o = (u.get("cache_read_input_tokens", 0) or 0, u.get("cache_creation_input_tokens", 0) or 0,
                        u.get("input_tokens", 0) or 0, u.get("output_tokens", 0) or 0)
        ctxs.append(cr + cw + i)
        cost += (cr * pr.get("cache_read", 0) + cw * pr.get("cache_write_5m", 0) + i * pr.get("in", 0) + o * pr.get("out", 0)) / 1e6
    return {"turns": len(ctxs), "ctx": ctxs, "cost": round(cost, 4)}


def _pct(xs, q):
    if not xs:
        return None
    xs = sorted(xs)
    return xs[min(len(xs) - 1, int(q * len(xs)))]


def slice_metrics(ctx, slice_, t0, rows, ledger, pricing, residual_rows):
    lr = [r for r in ledger if r.get("slice") == slice_ and (epoch(r.get("ts")) or 0) >= t0]
    cost = round(sum(r["cost_usd"] for r in lr if isinstance(r.get("cost_usd"), (int, float)) and not isinstance(r.get("cost_usd"), bool)), 2)
    outs = [str(r.get("outcome", "")).upper() for r in lr]
    merged = next((r for r in lr if str(r.get("outcome", "")).upper().startswith("MERGED")), None)
    sids = []
    for r in rows:
        if r.get("kind") == "session" and r.get("slice") == slice_ and r.get("sid") not in [s for s, _ in sids]:
            sids.append((r.get("sid"), r.get("phase") or "all"))
    for r in lr:
        for sid in re.findall(r"\bsession=([0-9a-fA-F-]{8,64})", str(r.get("notes", ""))):
            if sid not in [s for s, _ in sids]:
                sids.append((sid, "all"))
    sess = []
    for sid, phase in sids:
        mt = main_thread(ctx, sid, pricing)
        if mt:
            sess.append(dict(mt, sid=sid, phase=phase))
    allctx = [c for s in sess for c in s["ctx"]]
    turns = sum(s["turns"] for s in sess)
    mcost = sum(s["cost"] for s in sess)
    gates = None
    for gp in (os.path.join(ctx.mem, "gates", slice_ + ".gates.md"), os.path.join(ctx.mem, "gates", "archive", slice_ + ".gates.md")):
        try:
            gates = sum(1 for line in open(gp, errors="replace") if line.startswith("DEFER:"))
            break
        except OSError:
            continue
    return {"slice": slice_, "ledger_cost": cost, "sessions_rows": sum(1 for o in outs if o.startswith(("FINISHED", "CRASHED"))),
            "launches": sum(1 for o in outs if o.startswith(("LAUNCHED", "RESUMED"))), "parks": sum(1 for o in outs if o.startswith("PARKED")),
            "merged": bool(merged), "red_fix_cycles": (merged or {}).get("remote_red_fix_cycles"),
            "audit": " ".join(str((merged or {}).get(k) or "") for k in ("orchestration_audit", "gating_test_audit")).strip(),
            "residuals": len({r.get("id") for r in residual_rows if r.get("source_slice") == slice_ and r.get("id")}),
            "defers": gates, "main_sessions": len(sess), "main_turns": turns, "main_cost": round(mcost, 2),
            "main_cost_per_turn": round(mcost / turns, 4) if turns else None,
            "ctx_median": _pct(allctx, 0.5), "ctx_p90": _pct(allctx, 0.9), "ctx_max": max(allctx) if allctx else None,
            "per_phase": {ph: {"turns": sum(s["turns"] for s in sess if s["phase"] == ph),
                               "ctx_median": _pct([c for s in sess if s["phase"] == ph for c in s["ctx"]], 0.5),
                               "ctx_p90": _pct([c for s in sess if s["phase"] == ph for c in s["ctx"]], 0.9)}
                          for ph in sorted({s["phase"] for s in sess})}}


def baseline(ctx, start_e, ledger, pricing, residual_rows, n=30):
    """The last n slices merged before the experiment started, with their tier from the launch row."""
    merged = [r for r in ledger if str(r.get("outcome", "")).upper().startswith("MERGED") and (epoch(r.get("ts")) or 0) < start_e
              and r.get("slice") not in ("SUPERVISOR",) and not str(r.get("slice", "")).startswith(EXCLUDE)
              and spec_type(ctx, str(r.get("slice"))) not in ("design", "docs", "refactor")]
    seen, uniq = set(), []
    for m in reversed(merged):           # the latest MERGED row per slice
        if m["slice"] not in seen:
            seen.add(m["slice"])
            uniq.append(m)
    merged = list(reversed(uniq))
    out = []
    for m in merged[-n:]:
        s, te = m["slice"], epoch(m["ts"]) or 0
        first = next((r for r in ledger if r.get("slice") == s and str(r.get("outcome", "")).upper().startswith("LAUNCHED")
                      and te - 30 * 86400 <= (epoch(r.get("ts")) or 0) <= te), None)
        t0 = epoch(first["ts"]) if first else te - 14 * 86400
        tier = (re.search(r"tier=(\w+)", str((first or {}).get("notes", ""))) or [None, "?"])[1]
        sm = slice_metrics(ctx, s, t0, [], [r for r in ledger if (epoch(r.get("ts")) or 0) <= te], pricing, residual_rows)
        out.append(dict(sm, tier=tier))
    return out


def _med(xs):
    xs = [x for x in xs if isinstance(x, (int, float))]
    return round(statistics.median(xs), 4) if xs else None


def verdict(phased, control, base, timed_out=False):
    """Pre-registered reading (2026-11-26). n is tiny, so this is a LEANING, never a proof.
    Merged slices only; an assigned slice still in flight is listed apart and counts against the
    phased arm only when the experiment ended on its timeout."""
    unmerged = [m for m in phased if not m["merged"]]
    uc = [m for m in control if not m["merged"]]
    phased = [m for m in phased if m["merged"]]
    control = [m for m in control if m["merged"]]
    ref = control + base
    notes, guard = [], []
    pc, rc = _med([m["ctx_median"] for m in phased]), _med([m["ctx_median"] for m in ref])
    pt, rt = _med([m["main_cost_per_turn"] for m in phased]), _med([m["main_cost_per_turn"] for m in ref])
    ps, rs = _med([m["ledger_cost"] for m in phased if m["merged"]]), _med([m["ledger_cost"] for m in ref if m["merged"]])
    if _med([m["launches"] for m in phased]) is not None and _med([m["launches"] for m in control or base]) is not None \
            and _med([m["launches"] for m in phased]) > _med([m["launches"] for m in control or base]):
        guard.append("phased slices needed more launches/resumes")
    pr, rr = _med([m["residuals"] for m in phased]), _med([m["residuals"] for m in ref])
    if pr is not None and rr is not None and pr > max(1.5 * rr, rr + 1):
        guard.append("phased slices filed more residuals (%s vs %s)" % (pr, rr))
    if timed_out and unmerged:
        guard.append("%d phased slice(s) did not merge before the timeout" % len(unmerged))
    if any("FLAG" in (m["audit"] or "").upper() for m in phased) and not any("FLAG" in (m["audit"] or "").upper() for m in control):
        guard.append("only phased slices drew a FLAGGED audit")
    if pc and rc:
        notes.append("main-thread median context %.0fk vs %.0fk (%+.0f%%)" % (pc / 1e3, rc / 1e3, 100 * (pc - rc) / rc))
    if pt and rt:
        notes.append("main-thread cost per turn $%.3f vs $%.3f (%+.0f%%)" % (pt, rt, 100 * (pt - rt) / rt))
    if ps and rs:
        notes.append("ledger cost per merged slice $%.1f vs $%.1f (%+.0f%%)" % (ps, rs, 100 * (ps - rs) / rs))
    # Report-only (2026-11-27, docs/DECISIONS.md "progress per credit"): what the figures above leave
    # out. Never a guard and never the label: the pre-registered reading stays as registered.
    if unmerged or uc:
        notes.append("unmerged at analysis (excluded above): phased %d ($%.1f), control %d ($%.1f)"
                     % (len(unmerged), sum(m["ledger_cost"] or 0 for m in unmerged),
                        len(uc), sum(m["ledger_cost"] or 0 for m in uc)))
    if guard or (ps and rs and ps > 1.15 * rs):
        label = "LEANING-REVERT"
    elif pc and rc and pc <= 0.75 * rc and (not (ps and rs) or ps <= 1.10 * rs):
        label = "LEANING-ADOPT"
    else:
        label = "INCONCLUSIVE"
    return label, notes, guard


def due(ctx, rows=None, ledger=None):
    rows = ctx.rows() if rows is None else rows
    if any(r.get("kind") == "analysis" for r in rows):
        return False, "already analysed"
    cfg = ctx.cfg()
    a = assigned(rows)
    if not a:
        return False, "nothing assigned"
    done = completed(ctx, rows, ledger)
    if len(done) >= int(cfg["target_completed"]):
        return True, "%d assigned slices merged" % len(done)
    first = min(epoch(r.get("ts")) or now() for r in a.values())
    if done and now() - first > float(cfg["timeout_days"]) * 86400:
        return True, "timeout: %d merged after %s days" % (len(done), cfg["timeout_days"])
    return False, "%d of %d merged" % (len(done), int(cfg["target_completed"]))


def report(ctx):
    rows, ledger = ctx.rows(), ctx.ledger()
    cfg = ctx.cfg()
    pricing = _price(os.path.join(ctx.mem, "mr-budget-config.json"))
    try:
        res = [json.loads(l) for l in open(os.path.join(ctx.mem, "mr-residuals.jsonl"), errors="replace") if l.strip()]
    except Exception:
        res = []
    a = assigned(rows)
    start_e = min([epoch(r.get("ts")) or now() for r in a.values()] or [now()])
    ms = []
    for s, r in a.items():
        m = slice_metrics(ctx, s, epoch(r.get("ts")) or 0, rows, ledger, pricing, res)
        ms.append(dict(m, arm=r.get("arm"), tier=r.get("tier")))
    base = baseline(ctx, start_e, ledger, pricing, res)
    phased = [m for m in ms if m["arm"] == "phased"]
    control = [m for m in ms if m["arm"] == "control"]
    base_tiers = [b for b in base if b["tier"] in {m["tier"] for m in phased}] or base
    label, notes, guard = verdict(phased, control, base_tiers, timed_out=due(ctx, rows, ledger)[1].startswith("timeout"))
    cols = ("slice", "arm", "tier", "merged", "ledger_cost", "launches", "parks", "red_fix_cycles", "residuals", "defers",
            "main_sessions", "main_turns", "main_cost", "main_cost_per_turn", "ctx_median", "ctx_p90", "ctx_max")
    lines = ["# Phase-split A/B — analysis %s" % iso(now()), "",
             "Pre-registered reading (mr-phase-ab `verdict`, merged slices only): **%s** — assigned %d phased, %d control; %d baseline slices "
             "(baseline = last 30 merged before %s, same tiers as the phased arm). With n this small the reading is a "
             "leaning; read the runs before deciding." % (label, len(phased), len(control), len(base_tiers), iso(start_e)), ""]
    lines += ["- " + n for n in notes] + ["- GUARDRAIL: " + g for g in guard] + [""]
    lines += ["| " + " | ".join(cols) + " |", "|" + "---|" * len(cols)]
    for m in ms + [dict(b, arm="baseline") for b in base_tiers]:
        lines.append("| " + " | ".join(str(m.get(c)) for c in cols) + " |")
    lines += ["", "Per phase (phased arm): " + "; ".join("%s %s" % (m["slice"], json.dumps(m["per_phase"])) for m in phased), "",
              "In flight at analysis (not in the reading): " + (", ".join(m["slice"] for m in ms if not m["merged"]) or "none"), "",
              "Excluded from the experiment (not in the reading or the counts): "
              + ("; ".join("%s — %s" % kv for kv in sorted(excluded(rows).items())) or "none"), "",
              "Next: the experiment is now disabled (a `disabled` row in mr-phase-ab.jsonl). Make the changes this analysis "
              "recommends, then start a fresh experiment by raising `generation` in mr-phase-ab.json (the old rows stay as history).", "",
              "Held for this experiment (docs/DECISIONS.md, \"judged by genuine progress on the game per credit\"): the "
              "brief and milestone-prompt wording in %s. The supervisor was queued to merge it when this analysis was "
              "recorded; it must land before a new generation starts." % (cfg.get("held_pr") or "the held-wording PR")]
    return label, "\n".join(lines) + "\n", {"phased": phased, "control": control, "baseline_n": len(base_tiers), "cfg": cfg}


HELD_EVENT = """# EVENT phase-ab-held-changes
Operator-approved 2026-11-27 (docs/DECISIONS.md, "judged by genuine progress on the game per credit"):
the phase-split trial's analysis is recorded, so the wording held back for it lands now, before
new launches this tick. It is %(pr)s (draft).
1. `gh pr ready %(num)s -R %(repo)s`.
2. If it is behind main or conflicts, update its branch, resolving only the conflict and keeping
   both sides' meaning. Never change its wording otherwise.
3. Audit it `--doc-only` like any doc-only harness PR, then squash-merge it.
4. If it cannot merge cleanly, file `mr-ask-drew phase-ab-held-changes` with what blocks it; do
   not improvise the wording.
"""


def write_held_event(mem, held):
    """Queue the merge of the PR the operator held for this experiment (cfg `held_pr`,
    "owner/repo#N"). A pending event, so the next decision tick runs it whatever its source."""
    repo, _, num = held.rpartition("#")
    if not num.isdigit():
        return
    d = os.path.join(mem, "pending-events")
    try:
        os.makedirs(d, exist_ok=True)
        with open(os.path.join(d, "phase-ab-held-changes.md"), "w") as fh:
            fh.write(HELD_EVENT % {"pr": held, "num": num, "repo": repo or "mdrewt/claude-harness"})
    except OSError:
        pass


def cmd_analyze(ctx, apply_):
    ok, why = due(ctx)
    if not ok:
        print("PHASE-AB-NOT-DUE %s" % why)
        return 0
    label, md, _ = report(ctx)
    if not apply_:
        sys.stdout.write(md)
        print("PHASE-AB-DUE %s (dry: nothing written)" % why)
        return 0
    lk = ctx.lock()
    try:
        if any(r.get("kind") == "analysis" for r in ctx.rows()):
            print("PHASE-AB-NOT-DUE already analysed")
            return 0
        d = os.path.join(ctx.mem, "phase-ab")
        os.makedirs(d, exist_ok=True)
        path = os.path.join(d, "analysis-%s.md" % iso(now()).replace(":", ""))
        open(path, "w").write(md)
        ctx.append({"kind": "analysis", "path": path, "label": label, "why": why})
        ctx.append({"kind": "disabled", "reason": "analysis recorded (%s); disabled until its recommended changes are made" % label})
        held = ctx.cfg().get("held_pr")
        if held and os.environ.get("MR_PHASE_AB_NO_NOTIFY") != "1":
            write_held_event(ctx.mem, str(held))
    finally:
        lk.close()
    print("PHASE-AB-ANALYZED %s %s -> %s" % (label, why, path), flush=True)
    if os.environ.get("MR_PHASE_AB_NO_NOTIFY") != "1":
        q = ("The phase-split A/B reached its limit (%s) and is now disabled. Reading: %s. Analysis: %s. "
             "What changes should be made before phased runs are re-enabled (or should they stay off)? The brief and "
             "milestone-prompt wording held for this experiment can land now (see the analysis's last line)." % (why, label, path))
        for cmd in ([os.path.join(ctx.mem, "mr-ask-drew"), "phase-ab-analysis", "--repo", "mdrewt/claude-harness", "--question", q,
                     "--recommend", "Read %s; adopt only what the per-slice table supports" % path],
                    [os.path.join(ctx.mem, "mr-record"), "handoff", "--title", "Phase-split A/B analysed: %s (experiment disabled)" % label,
                     "--body", "%s. Report: %s" % (why, path)]):
            try:   # detached: the tick's own timeout must not cut the notice off; each bounded to 90s
                subprocess.Popen(["timeout", "90"] + cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                 stderr=subprocess.DEVNULL, start_new_session=True)
            except Exception:
                pass
    return 0


def cmd_status(ctx, as_json):
    rows = ctx.rows()
    a = assigned(rows)
    done = completed(ctx, rows)
    st = {"enabled": ctx.enabled(rows), "assigned": {s: {"arm": r.get("arm"), "tier": r.get("tier"), "ts": r.get("ts"),
                                                          "merged": s in done, "phase": cmd_current(ctx, s)} for s, r in a.items()},
          "due": due(ctx, rows)[1]}
    print(json.dumps(st, indent=1) if as_json else "PHASE-AB enabled=%s assigned=%d merged=%d (%s)" % (st["enabled"], len(a), len(done), st["due"]))
    return 0


def _arg(argv, name):
    return argv[argv.index(name) + 1] if name in argv and argv.index(name) + 1 < len(argv) else ""


def main(argv, ctx=None):
    ctx = ctx or Ctx()
    cmd = argv[0] if argv else ""
    s, ph = _arg(argv, "--slice"), _arg(argv, "--phase")
    if cmd in ("assign", "current", "started", "next", "start", "session", "prompt") and not SLICE_RE.match(s or ""):
        print("off" if cmd == "assign" else "")
        return 0
    if cmd == "assign":
        print(cmd_assign(ctx, s, _arg(argv, "--repo"), _arg(argv, "--tier")))
    elif cmd == "current":
        print(cmd_current(ctx, s))
    elif cmd == "started":
        print(cmd_started(ctx, s))
    elif cmd == "next":
        print(cmd_next(ctx, s))
    elif cmd == "start" and ph in PHASES:
        ctx.append({"kind": "start", "slice": s, "phase": ph})
    elif cmd == "session" and re.fullmatch(r"[0-9a-fA-F-]{8,64}", _arg(argv, "--sid") or ""):
        sid = _arg(argv, "--sid")
        if not any(r.get("kind") == "session" and r.get("slice") == s and r.get("sid") == sid for r in ctx.rows()):
            ctx.append({"kind": "session", "slice": s, "phase": ph or "all", "sid": sid})
    elif cmd == "prompt":
        sys.stdout.write(cmd_prompt(ctx, s, ph))
    elif cmd == "exclude":   # operator correction: --slice S --why T (recorded, never deleted)
        why = _arg(argv, "--why") or ""
        rows = ctx.rows()
        if not SLICE_RE.match(s or "") or not why or s not in assigned(rows):
            print("PHASE-AB-EXCLUDE-REFUSED need an assigned --slice and a --why")
        else:
            ctx.append({"kind": "exclude", "slice": s, "why": why})
            print("PHASE-AB-EXCLUDED %s" % s)
    elif cmd == "status":
        cmd_status(ctx, "--json" in argv)
    elif cmd == "analyze":
        cmd_analyze(ctx, "--apply" in argv)
    return 0


def selftest():
    bad = []

    def check(name, cond):
        if not cond:
