"""mr-phase-ab — the phase-split experiment: assignment, phase state, prompts, analysis.

WHY (operator item 2, 2026-11-26)
---------------------------------
A build session's main thread was 59% of build spend, its context averaged 275k tokens a turn and
87% of its cost was re-reading that context. Phased runs end the session at two boundaries
(plan+red tests | build | lens batch+gate+PR) and start a fresh one from a written handoff
(memory/projects/mr-phase-protocol.md), expecting a 60–300k context. The operator limited the A/B
to the first ~5 slices completed after it shipped: the analysis is recorded as soon as they are
merged, and the experiment then disables itself until the changes the analysis recommends are made.

STATE
-----
  mr-phase-ab.json   (tracked)   {enabled, target_completed, max_assigned, timeout_days, started_utc}
  mr-phase-ab.jsonl  (gitignored, append-only) rows: assign | start | session | analysis | disabled
  phase-ab/analysis-<utc>.md (gitignored)  the recorded analysis
  $MEM/monster-realm-<slice>-phase.md     the run's handoff; line 1 `NEXT-PHASE: build|finish`
The experiment is OFF once the config says enabled=false or any `disabled` row exists: the
runtime switch lives in the gitignored jsonl so the tool never dirties a tracked file.

COMMANDS (all print one line unless noted; ALWAYS rc 0 except --selftest failures)
  assign  --slice S --repo R [--tier T]  -> phased | control | off   (flock; a slice keeps its arm)
          Eligible: repo=project, not ci-fix-*/close-*/rv-*, spec `type:` feature or absent;
          while < max_assigned assigned and the target is not reached. Alternates within a tier,
          phased first.
  current --slice S        -> the phase to run now: plan | build | finish
  started --slice S        -> the phase whose session last started, or nothing
  next    --slice S        -> the phase to advance to, or nothing: a handoff written after the
                              current phase started that names a later phase
  start   --slice S --phase P            record that a new session for P started
  session --slice S --phase P --sid ID   record a session id (both arms; for the analysis)
  prompt  --slice S --phase P            the protocol text for that phase (multi-line)
  status  [--json]
  analyze [--apply]        when due: the report (+ with --apply: write it, disable the experiment,
                           file a non-blocking mr-ask-drew issue and a handoff entry)
"""
import datetime
import fcntl
import glob
import json
import os
import re
import statistics
import subprocess
import sys
import tempfile
import time

# SELF-LOCATING (like mr-selfcheck): the experiment's state lives beside the copy that runs, so the
# selfcheck's sandboxed launch exercises a sandboxed copy. The live copy is the main checkout's.
MEM = os.path.dirname(os.path.realpath(os.path.abspath(__file__)))
SPECS = os.path.join(os.path.dirname(os.path.dirname(MEM)), "specs", "monster-realm-v2")
TRANSCRIPTS = os.path.expanduser("~/.claude/projects")
PHASES = ("plan", "build", "finish")
EXCLUDE = ("ci-fix-", "close-", "rv-", "rb-", "lp-")   # loop and residual-fix slices: not the roadmap work measured
SLICE_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,80}$")
DEFAULT_CFG = {"enabled": False, "target_completed": 5, "max_assigned": 6, "timeout_days": 21, "generation": 1}


def now():
    try:
        return float(os.environ["MR_PHASE_AB_NOW"])
    except (KeyError, ValueError):
        return time.time()


def iso(e):
    return datetime.datetime.fromtimestamp(e, datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def epoch(s):
    try:
        return datetime.datetime.strptime(str(s)[:19], "%Y-%m-%dT%H:%M:%S").replace(tzinfo=datetime.timezone.utc).timestamp()
    except Exception:
        return None


class Ctx:
    def __init__(self, mem=MEM, specs=SPECS, transcripts=TRANSCRIPTS):
        self.mem, self.specs, self.transcripts = mem, specs, transcripts
        self.cfg_path = os.path.join(mem, "mr-phase-ab.json")
        self.rows_path = os.path.join(mem, "mr-phase-ab.jsonl")

    def cfg(self):
        try:
            c = json.load(open(self.cfg_path))
            return dict(DEFAULT_CFG, **(c if isinstance(c, dict) else {}))
        except Exception:
            return dict(DEFAULT_CFG)

    def gen(self):
        try:
            return int(self.cfg().get("generation") or 1)
        except (TypeError, ValueError):
            return 1

    def rows(self):
        """This generation's rows only: bumping `generation` in the config starts a fresh experiment."""
        g = self.gen()
        return [r for r in self._all_rows() if int(r.get("gen") or 1) == g]

    def _all_rows(self):
        out = []
        try:
            for line in open(self.rows_path, errors="replace"):
                try:
                    r = json.loads(line)
                    if isinstance(r, dict):
                        out.append(r)
                except Exception:
                    continue
        except OSError:
            pass
        return out

    def append(self, row):
        row = dict(row, ts=iso(now()), v=1, gen=self.gen())
        with open(self.rows_path, "a") as fh:
            fh.write(json.dumps(row, sort_keys=True) + "\n")
        return row

    def lock(self):
        fh = open(self.rows_path + ".lock", "a")
        fcntl.flock(fh, fcntl.LOCK_EX)
        return fh

    def enabled(self, rows=None):
        rows = self.rows() if rows is None else rows
        return bool(self.cfg().get("enabled")) and not any(r.get("kind") == "disabled" for r in rows)

    def handoff(self, slice_):
        return os.path.join(self.mem, "monster-realm-%s-phase.md" % slice_)

    def ledger(self):
        out = []
        try:
            for line in open(os.path.join(self.mem, "monster-realm-usage-ledger.jsonl"), errors="replace"):
                try:
                    r = json.loads(line)
                    if isinstance(r, dict) and r.get("ts"):
                        out.append(r)
                except Exception:
                    continue
        except OSError:
            pass
        return out


def spec_type(ctx, slice_):
    """The slice's `type:` from its spec section, '' when the section has none, None when no section."""
    head = re.compile(r"^###\s+%s(\s|$)" % re.escape(slice_))
    for p in sorted(glob.glob(os.path.join(ctx.specs, "*.md"))):
        try:
            lines = open(p, errors="replace").read().split("\n")
        except OSError:
            continue
        for i, line in enumerate(lines):
            if head.match(line):
                for nxt in lines[i + 1:i + 8]:
                    if nxt.startswith("### "):
                        break
                    m = re.search(r"\btype:\s*([a-z-]+)", nxt)
                    if m:
                        return m.group(1)
                return ""
    return None


def excluded(rows):
    """{slice: why} for slices taken out of the experiment (`exclude` rows): a slice whose arm did not
    describe how it was built, so its figures would misread the arm."""
    return {r["slice"]: r.get("why", "") for r in rows if r.get("kind") == "exclude" and r.get("slice")}


def assigned(rows):
    out = {}
    ex = excluded(rows)
    for r in rows:
        if r.get("kind") == "assign" and r.get("slice") and r["slice"] not in out and r["slice"] not in ex:
            out[r["slice"]] = r
    return out


RAN = ("FINISHED", "CRASHED", "PARKED")


def ran_before(ctx, slice_):
    """True when a build session of this slice already ran: a fix or credit-stop resume of work
    begun before it was assigned is not a launch the experiment can describe (2026-11-27: lpw-32,
    built unphased, was assigned `phased` on its CI-fix resume)."""
    return any(r.get("slice") == slice_ and str(r.get("outcome", "")).upper().startswith(RAN) for r in ctx.ledger())


def completed(ctx, rows, ledger=None):
    """{slice: MERGED row} for assigned slices merged after their assignment."""
    ledger = ctx.ledger() if ledger is None else ledger
    out = {}
    for s, a in assigned(rows).items():
        t0 = epoch(a.get("ts")) or 0
        for r in ledger:
            if r.get("slice") == s and str(r.get("outcome", "")).upper().startswith("MERGED") and (epoch(r.get("ts")) or 0) >= t0:
                out[s] = r
                break
    return out


def cmd_assign(ctx, slice_, repo, tier):
    if not SLICE_RE.match(slice_ or ""):
        return "off"
    lk = ctx.lock()
    try:
        rows = ctx.rows()
        if slice_ in excluded(rows):
            return "off"
        have = assigned(rows).get(slice_)
        if have:
            return have.get("arm", "off")
        if not ctx.enabled(rows):
            return "off"
        cfg = ctx.cfg()
        if repo != "project" or slice_.startswith(EXCLUDE):
            return "off"
        t = spec_type(ctx, slice_)
        if t is None or t not in ("", "feature"):
            return "off"
        if ran_before(ctx, slice_):
            return "off"
        a = assigned(rows)
        if len(a) >= int(cfg["max_assigned"]) or len(completed(ctx, rows)) >= int(cfg["target_completed"]):
            return "off"
        tier = tier or "routine"
        same = [r for r in a.values() if r.get("tier") == tier]
        p = sum(1 for r in same if r.get("arm") == "phased")
        arm = "phased" if p <= len(same) - p else "control"
        ctx.append({"kind": "assign", "slice": slice_, "arm": arm, "tier": tier})
        return arm
    finally:
        lk.close()


def _phase_state(ctx, slice_, rows=None):
    rows = ctx.rows() if rows is None else rows
    starts = [r for r in rows if r.get("kind") == "start" and r.get("slice") == slice_ and r.get("phase") in PHASES]
    cur = starts[-1]["phase"] if starts else None
    t0 = (epoch(starts[-1]["ts"]) or 0) if starts else 0
    adv = None
    try:
        hp = ctx.handoff(slice_)
        first = open(hp, errors="replace").readline().strip()
        m = re.match(r"^NEXT-PHASE:\s*(build|finish)\s*$", first)
        if m and os.path.getmtime(hp) >= t0 - 1:
            want = m.group(1)
            if cur is None or PHASES.index(want) > PHASES.index(cur):
                adv = want
    except OSError:
        pass
    return cur, adv


def cmd_started(ctx, slice_):
    cur, _ = _phase_state(ctx, slice_)
    return cur or ""


def cmd_current(ctx, slice_):
    cur, adv = _phase_state(ctx, slice_)
    return adv or cur or "plan"


def cmd_next(ctx, slice_):
    cur, adv = _phase_state(ctx, slice_)
    if cur is None:
        return ""
    return adv or ""


def cmd_prompt(ctx, slice_, phase):
    if phase not in PHASES or not SLICE_RE.match(slice_ or ""):
        return ""
    try:
        text = open(os.path.join(ctx.mem, "mr-phase-protocol.md")).read()
    except OSError:
        return ""
    return text.replace("<SLICE>", slice_).replace("<PHASE>", phase)


