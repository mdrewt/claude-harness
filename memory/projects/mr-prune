class Fail(Exception):
    """A usage error or an input that cannot be read: PRUNE-ERROR, rc=2."""


class LexError(Exception):
    pass


# ---------------------------------------------------------------------------------------------
# Lexers. A token is (kind, text, offset); text is the exact source slice, so two token sequences
# are equal only when the sources differ in comments and in whitespace between tokens.
# ---------------------------------------------------------------------------------------------
def _alternation(operators):
    return "|".join(re.escape(op) for op in sorted(operators, key=len, reverse=True))


TS_MASTER = re.compile(
    r"(?P<ws>\s+)"
    r"|(?P<lc>//[^\n\r  ]*)"
    r"|(?P<bc>/\*.*?\*/)"
    r"|(?P<id>[A-Za-z_$\u0080-\U0010ffff][\w$\u0080-\U0010ffff]*)"
    r"|(?P<num>(?:0[xXbBoO]\w+|(?:\d[\d_]*\.?[\d_]*|\.\d[\d_]*)(?:[eE][+-]?\d+)?)n?)"
    r"|(?P<str>'(?:[^'\\\n]|\\.)*'|\"(?:[^\"\\\n]|\\.)*\")"
    r"|(?P<punct>" + _alternation([
        ">>>=", "...", "===", "!==", "**=", "<<=", ">>=", ">>>", "&&=", "||=", "??=", "=>", "==",
        "!=", "<=", ">=", "&&", "||", "??", "?.", "++", "--", "+=", "-=", "*=", "/=", "%=", "&=",
        "|=", "^=", "<<", ">>", "**", "{", "}", "(", ")", "[", "]", ";", ",", "<", ">", "+", "-",
        "*", "/", "%", "&", "|", "^", "!", "~", "?", ":", "=", ".", "@", "#"]) + ")",
    re.S,
)
TS_REGEX = re.compile(r"/(?:[^/\\\n\[]|\\.|\[(?:[^\]\\\n]|\\.)*\])+/\w*")
TS_REGEX_SPAN = 2000    # how far a regex literal is looked for: keeps a line of `/[` linear
TS_TEMPLATE_CHUNK = re.compile(r"(?:[^`\\$]|\\.|\$(?!\{))*", re.S)
# After these words a `/` starts a regex literal, not a division.
TS_REGEX_AFTER_WORD = {"return", "typeof", "case", "in", "of", "delete", "void", "throw", "new",
                       "else", "do", "await", "yield", "instanceof", "default", "extends"}
# After a closing bracket a `/` is read as division. When the same text also scans as a regex
# literal holding one of these, the two readings tokenise differently (a quote opens a string, `//`
# a comment), so the file is refused instead of guessed at.
TS_AMBIGUOUS_REGEX = re.compile(r"['\"`]|//|/\*")


def lex_ts(src):
    toks, n, i = [], len(src), 0
    template = []       # one brace depth per open `${`
    while i < n:
        c = src[i]
        if c == "`" or (c == "}" and template and template[-1] == 0):
            if c == "}":
                template.pop()
            j = TS_TEMPLATE_CHUNK.match(src, i + 1).end()
            if j >= n:
                raise LexError("unterminated template")
            if src[j] == "`":
                toks.append(("tpl", src[i:j + 1], i))
                i = j + 1
            else:
                toks.append(("tpl", src[i:j + 2], i))
                template.append(0)
                i = j + 2
            continue
        if c == "/" and src[i + 1:i + 2] not in ("/", "*"):
            regex = TS_REGEX.match(src, i, min(n, i + TS_REGEX_SPAN))
            prev = toks[-1] if toks else None
            if regex and prev and prev[0] == "punct" and prev[1] in (")", "]", "}"):
                if TS_AMBIGUOUS_REGEX.search(regex.group(), 1):
                    raise LexError("`/` after a closing bracket: regex or division")
                regex = None
            elif prev and (prev[0] in ("num", "str", "re")
                           or (prev[0] == "tpl" and prev[1][-1] == "`")    # not after its `${`
                           or (prev[0] == "id" and prev[1] not in TS_REGEX_AFTER_WORD)
                           or (prev[0] == "punct" and prev[1] in ("++", "--"))):
                regex = None
            if regex:
                toks.append(("re", regex.group(), i))
                i = regex.end()
                continue
        m = TS_MASTER.match(src, i)
        if not m:
            raise LexError("unexpected %r" % src[i:i + 12])
        kind = m.lastgroup
        if kind not in ("ws", "lc", "bc"):
            text = m.group()
            if template and kind == "punct":
                if text == "{":
                    template[-1] += 1
                elif text == "}":
                    template[-1] -= 1
            toks.append((kind, text, i))
        i = m.end()
    if template:
        raise LexError("unterminated template")
    return toks


RS_MASTER = re.compile(
    r"(?P<ws>\s+)"
    r"|(?P<lc>//[^\n]*)"
    r"|(?P<raw>(?:br|cr|r)(?P<hashes>#*)\")"
    r"|(?P<str>[bc]?\"(?:[^\"\\]|\\.)*\")"
    r"|(?P<chr>b?'(?:[^'\\\n]|\\(?:u\{[0-9a-fA-F_]+\}|x[0-9a-fA-F]{2}|.))')"
    r"|(?P<life>'[A-Za-z_][A-Za-z0-9_]*)"
    r"|(?P<id>(?:r#)?[A-Za-z_\u0080-\U0010ffff][A-Za-z0-9_\u0080-\U0010ffff]*)"
    r"|(?P<num>0[xob][0-9a-fA-F_]+[a-z0-9]*"
    r"|\d[\d_]*(?:\.(?![.A-Za-z_])[\d_]*)?(?:[eE][+-]?[\d_]+)?[a-z0-9]*)"
    r"|(?P<punct>" + _alternation([
        "<<=", ">>=", "...", "..=", "::", "->", "=>", "==", "!=", "<=", ">=", "&&", "||", "+=",
        "-=", "*=", "/=", "%=", "^=", "&=", "|=", "<<", ">>", "..", "{", "}", "(", ")", "[", "]",
        ";", ",", "<", ">", "+", "-", "*", "/", "%", "&", "|", "^", "!", "~", "?", ":", "=", ".",
        "@", "#", "$"]) + ")",
    re.S,
)


def lex_rs(src):
    toks, n, i = [], len(src), 0
    while i < n:
        if src.startswith("/*", i):      # block comments nest
            depth, i = 1, i + 2
            while depth:
                opens, closes = src.find("/*", i), src.find("*/", i)
                if closes < 0:
                    raise LexError("unterminated block comment")
                if 0 <= opens < closes:
                    depth, i = depth + 1, opens + 2
                else:
                    depth, i = depth - 1, closes + 2
            continue
        m = RS_MASTER.match(src, i)
        if not m:
            raise LexError("unexpected %r" % src[i:i + 12])
        kind = m.lastgroup
        if kind == "raw":
            close = '"' + m.group("hashes")
            j = src.find(close, m.end())
            if j < 0:
                raise LexError("unterminated raw string")
            toks.append(("str", src[i:j + len(close)], i))
            i = j + len(close)
            continue
        if kind not in ("ws", "lc"):
            toks.append((kind, m.group(), i))
        i = m.end()
    return toks


BRACKETS = {"(": ")", "[": "]", "{": "}"}
CLOSERS = frozenset(BRACKETS.values())


def match_brackets(toks):
    """{index of an opening bracket: index of its closer}. The braces of a template's `${ }` are
    part of the template tokens, so they are not seen here."""
    match, stack = {}, []
    for index, (kind, text, _offset) in enumerate(toks):
        if kind != "punct":
            continue
        if text in BRACKETS:
            stack.append(index)
        elif text in CLOSERS:
            if not stack or BRACKETS[toks[stack[-1]][1]] != text:
                raise LexError("unbalanced %s" % text)
            match[stack.pop()] = index
    if stack:
        raise LexError("unclosed %s" % toks[stack[-1]][1])
    return match


# ---------------------------------------------------------------------------------------------
# Tests.
# ---------------------------------------------------------------------------------------------
NAME_SLOT = "\x00"      # stands in a form where the test's name was


class Test:
    """One lexed test. `block` identifies its innermost enclosing block; `form` and `body` are
    tuples of token texts; `index` is its position among the file's lexed tests."""
    __slots__ = ("name", "block", "form", "body", "index")

    def __init__(self, name, block, form, body):
        self.name, self.block, self.form, self.body, self.index = name, block, form, body, 0

    def digest(self):
        return hashlib.sha256(json.dumps([self.form, self.body]).encode("ascii")).hexdigest()[:16]

    def name_dependent(self):
        joined = ("".join(self.form) + "".join(self.body)).lower()
        return any(marker in joined for marker in NAME_DEPENDENT)


def _is(tok, text):
    return tok[0] == "punct" and tok[1] == text


def _word(tok, text):
    return tok[0] == "id" and tok[1] == text


def _texts(toks, a, b):
    return tuple(t[1] for t in toks[a:b])


def _plain_title(toks, a, b):
    """The title when the argument toks[a:b] is one plain string literal, else None."""
    if b - a != 1:
        return None
    kind, text, _offset = toks[a]
    if kind == "str" or (kind == "tpl" and len(text) > 1 and text[0] == "`" and text[-1] == "`"):
        return text[1:-1]
    return None


def _arguments(toks, match, opener):
    """[(start, end)] of the top-level arguments inside the parenthesis at `opener`."""
    args, start, i, close = [], opener + 1, opener + 1, match[opener]
    while i < close:
        if i in match:
            i = match[i]
        elif _is(toks[i], ","):
            args.append((start, i))
            start = i + 1
        i += 1
    if start < close:
        args.append((start, close))
    return args


def _function_literal(toks, match, a, b):
    """(first, end) when the argument toks[a:b] is a function literal: toks[first] is the `{` of a
    block body and `end` its `}`, or toks[first] is the `=>` of an expression body that runs to
    `end`. None for any other argument."""
    i = a + 1 if _word(toks[a], "async") and a + 1 < b else a
    if _word(toks[i], "function"):
        while i < b and not _is(toks[i], "("):
            i += 1
        if i >= b:
            return None
        i = match[i] + 1
        while i < b and not _is(toks[i], "{"):
            i = match.get(i, i) + 1
        return (i, match[i]) if i < b and match[i] == b - 1 else None
    if _is(toks[i], "("):               # an arrow's parameters: one parenthesis or one identifier
        i = match[i] + 1
    elif toks[i][0] == "id":
        i += 1
    else:
        return None
    if i < b and _is(toks[i], ":"):      # a return type
        while i < b and not _is(toks[i], "=>"):
            i = match.get(i, i) + 1
    if i >= b or not _is(toks[i], "=>"):
        return None
    if i + 1 < b and _is(toks[i + 1], "{") and match[i + 1] == b - 1:
        return (i + 1, b - 1)
    return (i, b)


TS_TEST_MODIFIERS = {"each", "for", "skip", "only", "todo", "fails", "concurrent", "sequential",
                     "skipIf", "runIf"}


def _type_arguments(toks, match, i):
    """The index after a `<...>` type-argument list starting at toks[i]; `i` when there is none."""
    if i >= len(toks) or not _is(toks[i], "<"):
        return i
    depth, j = 0, i
    while j < len(toks):
        if toks[j][0] == "punct":
            depth += {"<": 1, ">": -1, ">>": -2, ">>>": -3}.get(toks[j][1], 0)
            j = match.get(j, j)
        j += 1
        if depth <= 0:
            return j
    return i


def tests_ts(src):
    """-> (tests, unparsed). Raises LexError for a file that cannot be tokenised."""
    toks = lex_ts(src)
    match = match_brackets(toks)
    tests, unparsed, n = [], 0, len(toks)
    describes = {}      # index of a body `{` -> title, for a describe written as the rule allows
    describe_calls = set()      # the argument parenthesis of such a describe
    scope = []          # per open bracket: ("describe", title, index) | ("call",) | None
    i = 0
    while i < n:
        kind, text, _offset = toks[i]
        if kind == "punct":
            if text in BRACKETS:
                scope.append(("describe", describes[i], i) if i in describes
                             else ("call",) if i in describe_calls else None)
            elif text in CLOSERS:
                scope.pop()
            i += 1
            continue
        if kind != "id" or text not in ("it", "test", "describe") or (i and _is(toks[i - 1], ".")):
            i += 1
            continue
        # The callee: the word, then `.each(table)` or `.each<T>(table)` for a test, `.sequential`
        # for a describe. Any other modifier is read as far as it goes and is not `plain`.
        j, plain = i + 1, True
        if j + 1 < n and _is(toks[j], ".") and toks[j + 1][0] == "id":
            modifier = toks[j + 1][1]
            j, plain = _type_arguments(toks, match, j + 2), False
            if text == "describe":
                plain = modifier == "sequential"
            elif modifier not in TS_TEST_MODIFIERS:
                i += 1          # a property of something else named `it` or `test`
                continue
            elif modifier == "each" and j < n and _is(toks[j], "("):
                j, plain = match[j] + 1, True
            else:
                while j < n and (_is(toks[j], ".") or toks[j][0] in ("id", "tpl")):
                    j += 1
                if j < n and _is(toks[j], "(") and match[j] + 1 < n and _is(toks[match[j] + 1], "("):
                    j = match[j] + 1
                if j >= n or not _is(toks[j], "("):     # a tagged table whose call is not found
                    unparsed += 1
                    i += 1
                    continue
        if j >= n or not _is(toks[j], "("):
            i += 1
            continue
        opener, close = j, match[j]
        args = _arguments(toks, match, opener)
        title = _plain_title(toks, *args[0]) if args else None
        fn = None       # the callback: the last function literal after the title
        for a, b in reversed(args[1:]):
            fn = _function_literal(toks, match, a, b)
            if fn:
                break
        # A statement directly in a describe body (or the file) whose enclosing brackets, up to
        # the file, are all such describes.
        placed = (all(s is not None for s in scope) and (not scope or scope[-1][0] == "describe")
                  and (i == 0 or toks[i - 1][0] == "punct" and toks[i - 1][1] in ("{", "}", ";")))
        if text == "describe":
            if plain and placed and title is not None and fn and _is(toks[fn[0]], "{"):
                describes[fn[0]] = title
                describe_calls.add(opener)
            i += 1      # walk into the call either way: its tests are found there
            continue
        if not (plain and placed and title is not None and fn):
            unparsed += 1
            i = close + 1
            continue
        outer = [s for s in scope if s[0] == "describe"]
        first, end = fn
        form = (_texts(toks, i, args[0][0]) + (NAME_SLOT,) + _texts(toks, args[0][1], first + 1)
                + _texts(toks, end, close + 1))
        tests.append(Test(" > ".join([s[1] for s in outer] + [title]),
                          outer[-1][2] if outer else -1, form, _texts(toks, first + 1, end)))
        i = close + 1
    return tests, unparsed


RS_QUALIFIERS = {"pub", "async", "const", "unsafe", "extern"}
RS_CFG_TEST = ("#", "[", "cfg", "(", "test", ")", "]")


def _attribute_path(toks, a, b):
    """`#[a::b(...)]` at toks[a:b] -> ["a", "b"]."""
    path = []
    for kind, text, _offset in toks[a + 2:b - 1]:
        if kind == "id":
            path.append(text)
        elif text != "::":
            break
    return path


def _is_test(toks, attrs):
    return any(_attribute_path(toks, a, b)[-1:] == ["test"] for a, b in attrs)


def tests_rs(src):
    """-> (tests, unparsed, inline test modules). Raises LexError."""
    toks = lex_rs(src)
    match = match_brackets(toks)
    tests, unparsed, inline, n = [], 0, 0, len(toks)
    mods = {}           # index of a body `{` -> mod name, for a mod reached through mods only
    scope = []          # per open bracket: ("mod", name, index) | None
    attrs = []          # the pending item's attributes, [(start, end)]
    i = 0
    while i < n:
        kind, text, _offset = toks[i]
        if _is(toks[i], "#") and i + 1 < n and _is(toks[i + 1], "["):
            end = match[i + 1] + 1
            attrs.append((i, end))
            i = end
            continue
        if kind == "id" and text in RS_QUALIFIERS and attrs:
            i += 1
            if text == "pub" and i < n and _is(toks[i], "("):
                i = match[i] + 1
            elif text == "extern" and i < n and toks[i][0] == "str":
                i += 1
            continue
        named = i + 1 < n and toks[i + 1][0] == "id"
        if _word(toks[i], "mod") and named and i + 2 < n and _is(toks[i + 2], "{"):
            if any(_texts(toks, a, b) == RS_CFG_TEST for a, b in attrs):
                inline += 1
            if all(s is not None for s in scope):
                mods[i + 2] = toks[i + 1][1]
            attrs = []
            i += 2
            continue
        if _word(toks[i], "fn") and not named and _is_test(toks, attrs):
            unparsed += 1       # `fn $name` in a macro_rules! body
        if _word(toks[i], "fn") and named:
            j = i + 2
            while j < n and not (_is(toks[j], "{") or _is(toks[j], ";")):
                j = match.get(j, j) + 1
            if j < n and _is(toks[j], "{") and _is_test(toks, attrs):
                if all(s is not None for s in scope):
                    form = (_texts(toks, attrs[0][0], i + 1) + (NAME_SLOT,)
                            + _texts(toks, i + 2, j + 1))
                    tests.append(Test("::".join([s[1] for s in scope] + [toks[i + 1][1]]),
                                      scope[-1][2] if scope else -1, form,
                                      _texts(toks, j + 1, match[j])))
                else:
                    unparsed += 1
                attrs = []
                i = match[j] + 1
                continue
        if kind == "punct":
            if text in BRACKETS:
                scope.append(("mod", mods[i], i) if i in mods else None)
            elif text in CLOSERS:
                scope.pop()
        attrs = []
        i += 1
    return tests, unparsed, inline


def parse_tests(path, data):
    """-> (tests, unparsed count, lexable?) for the bytes of one test file. Names are unique."""
    lang = "ts" if path.endswith(".ts") else "rs"
    try:
        src = data.decode("utf-8")
        tests, unparsed = tests_ts(src) if lang == "ts" else tests_rs(src)[:2]
        if len(tests) + unparsed < len(TEST_LINE[lang].findall(src)):
            raise LexError("fewer declarations than test-shaped lines")
    except Exception:       # whatever one odd file does to the lexer, the report goes on
        return [], len(TEST_LINE[lang].findall(data.decode("utf-8", "replace"))), False
    taken = set()
    for index, t in enumerate(tests):
        name, k = t.name, 1
        while name in taken:
            k += 1
            name = "%s #%d" % (t.name, k)
        taken.add(name)
        t.name, t.index = name, index
    return tests, unparsed, True


def twin_pairs(tests):
    """-> ([(candidate, survivor)], identical-other-scope count), in definition order."""
    pairs, other, seen = [], 0, {}
    for t in tests:
        if t.name_dependent():
            continue
        earlier = seen.setdefault((t.form, t.body), [])
        same_block = [e for e in earlier if e.block == t.block]
        if same_block:
            pairs.append((t, same_block[0]))
        elif earlier:
            other += 1
        earlier.append(t)
    return pairs, other


def protected_token(*texts):
    lowered = [text.lower() for text in texts]
    for token in PROTECTED:
        if any(token in text for text in lowered):
            return token
    return None


# ---------------------------------------------------------------------------------------------
# The inspected repository: object reads at one commit.
# ---------------------------------------------------------------------------------------------
def _git(repo, *args, data=None):
    env = {k: v for k, v in os.environ.items() if not k.startswith("GIT_")}
    env.update(GIT_OPTIONAL_LOCKS="0", GIT_NO_LAZY_FETCH="1")
    try:
        return subprocess.run(["git", "--no-replace-objects", "-C", repo] + list(args), input=data,
                              env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    except OSError as e:
        raise Fail("cannot run git: %s" % e)


def _git_line(repo, *args):
    done = _git(repo, *args)
    return None if done.returncode else done.stdout.decode("utf-8", "replace").strip()


class Snapshot:
    """The regular files of `repo` at `ref`: their paths, and their contents on request."""

    def __init__(self, repo, ref):
        # `git -C` would read an enclosing repository for a directory that is not one itself.
        bare = _git_line(repo, "rev-parse", "--is-bare-repository") if os.path.isdir(repo) else None
        top = bare and _git_line(repo, "rev-parse",
                                 "--absolute-git-dir" if bare == "true" else "--show-toplevel")
        if not top or os.path.realpath(top) != os.path.realpath(repo):
            raise Fail("--repo %s is not the top level of a git repository" % repo)
        self.commit = _git_line(repo, "rev-parse", "--verify", "--quiet", "--end-of-options",
                                ref + "^{commit}")
        if not self.commit or not re.fullmatch(r"[0-9a-f]{40,64}", self.commit):
            raise Fail("--at %s is not a commit in %s" % (ref, repo))
        self.repo, self.blobs = repo, {}
        tree = _git(repo, "ls-tree", "-r", "-z", self.commit)
        if tree.returncode:
            raise Fail("cannot list %s" % self.commit)
        for entry in tree.stdout.split(b"\0"):
            meta, _tab, path = entry.partition(b"\t")
            fields = meta.split()
            if len(fields) == 3 and fields[1] == b"blob" and fields[0] in (b"100644", b"100755"):
                self.blobs[path.decode("utf-8", "surrogateescape")] = fields[2].decode("ascii")

    def read(self, paths):
        """{path: bytes} for the given paths, in one `cat-file --batch`."""
        paths = list(paths)
        if not paths:
            return {}
        request = "".join(self.blobs[p] + "\n" for p in paths).encode("ascii")
        out = _git(self.repo, "cat-file", "--batch", data=request).stdout
        contents, at = {}, 0
        for p in paths:
            eol = out.find(b"\n", at)
            header = out[at:eol].split()
            if eol < 0 or len(header) != 3 or header[1] != b"blob":
                raise Fail("cannot read %s at %s" % (p, self.commit))
            size = int(header[2])
            contents[p] = out[eol + 1:eol + 1 + size]
            at = eol + 1 + size + 1
        return contents


# ---------------------------------------------------------------------------------------------
# Keep file and trend file.
# ---------------------------------------------------------------------------------------------
def keep_path(mem):
    return os.path.join(mem, "mr-prune-keep.json")


def load_keep(mem):
    """-> the keep file's object, {} when the file is absent. Raises ValueError when it is not
    {file: {test: {"hash": str, ...}}}."""
    try:
        with open(keep_path(mem), encoding="utf-8") as fh:
            keep = json.load(fh)
    except FileNotFoundError:
        return {}
    except (OSError, RecursionError) as e:      # JSON and UTF-8 errors are ValueErrors already
        raise ValueError(str(e) or type(e).__name__)
    shaped = isinstance(keep, dict) and all(
        isinstance(tests, dict) and all(
            isinstance(entry, dict) and isinstance(entry.get("hash"), str)
            for entry in tests.values())
        for tests in keep.values())
    if not shaped:
        raise ValueError("not {file: {test: {hash, reason}}}")
    return keep


def keep_or_empty(mem):
    try:
        return load_keep(mem)
    except ValueError as e:
        sys.stderr.write("PRUNE-WARN keep-file %s unreadable (%s): read as empty\n"
                         % (keep_path(mem), e))
        return {}


def is_kept(keep, path, test):
    return keep.get(path, {}).get(test.name, {}).get("hash") == test.digest()


def writable_mem(opts):
    mem = opts.get("mem", HERE)
    if not os.path.isdir(mem):
        raise Fail("--mem %s is not a directory" % mem)
    return mem


def write_file(path, text, repo, append=False):
    """Appends `text` to `path`, or replaces it. Refused when `path`, links followed, is inside
    the inspected repository."""
    inside = os.path.relpath(os.path.realpath(path), os.path.realpath(repo))
    if inside != ".." and not inside.startswith(".." + os.sep):
        raise Fail("%s is inside --repo: this tool writes nothing there" % path)
    tmp = "%s.tmp.%d" % (path, os.getpid())
    try:
        if append:
            os.makedirs(os.path.dirname(path), exist_ok=True)
            with open(path, "a", encoding="utf-8") as fh:
                fh.write(text)
        else:
            with open(tmp, "w", encoding="utf-8") as fh:
                fh.write(text)
            os.replace(tmp, path)
    except OSError as e:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise Fail("cannot write %s: %s" % (path, e))


# ---------------------------------------------------------------------------------------------
# Subcommands.
# ---------------------------------------------------------------------------------------------
def census(snap, keep):
    """-> (totals, rows, counts, unlexable files). A row is (section, file, candidate name,
    survivor name, protected token or None)."""
    totals = {p: {"product-lines": 0, "test-lines": 0, "ratio": None, "test-files": 0, "tests": 0,
                  "unparsed": 0} for p in PACKAGES}
    totals["game-core"]["inline-modules"] = totals["server-module"]["inline-modules"] = 0
    totals["client"].update({"e2e": 0, "test-util": 0})
    totals["out-of-scope"] = {"evals": 0, "sim-harness": 0, "client-wasm": 0}
    tests_of, product_of = {}, {}       # path -> package
    for path in snap.blobs:
        for row, key, pattern in OUT_OF_SCOPE:
            if pattern.match(path):
                totals[row][key] += 1
        for pkg in PACKAGES:
            if TEST_FILE[pkg].match(path):
                tests_of[path] = pkg
            elif PRODUCT_FILE[pkg].match(path):
                product_of[path] = pkg
    contents = snap.read(sorted(tests_of) + sorted(product_of))
    unlexable = []
    for path, pkg in product_of.items():
        totals[pkg]["product-lines"] += contents[path].count(b"\n")
        if path.endswith(".rs"):
            try:
                totals[pkg]["inline-modules"] += tests_rs(contents[path].decode("utf-8"))[2]
            except Exception:       # as in parse_tests: one odd file does not stop the report
                unlexable.append(path)
    rows = []
    counts = {"duplicates": 0, "protected-twins": 0, "identical-other-scope": 0, "kept": 0,
              "unparsed": 0}
    for path in sorted(tests_of):
        package = totals[tests_of[path]]
        tests, unparsed, lexable = parse_tests(path, contents[path])
        if not lexable:
            unlexable.append(path)
        package["test-lines"] += contents[path].count(b"\n")
        package["test-files"] += 1
        package["tests"] += len(tests)
        package["unparsed"] += unparsed
        counts["unparsed"] += unparsed
        pairs, other = twin_pairs(tests)
        counts["identical-other-scope"] += other
        for cand, surv in pairs:
            if is_kept(keep, path, cand):
                counts["kept"] += 1
                continue
            token = protected_token(path, cand.name, surv.name)
            section = "protected-twins" if token else "duplicates"
            counts[section] += 1
            rows.append((section, path, cand.name, surv.name, token))
    for pkg in PACKAGES:
        package = totals[pkg]
        if package["product-lines"]:
            package["ratio"] = float("%.2f" % (package["test-lines"] / package["product-lines"]))
    return totals, rows, counts, sorted(unlexable)


def _quoted(name):
    return json.dumps(name, ensure_ascii=False)


def _shown(path):
    return path if re.fullmatch(r"[A-Za-z0-9_./-]+", path) else json.dumps(path)


def _emit(lines):
    sys.stdout.buffer.write(("\n".join(lines) + "\n").encode("utf-8"))
    sys.stdout.buffer.flush()


def cmd_census(opts):
    repo, label = opts.get("repo", DEFAULT_REPO), opts.get("record")
    mem = opts.get("mem", HERE)
    if label is not None:
        if not label or "\n" in label or "\r" in label:
            raise Fail("--record needs a one-line label")
        mem = writable_mem(opts)
    snap = Snapshot(repo, opts.get("at", DEFAULT_REF))
    totals, rows, counts, unlexable = census(snap, keep_or_empty(mem))
    for path in unlexable:
        sys.stderr.write("PRUNE-WARN unlexable %s\n" % _shown(path))
    out = ["PRUNE-CENSUS " + snap.commit]
    for row in PACKAGES + ("out-of-scope",):
        out.append("totals %s %s" % (row, " ".join(
            "%s=%s" % (k, "n/a" if v is None else "%.2f" % v if k == "ratio" else v)
            for k, v in totals[row].items())))
    for wanted in ("duplicates", "protected-twins"):
        for section, path, cand, surv, token in rows:
            if section == wanted:
                out.append("%s %s :: %s -> %s%s" % (section, _shown(path), _quoted(cand),
                                                    _quoted(surv), " token=" + token if token else ""))
    out.append("counts " + " ".join("%s=%d" % kv for kv in counts.items()))
    if label is not None:
        row = {"label": label, "commit": snap.commit, "totals": totals, "counts": counts}
        write_file(os.path.join(mem, "prune", "trend.jsonl"), json.dumps(row) + "\n", repo,
                   append=True)
        out.append("recorded " + label)
    _emit(out)
    return 0


def _tests_at(opts):
    """-> (tests, lexable?) of --file at --at, or None when it is not a test file there."""
    snap = Snapshot(opts.get("repo", DEFAULT_REPO), opts.get("at", DEFAULT_REF))
    path = opts["file"]
    if path not in snap.blobs or not any(TEST_FILE[p].match(path) for p in PACKAGES):
        return None
    tests, _unparsed, lexable = parse_tests(path, snap.read([path])[path])
    return tests, lexable


def _need(opts, *names):
    for name in names:
        if not opts.get(name):
            raise Fail("--%s is required" % name)


def cmd_twin(opts):
    _need(opts, "file", "test", "survivor")
    found = _tests_at(opts)
    by_name = {t.name: t for t in found[0]} if found else {}
    cand, surv = by_name.get(opts["test"]), by_name.get(opts["survivor"])
    if found is None:
        broken = ["missing"]
    elif not found[1]:
        broken = ["unparsed"]
    elif cand is None or surv is None:
        broken = ["missing"]
    elif cand is surv:
        broken = ["same-test"]
    else:
        broken = [rule for rule, bad in (
            ("block", cand.block != surv.block), ("form", cand.form != surv.form),
            ("body", cand.body != surv.body),
            ("name-dependent", cand.name_dependent() or surv.name_dependent()),
            ("order", cand.index < surv.index)) if bad]
    if broken:
        _emit(["PRUNE-TWIN-FAIL " + " ".join(broken)])
        return 1
    token = protected_token(opts["file"], cand.name, surv.name)
    kept = is_kept(keep_or_empty(opts.get("mem", HERE)), opts["file"], cand)
    _emit(["PRUNE-TWIN-OK" + (" protected=" + token if token else "") + (" kept" if kept else "")])
    return 0


def cmd_keep(opts):
    _need(opts, "file", "test", "reason")
    mem = writable_mem(opts)
    found = _tests_at(opts)
    cand = next((t for t in found[0] if t.name == opts["test"]), None) if found else None
    keep = why = None
    if cand is None:
        why = "missing"
    elif not any(c is cand for c, _survivor in twin_pairs(found[0])[0]):
        why = "not-a-candidate"
    else:
        try:
            keep = load_keep(mem)
        except ValueError:
            why = "keep-file-unreadable"
    if why:
        _emit(["PRUNE-KEEP-FAIL " + why])
        return 1
    keep.setdefault(opts["file"], {})[cand.name] = {"hash": cand.digest(), "reason": opts["reason"]}
    write_file(keep_path(mem), json.dumps(keep, indent=2, sort_keys=True, ensure_ascii=False) + "\n",
               opts.get("repo", DEFAULT_REPO))
    _emit(["PRUNE-KEEP-OK %s :: %s hash=%s" % (_shown(opts["file"]), _quoted(cand.name), cand.digest())])
    return 0


COMMANDS = {
    "census": (cmd_census, ("repo", "at", "mem", "record")),
    "twin": (cmd_twin, ("repo", "at", "mem", "file", "test", "survivor")),
    "keep": (cmd_keep, ("repo", "at", "mem", "file", "test", "reason")),
}


def parse_args(argv):
    """-> (subcommand, {flag: value}). Every flag takes one value."""
    if not argv or argv[0] not in COMMANDS:
        raise Fail("expected one of: census, twin, keep, --selftest")
    sub, opts, i = argv[0], {}, 1
    while i < len(argv):
        name = argv[i][2:] if argv[i].startswith("--") else None
        if name not in COMMANDS[sub][1]:
            raise Fail("%s: unknown argument %r" % (sub, argv[i]))
        if i + 1 >= len(argv):
            raise Fail("%s: --%s needs a value" % (sub, name))
        opts[name] = argv[i + 1]
        try:
            opts[name].encode("utf-8")
        except UnicodeEncodeError:
            raise Fail("%s: --%s is not UTF-8" % (sub, name))
        i += 2
    return sub, opts


def main(argv):
    if argv and argv[0] == "--selftest":
        os.execv("/usr/bin/python3", ["/usr/bin/python3", BATTERY, os.path.abspath(__file__)] + argv[1:])
    try:
        sub, opts = parse_args(argv)
        return COMMANDS[sub][0](opts)
    except Fail as e:
        sys.stderr.write("PRUNE-ERROR %s\n" % e)
        return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
