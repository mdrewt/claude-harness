# ---------------------------------------------------------------------------------------------
# Lexers. A token is (kind, text, offset); text is the exact source slice, so two token sequences
# are equal only when the sources differ in comments and in whitespace between tokens.
# ---------------------------------------------------------------------------------------------
def _alternation(operators):
    return "|".join(re.escape(op) for op in sorted(operators, key=len, reverse=True))


TS_MASTER = re.compile(
    r"(?P<ws>\s+)"
    r"|(?P<lc>//[^\n\r  ]*)"
    r"|(?P<bc>/\*.*?\*/)"
    r"|(?P<id>[A-Za-z_$\u0080-\U0010ffff][\w$\u0080-\U0010ffff]*)"
    r"|(?P<num>(?:0[xXbBoO]\w+|(?:\d[\d_]*\.?[\d_]*|\.\d[\d_]*)(?:[eE][+-]?\d+)?)n?)"
    r"|(?P<str>'(?:[^'\\\n]|\\.)*'|\"(?:[^\"\\\n]|\\.)*\")"
    r"|(?P<punct>" + _alternation([
        ">>>=", "...", "===", "!==", "**=", "<<=", ">>=", ">>>", "&&=", "||=", "??=", "=>", "==",
        "!=", "<=", ">=", "&&", "||", "??", "?.", "++", "--", "+=", "-=", "*=", "/=", "%=", "&=",
        "|=", "^=", "<<", ">>", "**", "{", "}", "(", ")", "[", "]", ";", ",", "<", ">", "+", "-",
        "*", "/", "%", "&", "|", "^", "!", "~", "?", ":", "=", ".", "@", "#"]) + ")",
    re.S,
)
TS_REGEX = re.compile(r"/(?:[^/\\\n\[]|\\.|\[(?:[^\]\\\n]|\\.)*\])+/\w*")
TS_REGEX_SPAN = 2000    # how far a regex literal is looked for: keeps a line of `/[` linear
TS_TEMPLATE_CHUNK = re.compile(r"(?:[^`\\$]|\\.|\$(?!\{))*", re.S)
# After these words a `/` starts a regex literal, not a division.
TS_REGEX_AFTER_WORD = {"return", "typeof", "case", "in", "of", "delete", "void", "throw", "new",
                       "else", "do", "await", "yield", "instanceof", "default", "extends"}
# After a closing bracket a `/` is read as division. When the same text also scans as a regex
# literal holding one of these, the two readings tokenise differently (a quote opens a string, `//`
# a comment), so the file is refused instead of guessed at.
TS_AMBIGUOUS_REGEX = re.compile(r"['\"`]|//|/\*")


def lex_ts(src):
    toks, n, i = [], len(src), 0
    template = []       # one brace depth per open `${`
    while i < n:
        c = src[i]
        if c == "`" or (c == "}" and template and template[-1] == 0):
            if c == "}":
                template.pop()
            j = TS_TEMPLATE_CHUNK.match(src, i + 1).end()
            if j >= n:
                raise LexError("unterminated template")
            if src[j] == "`":
                toks.append(("tpl", src[i:j + 1], i))
                i = j + 1
            else:
                toks.append(("tpl", src[i:j + 2], i))
                template.append(0)
                i = j + 2
            continue
        if c == "/" and src[i + 1:i + 2] not in ("/", "*"):
            regex = TS_REGEX.match(src, i, min(n, i + TS_REGEX_SPAN))
            prev = toks[-1] if toks else None
            if regex and prev and prev[0] == "punct" and prev[1] in (")", "]", "}"):
                if TS_AMBIGUOUS_REGEX.search(regex.group(), 1):
                    raise LexError("`/` after a closing bracket: regex or division")
                regex = None
            elif prev and (prev[0] in ("num", "str", "re")
                           or (prev[0] == "tpl" and prev[1][-1] == "`")    # not after its `${`
                           or (prev[0] == "id" and (prev[1] not in TS_REGEX_AFTER_WORD
                                                    or (len(toks) > 1 and toks[-2][1] in (".", "?."))))
                           or (prev[0] == "punct" and prev[1] in ("++", "--"))):
                regex = None
            if regex:
                toks.append(("re", regex.group(), i))
                i = regex.end()
                continue
        m = TS_MASTER.match(src, i)
        if not m:
            raise LexError("unexpected %r" % src[i:i + 12])
        kind = m.lastgroup
        if kind not in ("ws", "lc", "bc"):
            text = m.group()
            if template and kind == "punct":
                if text == "{":
                    template[-1] += 1
                elif text == "}":
                    template[-1] -= 1
            toks.append((kind, text, i))
        i = m.end()
    if template:
        raise LexError("unterminated template")
    return toks


RS_MASTER = re.compile(
    r"(?P<ws>\s+)"
    r"|(?P<lc>//[^\n]*)"
    r"|(?P<raw>(?:br|cr|r)(?P<hashes>#*)\")"
    r"|(?P<str>[bc]?\"(?:[^\"\\]|\\.)*\")"
    r"|(?P<chr>b?'(?:[^'\\\n]|\\(?:u\{[0-9a-fA-F_]+\}|x[0-9a-fA-F]{2}|.))')"
    r"|(?P<life>'[A-Za-z_][A-Za-z0-9_]*)"
    r"|(?P<id>(?:r#)?[A-Za-z_\u0080-\U0010ffff][A-Za-z0-9_\u0080-\U0010ffff]*)"
    r"|(?P<num>0[xob][0-9a-fA-F_]+[a-z0-9]*"
    r"|\d[\d_]*(?:\.(?![.A-Za-z_])[\d_]*)?(?:[eE][+-]?[\d_]+)?[a-z0-9]*)"
    r"|(?P<punct>" + _alternation([
        "<<=", ">>=", "...", "..=", "::", "->", "=>", "==", "!=", "<=", ">=", "&&", "||", "+=",
        "-=", "*=", "/=", "%=", "^=", "&=", "|=", "<<", ">>", "..", "{", "}", "(", ")", "[", "]",
        ";", ",", "<", ">", "+", "-", "*", "/", "%", "&", "|", "^", "!", "~", "?", ":", "=", ".",
        "@", "#", "$"]) + ")",
    re.S,
)


def lex_rs(src):
    toks, n, i = [], len(src), 0
    while i < n:
        if src.startswith("/*", i):      # block comments nest
            depth, i = 1, i + 2
            while depth:
                opens, closes = src.find("/*", i), src.find("*/", i)
                if closes < 0:
                    raise LexError("unterminated block comment")
                if 0 <= opens < closes:
                    depth, i = depth + 1, opens + 2
                else:
                    depth, i = depth - 1, closes + 2
            continue
        m = RS_MASTER.match(src, i)
        if not m:
            raise LexError("unexpected %r" % src[i:i + 12])
        kind = m.lastgroup
        if kind == "raw":
            close = '"' + m.group("hashes")
            j = src.find(close, m.end())
            if j < 0:
                raise LexError("unterminated raw string")
            toks.append(("str", src[i:j + len(close)], i))
            i = j + len(close)
            continue
        if kind not in ("ws", "lc"):
            toks.append((kind, m.group(), i))
        i = m.end()
    return toks


BRACKETS = {"(": ")", "[": "]", "{": "}"}
CLOSERS = frozenset(BRACKETS.values())


def match_brackets(toks):
    """{index of an opening bracket: index of its closer}. The braces of a template's `${ }` are
    part of the template tokens, so they are not seen here."""
    match, stack = {}, []
    for index, (kind, text, _offset) in enumerate(toks):
        if kind != "punct":
            continue
        if text in BRACKETS:
            stack.append(index)
        elif text in CLOSERS:
            if not stack or BRACKETS[toks[stack[-1]][1]] != text:
                raise LexError("unbalanced %s" % text)
            match[stack.pop()] = index
    if stack:
        raise LexError("unclosed %s" % toks[stack[-1]][1])
    return match


# ---------------------------------------------------------------------------------------------
# Tests.
# ---------------------------------------------------------------------------------------------
NAME_SLOT = "\x00"      # stands in a form where the test's name was
LITERAL_SLOT = "\x01"   # stands in a masked form or body where a literal was
LITERAL_KINDS = frozenset(("str", "tpl", "num", "re", "chr"))


def _masked(toks):
    """The token texts with every literal replaced by LITERAL_SLOT."""
    return tuple(LITERAL_SLOT if kind in LITERAL_KINDS else text for kind, text, _offset in toks)


class Test:
    """One lexed test. `block` identifies its innermost enclosing block; `form` and `body` are
    tuples of token texts; `index` is its position among the file's lexed tests."""
    __slots__ = ("name", "block", "form", "body", "masked", "index")

    def __init__(self, name, block, form, body, masked):
        self.name, self.block, self.form, self.body, self.index = name, block, form, body, 0
        self.masked = masked        # (form, body) with every literal token replaced by LITERAL_SLOT

    def digest(self):
        return hashlib.sha256(json.dumps([self.form, self.body]).encode("ascii")).hexdigest()[:16]

    def name_dependent(self):
        joined = ("".join(self.form) + "".join(self.body)).lower()
        return any(marker in joined for marker in NAME_DEPENDENT)


def _is(tok, text):
    return tok[0] == "punct" and tok[1] == text


def _word(tok, text):
    return tok[0] == "id" and tok[1] == text


def _texts(toks, a, b):
    return tuple(t[1] for t in toks[a:b])


def _plain_title(toks, a, b):
    """The title when the argument toks[a:b] is one plain string literal, else None."""
    if b - a != 1:
        return None
    kind, text, _offset = toks[a]
    if kind == "str" or (kind == "tpl" and len(text) > 1 and text[0] == "`" and text[-1] == "`"):
        return text[1:-1]
    return None


def _arguments(toks, match, opener):
    """[(start, end)] of the top-level arguments inside the parenthesis at `opener`."""
    args, start, i, close = [], opener + 1, opener + 1, match[opener]
    while i < close:
        if i in match:
            i = match[i]
        elif _is(toks[i], ","):
            args.append((start, i))
            start = i + 1
        i += 1
    if start < close:
        args.append((start, close))
    return args


def _function_literal(toks, match, a, b):
    """(first, end) when the argument toks[a:b] is a function literal: toks[first] is the `{` of a
    block body and `end` its `}`, or toks[first] is the `=>` of an expression body that runs to
    `end`. None for any other argument."""
    i = a + 1 if _word(toks[a], "async") and a + 1 < b else a
    if _word(toks[i], "function"):
        while i < b and not _is(toks[i], "("):
            i += 1
        if i >= b:
            return None
        i = match[i] + 1
        while i < b and not _is(toks[i], "{"):
            i = match.get(i, i) + 1
        return (i, match[i]) if i < b and match[i] == b - 1 else None
    if _is(toks[i], "("):               # an arrow's parameters: one parenthesis or one identifier
        i = match[i] + 1
    elif toks[i][0] == "id":
        i += 1
    else:
        return None
    if i < b and _is(toks[i], ":"):      # a return type
        while i < b and not _is(toks[i], "=>"):
            i = match.get(i, i) + 1
    if i >= b or not _is(toks[i], "=>"):
        return None
    if i + 1 < b and _is(toks[i + 1], "{") and match[i + 1] == b - 1:
        return (i + 1, b - 1)
    return (i, b)


TS_TEST_MODIFIERS = {"each", "for", "skip", "only", "todo", "fails", "concurrent", "sequential",
                     "skipIf", "runIf"}


def _type_arguments(toks, match, i):
    """The index after a `<...>` type-argument list starting at toks[i]; `i` when there is none."""
    if i >= len(toks) or not _is(toks[i], "<"):
        return i
    depth, j = 0, i
    while j < len(toks):
        if toks[j][0] == "punct":
            depth += {"<": 1, ">": -1, ">>": -2, ">>>": -3}.get(toks[j][1], 0)
            j = match.get(j, j)
        j += 1
        if depth <= 0:
            return j
    return i


def tests_ts(src):
    """-> (tests, unparsed). Raises LexError for a file that cannot be tokenised."""
    toks = lex_ts(src)
    match = match_brackets(toks)
    tests, unparsed, n = [], 0, len(toks)
    describes = {}      # index of a body `{` -> title, for a describe written as the rule allows
    describe_calls = set()      # the argument parenthesis of such a describe
    scope = []          # per open bracket: ("describe", title, index) | ("call",) | None
    i = 0
    while i < n:
        kind, text, _offset = toks[i]
        if kind == "punct":
            if text in BRACKETS:
                scope.append(("describe", describes[i], i) if i in describes
                             else ("call",) if i in describe_calls else None)
            elif text in CLOSERS:
                scope.pop()
            i += 1
            continue
        if kind != "id" or text not in ("it", "test", "describe") or (i and _is(toks[i - 1], ".")):
            i += 1
            continue
        # The callee: the word, then `.each(table)` or `.each<T>(table)` for a test, `.sequential`
        # for a describe. Any other modifier is read as far as it goes and is not `plain`.
        j, plain = i + 1, True
        if j + 1 < n and _is(toks[j], ".") and toks[j + 1][0] == "id":
            modifier = toks[j + 1][1]
            j, plain = _type_arguments(toks, match, j + 2), False
            if text == "describe":
                plain = modifier == "sequential"
            elif modifier not in TS_TEST_MODIFIERS:
                i += 1          # a property of something else named `it` or `test`
                continue
            elif modifier == "each" and j < n and _is(toks[j], "("):
                j, plain = match[j] + 1, True
            else:
                while j < n and (_is(toks[j], ".") or toks[j][0] in ("id", "tpl")):
                    j += 1
                if j < n and _is(toks[j], "(") and match[j] + 1 < n and _is(toks[match[j] + 1], "("):
                    j = match[j] + 1
                if j >= n or not _is(toks[j], "("):     # a tagged table whose call is not found
                    unparsed += 1
                    i += 1
                    continue
        if j >= n or not _is(toks[j], "("):
            i += 1
            continue
        opener, close = j, match[j]
        args = _arguments(toks, match, opener)
        title = _plain_title(toks, *args[0]) if args else None
        fn = None       # the callback: the last function literal after the title
        for a, b in reversed(args[1:]):
            fn = _function_literal(toks, match, a, b)
            if fn:
                break
        # A statement directly in a describe body (or the file) whose enclosing brackets, up to
        # the file, are all such describes.
        placed = (all(s is not None for s in scope) and (not scope or scope[-1][0] == "describe")
                  and (i == 0 or toks[i - 1][0] == "punct" and toks[i - 1][1] in ("{", "}", ";")))
        if text == "describe":
            if plain and placed and title is not None and fn and _is(toks[fn[0]], "{"):
                describes[fn[0]] = title
                describe_calls.add(opener)
            i += 1      # walk into the call either way: its tests are found there
            continue
        if not (plain and placed and title is not None and fn):
            unparsed += 1
            i = close + 1
            continue
        outer = [s for s in scope if s[0] == "describe"]
        first, end = fn
        pieces = ((i, args[0][0]), (args[0][1], first + 1), (end, close + 1))
        form = _texts(toks, *pieces[0]) + (NAME_SLOT,) + sum((_texts(toks, *p) for p in pieces[1:]), ())
        masked = (_masked(toks[slice(*pieces[0])]) + (NAME_SLOT,)
                  + sum((_masked(toks[slice(*p)]) for p in pieces[1:]), ()))
        tests.append(Test(" > ".join([s[1] for s in outer] + [title]),
                          outer[-1][2] if outer else -1, form, _texts(toks, first + 1, end),
                          (masked, _masked(toks[first + 1:end]))))
        i = close + 1
    return tests, unparsed


RS_QUALIFIERS = {"pub", "async", "const", "unsafe", "extern"}
RS_CFG_TEST = ("#", "[", "cfg", "(", "test", ")", "]")


def _attribute_path(toks, a, b):
    """`#[a::b(...)]` at toks[a:b] -> ["a", "b"]."""
    path = []
    for kind, text, _offset in toks[a + 2:b - 1]:
        if kind == "id":
            path.append(text)
        elif text != "::":
            break
    return path


def _is_test(toks, attrs):
    return any(_attribute_path(toks, a, b)[-1:] == ["test"] for a, b in attrs)


def tests_rs(src):
    """-> (tests, unparsed, inline test modules). Raises LexError."""
    toks = lex_rs(src)
    match = match_brackets(toks)
    tests, unparsed, inline, n = [], 0, 0, len(toks)
    mods = {}           # index of a body `{` -> mod name, for a mod reached through mods only
    scope = []          # per open bracket: ("mod", name, index) | None
    attrs = []          # the pending item's attributes, [(start, end)]
    i = 0
    while i < n:
        kind, text, _offset = toks[i]
        if _is(toks[i], "#") and i + 1 < n and _is(toks[i + 1], "["):
            end = match[i + 1] + 1
            attrs.append((i, end))
            i = end
            continue
        if kind == "id" and text in RS_QUALIFIERS and attrs:
            i += 1
            if text == "pub" and i < n and _is(toks[i], "("):
                i = match[i] + 1
            elif text == "extern" and i < n and toks[i][0] == "str":
                i += 1
            continue
        named = i + 1 < n and toks[i + 1][0] == "id"
        if _word(toks[i], "mod") and named and i + 2 < n and _is(toks[i + 2], "{"):
            if any(_texts(toks, a, b) == RS_CFG_TEST for a, b in attrs):
                inline += 1
            if all(s is not None for s in scope):
                mods[i + 2] = toks[i + 1][1]
            attrs = []
            i += 2
            continue
        if _word(toks[i], "fn") and not named and _is_test(toks, attrs):
            unparsed += 1       # `fn $name` in a macro_rules! body
        if _word(toks[i], "fn") and named:
            j = i + 2
            while j < n and not (_is(toks[j], "{") or _is(toks[j], ";")):
                j = match.get(j, j) + 1
            if j < n and _is(toks[j], "{") and _is_test(toks, attrs):
                if all(s is not None for s in scope):
                    form = (_texts(toks, attrs[0][0], i + 1) + (NAME_SLOT,)
                            + _texts(toks, i + 2, j + 1))
                    masked = (_masked(toks[attrs[0][0]:i + 1]) + (NAME_SLOT,)
                              + _masked(toks[i + 2:j + 1]))
                    tests.append(Test("::".join([s[1] for s in scope] + [toks[i + 1][1]]),
                                      scope[-1][2] if scope else -1, form,
                                      _texts(toks, j + 1, match[j]),
                                      (masked, _masked(toks[j + 1:match[j]]))))
                else:
                    unparsed += 1
                attrs = []
                i = match[j] + 1
                continue
        if kind == "punct":
            if text in BRACKETS:
                scope.append(("mod", mods[i], i) if i in mods else None)
            elif text in CLOSERS:
                scope.pop()
        attrs = []
        i += 1
    return tests, unparsed, inline


def parse_tests(path, data):
    """-> (tests, unparsed count, lexable?) for the bytes of one test file. Names are unique."""
    lang = "ts" if path.endswith(".ts") else "rs"
    try:
        src = data.decode("utf-8")
        tests, unparsed = tests_ts(src) if lang == "ts" else tests_rs(src)[:2]
        if len(tests) + unparsed < len(TEST_LINE[lang].findall(src)):
            raise LexError("fewer declarations than test-shaped lines")
    except Exception:       # whatever one odd file does to the lexer, the report goes on
        return [], len(TEST_LINE[lang].findall(data.decode("utf-8", "replace"))), False
    taken = set()
    for index, t in enumerate(tests):
        name, k = t.name, 1
        while name in taken:
            k += 1
            name = "%s #%d" % (t.name, k)
        taken.add(name)
        t.name, t.index = name, index
    return tests, unparsed, True


def twin_pairs(tests):
    """-> ([(candidate, survivor)], identical-other-scope count), in definition order."""
    pairs, other, seen = [], 0, {}
    for t in tests:
        if t.name_dependent():
            continue
        earlier = seen.setdefault((t.form, t.body), [])
        same_block = [e for e in earlier if e.block == t.block]
        if same_block:
            pairs.append((t, same_block[0]))
        elif earlier:
            other += 1
        earlier.append(t)
    return pairs, other


def protected_token(*texts):
    lowered = [text.lower() for text in texts]
    for token in PROTECTED:
        if any(token in text for text in lowered):
            return token
    return None


def literal_variant_groups(tests):
    """Groups of two or more tests in one block whose form and body are equal once every literal is
    masked and that hold at least two different unmasked bodies: a count."""
    groups = {}
    for t in tests:
        groups.setdefault((t.block, t.masked), set()).add((t.form, t.body))
    return sum(1 for exact in groups.values() if len(exact) >= 2)


# ---------------------------------------------------------------------------------------------
# Orphans: product symbols that only tests name.
# ---------------------------------------------------------------------------------------------
ORPHAN_SOURCE = re.compile(r"^(?:(?:game-core|server-module)/src/.*\.rs|client/src/(?!module_bindings/).*\.ts)$")
# What is not production: names here do not keep a symbol alive.
NOT_PRODUCTION = re.compile(
    r"(?:^|/)(?:tests|benches)/|^client/test-util/|_tests\.rs$|\.test\.ts$|\.(?:md|txt)$")
# Blobs never read for names.
BINARY = re.compile(r"\.(?:png|jpe?g|gif|webp|ico|bmp|wasm|ttf|otf|woff2?|mp3|ogg|wav|zip|gz|pdf)$", re.I)
TS_LIKE = re.compile(r"\.(?:ts|tsx|js|jsx|mjs|cjs)$")
WORD = re.compile(r"[A-Za-z_$][\w$]*")
# An item attribute outside these marks an entry point (reducer, table, wasm export, ...).
PLAIN_ATTRIBUTES = {"doc", "inline", "must_use", "allow", "derive", "cfg_attr"}
TS_SYMBOL_KINDS = {"function", "class", "interface", "type", "enum", "const", "let", "var"}
TS_STATEMENT_START = {"export", "import", "function", "class", "interface", "type", "enum", "const",
                      "let", "var", "declare", "abstract", "async", "namespace", "module"}


class Item:
    """A region of a product file. `kind` is "region" for code that is not a symbol (always live),
    "test" for code compiled only under test (never a reference), "impl" for an impl block (live
    when its self type is), else the item keyword. `names` is every name the region holds."""
    __slots__ = ("kind", "name", "candidate", "test_only", "entry", "names")

    def __init__(self, kind, name=None, names=(), candidate=False, test_only=False, entry=False):
        self.kind, self.name, self.names = kind, name, set(names)
        self.candidate, self.test_only, self.entry = candidate, test_only, entry


def _reached(toks, a, b):
    """The names a use / import / export-from statement at toks[a:b] reaches a symbol through
    without re-exporting it: X of `X as Y`, and X of `X::...` (a path prefix, `Kind::*`)."""
    out = set()
    for i in range(a, b - 1):
        kind, text, _offset = toks[i]
        if kind == "id" and (_is(toks[i + 1], "::") or (
                _word(toks[i + 1], "as") and i + 2 < b and not _word(toks[i + 2], "_"))):
            out.add(text[2:] if text.startswith("r#") else text)
    return out


def _names(toks, a, b, strip):
    """The identifiers of toks[a:b] and the words inside its literals. A statement `strip(i)` says
    ends at an index (None for any other position) adds only the names it reaches through."""
    out, i = set(), a
    while i < b:
        end = strip(i)
        if end is not None:
            out |= _reached(toks, i, end)
            i = end
            continue
        kind, text, _offset = toks[i]
        if kind == "id":
            out.add(text[2:] if text.startswith("r#") else text)
        elif kind in ("str", "tpl", "chr"):
            out.update(WORD.findall(text))
        i += 1
    return out


def _rs_use_end(toks, match, i):
    """The index after a `use ...;` starting at toks[i]; None when toks[i] does not start one."""
    if not _word(toks[i], "use") or (i + 1 < len(toks) and _is(toks[i + 1], "<")):
        return None
    while i < len(toks) and not _is(toks[i], ";"):
        i = match.get(i, i) + 1
    return i + 1


RS_PRIMITIVES = {"str", "bool", "char", "u8", "u16", "u32", "u64", "u128", "usize", "i8", "i16",
                 "i32", "i64", "i128", "isize", "f32", "f64"}


def _rs_self_type(toks, a, b):
    """The name of an impl's self type from the tokens between `impl` and its body; None for a
    type no symbol names (a primitive, slice, tuple), whose impl is then live."""
    depth, start, i = 0, a, a
    while i < b:
        text = toks[i][1]
        if toks[i][0] == "punct":
            depth += {"<": 1, ">": -1, ">>": -2}.get(text, 0)
        elif depth == 0 and text == "for":
            start = i + 1
        elif depth == 0 and text == "where":
            b = i
            break
        i += 1
    depth, name = 0, None
    for kind, text, _offset in toks[start:b]:
        if kind == "punct":
            depth += {"<": 1, ">": -1, ">>": -2}.get(text, 0)
            if depth == 0 and text in ("(", "["):
                return None
        elif kind == "id" and depth == 0 and text not in ("dyn", "mut", "crate", "super", "self", "impl"):
            name = text
    return None if name in RS_PRIMITIVES else name


def rs_items(toks, match, a, b, items):
    """Appends the items of toks[a:b], a module body, to `items`."""
    strip = lambda i: _rs_use_end(toks, match, i)
    i = a
    while i < b:
        start, attrs = i, []
        while i + 1 < b and _is(toks[i], "#") and (_is(toks[i + 1], "[") or _is(toks[i + 1], "!")):
            bracket = i + 1 if _is(toks[i + 1], "[") else i + 2
            if bracket >= b or not _is(toks[bracket], "["):
                break
            if bracket == i + 1:
                attrs.append((i, match[bracket] + 1))
            i = match[bracket] + 1
        if i >= b:
            break
        test_only = any(_texts(toks, x, y) == RS_CFG_TEST for x, y in attrs)
        entry = any((_attribute_path(toks, x, y) or [""])[0] not in PLAIN_ATTRIBUTES
                    for x, y in attrs if _texts(toks, x, y) != RS_CFG_TEST)
        public = _word(toks[i], "pub")
        if public:
            i += 1
            if i < b and _is(toks[i], "("):
                i = match[i] + 1
        while i + 1 < b and toks[i][0] == "id" and (
                toks[i][1] in ("async", "unsafe", "default")
                or (toks[i][1] == "const" and toks[i + 1][0] == "id"
                    and toks[i + 1][1] in ("fn", "unsafe", "async", "extern"))
                or (toks[i][1] == "extern" and toks[i + 1][0] == "str")):
            i += 2 if toks[i][1] == "extern" else 1
        kind = toks[i][1] if toks[i][0] == "id" else None
        if kind == "use":
            end = strip(i)
            items.append(Item("region", names=_reached(toks, i, end)))
            i = end
            continue
        if kind in ("fn", "struct", "enum", "union", "trait", "mod", "impl"):
            j = i + 1
            while j < b and not (_is(toks[j], "{") or _is(toks[j], ";")):
                j = match.get(j, j) + 1
            end = match[j] + 1 if j < b and _is(toks[j], "{") else j + 1
            if kind == "mod" and j < b and _is(toks[j], "{"):
                if test_only:
                    items.append(Item("test"))
                else:
                    rs_items(toks, match, j + 1, match[j], items)
                i = end
                continue
            name = toks[i + 1][1] if i + 1 < b and toks[i + 1][0] == "id" and kind != "impl" else None
            entry = entry or (kind == "fn" and name == "main")      # a binary's entry point
        elif kind in ("const", "static", "type"):
            j = i + 1
            if j < b and _word(toks[j], "mut"):
                j += 1
            name = toks[j][1] if j < b and toks[j][0] == "id" and toks[j][1] != "_" else None
            entry = entry or name is None       # `const _: () = assert!(...)` runs at compile time
            while j < b and not _is(toks[j], ";"):
                j = match.get(j, j) + 1
            end = j + 1
        else:       # a macro invocation, macro_rules!, an extern item: code that is not a symbol
            j = i
            while j < b and not (toks[j][0] == "punct" and (toks[j][1] in BRACKETS or toks[j][1] == ";")):
                j += 1
            end = match[j] + 1 if j < b and toks[j][1] in BRACKETS else j + 1
            if end < b and _is(toks[end], ";"):
                end += 1
            items.append(Item("test" if test_only else "region", names=_names(toks, start, end, strip)))
            i = max(end, i + 1)
            continue
        names = _names(toks, start, end, strip)
        if name and name.startswith("r#"):
            name = name[2:]
        if test_only:
            items.append(Item("test", name, test_only=bool(name) and kind != "mod"))
        elif kind == "impl":
            items.append(Item("impl", _rs_self_type(toks, i + 1, j), names, entry=entry))
        elif kind == "mod":
            pass        # `mod name;`
        else:
            items.append(Item(kind, name, names, entry=entry, candidate=public and bool(name)))
        i = max(end, i + 1)
    return items


def _ts_newline_before(src, toks, i):
    return i > 0 and "\n" in src[toks[i - 1][2] + len(toks[i - 1][1]):toks[i][2]]


def _ts_statement_end(src, toks, match, i, n):
    """The index after the statement running from toks[i]: through its `;`, or up to a line that
    starts another declaration."""
    j = i
    while j < n:
        if _is(toks[j], ";"):
            return j + 1
        if (j > i and toks[j][0] == "id" and toks[j][1] in TS_STATEMENT_START
                and _ts_newline_before(src, toks, j)):
            return j
        j = match.get(j, j) + 1
    return n


def _ts_module_end(toks, match, i, n):
    """The index after an `import ... 'x'` or `export ... from 'x'` statement at toks[i]; None when
    toks[i] starts neither."""
    if toks[i][0] != "id" or (i and _is(toks[i - 1], ".")):
        return None
    j = i + 1
    if toks[i][1] == "import":
        if j >= n or _is(toks[j], "(") or _is(toks[j], "."):
            return None
        while j < n and not _is(toks[j], ";"):
            if toks[j][0] == "str" and (j == i + 1 or _word(toks[j - 1], "from")):
                break
            j = match.get(j, j) + 1
        else:
            return None
    elif toks[i][1] == "export":
        if j < n and _word(toks[j], "type"):
            j += 1
        if j < n and _is(toks[j], "{"):
            j = match[j] + 1
        elif j < n and _is(toks[j], "*"):
            j += 3 if j + 2 < n and _word(toks[j + 1], "as") else 1
        else:
            return None
        if not (j + 1 < n and _word(toks[j], "from") and toks[j + 1][0] == "str"):
            return None
        j += 1
    else:
        return None
    return j + 2 if j + 1 < n and _is(toks[j + 1], ";") else j + 1


def ts_items(src, toks, match):
    """The top-level statements of a TypeScript product file as items."""
    n, items, i = len(toks), [], 0
    strip = lambda k: _ts_module_end(toks, match, k, n)
    while i < n:
        start = i
        end = strip(i)
        if end is not None:
            items.append(Item("region", names=_reached(toks, i, end)))
            i = end
            continue
        exported = _word(toks[i], "export")
        if exported:
            i += 1
        kind = name = None
        if i < n and toks[i][0] == "id" and toks[i][1] not in ("default", "declare"):
            j = i + 1 if toks[i][1] in ("async", "abstract") else i
            if j < n and _word(toks[j], "const") and j + 1 < n and _word(toks[j + 1], "enum"):
                j += 1
            if j < n and toks[j][0] == "id" and toks[j][1] in TS_SYMBOL_KINDS:
                k = j + 1 + (j + 1 < n and _is(toks[j + 1], "*"))
                if k < n and toks[k][0] == "id":
                    kind, name = toks[j][1], toks[k][1]
                    if kind == "type" and not (k + 1 < n and toks[k + 1][1] in ("=", "<")):
                        kind = name = None
        if kind in ("function", "class", "interface", "enum"):
            j = i
            while j < n and not (_is(toks[j], "{") or _is(toks[j], ";")):
                j = match.get(j, j) + 1
            while j < n and _is(toks[j], "{") and match[j] + 1 < n and _is(toks[match[j] + 1], "{"):
                j = match[j] + 1        # a return type written as an object type
            end = match[j] + 1 if j < n and _is(toks[j], "{") else min(j + 1, n)
        else:
            end = _ts_statement_end(src, toks, match, i, n)
        end = max(end, start + 1)
        names = _names(toks, start, end, strip)
        if kind in ("function", "class", "interface", "enum"):
            items.append(Item(kind, name, names, candidate=exported))
        else:       # an initializer runs at load, and a line it swallowed without `;` runs too
            if name:
                items.append(Item(kind, name, candidate=exported))
            items.append(Item("region", names=names - {name}))
        i = end
    return items


def product_items(path, data):
    """-> (items, names) of one file: `items` its symbols and regions when it is a product file,
    `names` every name it holds outside test code, comments and use/import/export-from statements.
    A file the lexer cannot read has no items and every word of its text as names."""
    try:
        src = data.decode("utf-8")
    except UnicodeDecodeError:
        return [], set(WORD.findall(data.decode("utf-8", "replace")))
    try:
        if path.endswith(".rs"):
            toks = lex_rs(src)
            items = rs_items(toks, match_brackets(toks), 0, len(toks), [])
        elif TS_LIKE.search(path):
            toks = lex_ts(src)
            items = ts_items(src, toks, match_brackets(toks))
        else:
            return [], set(WORD.findall(src))
    except Exception:       # as in parse_tests: one odd file does not stop the report
        return [], set(WORD.findall(src))
    names = set()
    for item in items:
        if item.kind != "test":
            names |= item.names
    return items, names


def orphans_of(path, items, named_elsewhere):
    """-> [(symbol, test-only?)] of one product file: candidates no production file but this one
    names, and that no live region of this file names. `named_elsewhere(name)` says whether
    another production file names it."""
    live, said = set(), set()
    changed = True
    while changed:
        changed = False
        for index, item in enumerate(items):
            if index in live or item.kind == "test":
                continue
            alive = (item.kind == "region" or item.entry
                     or (item.kind == "impl" and (item.name is None or item.name in said
                                                  or named_elsewhere(item.name)))
                     or (item.kind != "impl" and (item.name in said or named_elsewhere(item.name))))
            if alive:
                live.add(index)
                said |= item.names
                changed = True
    out = []
    for index, item in enumerate(items):
        if item.test_only:
            out.append((item.name, True))
        elif item.candidate and index not in live:
            out.append((item.name, False))
    return out


def orphan_rows(contents):
    """-> [(section, file, symbol, test-only?, [test files], token)], one per symbol, over
    `contents`, every file read for names."""
    names_of, items_of = {}, {}
    for path, data in contents.items():
        items, names = product_items(path, data)
        if ORPHAN_SOURCE.match(path) and not NOT_PRODUCTION.search(path):
            items_of[path] = items
        names_of[path] = names
    by_name = {}        # name -> production files naming it
    for path, names in names_of.items():
        if not NOT_PRODUCTION.search(path):
            for name in names:
                by_name.setdefault(name, set()).add(path)
    test_files = sorted(p for p in names_of if any(TEST_FILE[k].match(p) for k in PACKAGES))
    rows, seen = [], set()
    for path in sorted(items_of):
        def elsewhere(name, path=path):
            return bool(by_name.get(name, set()) - {path})
        for symbol, test_only in orphans_of(path, items_of[path], elsewhere):
            if (path, symbol) in seen:      # an overload, or a type and a value of one name
                continue
            seen.add((path, symbol))
            tests = [t for t in test_files if symbol in names_of[t]]
            token = protected_token(path, symbol)
            rows.append(("orphan-protected" if token else "orphans", path, symbol, test_only, tests,
                         token))
    return sorted(rows, key=lambda r: (r[1], r[2]))


# ---------------------------------------------------------------------------------------------
# Signals on test files.
# ---------------------------------------------------------------------------------------------
SOURCE_TEXT = {"include_str", "read_to_string", "readFileSync", "readFile"}
CHURN_WINDOW = 300
CHURN_MAX_LINES = 12


def reads_source(path, data):
    """Whether a test file calls one of SOURCE_TEXT, comments and literals aside."""
    try:
        src = data.decode("utf-8")
        toks = lex_ts(src) if path.endswith(".ts") else lex_rs(src)
        return any(kind == "id" and text in SOURCE_TEXT for kind, text, _offset in toks)
    except Exception:       # unlexable: read the raw words
        return bool(SOURCE_TEXT & set(WORD.findall(data.decode("utf-8", "replace"))))


def subject_of(path):
    """The product file a test file is named for: same directory, stem without the test suffix."""
    if path.endswith("_tests.rs"):
        return path[:-len("_tests.rs")] + ".rs"
    if path.endswith(".test.ts"):
        return path[:-len(".test.ts")] + ".ts"
    return None


def churn_counts(log, test_files):
    """{test file: commits that changed it by CHURN_MAX_LINES lines or fewer and left its subject
    alone}, from `git log -z --format=%x01%H --numstat` text."""
    counts = {}
    for commit in log.split("\x01")[1:]:
        changed = {}
        for entry in commit.split("\0")[1:]:
            fields = entry.lstrip("\n").split("\t", 2)
            if len(fields) == 3:
                added, deleted, path = fields
                changed[path] = (int(added) + int(deleted)
                                 if added.isdigit() and deleted.isdigit() else None)
        for path, lines in changed.items():
            if (path in test_files and lines is not None and lines <= CHURN_MAX_LINES
                    and subject_of(path) not in changed):
                counts[path] = counts.get(path, 0) + 1
    return counts


def widened_counts(mem):
    """{path: rows naming it} over DIR/gates/*.widened.jsonl; a line that is not a JSON object with
    a string `path` is skipped."""
    counts, gates = {}, os.path.join(mem, "gates")
    try:
        names = sorted(n for n in os.listdir(gates) if n.endswith(".widened.jsonl"))
    except OSError:
        return counts
    for name in names:
        try:
            with open(os.path.join(gates, name), encoding="utf-8", errors="replace") as fh:
                lines = fh.read().splitlines()
        except OSError:
            continue
        for line in lines:
            try:
                row = json.loads(line)
            except ValueError:
                continue
            if isinstance(row, dict) and isinstance(row.get("path"), str):
                counts[row["path"]] = counts.get(row["path"], 0) + 1
    return counts


# ---------------------------------------------------------------------------------------------
# --spec: the slices whose `touches:` name a file.
# ---------------------------------------------------------------------------------------------
SLICE_HEADING = re.compile(r"^###\s+(\S+)\s+—\s")


def _glob(entry):
    """A regex for one `touches:` entry: `**` crosses directories, `*` and `?` do not, and an entry
    names everything under it when it is a directory."""
    entry = entry.rstrip("/")
    out, i = "", 0
    while i < len(entry):
        if entry.startswith("**/", i):
            out, i = out + "(?:.*/)?", i + 3
        elif entry.startswith("**", i):
            out, i = out + ".*", i + 2
        elif entry[i] == "*":
            out, i = out + "[^/]*", i + 1
        elif entry[i] == "?":
            out, i = out + "[^/]", i + 1
        else:
            out, i = out + re.escape(entry[i]), i + 1
    return re.compile(out + "(?:/.*)?$")


def spec_touches(text):
    """[(slice id, [pattern])] for each `### <id> — ` heading of a spec, from the first `touches:`
    line under it."""
    slices, current, fenced = [], None, False
    for line in text.splitlines():
        if line.lstrip().startswith("```"):
            fenced = not fenced
        if fenced:
            continue
        heading = SLICE_HEADING.match(line)
        if heading:
            current = [heading.group(1), [], False]
            slices.append(current)
        elif line.startswith("#"):
            current = None
        elif current is not None and not current[2] and line.startswith("touches:"):
            entries = [e.strip().strip("`").strip() for e in line[len("touches:"):].split(",")]
            current[1].extend(_glob(e) for e in entries if e)
            current[2] = True
    return [(sid, patterns) for sid, patterns, _seen in slices]


def slices_naming(slices, files):
    return [sid for sid, patterns in slices if any(p.match(f) for p in patterns for f in files)]


# ---------------------------------------------------------------------------------------------
# --ci: one `gh run list` over the game's master runs.
# ---------------------------------------------------------------------------------------------
CI_FIELDS = ("seconds", "conclusion", "nightly", "reruns_to_green")
CI_BRANCH, CI_WORKFLOW, NIGHTLY_WORKFLOW = "master", "CI", "Nightly"
CI_RUN_LIMIT = 1000
CI_RERUN_WINDOW = 300


def _seconds(run):
    try:
        start, end = (datetime.datetime.fromisoformat(run[k].replace("Z", "+00:00"))
                      for k in ("startedAt", "updatedAt"))
        return int((end - start).total_seconds())
    except (KeyError, AttributeError, TypeError, ValueError):
        return None


def _word_or_none(value):
    return value if isinstance(value, str) and re.fullmatch(r"[A-Za-z_]+", value) else None


def ci_fields(runs, commit):
    """The CI fields from `gh run list` rows, newest first."""
    ci = [r for r in runs if r.get("workflowName") == CI_WORKFLOW]
    own = next((r for r in ci if r.get("headSha") == commit and r.get("status") == "completed"),
               None)
    nightly = next((r for r in runs if r.get("workflowName") == NIGHTLY_WORKFLOW
                    and r.get("status") == "completed"), None)
    reruns = sum(1 for r in ci[:CI_RERUN_WINDOW] if r.get("conclusion") == "success"
                 and isinstance(r.get("attempt"), int) and r["attempt"] >= 2)
    return {"seconds": _seconds(own) if own else None,
            "conclusion": _word_or_none(own.get("conclusion")) if own else None,
            "nightly": _word_or_none(nightly.get("conclusion")) if nightly else None,
            "reruns_to_green": reruns}


def read_ci(repo, commit):
    """The CI fields, all None (with a PRUNE-WARN) when `gh` is not on PATH or does not answer."""
    gh, why = shutil.which("gh"), None
    if not gh:
        why = "gh not on PATH"
    else:
        try:
            done = subprocess.run(
                [gh, "run", "list", "--branch", CI_BRANCH, "--limit", str(CI_RUN_LIMIT), "--json",
                 "workflowName,headSha,status,conclusion,attempt,startedAt,updatedAt"],
                cwd=repo, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                timeout=180)
            runs = json.loads(done.stdout.decode("utf-8")) if not done.returncode else None
            if done.returncode:
                why = "gh exited %d" % done.returncode
            elif not isinstance(runs, list) or not all(isinstance(r, dict) for r in runs):
                why = "gh answered something other than a list of runs"
            else:
                return ci_fields(runs, commit)
        except (OSError, subprocess.TimeoutExpired, ValueError, RecursionError) as e:
            why = "gh failed: %s" % (str(e) or type(e).__name__)
    sys.stderr.write("PRUNE-WARN ci %s: fields are null\n" % why)
    return dict.fromkeys(CI_FIELDS)


# ---------------------------------------------------------------------------------------------
# The inspected repository: object reads at one commit.
# ---------------------------------------------------------------------------------------------
def _git(repo, *args, data=None):
    env = {k: v for k, v in os.environ.items() if not k.startswith("GIT_")}
    env.update(GIT_OPTIONAL_LOCKS="0", GIT_NO_LAZY_FETCH="1")
    try:
        return subprocess.run(["git", "--no-replace-objects", "-C", repo] + list(args), input=data,
                              env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    except OSError as e:
        raise Fail("cannot run git: %s" % e)


def _git_line(repo, *args):
    done = _git(repo, *args)
    return None if done.returncode else done.stdout.decode("utf-8", "replace").strip()


class Snapshot:
    """The regular files of `repo` at `ref`: their paths, and their contents on request."""

    def __init__(self, repo, ref):
        # `git -C` would read an enclosing repository for a directory that is not one itself.
        bare = _git_line(repo, "rev-parse", "--is-bare-repository") if os.path.isdir(repo) else None
        top = bare and _git_line(repo, "rev-parse",
                                 "--absolute-git-dir" if bare == "true" else "--show-toplevel")
        if not top or os.path.realpath(top) != os.path.realpath(repo):
            raise Fail("--repo %s is not the top level of a git repository" % repo)
        self.commit = _git_line(repo, "rev-parse", "--verify", "--quiet", "--end-of-options",
                                ref + "^{commit}")
        if not self.commit or not re.fullmatch(r"[0-9a-f]{40,64}", self.commit):
            raise Fail("--at %s is not a commit in %s" % (ref, repo))
        self.repo, self.blobs = repo, {}
        tree = _git(repo, "ls-tree", "-r", "-z", self.commit)
        if tree.returncode:
            raise Fail("cannot list %s" % self.commit)
        for entry in tree.stdout.split(b"\0"):
            meta, _tab, path = entry.partition(b"\t")
            fields = meta.split()
            if len(fields) == 3 and fields[1] == b"blob" and fields[0] in (b"100644", b"100755"):
                self.blobs[path.decode("utf-8", "surrogateescape")] = fields[2].decode("ascii")

    def read(self, paths):
        """{path: bytes} for the given paths, in one `cat-file --batch`."""
        paths = list(paths)
        if not paths:
            return {}
        request = "".join(self.blobs[p] + "\n" for p in paths).encode("ascii")
        out = _git(self.repo, "cat-file", "--batch", data=request).stdout
        contents, at = {}, 0
        for p in paths:
            eol = out.find(b"\n", at)
            header = out[at:eol].split()
            if eol < 0 or len(header) != 3 or header[1] != b"blob":
                raise Fail("cannot read %s at %s" % (p, self.commit))
            size = int(header[2])
            contents[p] = out[eol + 1:eol + 1 + size]
            at = eol + 1 + size + 1
        return contents


# ---------------------------------------------------------------------------------------------
# Keep file and trend file.
# ---------------------------------------------------------------------------------------------
def keep_path(mem):
    return os.path.join(mem, "mr-prune-keep.json")


def load_keep(mem):
    """-> the keep file's object, {} when the file is absent. Raises ValueError when it is not
    {file: {test: {"hash": str, ...}}}."""
    try:
        with open(keep_path(mem), encoding="utf-8") as fh:
            keep = json.load(fh)
    except FileNotFoundError:
        return {}
    except (OSError, RecursionError) as e:      # JSON and UTF-8 errors are ValueErrors already
        raise ValueError(str(e) or type(e).__name__)
    shaped = isinstance(keep, dict) and all(
        isinstance(tests, dict) and all(
            isinstance(entry, dict) and isinstance(entry.get("hash"), str)
            for entry in tests.values())
        for tests in keep.values())
    if not shaped:
        raise ValueError("not {file: {test: {hash, reason}}}")
    return keep


def keep_or_empty(mem):
    try:
        return load_keep(mem)
    except ValueError as e:
        sys.stderr.write("PRUNE-WARN keep-file %s unreadable (%s): read as empty\n"
                         % (keep_path(mem), e))
        return {}


def is_kept(keep, path, test):
    return keep.get(path, {}).get(test.name, {}).get("hash") == test.digest()


def writable_mem(opts):
    mem = opts.get("mem", HERE)
    if not os.path.isdir(mem):
        raise Fail("--mem %s is not a directory" % mem)
    return mem


def write_file(path, text, repo, append=False):
    """Appends `text` to `path`, or replaces it. Refused when `path`, links followed, is inside
    the inspected repository."""
    inside = os.path.relpath(os.path.realpath(path), os.path.realpath(repo))
    if inside != ".." and not inside.startswith(".." + os.sep):
        raise Fail("%s is inside --repo: this tool writes nothing there" % path)
    tmp = "%s.tmp.%d" % (path, os.getpid())
    try:
        if append:
            os.makedirs(os.path.dirname(path), exist_ok=True)
            with open(path, "a", encoding="utf-8") as fh:
                fh.write(text)
        else:
            with open(tmp, "w", encoding="utf-8") as fh:
                fh.write(text)
            os.replace(tmp, path)
    except OSError as e:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise Fail("cannot write %s: %s" % (path, e))


# ---------------------------------------------------------------------------------------------
# Subcommands.
# ---------------------------------------------------------------------------------------------
class Report:
    """What `census` reads at one commit. `rows` are the twin rows, each (section, file,
    candidate name, survivor name, protected token or None); `contents` every text blob read."""
    __slots__ = ("totals", "rows", "counts", "unlexable", "contents", "test_files",
                 "literal_variants", "source_text")


def census(snap, keep):
    """-> a Report of the snapshot's totals, twins and per-test-file facts."""
    totals = {p: {"product-lines": 0, "test-lines": 0, "ratio": None, "test-files": 0, "tests": 0,
                  "unparsed": 0} for p in PACKAGES}
    totals["game-core"]["inline-modules"] = totals["server-module"]["inline-modules"] = 0
    totals["client"].update({"e2e": 0, "test-util": 0})
    totals["out-of-scope"] = {"evals": 0, "sim-harness": 0, "client-wasm": 0}
    tests_of, product_of = {}, {}       # path -> package
    for path in snap.blobs:
        for row, key, pattern in OUT_OF_SCOPE:
            if pattern.match(path):
                totals[row][key] += 1
        for pkg in PACKAGES:
            if TEST_FILE[pkg].match(path):
                tests_of[path] = pkg
            elif PRODUCT_FILE[pkg].match(path):
                product_of[path] = pkg
    contents = snap.read(sorted(p for p in snap.blobs if not BINARY.search(p)))
    unlexable, literal_variants, source_text = [], {}, set()
    for path, pkg in product_of.items():
        totals[pkg]["product-lines"] += contents[path].count(b"\n")
        if path.endswith(".rs"):
            try:
                totals[pkg]["inline-modules"] += tests_rs(contents[path].decode("utf-8"))[2]
            except Exception:       # as in parse_tests: one odd file does not stop the report
                unlexable.append(path)
    rows = []
    counts = {"duplicates": 0, "protected-twins": 0, "identical-other-scope": 0, "kept": 0,
              "unparsed": 0}
    for path in sorted(tests_of):
        package = totals[tests_of[path]]
        tests, unparsed, lexable = parse_tests(path, contents[path])
        if not lexable:
            unlexable.append(path)
        package["test-lines"] += contents[path].count(b"\n")
        package["test-files"] += 1
        package["tests"] += len(tests)
        package["unparsed"] += unparsed
        counts["unparsed"] += unparsed
        literal_variants[path] = literal_variant_groups(tests)
        if reads_source(path, contents[path]):
            source_text.add(path)
        pairs, other = twin_pairs(tests)
        counts["identical-other-scope"] += other
        for cand, surv in pairs:
            if is_kept(keep, path, cand):
                counts["kept"] += 1
                continue
            token = protected_token(path, cand.name, surv.name)
            section = "protected-twins" if token else "duplicates"
            counts[section] += 1
            rows.append((section, path, cand.name, surv.name, token))
    for pkg in PACKAGES:
        package = totals[pkg]
        if package["product-lines"]:
            package["ratio"] = float("%.2f" % (package["test-lines"] / package["product-lines"]))
    report = Report()
    report.totals, report.rows, report.counts, report.unlexable = totals, rows, counts, sorted(unlexable)
    report.contents, report.test_files = contents, sorted(tests_of)
    report.literal_variants, report.source_text = literal_variants, source_text
    return report


def _quoted(name):
    return json.dumps(name, ensure_ascii=False)


def _shown(path):
    return path if re.fullmatch(r"[A-Za-z0-9_./-]+", path) else json.dumps(path)


def _emit(lines):
    sys.stdout.buffer.write(("\n".join(lines) + "\n").encode("utf-8"))
    sys.stdout.buffer.flush()


def read_spec(path):
    try:
        with open(path, encoding="utf-8") as fh:
            return spec_touches(fh.read())
    except (OSError, ValueError) as e:
        raise Fail("--spec %s cannot be read: %s" % (path, e))


def churn_of(snap, test_files):
    log = _git(snap.repo, "log", "-z", "-n", str(CHURN_WINDOW), "--no-renames", "--no-textconv",
               "--no-ext-diff", "--no-show-signature", "--format=%x01%H", "--numstat", snap.commit)
    if log.returncode:
        raise Fail("cannot read the log of %s" % snap.commit)
    return churn_counts(log.stdout.decode("utf-8", "surrogateescape"), set(test_files))


def cmd_census(opts):
    repo, label = opts.get("repo", DEFAULT_REPO), opts.get("record")
    mem = opts.get("mem", HERE)
    if label is not None:
        if not label or "\n" in label or "\r" in label:
            raise Fail("--record needs a one-line label")
        mem = writable_mem(opts)
    slices = read_spec(opts["spec"]) if "spec" in opts else None
    snap = Snapshot(repo, opts.get("at", DEFAULT_REF))
    report = census(snap, keep_or_empty(mem))
    for path in report.unlexable:
        sys.stderr.write("PRUNE-WARN unlexable %s\n" % _shown(path))

    def scope(*files):
        """The row's ` slices=` suffix under --spec; None when no slice of the spec names a file."""
        if slices is None:
            return ""
        ids = slices_naming(slices, files)
        return " slices=" + ",".join(ids) if ids else None

    out = ["PRUNE-CENSUS " + snap.commit]
    for row in PACKAGES + ("out-of-scope",):
        out.append("totals %s %s" % (row, " ".join(
            "%s=%s" % (k, "n/a" if v is None else "%.2f" % v if k == "ratio" else v)
            for k, v in report.totals[row].items())))
    lines = {}

    def add(section, text, *files):
        suffix = scope(*files)
        if suffix is not None:
            lines.setdefault(section, []).append(text + suffix)

    for section, path, cand, surv, token in report.rows:
        add(section, "%s %s :: %s -> %s%s" % (section, _shown(path), _quoted(cand), _quoted(surv),
                                              " token=" + token if token else ""), path)
    for section, path, symbol, test_only, tests, token in orphan_rows(report.contents):
        add(section, "%s %s :: %s%s tests=%s%s" % (
            section, _shown(path), _quoted(symbol), " test-only" if test_only else "",
            json.dumps(tests, separators=(",", ":")),
            " token=" + token if token else ""), path, *tests)
    churn, widened = churn_of(snap, report.test_files), widened_counts(mem)
    for path in report.test_files:
        if report.literal_variants[path]:
            add("literal-variants", "literal-variants %s groups=%d"
                % (_shown(path), report.literal_variants[path]), path)
        signals = (["source-text"] if path in report.source_text else []) + [
            "%s=%d" % (name, n) for name, n in (("churn", churn.get(path, 0)),
                                                ("widened", widened.get(path, 0))) if n]
        if signals:
            add("signals", "signals %s %s" % (_shown(path), " ".join(signals)), path)
        token = protected_token(path) if path in churn else None
        if token:
            add("protected-churn", "protected-churn %s churn=%d token=%s"
                % (_shown(path), churn[path], token), path)
    for section in ("duplicates", "protected-twins", "orphans", "orphan-protected",
                    "literal-variants", "signals", "protected-churn"):
        out.extend(lines.get(section, []))
    out.append("counts " + " ".join("%s=%d" % kv for kv in report.counts.items()))
    ci = read_ci(repo, snap.commit) if "ci" in opts else None
    if ci is not None:
        out.append("ci " + " ".join("%s=%s" % (k.replace("_", "-"), "null" if v is None else v)
                                     for k, v in ci.items()))
    if label is not None:
        row = {"label": label, "commit": snap.commit, "totals": report.totals,
               "counts": report.counts}
        if ci is not None:
            row["ci"] = ci
        write_file(os.path.join(mem, "prune", "trend.jsonl"), json.dumps(row) + "\n", repo,
                   append=True)
        out.append("recorded " + label)
    _emit(out)
    return 0


def _tests_at(opts):
    """-> (tests, lexable?) of --file at --at, or None when it is not a test file there."""
    snap = Snapshot(opts.get("repo", DEFAULT_REPO), opts.get("at", DEFAULT_REF))
    path = opts["file"]
    if path not in snap.blobs or not any(TEST_FILE[p].match(path) for p in PACKAGES):
        return None
    tests, _unparsed, lexable = parse_tests(path, snap.read([path])[path])
    return tests, lexable


def _need(opts, *names):
    for name in names:
        if not opts.get(name):
            raise Fail("--%s is required" % name)


def cmd_twin(opts):
    _need(opts, "file", "test", "survivor")
    found = _tests_at(opts)
    by_name = {t.name: t for t in found[0]} if found else {}
    cand, surv = by_name.get(opts["test"]), by_name.get(opts["survivor"])
    if found is None:
        broken = ["missing"]
    elif not found[1]:
        broken = ["unparsed"]
    elif cand is None or surv is None:
        broken = ["missing"]
    elif cand is surv:
        broken = ["same-test"]
    else:
        broken = [rule for rule, bad in (
            ("block", cand.block != surv.block), ("form", cand.form != surv.form),
            ("body", cand.body != surv.body),
            ("name-dependent", cand.name_dependent() or surv.name_dependent()),
            ("order", cand.index < surv.index)) if bad]
    if broken:
        _emit(["PRUNE-TWIN-FAIL " + " ".join(broken)])
        return 1
    token = protected_token(opts["file"], cand.name, surv.name)
    kept = is_kept(keep_or_empty(opts.get("mem", HERE)), opts["file"], cand)
    _emit(["PRUNE-TWIN-OK" + (" protected=" + token if token else "") + (" kept" if kept else "")])
    return 0


def cmd_keep(opts):
    _need(opts, "file", "test", "reason")
    mem = writable_mem(opts)
    found = _tests_at(opts)
    cand = next((t for t in found[0] if t.name == opts["test"]), None) if found else None
    keep = why = None
    if cand is None:
        why = "missing"
    elif not any(c is cand for c, _survivor in twin_pairs(found[0])[0]):
        why = "not-a-candidate"
    else:
        try:
            keep = load_keep(mem)
        except ValueError:
            why = "keep-file-unreadable"
    if why:
        _emit(["PRUNE-KEEP-FAIL " + why])
        return 1
    keep.setdefault(opts["file"], {})[cand.name] = {"hash": cand.digest(), "reason": opts["reason"]}
    write_file(keep_path(mem), json.dumps(keep, indent=2, sort_keys=True, ensure_ascii=False) + "\n",
               opts.get("repo", DEFAULT_REPO))
    _emit(["PRUNE-KEEP-OK %s :: %s hash=%s" % (_shown(opts["file"]), _quoted(cand.name), cand.digest())])
    return 0


COMMANDS = {
    "census": (cmd_census, ("repo", "at", "mem", "record", "spec", "ci")),
    "twin": (cmd_twin, ("repo", "at", "mem", "file", "test", "survivor")),
    "keep": (cmd_keep, ("repo", "at", "mem", "file", "test", "reason")),
}


SWITCHES = {"ci"}       # flags that take no value


def parse_args(argv):
    """-> (subcommand, {flag: value}). Every flag but a SWITCHES one takes one value."""
    if not argv or argv[0] not in COMMANDS:
        raise Fail("expected one of: census, twin, keep, --selftest")
    sub, opts, i = argv[0], {}, 1
    while i < len(argv):
        name = argv[i][2:] if argv[i].startswith("--") else None
        if name not in COMMANDS[sub][1]:
            raise Fail("%s: unknown argument %r" % (sub, argv[i]))
        if name in SWITCHES:
            opts[name] = True
            i += 1
            continue
        if i + 1 >= len(argv):
            raise Fail("%s: --%s needs a value" % (sub, name))
        opts[name] = argv[i + 1]
        try:
            opts[name].encode("utf-8")
        except UnicodeEncodeError:
            raise Fail("%s: --%s is not UTF-8" % (sub, name))
        i += 2
    return sub, opts


def main(argv):
    if argv and argv[0] == "--selftest":
        os.execv("/usr/bin/python3", ["/usr/bin/python3", BATTERY, os.path.abspath(__file__)] + argv[1:])
    try:
        sub, opts = parse_args(argv)
        return COMMANDS[sub][0](opts)
    except Fail as e:
        sys.stderr.write("PRUNE-ERROR %s\n" % e)
        return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
