            elif k: notes=why("COST-PARTIAL (%d of %d attempts ended without a result event and the transcript adds nothing; cost is a lower bound)"%(k,n))
        else:
            notes=why("COST-UNKNOWN (no result event in the log and no cost-state in the session transcript; %d of %d attempts ended before reporting)"%(k,n))
        if not a.get("attempts"): a["attempts"]=n
