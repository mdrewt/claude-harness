# ================================ lp-02: --ci normalisation =====================================
CI_VOCAB=("green","red","pending","not-applicable","not-recorded","unknown")
_RED=re.compile(r"\bred\b|\bfail(?:ed|ure|ing|s)?\b|\bbroken\b")
_HEDGE=re.compile(r"\bunverified\b|\bexpected\b|\bassumed\b|\bpresumed\b|\bflak(?:e|ed|y|es)\b"
                  r"|\bcancel(?:led|ed|s)?\b|\bunmerged\b|\bstood\s+down\b|\bpre-merge\b"
                  r"|\bnot\s+verified\b")
_NA_UNIT=re.compile(r"\bno[-_ ]remote[-_ ]ci[a-z0-9._-]*")
_NA=re.compile(r"\bn/a\b|\bnot[-_ ]applicable\b")
_GREEN=re.compile(r"\bgreen\b|\bsuccess(?:ful)?\b|\bpass(?:ed|ing)?\b|\bok\b")
_PENDING=re.compile(r"\bpending\b|\bin[-_ ]?progress\b|\bqueued\b|\brerun[a-z-]*|\bre-run[a-z-]*"
                    r"|\bretry\b|\bretriggered\b|\brunning\b")
_NA_MARK=" \x00na\x00 "

def lp02_normalize_ci(raw):
    """Map an arbitrary --ci onto CI_VOCAB. Returns (value, raw_note_or_None). Never raises.

    Inline on purpose: --ci must never depend on an external process.
    Evaluation is over the WHOLE string: a head-token rule mismapped 21 real rows to `green`,
    headed by 'GREEN (CI wf); Nightly RED (mutation job, ...)' — compound verdicts are HOW reds get
    written here."""
    if not isinstance(raw,str): return ("not-recorded",None)
    t=raw.strip()
    if not t: return ("not-recorded",None)
    low=t.lower(); note=t[:120]
    if _RED.search(low): return ("red",None)        # \bred\b, not a substring: `rerun-triggered`
    if _HEDGE.search(low): return ("unknown",note)  # unverified/flaked/cancelled is not a verdict
    scan=_NA_UNIT.sub(_NA_MARK,low)                 # `no-remote-ci-*` is ONE not-applicable family
    fams=set()
    if _NA_MARK.strip() in scan or _NA.search(scan): fams.add("not-applicable")
    if _GREEN.search(scan): fams.add("green")
    if _PENDING.search(scan): fams.add("pending")
    if len(fams)>=2: return ("unknown",note)        # never collapse a compound verdict
    if len(fams)==1: return (fams.pop(),None)
    return ("unknown",note)

def lp02_is_closing(sl,oc):
    """Does this row CLOSE a slice? (A closing row with no --ci records `not-recorded`.)"""
    if sl=="SUPERVISOR": return False
    if not isinstance(oc,str): return False
    h=oc.strip().upper()
    if h.startswith("CORRECTION"): return False     # accounting reversal, not a close
    return h.startswith(("MERGED","FINISHED","CRASHED","PARKED"))

