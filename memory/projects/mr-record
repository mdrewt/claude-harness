            if not re.match(r"^(opus|sonnet|haiku|fable|escalated:(opus|sonnet|haiku|fable)-to-fable)$", model): model=""
        if run.get("session_id"): notes=why("session=%s"%run["session_id"])
if cost in (None,"","null"):
    cost=None
    # A SUPERVISOR row is the tick's own cost row, so a missing cost there is a gap worth naming.
