#!/bin/bash
# mr-record — validated writes to ledger/handoff. Subcommands:
#   ledger  --run_id X --slice S --outcome O [--cost N|--from-log LOG] [--model M] [--attempts N]
#           [--orch A] [--gating G] [--ci V] [--notes "..."]   (ts auto-UTC; refuses empty slice/outcome; validates JSON)
#   handoff --title T (--body "..." | --body-file F)
#
# lp-02 — SLICE-SIZE DENOMINATOR. When a row CLOSES a slice (MERGED/FINISHED/CRASHED/PARKED, and
# never SUPERVISOR or CORRECTION*), this writer attaches six measured columns plus quality_source:
# files_changed, prod_lines_added, prod_lines_deleted, test_lines_added, ears_criteria_count,
# skills_invoked. They are DERIVED here, at write time, from live ground truth — never backfilled
# by a later pass over historical rows (the ledger is append-only, ADR-0011). Non-closing rows omit
# the keys entirely: the schema already carries 259 distinct keys over 749 rows, and emitting six
# nulls on every `tick-ok` row would make that worse while destroying the reader's row-selection
# rule. Measurement lives in `mr-slice-quality` (which has a real fixture battery); this file only
# calls it, bounded, and NEVER lets a derivation failure become a lost row.
#
# `--ci` is normalised onto the closed vocabulary green|red|pending|not-applicable|not-recorded|
# unknown. It is never rejected: this writer's contract is that a row is never lost, so dying on an
# unmappable value would trade a data-QUALITY problem for a data-LOSS one.
#
# DEPRECATED, still accepted forever (append-only ledger — never break a past reader):
#   --cycles / remote_red_fix_cycles — sums 27 over all 749 rows, 0 over the post-cutover rows,
#   last nonzero 2026-07-20. Dead. Nothing requests it; do not add new call sites.
MEM=/home/mdrewt/projects/ai-apps/claude-harness/memory/projects
# lp-02 helper resolution, tier 2. MEM (and therefore the LEDGER) stays hardcoded on purpose: the
# ledger is a machine SINGLETON and a self-locating MEM would let a worktree copy fork the
# append-only SSOT. Only the HELPER is resolved beside the copy actually being run, so a slice's
# own gate exercises its own mr-slice-quality instead of silently degrading against the main
# checkout's (which is what made an earlier design's dogfood read as a clean pass).
MEM_SELF="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
SUB="${1:?usage: mr-record ledger|handoff ...}"; shift
export MEM MEM_SELF SUB
ARGS_JSON=$(/usr/bin/python3 -c 'import json,sys; print(json.dumps(sys.argv[1:]))' "$@")
export ARGS_JSON
/usr/bin/python3 <<'PY'
import json, os, sys, re, datetime, subprocess
MEM=os.environ["MEM"]; SUB=os.environ["SUB"]; argv=json.loads(os.environ["ARGS_JSON"])
LEDGER=os.environ.get("MR_RECORD_LEDGER") or (MEM+"/monster-realm-usage-ledger.jsonl")
HANDOFF=os.environ.get("MR_RECORD_HANDOFF") or (MEM+"/monster-realm-handoff.md")
def die(m): print("ERROR: "+m); sys.exit(1)
a={}; i=0
while i<len(argv):
    k=argv[i]
    if not k.startswith("--"): die("bad arg "+k)
    if i+1>=len(argv) or argv[i+1].startswith("--"): die("flag "+k+" requires a value")
    v=argv[i+1]
    key=k[2:]
    if key not in ("run_id","slice","outcome","cost","model","attempts","orch","gating","cycles","standdowns","ci","notes","from-log","title","body","body-file"): die("unknown flag --"+key+" (allowed: run_id slice outcome cost model attempts orch gating cycles standdowns ci notes from-log title body body-file)")
    a[key]=v; i+=2
ts=datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
if SUB=="handoff":
    title=a.get("title") or die("--title required")
    body=a.get("body") or (open(a["body-file"]).read() if a.get("body-file") else "")
    with open(HANDOFF,"a") as f:
        f.write(f"\n## {ts} — {title}\n{body.rstrip()}\n")
    print("handoff-appended: "+title); sys.exit(0)
if SUB!="ledger": die("unknown subcommand "+SUB)
slice_=a.get("slice") or die("--slice required")
if slice_=="SUPERVISOR" and os.environ.get("MR_RECORD_WRAPPER")!="1": die("SUPERVISOR rows are wrapper-owned (duplicate written by a decision run 2026-07-25); record outcomes on the SLICE row instead")
outcome=a.get("outcome") or die("--outcome required")
model=a.get("model","")
if model and not re.match(r"^(claude-(opus|sonnet|haiku|fable)[-a-z0-9.]*|opus|sonnet|haiku|fable|escalated:.*|n/a)$", model):
    die("model fails validation: "+model)
cost=a.get("cost")
notes=a.get("notes","")
# C1 guard: if a wrapper-reconcile row already captured this slice's cost (<48h), refuse to double-count
def wrapper_cost_exists(sl):
    import time as _t
    try:
        rows=open(LEDGER).readlines()[-300:]
        for l in rows:
            try: d=json.loads(l)
            except Exception: continue
            if d.get("slice")==sl and d.get("run_id")=="wrapper-reconcile" and d.get("cost_usd"):
                e=datetime.datetime.strptime(str(d.get("ts",""))[:19],"%Y-%m-%dT%H:%M:%S").timestamp()
                if _t.time()-e < 48*3600: return True
    except Exception: pass
    return False
if a.get("from-log") and a.get("run_id")!="wrapper-reconcile" and wrapper_cost_exists(slice_):
    a.pop("from-log",None)
    if cost not in (None,"","null"):
        notes=(notes+" | " if notes else "")+"cost omitted: already captured by wrapper-reconcile row"
        cost=None
if (cost in (None,"","null")) and a.get("from-log") and os.path.exists(a["from-log"]):
    # Cost comes from the mr-cost-sum SSOT. `total_cost_usd` is CUMULATIVE for the emitting
    # session's accumulation run, so the naive sum this replaced overcounted every multi-attempt
    # run (uxd2 recorded $423.65 against a true $165.65) and inflated the governor's d7 by 37%.
    # Invoked via sys.executable rather than the shebang so exec-bit / ENOEXEC / asdf-shim
    # breakage cannot take out a cron-critical path.
    out=None
    try:
        r=subprocess.run([sys.executable, MEM+"/mr-cost-sum", a["from-log"]],
                         capture_output=True, text=True, timeout=60)
        if r.returncode==0: out=r.stdout.strip()
    except Exception: out=None
    if out and out!="-":
        try: cost=round(float(out),4)
        except ValueError: out=None
    # NOTE the empty-string case is deliberately grouped with None: a truncated/zero-byte helper
    # exits 0 with NO stdout, and treating that as "-" would record COST-UNKNOWN, which
    # mr-situation counts as $0 and would let the loop overspend unseen. Only a literal "-"
    # (helper ran and found no result events) means genuine COST-UNKNOWN.
    if out is None or out=="":
        # Helper unavailable/unusable -> fall back to the naive sum, which OVERCOUNTS. That is
        # deliberately the safe direction: an overcount trips SOFT-PAUSE early, whereas leaving
        # cost None counts as $0 in mr-situation:81 and would let the loop overspend unseen.
        # ("-" is NOT this case — it means zero result events, i.e. genuine COST-UNKNOWN.)
        tot=0.0; found=False
        for line in open(a["from-log"], errors="replace"):
            if '"type":"result"' in line:
                try:
                    o=json.loads(line); c=o.get("total_cost_usd")
                    if c is not None: tot+=float(c); found=True
                except Exception: pass
        if found:
            cost=round(tot,4)
            notes=(notes+" | " if notes else "")+"COST-FALLBACK-NAIVE (mr-cost-sum unavailable; may overcount multi-attempt runs)"
if cost in (None,"","null"):
    cost=None
    notes=(notes+" | " if notes else "")+"COST-UNKNOWN (no result event; true spend unrecorded)"
else:
    try: cost=float(cost)
    except ValueError: die("cost not a number")
# ================================ lp-02: slice-size denominator ================================
CI_VOCAB=("green","red","pending","not-applicable","not-recorded","unknown")
CI_COLUMNS=("files_changed","prod_lines_added","prod_lines_deleted","test_lines_added",
            "ears_criteria_count","skills_invoked")
_RED=re.compile(r"\bred\b|\bfail(?:ed|ure|ing|s)?\b|\bbroken\b")
_HEDGE=re.compile(r"\bunverified\b|\bexpected\b|\bassumed\b|\bpresumed\b|\bflak(?:e|ed|y|es)\b"
                  r"|\bcancel(?:led|ed|s)?\b|\bunmerged\b|\bstood\s+down\b|\bpre-merge\b"
                  r"|\bnot\s+verified\b")
_NA_UNIT=re.compile(r"\bno[-_ ]remote[-_ ]ci[a-z0-9._-]*")
_NA=re.compile(r"\bn/a\b|\bnot[-_ ]applicable\b")
_GREEN=re.compile(r"\bgreen\b|\bsuccess(?:ful)?\b|\bpass(?:ed|ing)?\b|\bok\b")
_PENDING=re.compile(r"\bpending\b|\bin[-_ ]?progress\b|\bqueued\b|\brerun[a-z-]*|\bre-run[a-z-]*"
                    r"|\bretry\b|\bretriggered\b|\brunning\b")
_NA_MARK=" \x00na\x00 "

def lp02_normalize_ci(raw):
    """Map an arbitrary --ci onto CI_VOCAB. Returns (value, raw_note_or_None). Never raises.

    ACCEPTED DUPLICATION of mr-slice-quality.normalize_ci, and deliberate: the row must carry a
    vocabulary value even when the helper is missing, hung or unrunnable, so --ci cannot depend on
    an external process. Both copies are tested — the reference by mr-slice-quality's own fixture
    battery, this one by mr-selfcheck's lp02-ci-normalised / lp02-parked-measured fixtures.
    Evaluation is over the WHOLE string: a head-token rule mismapped 21 real rows to `green`,
    headed by 'GREEN (CI wf); Nightly RED (mutation job, ...)' — compound verdicts are HOW reds get
    written here."""
    if not isinstance(raw,str): return ("not-recorded",None)
    t=raw.strip()
    if not t: return ("not-recorded",None)
    low=t.lower(); note=t[:120]
    if _RED.search(low): return ("red",None)        # \bred\b, not a substring: `rerun-triggered`
    if _HEDGE.search(low): return ("unknown",note)  # unverified/flaked/cancelled is not a verdict
    scan=_NA_UNIT.sub(_NA_MARK,low)                 # `no-remote-ci-*` is ONE not-applicable family
    fams=set()
    if _NA_MARK.strip() in scan or _NA.search(scan): fams.add("not-applicable")
    if _GREEN.search(scan): fams.add("green")
    if _PENDING.search(scan): fams.add("pending")
    if len(fams)>=2: return ("unknown",note)        # never collapse a compound verdict
    if len(fams)==1: return (fams.pop(),None)
    return ("unknown",note)

def lp02_is_closing(sl,oc):
    """Does this row CLOSE a slice? Inline copy of mr-slice-quality.is_closing (4 lines; shelling
    out to classify a row would add a subprocess and a failure mode per write). Both are tested."""
    if sl=="SUPERVISOR": return False
    if not isinstance(oc,str): return False
    h=oc.strip().upper()
    if h.startswith("CORRECTION"): return False     # accounting reversal, not a close
    return h.startswith(("MERGED","FINISHED","CRASHED","PARKED"))

def lp02_quality_bin():
    """Tier 1 an explicit MR_QUALITY_BIN, tier 2 the copy beside the mr-record being run, tier 3
    the hardcoded MEM. An explicit override is AUTHORITATIVE: if it is set but unusable we return
    None rather than silently falling through to another helper, because a fallback there would
    make a fixture that points at a broken helper quietly measure the real one — the difference
    between testing degradation and testing nothing."""
    env=os.environ.get("MR_QUALITY_BIN")
    if env:
        return env if os.path.exists(env) else None
    for c in (os.path.join(os.environ.get("MEM_SELF") or MEM,"mr-slice-quality"),
              MEM+"/mr-slice-quality"):
        if os.path.exists(c): return c
    return None

def lp02_derive(sl):
    """Measure the slice via the helper. BOUNDED and TOTAL: any failure yields all-null columns,
    never an exception and never a lost row. The tick bumps both heartbeats BEFORE the reconcile
    and takes its flock ~180 lines later, so an unbounded stall here would leave the loop looking
    alive while nothing progresses — the '~2 days undetected' failure the README records."""
    blank=dict((c,None) for c in CI_COLUMNS); blank["quality_source"]="unavailable"
    blank["reason"]="helper-unavailable"
    qb=lp02_quality_bin()
    if not qb: return blank
    try:
        p=subprocess.Popen([sys.executable,qb,"derive",sl],stdout=subprocess.PIPE,
                           stderr=subprocess.PIPE,text=True,start_new_session=True)
        try:
            out,_e=p.communicate(timeout=20)
        except subprocess.TimeoutExpired:
            # Kill the PROCESS GROUP: killing only the direct child leaves an orphaned git
            # grandchild holding .git state, once per tick, forever.
            try: os.killpg(os.getpgid(p.pid),9)
            except Exception:
                try: p.kill()
                except Exception: pass
            p.communicate(timeout=10)
            blank["reason"]="helper-timeout"; return blank
        if p.returncode!=0: return blank
        d=json.loads(out)
        if not isinstance(d,dict): return blank
        # COERCE, never copy verbatim. The ledger is append-only and a bad row can never be
        # removed, so a helper that returned a string (or a float, or a dict) for a COUNT column
        # would permanently corrupt the SSOT and break every arithmetic reader downstream. Anything
        # that is not a non-negative integer becomes None — the honest "unmeasurable" value.
        def _count(v):
            if isinstance(v,bool) or not isinstance(v,int) or v<0: return None
            return v
        row=dict((c,_count(d.get(c))) for c in CI_COLUMNS)
        q=d.get("quality_source")
        row["quality_source"]=q if q in ("derived","replayed","partial","unavailable") else "unavailable"
        row["reason"]=str(d.get("reason") or "")
        return row
    except Exception as exc:
        blank["reason"]="helper-error-"+type(exc).__name__
        return blank

def lp02_replay(sl):
    """The worktree is deleted BEFORE the MERGED row is written, so a later closing row can never
    re-measure. Replay the slice's most recent measured row FROM THE LEDGER — the durable SSOT, not
    a /tmp sidecar (which slice-name reuse across park->relaunch would silently make wrong)."""
    try:
        rows=open(LEDGER).readlines()[-400:]
    except Exception:
        return None
    for l in reversed(rows):
        try: d=json.loads(l)
        except Exception: continue
        if d.get("slice")!=sl: continue
        if d.get("quality_source") not in ("derived","replayed"): continue
        if all(c in d for c in CI_COLUMNS):
            return dict((c,d.get(c)) for c in CI_COLUMNS)
    return None

lp02_cols={}
closing=lp02_is_closing(slice_,outcome)
raw_ci=a.get("ci")
if raw_ci is None:
    ci_value="not-recorded" if closing else ""
    ci_note=None
else:
    ci_value,ci_note=lp02_normalize_ci(raw_ci)
if ci_note:
    notes=(notes+" | " if notes else "")+"CI-RAW: "+ci_note
if closing:
    q=lp02_derive(slice_)
    if q.get("quality_source")=="unavailable":
        # Only an UNAVAILABLE row is worth replaying: `partial` already carries measured
        # ears/skills and an honest verdict about the dirty tree.
        rep=lp02_replay(slice_)
        if rep is not None:
            q=dict(rep); q["quality_source"]="replayed"; q["reason"]=""
    reason=q.pop("reason","")
    lp02_cols=q
    if lp02_cols.get("quality_source")!="derived" and reason:
        notes=(notes+" | " if notes else "")+"QUALITY(%s): %s"%(lp02_cols["quality_source"],reason)
# ============================================ end lp-02 ========================================
row={"ts":ts,"run_id":a.get("run_id","n/a"),"slice":slice_,"outcome":outcome,"cost_usd":cost,
     "model":model or "n/a","attempts":int(a.get("attempts") or 0),
     "orchestration_audit":a.get("orch",""),"gating_test_audit":a.get("gating",""),
     "remote_red_fix_cycles":int(a.get("cycles") or 0),"consecutive_standdowns":int(a.get("standdowns") or 0),
     "master_ci_after":ci_value,"notes":notes}
row.update(lp02_cols)
line=json.dumps(row)
json.loads(line)  # verify parse
if not row["ts"]: die("empty ts")
with open(LEDGER,"a") as f: f.write(line+"\n")
print("ledger-appended: "+line[:160])
PY
