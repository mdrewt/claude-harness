helper=next((c for c in (os.path.join(os.environ.get("MEM_SELF") or MEM,"mr-cost-sum"), MEM+"/mr-cost-sum")
             if os.path.exists(c)), MEM+"/mr-cost-sum")
_SESSION=re.compile(r"\bsession=([0-9a-fA-F-]{8,64})")
def top_up(fresh=None):
    """Append the spend a session of this slice made after its cost row was written. A session
    resumed outside the wrapper (after a crash or a rate-limit stop) keeps spending on the same
    CLI session id, and only its transcript sees it. For each session id named by this slice's
    rows, the amount by which the session's cost exceeds what those rows already carry goes in
    as one `CORRECTION(late spend)` row under the session's run_id, so the rows of a run_id sum
    to the session's spend and a repeat adds nothing. `fresh` maps session id -> cost just read
    and limits the pass to those sessions; without it every session of the slice is read from
    its transcript. Returns the rows appended. Never raises."""
    added=[]
    try:
        with open(LEDGER,"a+") as f:
            fcntl.flock(f, fcntl.LOCK_EX)
            f.seek(0)
            have={}; rid={}
            for l in f:
                if "session=" not in l: continue
                try: d=json.loads(l)
                except Exception: continue
                if not isinstance(d,dict) or d.get("slice")!=slice_: continue
                m=_SESSION.search(str(d.get("notes") or ""))
                if not m or (fresh is not None and m.group(1) not in fresh): continue
                try: c=float(d.get("cost_usd") or 0)
                except (TypeError,ValueError): c=0.0
                have[m.group(1)]=have.get(m.group(1),0.0)+c
                rid.setdefault(m.group(1), d.get("run_id","n/a"))
            for sid in have:
                now=(fresh or {}).get(sid)
                if now is None:
                    try:
                        r=subprocess.run([sys.executable, helper, "--session", sid], capture_output=True, text=True, timeout=30)
                        now=float(r.stdout.strip())
                    except Exception: continue
                delta=round(float(now)-have[sid],4)
                if not delta>=0.005: continue      # also false for NaN
                extra={"ts":ts,"run_id":rid[sid],"slice":slice_,"outcome":"CORRECTION(late spend)","cost_usd":delta,
                       "model":"n/a","attempts":0,"orchestration_audit":"","gating_test_audit":"",
                       "remote_red_fix_cycles":0,"consecutive_standdowns":0,"master_ci_after":"",
                       "notes":"session=%s | spent after the session's cost row was written; the session total is $%.4f"%(sid,float(now))}
                f.write(json.dumps(extra)+"\n")
                added.append(extra)
    except Exception as exc:
        sys.stderr.write("WARN top-up: %s: %s\n"%(type(exc).__name__,exc))
    for extra in added: print("ledger-topup: %s +$%.4f"%(extra["run_id"],extra["cost_usd"]))
    return added
if run_log:
    if a.get("run_id"): die("--from-log derives the session's run_id from the log; drop --run_id")
    if cost not in (None,"","null"): die("--from-log reads the cost from the log; drop --cost")
    try:
        r=subprocess.run([sys.executable, helper, "--run", run_log], capture_output=True, text=True, timeout=60)
        run=json.loads(r.stdout) if r.returncode==0 else None
        if not isinstance(run,dict) or "cost" not in run: run=None
    except Exception: run=None
    stamp=(run or {}).get("launch")
    # No stamp (the log is gone, was never written, or the helper is unusable): the session cannot
    # be told from another, so the row gets an id of its own and is always written.
    a["run_id"]="run-%s-%s"%(slice_, stamp or "unstamped-"+re.sub(r"[-:]","",ts))
    def why(text): return (notes+" | " if notes else "")+text
    if run is None and os.path.exists(run_log):
        # Helper unavailable -> the naive sum of result events, which OVERCOUNTS a multi-result
        # run. That is the safe direction: an overcount trips SOFT-PAUSE early, whereas an
        # unknown cost counts as $0 in mr-situation and would let the loop overspend unseen.
        tot=0.0; found=False
