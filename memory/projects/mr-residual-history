PATH_RE = re.compile(r"(?<![\w/.-])((?:\.github|\.claude|[A-Za-z_][\w.-]*)(?:/[\w.@-]+)+\.[A-Za-z]\w*|memory/projects/mr-[\w-]+|[A-Z][A-Z_]+\.md)")


def load_gates(here=HERE):
    loader = importlib.machinery.SourceFileLoader("mr_gates_lib", os.path.join(here, "mr-gates"))
    spec = importlib.util.spec_from_loader("mr_gates_lib", loader)
    mod = importlib.util.module_from_spec(spec)
    sys.dont_write_bytecode = True
    loader.exec_module(mod)
    return mod


def _norm(p):
    p = str(p).strip().strip("`'\"").rstrip("/")
    return p[:p.index("*")].rstrip("/") if "*" in p else p


def cited_paths(r):
    out = []
    for t in r.get("touches") or []:
        t = _norm(t)
        if t and t not in out:
            out.append(t)
    for m in PATH_RE.finditer("%s %s" % (r.get("title") or "", r.get("reason") or "")):
        p = _norm(m.group(1))
        if p and p not in out:
            out.append(p)
    return out


def overlaps(path, wanted):
    for raw in wanted:
        w = _norm(raw)
        if not w:
            continue
        if path == w or path.startswith(w + "/") or w.startswith(path + "/") or ("*" in str(raw) and path.startswith(w)):
            return True
    return False


def resolve(p, files):
    """The repo path a citation means: as written, a directory of files, or relative to client/src/."""
    if p in files or any(f.startswith(p + "/") for f in files):
        return p
    for pre in ("client/src/", "client/"):
        q = pre + p
        if q in files or any(f.startswith(q + "/") for f in files):
            return q
    return None


def tree(repo, ref):
    try:
        r = subprocess.run(["git", "-C", repo, "ls-tree", "-r", "--name-only", ref], capture_output=True,
                           text=True, timeout=60)
        return set(r.stdout.split("\n")) if r.returncode == 0 else None
    except Exception:
        return None


def changed_since(repo, ref, since, paths):
    try:
        r = subprocess.run(["git", "-C", repo, "log", "-1", "--format=%h", "--since=" + since, ref, "--"] + paths,
                           capture_output=True, text=True, timeout=60)
        return r.stdout.strip() if r.returncode == 0 else None
    except Exception:
        return None


def classify(r, repos):
    paths = cited_paths(r)
    if not paths:
        return paths, "no-paths", None
    found = {}
    for repo, ref, files in repos:
        if files is None:
            continue
        hit = [q for q in (resolve(p, files) for p in paths) if q]
        if hit:
            found[(repo, ref)] = hit
    if not found:
        return paths, "gone", None
    since = r.get("disclosed_at") or "1970-01-01T00:00:00Z"
    for (repo, ref), hit in found.items():
        sha = changed_since(repo, ref, since, hit)
        if sha:
            return paths, "changed", sha
    return paths, "unchanged", None


def cluster_of(r, paths):
    lead = "/".join(paths[0].split("/")[:2]) if paths else (r.get("source_slice") or "?").split("-")[0]
    return "%s:%s" % (r.get("category") or "uncategorised", lead)


def verdicts(mem):
    """{residual id: (verdict, reviewed_at)} — the latest rv verdict per row."""
    out = {}
    for p in sorted(glob.glob(os.path.join(mem, "residual-reviews", "*.verdicts.json"))):
        try:
            d = json.load(open(p))
        except Exception:
            continue
        at = str(d.get("reviewed_at") or "")
        for rid, v in (d.get("verdicts") or {}).items():
            if at >= out.get(rid, ("", ""))[1]:
                out[rid] = (str(v), at)
    return out


def spec_mentions(specs, ids):
    named = collections.defaultdict(list)
    for p in sorted(glob.glob(os.path.join(specs, "*.md"))):
        try:
            text = open(p, errors="replace").read()
        except OSError:
            continue
        for rid in ids:
            if rid and re.search(r"(?<![\w-])%s(?![\w-])" % re.escape(rid), text):
                named[rid].append(os.path.basename(p))
    return named


def cmd_sort(rows, mg, repos, as_json, mem=MEM, specs=SPECS):
    opens = mg.open_residuals(rows)
    seen = verdicts(mem)
    named = spec_mentions(specs, [r.get("id") for r in opens])
    out = []
    for r in sorted(opens, key=lambda x: (x.get("disclosed_at") or "", x.get("id") or "")):
        paths, state, sha = classify(r, repos)
        v = seen.get(r.get("id"))
        recheck = True
        if v:
            # A verdict stands until a cited path changes after it was given.
            since = v[1] or ""
            moved = any(changed_since(repo, ref, since, [q for q in (resolve(p, files or set()) for p in paths) if q])
                        for repo, ref, files in repos if files is not None and paths and
                        [q for q in (resolve(p, files) for p in paths) if q])
            recheck = bool(moved)
        out.append({"id": r.get("id"), "severity": r.get("severity"), "category": r.get("category"),
                    "status": r.get("status"), "disclosed_at": r.get("disclosed_at"),
                    "source_slice": r.get("source_slice"), "title": (r.get("title") or "")[:160],
                    "paths": paths, "state": state, "changed_by": sha, "cluster": cluster_of(r, paths),
                    "reviewed": {"verdict": v[0], "at": v[1]} if v else None, "recheck": recheck,
                    "named_in": named.get(r.get("id"), []),
                    "followup": bool(mg.is_followup_slice(r.get("source_slice"), rows))})
    if as_json:
        print(json.dumps({"open": out, "states": dict(collections.Counter(x["state"] for x in out)),
                          "clusters": dict(collections.Counter(x["cluster"] for x in out))}, indent=1))
    else:
        for x in out:
            print("%-34s %-4s %-9s %-28s %s" % (x["id"], x["severity"] or "?", x["state"], x["cluster"][:28], x["title"][:70]))
        print("RESIDUAL-SORT open=%d to-check=%d %s" % (len(out), sum(1 for x in out if x["recheck"] and x["state"] != "unchanged"),
                                                        " ".join("%s=%d" % kv for kv in sorted(collections.Counter(x["state"] for x in out).items()))))
    return 0


def cmd_related(rows, mg, wanted, as_json):
    folded = mg.fold_residuals(rows)
    open_ids = {r.get("id") for r in mg.open_residuals(rows)}
    opens, closed = [], collections.defaultdict(list)
    for rid, r in sorted(folded.items()):
        paths = [p for p in cited_paths(r) if overlaps(p, wanted)]
        if not paths:
            continue
        row = {"id": rid, "severity": r.get("severity"), "category": r.get("category"), "status": r.get("status"),
               "title": (r.get("title") or "")[:160], "paths": paths, "source_slice": r.get("source_slice")}
        if rid in open_ids:
            opens.append(row)
        else:
            closed[r.get("category") or "uncategorised"].append(row)
    if as_json:
        print(json.dumps({"open": opens, "closed_by_category": closed}, indent=1))
    else:
        print("OPEN (fold each into the slice that touches its paths):")
        for x in opens:
            print("  %-34s %-4s %-20s %s  [%s]" % (x["id"], x["severity"] or "?", x["category"] or "?", x["title"][:80], ", ".join(x["paths"])[:80]))
        print("CLOSED, by category (defect classes earlier work on these paths produced):")
        for cat, xs in sorted(closed.items(), key=lambda kv: -len(kv[1])):
            print("  %-20s %3d  e.g. %s" % (cat, len(xs), " | ".join(x["title"][:60] for x in xs[:3])))
        print("RESIDUAL-RELATED open=%d closed=%d" % (len(opens), sum(len(v) for v in closed.values())))
    return 0


def main(argv, mem=MEM, here=HERE, repos_spec=REPOS, specs=SPECS):
    mg = load_gates(here)
    rows = mg.residual_rows(os.path.join(mem, "mr-residuals.jsonl"))
    as_json = "--json" in argv
    if argv and argv[0] == "sort":
        return cmd_sort(rows, mg, [(repo, ref, tree(repo, ref)) for repo, ref in repos_spec], as_json, mem, specs)
    if argv and argv[0] == "related":
        try:
            raw = argv[argv.index("--paths") + 1]
        except (ValueError, IndexError):
            print("RESIDUAL-HISTORY-ERROR related needs --paths P[,P...]")
            return 0
        return cmd_related(rows, mg, [p.strip() for p in raw.split(",") if p.strip()], as_json)
    print(__doc__.strip().split("\n\n")[1])
    return 0


