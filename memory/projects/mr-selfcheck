def _mr_files(mem):
    # Same exclusion shape as the tool enumeration above (mr-selfcheck's own TOOLS glob and
    # the PYHD heredoc scanner): `.bak*`/`.log`/`.md`/`.json`/`.jsonl` are documentation,
    # backups or data, never scannable executables.
    return sorted(
        n for n in os.listdir(mem)
        if n.startswith("mr-")
        and not any(k in n for k in (".bak", ".log"))
        and not n.endswith((".md", ".json", ".jsonl"))
        and os.path.isfile(os.path.join(mem, n))
    )


def _bash_mr_tools(mem):
    out = []
    for n in _mr_files(mem):
        p = os.path.join(mem, n)
        if not os.access(p, os.X_OK):
            continue
        try:
            with open(p, errors="replace") as f:
                first = f.readline()
        except OSError:
            continue
        # python tools CANNOT carry a bash `unset` line — including them here would be a
        # permanent false positive against A1's anchor requirement.
        if "bash" in first or first.strip().endswith("/sh"):
            out.append(n)
    return out


def _nonblank_noncomment_lines(path):
    try:
        with open(path, errors="replace") as f:
            src = f.read()
    except OSError:
        return []
    return [ln for ln in src.splitlines() if ln.strip() and not ln.strip().startswith("#")]


SETSID_RE = re.compile(r"\bsetsid\b")
