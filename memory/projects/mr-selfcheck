def markers_in(path, markers):
    """Returns (found, io_error). An UNREADABLE watched file is NOT treated as clean — the
    difference between `nothing was written` and `we could not look` is the whole point."""
    try:
        with open(path, errors="replace") as fh:
            text = fh.read()
    except FileNotFoundError:
        return [], None
    except OSError as exc:
        return [], "%s: %s" % (type(exc).__name__, exc)
    return [m for m in markers if m in text], None

