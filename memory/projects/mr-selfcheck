def run(argv, env=None, timeout=120):
    b0 = os.path.basename(str(argv[0]))
    if b0 in _FORBIDDEN0:
        raise RuntimeError("REFUSED: this block must never execute %s" % b0)
    for a in argv:
        sa = str(a)
        if os.path.basename(sa) in _FORBIDDEN_ANY or sa.strip() in _FORBIDDEN_ANY:
            raise RuntimeError("REFUSED: this block must never invoke %r" % sa)
        if ".native-supervisor-disabled" in sa:
            raise RuntimeError("REFUSED: this block must never touch the kill-switch flag path")
    try:
        r = subprocess.run(argv, env=env, capture_output=True, text=True, timeout=timeout)
        return r.returncode, r.stdout or "", r.stderr or ""
    except FileNotFoundError as exc:
        return None, "", "NOT-FOUND: %s" % exc
    except subprocess.TimeoutExpired:
        return None, "", "TIMEOUT after %ss" % timeout


