        hang = os.path.join(TMP, "helper-hang")
        write(hang, "import time\ntime.sleep(120)\n")
        for label, helper, tmo in (("lp02-helper-missing", os.path.join(TMP, "no-such-helper"), 120),
                                   ("lp02-helper-raises", boom, 120),
                                   ("lp02-helper-garbage", garbage, 120),
                                   ("lp02-helper-hangs", hang, 100)):
            led = fresh(label)
            rc, out, err, elapsed, _l = record(
                ["--run_id", "wrapper-reconcile", "--slice", SLICE, "--outcome", "CRASHED(rc=1)",
                 "--cost", "0.5"],
                env_extra={"MR_QUALITY_BIN": helper}, ledger=led, timeout=tmo)
            if rc is None:
                fail(label, "mr-record did not return within %ss (%s) — a derivation defect became "
                            "a row-loss defect, and a stall in the tick's reconcile leaves both "
                            "heartbeats fresh while nothing progresses" % (tmo, err.strip()[:80]))
                continue
            if rc != 0:
                fail(label, "mr-record exited %r; the row must be written regardless of the helper "
                            "(stderr=%r)" % (rc, err.strip()[:200]))
            row = appended(label, led, 0)
            if row is None:
                continue
            if not row.get("ts") or not row.get("slice"):
                fail(label, "the appended row lost its own fields: %r" % (row,))
            for col in COLUMNS:
                # PRESENT and null. A closing row ALWAYS carries all six keys plus quality_source,
                # explicitly null when unmeasurable (orchestrator decision resolving E1-literal vs
                # the plan's `return {}`). Absent-or-null was the weaker assertion; this one also
                # catches a writer that silently drops the columns whenever derivation misbehaves.
                if col not in row:
                    fail(label, "a CLOSING row must carry %s even when derivation failed (EARS-1); "
                                "the key is absent" % col)
                elif row[col] is not None:
                    fail(label, "%s must be null when derivation failed, never a fabricated number; "
                                "got %r" % (col, row[col]))
            if "quality_source" not in row:
                fail(label, "a CLOSING row must carry quality_source; the key is absent")
            elif row.get("quality_source") == "derived":
                fail(label, "quality_source must not claim 'derived' when the helper never produced "
                            "a measurement")
            if label == "lp02-helper-hangs" and elapsed > 75:
                fail(label, "mr-record took %.1fs — the helper call must be bounded by a timeout "
                            "(R1/R-D); an unbounded call wedges the hourly tick with fresh "
                            "heartbeats, the exact ~2-days-undetected failure the README records"
                            % elapsed)

        # =========================================================================================
        # R-A: a LATER closing row for the same slice REPLAYS from the ledger. The worktree is
        # deleted BEFORE the MERGED row is written (mr-supervisor-prompt-native.md:125 removes it in
        # the bullet above the ledger write), so replay is the only way E1's literal "every closed
        # row" can hold. Same numbers, quality_source 'replayed'.
        # =========================================================================================
        rcw, _o, errw = git(ROOT, ["worktree", "remove", "--force", WT], env)
        if rcw != 0:
            shutil.rmtree(WT, ignore_errors=True)
            git(ROOT, ["worktree", "prune"], env)
        os.makedirs(WT, exist_ok=True)  # exists but is NOT a worktree: `git -C` now walks up to ROOT
        rc, out, err, _el, _l = record(
            ["--run_id", "supervisor", "--slice", SLICE, "--outcome", "MERGED",
             "--ci", "no-remote-ci-local-gate-green"], ledger=main_led)
        if rc != 0:
            fail("lp02-replay", "mr-record exited %r (stderr=%r)" % (rc, err.strip()[:200]))
        row = appended("lp02-replay", main_led, 1)
        if row is not None:
            for col in COLUMNS:
                if row.get(col) != EXPECT[col]:
                    fail("lp02-replay",
                         "%s must REPLAY the first closing row's value %r; got %r. Re-measuring "
                         "here is impossible (the worktree is gone) and emitting null would break "
                         "EARS-1 on the MERGED row" % (col, EXPECT[col], row.get(col)))
            if row.get("quality_source") != "replayed":
                fail("lp02-replay",
                     "a replayed row must be labelled quality_source='replayed' — that label is the "
                     "only thing distinguishing a fresh measurement from a copy; got %r"
                     % (row.get("quality_source"),))
            if row.get("master_ci_after") != "not-applicable":
                fail("lp02-replay",
                     "`no-remote-ci-local-gate-green` is a real corpus value and normalises to "
                     "'not-applicable'; got %r" % (row.get("master_ci_after"),))

        # =========================================================================================
        # NEGATIVE DIRECTION of R-J item 4, on a FRESH ledger so replay has nothing to find.
        #
        # The worktree directory exists but is not a worktree, so `git -C` walks up into ROOT, whose
        # HEAD is `main`, and honestly reports an EMPTY diff. An isdir+returncode implementation
        # therefore writes files_changed=0 ... quality_source=derived with total confidence, about a
        # tree it never inspected — and that is the NORMAL post-merge state, not an edge case.
        # =========================================================================================
        led = fresh("removed")
        rc, out, err, _el, _l = record(
            ["--run_id", "supervisor", "--slice", SLICE, "--outcome", "MERGED"], ledger=led)
        if rc != 0:
            fail("lp02-worktree-removed", "mr-record exited %r (stderr=%r)" % (rc, err.strip()[:200]))
        row = appended("lp02-worktree-removed", led, 0)
        if row is not None:
            for col in COLUMNS:
                # PRESENT and null (see the degradation loop above for the decision).
                if col not in row:
                    fail("lp02-worktree-removed",
                         "a CLOSING row must carry %s even when unmeasurable (EARS-1); key absent" % col)
                elif row[col] is not None:
                    fail("lp02-worktree-removed",
                         "%s must be null when the worktree cannot be identified, NEVER 0; got %r"
                         % (col, row[col]))
            if row.get("quality_source") != "unavailable":
                fail("lp02-worktree-removed",
                     "quality_source must be 'unavailable'; got %r — 'derived' means the identity "
                     "assertion (rev-parse --show-toplevel == the resolved worktree path) is missing"
                     % (row.get("quality_source"),))
            if row.get("master_ci_after") != "not-recorded":
                fail("lp02-absent-ci-not-recorded",
                     "a CLOSING row written with no --ci must record 'not-recorded' — the newest "
                     "MERGED row in the live ledger carries \"\" for exactly this reason; got %r"
                     % (row.get("master_ci_after"),))

        # =========================================================================================
        # R-J item 14 (A4) — NON-closing rows omit all six keys entirely. Emitting nulls on every
        # `tick-ok` row would amplify the 259-key collapse this slice exists to fix and would
        # destroy the reader's row-selection rule ("the rows carrying the keys").
        # R-J item 15 (D2) — CORRECTION* is an accounting reversal and SUPERVISOR is wrapper
        # bookkeeping; neither closes a slice.
        # =========================================================================================
        for label, args, extra in (
                ("lp02-non-closing-omits",
                 ["--run_id", "supervisor", "--slice", SLICE, "--outcome", "LAUNCHED"], None),
                ("lp02-non-closing-omits",
                 ["--run_id", "cron", "--slice", SLICE, "--outcome", "tick-ok src=cron"], None),
                ("lp02-correction-not-closing",
                 ["--run_id", "supervisor", "--slice", SLICE,
                  "--outcome", "CORRECTION(cost -12.34 double-counted)"], None),
                ("lp02-supervisor-not-closing",
                 ["--run_id", "wrapper", "--slice", "SUPERVISOR", "--outcome", "MERGED"],
                 {"MR_RECORD_WRAPPER": "1"})):
            led = fresh(label + "-" + args[-1][:12].replace(" ", "_").replace("(", "_"))
            rc, out, err, _el, _l = record(args, env_extra=extra, ledger=led)
            if rc != 0:
                fail(label, "mr-record exited %r for outcome=%r (stderr=%r)"
                     % (rc, args[-1], err.strip()[:200]))
                continue
            row = appended(label, led, 0)
            if row is None:
                continue
            present = [c for c in COLUMNS if c in row]
            if present:
                fail(label, "outcome=%r is NOT a closing row, so it must omit the quality columns "
                            "entirely; found %s" % (args[-1], present))
            if "quality_source" in row:
                fail(label, "outcome=%r must not carry quality_source either" % (args[-1],))
            if row.get("master_ci_after") != "":
                fail(label, "a non-closing row written with no --ci keeps master_ci_after == \"\" "
                            "(no churn on the ~400 tick-ok rows); got %r"
                     % (row.get("master_ci_after"),))

for path in WATCH:
    hits = markers_in(path, [SLICE, "sqfx-", TMP])
    if hits:
        fail("lp02-corpus-pollution",
             "%s contains fixture marker(s) %s — a fixture reached the real corpus instead of "
             "MR_RECORD_LEDGER/MR_RECORD_HANDOFF. The ledger is append-only (ADR-0011), so a test "
             "row written there is unremovable." % (path, hits))

sys.exit(bad)
PYSQ
[ "$BAD" = 0 ] && echo "SELFCHECK-OK"
exit 0
