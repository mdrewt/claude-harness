                            "call wedges the hourly tick with fresh heartbeats, the exact "
                            "~2-days-undetected failure the README records" % elapsed)

        # =========================================================================================
        # R-A: a LATER closing row for the same slice REPLAYS from the ledger. The worktree is
        # deleted BEFORE the MERGED row is written (mr-supervisor-prompt-native.md:125 removes it in
        # the bullet above the ledger write), so replay is the only way E1's literal "every closed
        # row" can hold. Same numbers, quality_source 'replayed'.
        # =========================================================================================
        rcw, _o, errw = git(ROOT, ["worktree", "remove", "--force", WT], env)
        if rcw != 0:
            shutil.rmtree(WT, ignore_errors=True)
            git(ROOT, ["worktree", "prune"], env)
        os.makedirs(WT, exist_ok=True)  # exists but is NOT a worktree: `git -C` now walks up to ROOT
        rc, out, err, _el, _l = record(
            ["--run_id", "supervisor", "--slice", SLICE, "--outcome", "MERGED",
             "--ci", "no-remote-ci-local-gate-green"], ledger=main_led)
