def plan_of():
    """This block's fixture diff. Sizes derive from os.getpid() — deterministic inside one run,
    different across runs — and the shape is DELIBERATELY DIFFERENT from the ones in
    mr-slice-quality's own selftest. Both properties exist because a red-team scored 418/419 with
    `if the diff is non-empty: return the one tuple that appears in every fixture in the slice`.
    Nothing here is transcribable.

    (path, klass, base_n, head_n, base_tag, head_tag); base_n None = created on the branch,
    head_n None = deleted on the branch. Line content is `<tag><i>`, so a size change is a pure
    suffix append/truncation and the added/deleted counts are exactly the difference."""
    def sz(i):
        return 4 + (os.getpid() + i * 5) % 11        # 4..14
    return [
        ("src/one.rs", "prod", None, sz(0), "o", "o"),
        ("src/two.rs", "prod", sz(1), None, "w", "w"),          # DELETED outright
        ("tests/three.py", "test", None, sz(2), "h", "h"),      # D5.1 segment rule
        ("docs/four.md", "other", None, sz(3), "f", "f"),       # OTHER, contributes no lines
        ("Cargo.lock", "other", sz(4), sz(4) + 2, "l", "l"),    # OTHER lockfile
    ]


def expect_of(plan):
    """The expectation, COMPUTED from the plan the files are written from, plus the two records
    that carry no lines: the rename (ONE record under -M) and the binary file."""
    exp = {"files_changed": len(plan) + 2, "prod_lines_added": 0, "prod_lines_deleted": 0,
           "test_lines_added": 0, "ears_criteria_count": 3, "skills_invoked": None}
    for _path, klass, bn, hn, bt, ht in plan:
        if bn is None:
            add, dele = hn, 0
        elif hn is None:
            add, dele = 0, bn
        elif bt != ht:
            add, dele = hn, bn
        elif hn > bn:
            add, dele = hn - bn, 0
        elif hn < bn:
            add, dele = 0, bn - hn
        else:
            add, dele = 0, 0
        if klass == "prod":
            exp["prod_lines_added"] += add
            exp["prod_lines_deleted"] += dele
        elif klass == "test":
            exp["test_lines_added"] += add
    return exp


