def git(cwd, args, env):
    return run(["git", "-C", cwd] + list(args), env=env)


def write(path, text):
    d = os.path.dirname(path)
    if d and not os.path.isdir(d):
        os.makedirs(d)
    with open(path, "w") as fh:
        fh.write(text)


def rows_of(path):
    out = []
    if not os.path.exists(path):
        return out
    with open(path, errors="replace") as fh:
        for line in fh:
            line = line.strip()
            if not line:
                continue
            try:
                obj = json.loads(line)
            except Exception:
                out.append({"__unparseable__": line[:120]})
                continue
            out.append(obj)
    return out


