#!/bin/bash
# mr-selfcheck — mechanical corpus health check (daily via tick). rc=0 always; prints FAIL lines.
set -u
# SELF-LOCATING (lp-09), not hardcoded. This gate attests the corpus it SHIPS BESIDE, so whichever
# copy you run must check that copy's tools — otherwise a slice's own worktree run silently gates the
# live main-checkout files and every assertion below is a false green. Deliberately NOT an env
# override (`MR_SELFCHECK_MEM=…`): an override is a surface for greening production vacuously, which
# is the exact failure class this gate exists to prevent. Cron invokes this by absolute path in its
# own directory, so production behaviour is unchanged. (mr-hold is the opposite call — it addresses a
# singleton machine-wide artifact and MUST stay hardcoded; the reason is in its header.)
MEM="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
BAD=0
# The tool set is DERIVED, not hand-maintained (lp-00). The old hardcoded 19-path list had already
# drifted: it omitted mr-selfcheck itself and mr-feedback, and every new tool had to be remembered
# into it — the hand-maintained-list failure mode scripts/tests/invariants.test.mjs exists to prevent
# elsewhere. `.bak*` is excluded deliberately: several backups are executable and one bad archived
# copy must not red the live check.
TOOLS=$(find "$MEM" -maxdepth 1 -type f -perm -u+x -name 'mr-*' \
        ! -name '*.bak*' ! -name '*.log' ! -name '*.md' ! -name '*.json' ! -name '*.jsonl' 2>/dev/null | sort)
[ -n "$TOOLS" ] || { echo "SELFCHECK-FAIL tool-enumeration found ZERO mr-* executables in $MEM — the glob has rotted"; BAD=1; }
while IFS= read -r f; do
  [ -n "$f" ] || continue
  SB=$(head -1 "$f")
  case "$SB" in
    *python*) /usr/bin/python3 -c "import ast,sys;ast.parse(open(sys.argv[1]).read())" "$f" 2>/dev/null || { echo "SELFCHECK-FAIL py: $f"; BAD=1; } ;;
    *bash*|*/sh) bash -n "$f" 2>/dev/null || { echo "SELFCHECK-FAIL sh: $f"; BAD=1; } ;;
    # Coverage assertion, same rationale as the heredoc one below: a tool the classifier cannot
    # route is a tool that ships UNCHECKED while the gate still prints OK. Fail loudly instead.
    *) echo "SELFCHECK-FAIL unclassifiable-shebang: $f (first line: $(echo "$SB" | cut -c1-40))"; BAD=1 ;;
  esac
done <<EOF
$TOOLS
EOF
/usr/bin/python3 -c "import ast,sys;ast.parse(open(sys.argv[1]).read())" "$MEM/mr-feedback" 2>/dev/null || { echo "SELFCHECK-FAIL py: mr-feedback"; BAD=1; }
"$MEM/mr-feedback" selftest >/dev/null 2>&1 || { echo "SELFCHECK-FAIL mr-feedback selftest"; BAD=1; }
# ADR-0011 Confirmation: the cost SSOT must keep reconstructing per-invocation spend from the
# cumulative total_cost_usd field. Its fixtures include the real uxd2 shape (naive $423.65 ->
# true $165.65) and the escalation case a pure value-decrease split would undercount.
"$MEM/mr-cost-sum" --selftest >/dev/null 2>&1 || { echo "SELFCHECK-FAIL mr-cost-sum selftest"; BAD=1; }
# lp-00: repo routing is the SSOT both mr-spawn and mr-launch.sh read. Its register carries the real
# declared touches of live slices, so a classification regression reds HERE rather than at spawn —
# where the cost is a slice launched into the wrong repo's main checkout.
"$MEM/mr-repo-of" --selftest >/dev/null 2>&1 || { echo "SELFCHECK-FAIL mr-repo-of selftest"; BAD=1; }
# lp-09: the kill switch is the operator's only control while pacing is manual. Its fail-safe (no
# provenance => OPERATOR => never auto-clearable) is the property that must never regress silently.
"$MEM/mr-hold" --selftest >/dev/null 2>&1 || { echo "SELFCHECK-FAIL mr-hold selftest"; BAD=1; }
"$MEM/mr-branch-audit" --selftest >/dev/null 2>&1 || { echo "SELFCHECK-FAIL mr-branch-audit selftest"; BAD=1; }
# lp-01: the utilization SSOT. lp-12/lp-13 are blocked on a full reset cycle of its output, so a
# reader that silently stops persisting rows is a multi-week loss that no other gate would catch.
"$MEM/mr-telemetry-selftest" --selftest >/dev/null 2>&1 || { echo "SELFCHECK-FAIL mr-telemetry-selftest"; BAD=1; }
# lp-11a: the lock-release SSOT. Exists so the tick never needs `rm -rf` for routine cleanup — the
# guard blocks that (rightly), and a headless tick that hits a block stops to ask a human who is not
# there. Its must-never-regress property is that a LIVE owner is refused.
"$MEM/mr-unlock" --selftest >/dev/null 2>&1 || { echo "SELFCHECK-FAIL mr-unlock selftest"; BAD=1; }
# lp-02: the slice-size denominator (files_changed, prod_lines_added/deleted, test_lines_added,
# ears_criteria_count, skills_invoked). This runs the tool's OWN fixture battery — deliberately NOT
# a `variance` run over the real ledger, and that is a decision, not an oversight. Today ZERO ledger
# rows carry the new columns and `Skill` tool_use blocks occur in only ~5 pass logs corpus-wide, so
# a real-ledger gate would exit 1 on its first night and be commented out within the week — the
# disabled-gate failure this corpus keeps re-learning. When `variance` does RED on real data later,
# that exit 1 is a TRUE FINDING about the loop (a column nobody is populating), not a broken gate:
# promote the real-ledger run (parked -> lp-02b) rather than delete this line. The behavioural half
# — that mr-record actually WRITES the columns — is the PYSQ block at the bottom of this file;
# without it every gate here stays green while the writer emits nothing at all.
"$MEM/mr-slice-quality" --selftest >/dev/null 2>&1 || { echo "SELFCHECK-FAIL mr-slice-quality selftest"; BAD=1; }
# lp-04: mr-audit's policy/detector split + the disposition sweep.
#
# The one-line house form — `"$MEM/mr-audit" --selftest >/dev/null 2>&1 || BAD=1` — is DELIBERATELY
# not used here, because against this particular tool it has ZERO teeth. mr-audit is rc=0 ALWAYS
# (that is a promise in its own header, which the supervisor prompt relies on) and its argument
# loop ignores unknown flags, so the one-liner passes identically against today's unmodified tool,
# against a complete implementation, and against a ten-line stub. A red-team copied
# memory/projects/ twice, wired that line into both copies, and the output diff was IDENTICAL.
#
# So the wiring is three parts, and each closes a hole the other two cannot:
#   (a) the marker AND the fixture COUNT are parsed from stdout — a battery that shrinks must red;
#   (b) an EXTERNAL behavioural probe drives the real tool over synthetic logs and asserts real
#       verdicts, real key names and the real artifact. mr-audit's in-file battery necessarily
#       drives its functions in process, so if main() stopped calling audit_gating altogether
#       every in-file assertion would still pass. This is the half that sees that;
#   (c) neither the probe nor the selftest may leave a /tmp/mr_audit_*.json behind.
#
# Tester-authored, TDD RED PHASE — do not edit these to fit a buggy implementation; a wrong
# expectation is corrected FROM THE SPEC (M-loop-infrastructure.spec.md:224-253 and the binding
# amendments in memory/projects/monster-realm-lp-04-plan.md), never retargeted to match the code.
/usr/bin/python3 - "$MEM" <<'PYAUDIT' || BAD=1
import json
import os
import re
import subprocess
import sys
import tempfile

MEM = sys.argv[1]
AUDIT = os.path.join(MEM, "mr-audit")
FIXTURE_SLICE = "mr-audit-fixture"          # never a live slice id: the artifact path is shared
FIXTURE_ARTIFACT = "/tmp/mr_audit_%s.json" % FIXTURE_SLICE
COUNT_FLOOR = 24
bad = 0


def fail(name, detail=""):
    global bad
    bad = 1
    print(("SELFCHECK-FAIL %s" % name) + (": " + detail if detail else ""))


def run(args, timeout):
    try:
        r = subprocess.run(["bash", AUDIT] + list(args), capture_output=True, text=True,
                           timeout=timeout)
        return r.returncode, r.stdout or "", r.stderr or ""
    except FileNotFoundError as exc:
        return None, "", "NOT-FOUND: %s" % exc
    except subprocess.TimeoutExpired:
        return None, "", "TIMEOUT after %ss" % timeout


def tmp_artifacts():
    import glob
    snap = {}
    for p in glob.glob("/tmp/mr_audit_*.json"):
        try:
            s = os.stat(p)
            snap[p] = (s.st_mtime_ns, s.st_size)
        except OSError:
            snap[p] = None
    return snap


if not os.path.isfile(AUDIT):
    fail("lp04-audit-missing", "mr-audit not found at %s" % AUDIT)
    sys.exit(bad)

# =============================================================================================
# (a) marker + count. rc alone proves nothing (rc=0 always); the marker alone is one print
# statement away from being faked; the COUNT is what makes a quietly-deleted fixture visible.
# =============================================================================================
before = tmp_artifacts()
rc, out, err = run(["--selftest"], 300)
if rc is None:
    fail("lp04-selftest-unrunnable", err.strip()[:200])
elif rc != 0:
    tail = (out + err).strip().splitlines()
    fail("lp04-selftest", "mr-audit --selftest exited %d: %s" % (rc, " | ".join(tail[-8:])))
m = re.search(r"^AUDIT-SELFTEST-OK ([0-9]+)$", out, re.M)
if not m:
    fail("lp04-selftest-marker",
         "mr-audit --selftest did not print `AUDIT-SELFTEST-OK <n>` (rc=%r). Until lp-04 lands "
         "this is the expected RED: the battery is dead code below finish() and nothing "
         "dispatches --selftest. stdout tail: %s" % (rc, out.strip()[-200:]))
elif int(m.group(1)) < COUNT_FLOOR:
    fail("lp04-selftest-count",
         "the battery ran %s fixtures, floor is %d — fixtures have been deleted, or the count "
         "is being reported instead of measured" % (m.group(1), COUNT_FLOOR))
after = tmp_artifacts()
leaked = sorted([p for p in after if p not in before or after[p] != before.get(p)])
if leaked:
    fail("lp04-selftest-tmp-pollution",
         "--selftest created or modified %s; every emit() in the battery must be handed an "
         "artifact_dir inside its own tempdir" % (leaked,))

# =============================================================================================
# (b) EXTERNAL behavioural probe. A stub that prints the marker cannot fake ANY of this.
# =============================================================================================
AGENT = '{"name":"Agent","input":{"subagent_type":"%s"},"model":"claude-opus-5"}\n'


def probe(label, args, timeout=120):
    rc, out, err = run(args, timeout)
    if rc is None:
        fail(label, err.strip()[:200])
        return None
    if rc != 0:
        fail(label, "mr-audit exited %d — the rc=0-ALWAYS contract in its own header is what "
                    "lets the supervisor call it unguarded; stderr: %s" % (rc, err.strip()[:160]))
    try:
        return json.loads(out)
    except Exception as exc:
        fail(label, "stdout is not JSON (%s): %r" % (exc, out.strip()[:200]))
        return None


with tempfile.TemporaryDirectory(prefix="mr-selfcheck-lp04-") as TMP:
    flagged_log = os.path.join(TMP, "flagged.jsonl")
    with open(flagged_log, "w") as fh:
        fh.write('{"type":"user","content":"no agent calls at all"}\n')
    clean_log = os.path.join(TMP, "clean.jsonl")
    with open(clean_log, "w") as fh:
        fh.write((AGENT % "tester") + (AGENT % "reviewer"))
    dir_log = os.path.join(TMP, "a-directory")
    os.makedirs(dir_log)

    obj = probe("lp04-probe-flagged", ["--slice", FIXTURE_SLICE, "--log", flagged_log])
    if obj is not None:
        got = (obj.get("orchestration") or {}).get("verdict")
        if got != "FLAGGED":
            fail("lp04-probe-flagged",
                 "a log with zero Agent calls must be FLAGGED; got %r. This is the assertion a "
                 "marker-printing stub cannot satisfy" % (got,))
        # AM3: the key was renamed, the VOCABULARY was not. mr-supervisor-prompt-native.md:39,
        # :122-123 and mr-record's gating_test_audit column both key on the FLAGGED token.
        if "gating_advisory" not in obj:
            fail("lp04-probe-key", "top-level `gating_advisory` is missing (AM3)")
        if "gating" in obj:
            fail("lp04-probe-legacy-key",
                 "the legacy `gating` key is still emitted; AM3 renames it so a reader reaching "
                 "for gating.verdict gets a visible absence instead of a stale block")
        # AM4: no --repo was passed, so the advisory inputs are unavailable and the AUDIT-ERROR
        # -treated-as-FLAGGED convention from mr-audit's own header must survive as policy.
        if obj.get("mandatory_read") is not True:
            fail("lp04-probe-mandatory-read",
                 "advisory inputs unavailable must hoist mandatory_read=True at TOP LEVEL; got "
                 "%r. Without it a typo'd --repo is a silent proceed" % (obj.get("mandatory_read"),))
        if obj.get("read_reason") != ["advisory-inputs-unavailable"]:
            fail("lp04-probe-read-reason",
                 "expected ['advisory-inputs-unavailable']; got %r" % (obj.get("read_reason"),))
        disp = obj.get("disposition")
        if not isinstance(disp, dict):
            fail("lp04-probe-disposition", "no top-level `disposition` block on a real run")
        else:
            if disp.get("advisory") is not True:
                fail("lp04-probe-disposition", "the disposition block must carry advisory=True")
            if "verdict" in disp:
                fail("lp04-probe-disposition",
                     "AM11: the corpus sweep uses status OK|FINDINGS|AUDIT-ERROR, never a "
                     "verdict — a FLAGGED here attaches unactionable findings to every merge "
                     "forever and corrupts AM6's falsification, which reads gating_advisory only")
            if disp.get("status") not in ("OK", "FINDINGS", "AUDIT-ERROR"):
                fail("lp04-probe-disposition", "status %r is outside the closed vocabulary"
                     % (disp.get("status"),))
        # emit()'s artifact half, proven on the real binary before we clean it up.
        if not os.path.exists(FIXTURE_ARTIFACT):
            fail("lp04-probe-artifact", "%s was not written" % FIXTURE_ARTIFACT)
        else:
            with open(FIXTURE_ARTIFACT, errors="replace") as fh:
                if json.loads(fh.read()) != obj:
                    fail("lp04-probe-artifact", "the artifact and stdout disagree")

    obj = probe("lp04-probe-clean", ["--slice", FIXTURE_SLICE, "--log", clean_log])
    if obj is not None:
        got = (obj.get("orchestration") or {}).get("verdict")
        if got != "CLEAN":
            fail("lp04-probe-clean",
                 "tester + reviewer role evidence must be CLEAN; got %r" % (got,))

    # The AM2 shape, on the REAL tool: os.path.exists() is true for a directory, open() raises,
    # and the SINGLE outer try takes both halves down together. Any per-function error handling
    # turns this into a populated orchestration block and a computed gating CLEAN — strictly
    # less conservative than today.
    obj = probe("lp04-probe-directory-log", ["--slice", FIXTURE_SLICE, "--log", dir_log])
    if obj is not None:
        if obj.get("orchestration") != {"verdict": "AUDIT-ERROR"}:
            fail("lp04-probe-directory-log",
                 "`--log <a directory>` must yield the degraded shape {'verdict':'AUDIT-ERROR'} "
                 "with no reason/agent_calls/roles/models; got %r" % (obj.get("orchestration"),))
        if (obj.get("gating_advisory") or {}).get("verdict") != "AUDIT-ERROR":
            fail("lp04-probe-directory-log",
                 "the shared try must take the gating half down with it; got %r"
                 % (obj.get("gating_advisory"),))
        # AM17, and THIS is where it bites. mr-audit's own battery has to mirror the exception
        # handler to reach this path at all, so the real :71-73 body is only ever executed here.
        # A handler that leaves mandatory_read at its init value reports "the audit blew up" and
        # "no mandatory read" in the same object — the silent proceed AM4 closes for a typo'd
        # --repo, reached through the other door.
        if obj.get("mandatory_read") is not True:
            fail("lp04-probe-directory-log-am17",
                 "an audit that RAISED must force the diff read: expected mandatory_read=True, "
                 "got %r" % (obj.get("mandatory_read"),))
        if obj.get("read_reason") != ["advisory-inputs-unavailable"]:
            fail("lp04-probe-directory-log-am17",
                 "expected ['advisory-inputs-unavailable'] exactly once; got %r"
                 % (obj.get("read_reason"),))

    # The hard-tier half of the same door: `hard-tier` can only have come from the init, which
    # runs BEFORE the try. A handler that ASSIGNS the list instead of appending loses it, and an
    # init moved inside the try never produced it. Order is asserted, not membership.
    obj = probe("lp04-probe-directory-log-hard",
                ["--slice", FIXTURE_SLICE, "--tier", "hard", "--log", dir_log])
    if obj is not None:
        if obj.get("read_reason") != ["hard-tier", "advisory-inputs-unavailable"]:
            fail("lp04-probe-directory-log-hard",
                 "expected ['hard-tier', 'advisory-inputs-unavailable'] in that order; got %r"
                 % (obj.get("read_reason"),))
        if obj.get("mandatory_read") is not True:
            fail("lp04-probe-directory-log-hard",
                 "got mandatory_read=%r" % (obj.get("mandatory_read"),))

# =============================================================================================
# (c) no artifact survives. The probe slice id is deliberately one no live slice can carry, so
# the removal below can never delete a real audit.
# =============================================================================================
try:
    if os.path.exists(FIXTURE_ARTIFACT):
        os.remove(FIXTURE_ARTIFACT)
except OSError as exc:
    fail("lp04-probe-cleanup", "could not remove %s: %s" % (FIXTURE_ARTIFACT, exc))
if os.path.exists(FIXTURE_ARTIFACT):
    fail("lp04-probe-cleanup", "%s survived the probe" % FIXTURE_ARTIFACT)

sys.exit(bad)
PYAUDIT
# lp-11a: POLYGLOT INTERPRETER GUARD on every python mr-* tool.
#
# `bash <a python file>` does not read the shebang — it interprets the source as shell, which
# executes any backticked prose in it as commands. That is not a hypothetical: it fired the
# operator's kill switch out of mr-hold's own docstring on 2026-08-17 and wedged the loop for 8
# hours. Line 2 of every python tool re-execs the file under python3, making the mis-invocation
# correct instead of catastrophic.
#
# The split below is deliberate and is itself a safety property. Real tools are checked STATICALLY
# (string compare on line 2) and are never executed under bash by this gate — running an unguarded
# copy under bash is precisely the accident being closed, so the checker must not be able to cause
# it. The behavioural proof that the guard actually WORKS runs against synthetic fixtures whose
# only side effect is a sentinel file in a temp dir, and it asserts BOTH directions: guarded => the
# hazard does not fire, unguarded => it does. Without that second assertion this is a decoration.
/usr/bin/python3 - "$MEM" <<'PYGUARD' || BAD=1
import os, subprocess, sys, tempfile
mem = sys.argv[1]
bad = 0
GUARD = '''\'\'\'\'exec /usr/bin/python3 "$0" "$@" # \'\'\''''

# --- static: every python mr-* tool carries the guard on line 2 ---
n = 0
for name in sorted(os.listdir(mem)):
    p = os.path.join(mem, name)
    if not name.startswith("mr-") or not os.path.isfile(p) or not os.access(p, os.X_OK):
        continue
    if any(s in name for s in (".bak", ".log", ".md", ".json")):
        continue
    try:
        lines = open(p, errors="replace").read().splitlines()
    except OSError:
        continue
    if not lines or "python" not in lines[0]:
        continue
    n += 1
    if len(lines) < 2 or lines[1].rstrip() != GUARD:
        print("SELFCHECK-FAIL polyglot-guard missing on line 2 of %s" % name)
        bad = 1
if n == 0:
    print("SELFCHECK-FAIL polyglot-guard scan matched ZERO python tools — the enumeration has rotted")
    bad = 1

# --- behavioural: prove the guard closes the hazard, and that this check can fail ---
BODY = '"""doc mentioning `touch %s` in backticks."""\nprint("PY-REACHED")\n'
with tempfile.TemporaryDirectory() as d:
    for guarded in (True, False):
        sent = os.path.join(d, "sentinel-%s" % guarded)
        tool = os.path.join(d, "probe-%s" % guarded)
        with open(tool, "w") as fh:
            fh.write("#!/usr/bin/python3\n" + (GUARD + "\n" if guarded else "") + BODY % sent)
        os.chmod(tool, 0o755)
        subprocess.run(["bash", tool], cwd=d, capture_output=True, timeout=30)
        fired = os.path.exists(sent)
        if guarded and fired:
            print("SELFCHECK-FAIL polyglot-guard did NOT stop bash from executing docstring prose")
            bad = 1
        if not guarded and not fired:
            print("SELFCHECK-FAIL polyglot-guard behavioural fixture is INERT "
                  "(unguarded copy did not fire the hazard, so the guarded pass proves nothing)")
            bad = 1
sys.exit(bad)
PYGUARD
# python heredocs embedded in bash wrappers. `bash -n` above cannot see inside them, yet that is
# where most of the real logic lives (mr-record's cost path, mr-native-tick's reconcile/gate-2/
# rate-limit-arming). Without this, a python syntax error in any of them ships silently and only
# surfaces at 03:00 from cron. Added with ADR-0011, whose own edits live in two of these blocks.
/usr/bin/python3 - "$MEM" <<'PYHD' || BAD=1
import ast, re, sys, os
mem = sys.argv[1]; bad = 0
# The opener regex MUST tolerate anything after the closing quote: mr-situation:14 is
# `python3 - <<'PY' > "$CACHE.tmp" 2>/dev/null || echo ...`, and a pattern anchored on \n right
# after the tag silently matched ZERO blocks there — leaving budget(), the governor itself,
# unchecked. A SyntaxError in that block degrades to GSTATE=UNKNOWN, which does NOT stand the
# loop down, so it would keep spawning $60-400 slices with no budget gate at all.
OPEN = re.compile(r"^[^\n]*python3[^\n]*<<-?'([A-Za-z0-9_]+)'[^\n]*$", re.M)
# A line whose first non-space character is `#` is a bash COMMENT and cannot open a heredoc.
# Skipping those is strictly correct, and it is load-bearing now that the scan set is derived:
# this very file documents `python3 - <<'PY'` inside a comment, and counting it produced an
# unpairable opener -> a coverage FAIL that was pure noise. A carve-out for mr-selfcheck would
# have hidden the same false positive in every other tool that documents a heredoc.
def _openers(src):
    # OPEN is ^-anchored, so m.group(0) IS the whole line — test that, not a prefix before it.
    return [m for m in OPEN.finditer(src) if not m.group(0).lstrip().startswith("#")]
# DERIVED, like the syntax set above: any bash wrapper may grow a python heredoc, and the old
# 7-name tuple would simply not scan a new one.
names = sorted(
    n for n in os.listdir(mem)
    if n.startswith("mr-")
    and not any(k in n for k in (".bak", ".log"))
    and not n.endswith((".md", ".json", ".jsonl"))
    and os.path.isfile(os.path.join(mem, n))
    and os.access(os.path.join(mem, n), os.X_OK)
)
if not names:
    print("SELFCHECK-FAIL py-heredoc-enumeration found zero tools — the enumeration has rotted")
    bad = 1
for name in names:
    p = os.path.join(mem, name)
    if not os.path.exists(p): continue
    src = open(p, errors="replace").read()
    openers = [m.group(1) for m in _openers(src)]; found = 0
    for tag in set(openers):
        pat = r"^[^\n]*python3[^\n]*<<-?'%s'[^\n]*\n(.*?)^\t*%s$" % (re.escape(tag), re.escape(tag))
        for m in re.finditer(pat, src, re.M | re.S):
            found += 1
            try: ast.parse(m.group(1))
            except SyntaxError as e:
                print("SELFCHECK-FAIL py-heredoc: %s <<%s line %s: %s" % (name, tag, e.lineno, e.msg))
                bad = 1
    # Coverage assertion: a scanner that silently matches nothing is worse than no scanner,
    # because it reports green. If openers exist that we failed to pair with a terminator,
    # the pattern has drifted — fail loudly rather than skip.
    if len(openers) != found:
        print("SELFCHECK-FAIL py-heredoc-coverage: %s has %d python-heredoc opener(s) but the "
              "scanner paired %d — pattern drift, blocks are going unchecked" % (name, len(openers), found))
        bad = 1
sys.exit(bad)
PYHD
grep -q "Feedback doctrine (ACTIVE" "$MEM/mr-supervisor-prompt-native.md" || { echo "SELFCHECK-FAIL SSOT doctrine pointer missing"; BAD=1; }
grep -q "ACTIVE 2026" "$MEM/mr-feedback-doctrine.md" || { echo "SELFCHECK-FAIL doctrine not ACTIVE"; BAD=1; }
