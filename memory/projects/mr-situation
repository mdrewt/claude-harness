#!/bin/bash
# mr-situation — one-shot JSON state bundle for supervisor ticks. HINTS-ONLY (re-verify before mutating).
# Contract: ALWAYS rc=0, ALWAYS valid JSON; failures become per-field "error:..." strings.
# Flags: --fresh (bypass 45s cache) · --no-gh (skip gh calls; for tests)
MEM=/home/mdrewt/projects/ai-apps/claude-harness/memory/projects
CACHE="$MEM/.situation-cache.json"
FRESH=0; NOGH=0
for a in "$@"; do case "$a" in --fresh) FRESH=1;; --no-gh) NOGH=1;; esac; done
if [ "$FRESH" = 0 ] && [ -f "$CACHE" ]; then
  AGE=$(( $(date +%s) - $(stat -c %Y "$CACHE") ))
  if [ "$AGE" -lt 45 ]; then cat "$CACHE"; exit 0; fi
fi
export MEM NOGH
/usr/bin/python3 - <<'PY' > "$CACHE.tmp" 2>/dev/null || echo '{"authority":"HINTS-ONLY","error":"situation-generator-crashed"}' > "$CACHE.tmp"
import json, os, glob, re, subprocess, time, datetime
# NOGH first so this line does NOT start with `MEM=`: fixtures replace the one shell-level `^MEM=`
# line above with a sandbox path and count exactly one substitution.
NOGH=os.environ.get("NOGH")=="1"; MEM=os.environ["MEM"]
out={"authority":"HINTS-ONLY (re-verify anything you are about to mutate)",
     "generated_at": datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")}
def safe(fn, default):
    try: return fn()
    except Exception as e: return "error:"+str(e)[:120] if isinstance(default,str) else default
def run(cmd, t=20):
    r=subprocess.run(cmd, shell=True, capture_output=True, text=True, timeout=t)
    return r.returncode, r.stdout.strip(), r.stderr.strip()
# NOTE (DRY, Drew 2026-07-24): the pause flag is deliberately NOT in this bundle. It is enforced solely by
# the wrapper's gate -1; status/fallback/watchers read the flag FILE directly. Decision runs never see it.
locks=[]
for L in glob.glob(MEM+"/.harness-runner.*.lock"):
    sl=os.path.basename(L)[len(".harness-runner."):-len(".lock")]
    try:
        d=json.load(open(L)); pid=d.get("session_leader")
        alive=False
        if pid:
            try: os.kill(int(pid),0); alive=True
            except Exception: alive=False
        locks.append({"slice":sl,"leader":pid,"alive":alive,"done":os.path.exists(f"/tmp/mr_pass_{sl}.done")})
    except Exception as e: locks.append({"slice":sl,"error":str(e)[:80]})
out["locks"]=locks
out["done_files"]=[os.path.basename(p) for p in glob.glob("/tmp/mr_pass_*.done")]
out["pending_events"]=sorted(os.path.basename(p) for p in glob.glob(MEM+"/pending-events/*.md"))
def ghpr():
    if NOGH: return "skipped:--no-gh"
    rc,so,se=run("gh pr list -R mdrewt/monster-realm --state open --json number,headRefName,mergeStateStatus", 25)
    if rc!=0: return "error:gh:"+se[:100]
    return json.loads(so or "[]")
out["open_prs"]=safe(ghpr,"error")
def masterci():
    # --workflow CI: Nightly runs also carry headBranch=master and are not the master CI result.
    if NOGH: return "skipped:--no-gh"
    rc,so,se=run("gh run list -R mdrewt/monster-realm -b master --workflow CI -L1 --json conclusion,status,displayTitle,headSha,attempt", 20)
    if rc!=0: return "error:gh:"+se[:100]
    return json.loads(so or "[]")
out["master_ci_latest"]=safe(masterci,"error")
rc,so,_=run(f"git -C /home/mdrewt/projects/ai-apps/claude-harness/projects/monster-realm rev-parse --short HEAD", 10)
out["master_sha_local"]=so if rc==0 else "error:git"
# budget
WEEKLY,SOFT,HARD,FGUARD,FALLOW=1250.0,0.90,0.97,0.45,625.0
try:
    _c=json.load(open(MEM+"/mr-budget-config.json"))
    _w,_s,_h,_f=float(_c["weekly_limit_usd"]),float(_c["soft_pause_frac"]),float(_c["hard_stop_frac"]),float(_c["fable_guard_frac"])
    _fa=float(_c.get("fable_allowance_usd") or 0.5*_w)
    if _w>0 and 0<_s<=_h<=1 and 0<_f<=1 and _fa>0: WEEKLY,SOFT,HARD,FGUARD,FALLOW=_w,_s,_h,_f,_fa
except Exception: pass  # fall back to defaults above
# What mr-spawn caps a launch at, per tier: with effective_usd and soft_pause_usd it is the whole
# per-launch budget check, so the session does not open the config file.
CAPS={"default":60}
try:
    _caps=json.load(open(MEM+"/mr-budget-config.json")).get("slice_caps_usd")
    if isinstance(_caps,dict) and _caps and all(isinstance(v,(int,float)) and not isinstance(v,bool) and v>0 for v in _caps.values()): CAPS=_caps
except Exception: pass
# REAL UTILISATION. The CLI's rate_limit_event rows (mr-cost-watch telemetry writes them) carry the
# plan's own figure per window: a 0..1 utilisation and the window's resetsAt. A window covers one
# model when its name carries the model or `telemetry_window_models` maps it, every model
# otherwise — mr-interrupted's scope rule. A window's reading is its newest sample among the rows
# whose resetsAt is still ahead, with the resetsAt that sample carries: the plan's latest word on
# the window decides, whichever reset time it names. It is in force by these rules:
#   - never once its resetsAt has passed: the window it measured is over and the next starts empty;
#   - as read, for FRESH_S after it was read. The figure moves both ways inside a window (the plan
#     restores credit mid-window), so an older reading is not acted on as if it were current;
#   - older than that and over the soft threshold: SOFT-PAUSE, whatever it read. On a window that
#     covers every model a decision session then runs, launches nothing new and leaves the next
#     sample; standing down on it (HARD-STOP) would leave no session to notice the figure fall.
#     A model's own window is sampled only by sessions on that model, so its entry carries
#     `stale` and `probe_every_s`: mr-spawn lets one launch on the model through per that period
#     to measure it and refuses the rest, and `fable_ok` stays false for escalations;
#   - older than that and under the soft threshold: not at all.
# With no reading in force for an axis the ledger's dollars against the calibrated limits decide.
TEL_TAIL=4<<20   # bytes of the telemetry file read: about a week of rows
FRESH_S=10800.0  # three hourly ticks: one decision session can hold the tick lock for 90 minutes
WMODELS={"seven_day_overage_included":"fable"}
try:
    _c=json.load(open(MEM+"/mr-budget-config.json"))
    _fs=_c.get("telemetry_fresh_s")
    if isinstance(_fs,(int,float)) and not isinstance(_fs,bool) and _fs>0: FRESH_S=float(_fs)
    _wm=_c.get("telemetry_window_models")
    if isinstance(_wm,dict): WMODELS=dict((str(k),str(v).lower()) for k,v in _wm.items())
except Exception: pass
ORDER=("NORMAL","SOFT-PAUSE","HARD-STOP")
def grade(frac): return "HARD-STOP" if frac>HARD else "SOFT-PAUSE" if frac>SOFT else "NORMAL"
def iso(e): return datetime.datetime.fromtimestamp(e,datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
def _num(v): return isinstance(v,(int,float)) and not isinstance(v,bool) and v==v
def window_model(name):
    for m in ("fable","opus","sonnet","haiku"):
        if re.search(r"(^|_)%s($|_)"%m, name): return m
    return WMODELS.get(name)
def real_utilisation(now):
    """{None or model: {window, u, resets, ts, stale, state}}: per axis, the worst reading in force."""
    wins={}
    try:
        with open(MEM+"/mr-rate-limit-telemetry.jsonl","rb") as f:
            f.seek(0,2); size=f.tell(); f.seek(max(0,size-TEL_TAIL)); data=f.read(TEL_TAIL)
    except OSError: return {}
    for raw in data.split(b"\n"):
        try:
            row=json.loads(raw.decode("utf-8","replace"))
            ts=datetime.datetime.strptime(row["ts"][:19],"%Y-%m-%dT%H:%M:%S").replace(tzinfo=datetime.timezone.utc).timestamp()
            ri=row.get("ri") if isinstance(row.get("ri"),dict) else {}
        except Exception: continue   # the tail's cut first line, or a torn row
        if ts>now+300: continue
        uw=ri.get("unifiedWindows")
        seen=dict((str(k),v) for k,v in uw.items() if isinstance(v,dict)) if isinstance(uw,dict) else {}
        seen.setdefault(str(row.get("rateLimitType")),{"utilization":row.get("utilization"),"resetsAt":row.get("resetsAt"),"status":row.get("status")})
        for name,w in seen.items():
            u,r=w.get("utilization"),w.get("resetsAt")
            if w.get("status")=="rejected" and not (_num(u) and u>1): u=1.0
            if not (_num(u) and u>=0 and _num(r)): continue
            if r>1e11: r=r/1000.0
            if r<=now or r>now+8*86400: continue   # a window that is over, or not a reset time
            wins.setdefault(name,[]).append((ts,r,float(u)))
    best={}
    for name,rows in wins.items():
        # One tick reads several logs a second or two apart, each ending on its own last event:
        # the newest reading is the highest of that pass.
        ts,r,_u=max(rows)
        w={"window":name,"resets":r,"ts":ts,"u":max(u for t,rr,u in rows if rr==r and t>=ts-60)}
        m=window_model(name); w["stale"]=now-ts>FRESH_S
        if w["stale"] and w["u"]<=SOFT: continue
        w["state"]="SOFT-PAUSE" if w["stale"] else grade(w["u"])
        key=lambda x: (ORDER.index(x["state"]),x["u"],x["resets"])
        if m not in best or key(w)>key(best[m]): best[m]=w
    return best
def budget():
    now=time.time()
    ws=now-7*86400
    wend=None   # known only for an anchored window; a rolling one has no moment at which it resets
    try:
        a=float(open(MEM+"/.weekly-reset-anchor").read().strip())
        if a<=now: ws=a+int((now-a)//(7*86400))*7*86400; wend=ws+7*86400
    except Exception: pass
    d7=0.0; fab=0.0; latest={}
    for l in open(MEM+"/monster-realm-usage-ledger.jsonl"):
        l=l.strip()
        if not l: continue
        try: d=json.loads(l)
        except Exception: continue
        ts=d.get("ts") or ""
        try: e=datetime.datetime.strptime(ts[:19],"%Y-%m-%dT%H:%M:%S").replace(tzinfo=datetime.timezone.utc).timestamp()
        except Exception: continue
        sl=str(d.get("slice")); latest[sl]=d
        if e<ws: continue
        try: c=float(d.get("cost_usd") or 0)
        except (TypeError,ValueError): c=0.0
        d7+=c
        if "fable" in str(d.get("model","")).lower(): fab+=c
    unrec=0
    for df in glob.glob("/tmp/mr_pass_*.done"):
        sl=os.path.basename(df)[len("mr_pass_"):-len(".done")]
        last=latest.get(sl)
        if last is None or str(last.get("outcome","")).upper().startswith("LAUNCH"): unrec+=1
    for L in glob.glob(MEM+"/.harness-runner.*.lock"):
        sl=os.path.basename(L)[len(".harness-runner."):-len(".lock")]
        if os.path.exists(f"/tmp/mr_pass_{sl}.done"): continue
        try:
            pid=json.load(open(L)).get("session_leader")
            os.kill(int(pid),0)
        except Exception:
            unrec+=1
    est=0.0
    for df in glob.glob("/tmp/mr_pass_*.done"):
        sl=os.path.basename(df)[len("mr_pass_"):-len(".done")]
        last=latest.get(sl)
        if last is None or str(last.get("outcome","")).upper().startswith("LAUNCH"):
            try: t=json.load(open(MEM+f"/.harness-runner.{sl}.lock")).get("tier","routine")
            except Exception: t="routine"
            est+={"hard":90.0,"routine":25.0,"content":35.0}.get(str(t),25.0)
    # in-flight committed exposure: live runs have spent tokens the ledger cannot see yet.
    # Rough per-tier medians (from ledger history); matters at N>=3 where 4 slices ~ $300 committed.
    tier_est={"hard":90.0,"routine":25.0,"content":35.0}
    committed=0.0; live=0
    for L in glob.glob(MEM+"/.harness-runner.*.lock"):
        sl=os.path.basename(L)[len(".harness-runner."):-len(".lock")]
        if os.path.exists(f"/tmp/mr_pass_{sl}.done"): continue
        try:
            lk=json.load(open(L)); pid=lk.get("session_leader")
            os.kill(int(pid),0)
            committed+=tier_est.get(str(lk.get("tier","routine")),25.0); live+=1
        except Exception: pass
    # `source` names what is in force. On telemetry `effective_usd` is the real utilisation put on
    # the dollar scale (x weekly_limit_usd), so the per-launch check against `soft_pause_usd` and
    # `tier_caps_usd` reads one scale either way; a live run's spend is already in the utilisation.
    eff=d7+est+committed
    state=grade(eff/WEEKLY); source="calibration"; real={}; resets=iso(wend) if wend else None
    try: tel=real_utilisation(now)
    except Exception: tel={}
    g=tel.get(None)
    if g:
        state=g["state"]; source="telemetry-stale" if g["stale"] else "telemetry"; eff=g["u"]*WEEKLY; resets=iso(g["resets"])
        real={"utilisation":g["u"],"window":g["window"],"sample_utc":iso(g["ts"])}
    # A model with a window of its own in force: the worse of that window and the state above.
    models={}
    for m,w in tel.items():
        if m is None: continue
        models[m]={"state":max(w["state"],state,key=ORDER.index),"utilisation":w["u"],"window":w["window"],"resets_at_utc":iso(w["resets"])}
        if w["stale"]: models[m].update({"stale":True,"sample_utc":iso(w["ts"]),"probe_every_s":FRESH_S})
    fable_ok=models["fable"]["state"]=="NORMAL" if "fable" in models else fab < FGUARD*FALLOW
    out={"window_start_utc":iso(ws),"window_end_utc":iso(wend) if wend else None,"d7_usd":round(d7,2),"fable_d7_usd":round(fab,2),"unreconciled_runs":unrec,
            "unreconciled_est_usd":est,"inflight_committed_est_usd":round(committed,2),"inflight_runs":live,"effective_usd":round(eff,2),"weekly_limit_usd":WEEKLY,
            "soft_pause_frac":SOFT,"hard_stop_frac":HARD,"soft_pause_usd":round(SOFT*WEEKLY,2),"tier_caps_usd":CAPS,"fable_guard_frac":FGUARD,
            "fable_allowance_usd":FALLOW,"fable_guard_usd":round(FGUARD*FALLOW,2),"fable_ok":fable_ok,"source":source}
    out.update(real)
    out.update({"resets_at_utc":resets,"model_states":models,"state":state})
    return out
b=safe(budget,{"state":"UNKNOWN","error":"budget-computation-failed"})
if not isinstance(b,dict) or "state" not in b: b={"state":"UNKNOWN","error":str(b)[:120]}
out["budget"]=b
def state_extra():
    d=json.load(open(MEM+"/mr-state.json")); return d.get("rate_limit_resets_at")
out["rate_limit_resets_at"]=safe(state_extra,"error")
# The slices a credit stop interrupted (mr-interrupted's record): `due` entries are resumed first.
def interrupted():
    r=subprocess.run([MEM+"/mr-interrupted","list"], capture_output=True, text=True, timeout=20)
    return json.loads(r.stdout)
out["interrupted"]=safe(interrupted,"error")
def lastfail():
    p=MEM+"/.native-supervisor-last-failure"
    return open(p).read().strip() if os.path.exists(p) else None
out["last_failure"]=safe(lastfail,"error")
def blockers():
    rc,so,_=run(f"tail -c 20000 '{MEM}/monster-realm-handoff.md' | grep -n 'BLOCKER' | tail -5", 10)
    return [x[:200] for x in so.splitlines()] if so else []
out["recent_blockers"]=safe(blockers,[])
def watchers():
    rc,so,_=run("pgrep -af 'mr-ci-watch|mr-reset-watch' | grep -v grep", 5)
    return so.splitlines() if so else []
out["live_watchers"]=safe(watchers,[])
# A close census section (`mr-prune close`, run by mr-record's MERGED-row hook) waits under
# prune/close/ until the doc-only PR that deletes its milestone's spec appends it to
# structure.spec.md; once the spec is gone from the corpus the entry is gone too.
def prune_close():
    corpus=os.path.join(os.path.dirname(os.path.dirname(MEM)),"specs","monster-realm-v2")
    entries=[]
    for p in sorted(glob.glob(os.path.join(glob.escape(MEM),"prune","close","*.section.md"))):
        label=os.path.basename(p)[:-len(".section.md")]
        if os.path.isfile(os.path.join(corpus,label+".spec.md")):
            entries.append({"milestone":label,"section_file":p,
                            "action":"append to structure.spec.md in the doc-only PR that deletes %s.spec.md"%label})
    return entries
out["prune_close"]=safe(prune_close,[])
print(json.dumps(out, indent=1))
PY
mv "$CACHE.tmp" "$CACHE"
cat "$CACHE"
exit 0
