def selftest():
    stages = (
        ("classification", lambda tmp: assert_f3_classification()),
        ("ci-red", lambda tmp: assert_f10_ci_never_greens_a_red()),
        ("ci-map", lambda tmp: assert_f11_ci_mapping()),
        ("ci-absent", lambda tmp: assert_f12_absent_ci()),
        ("is-closing", lambda tmp: assert_is_closing()),
        ("worktree-path", lambda tmp: assert_worktree_path_for()),
        ("skills", assert_f16_skills),
        ("ears", assert_f17_ears),
        ("bad-slice-ids", assert_f18_bad_slice_ids),
        ("repo", assert_repo_fixtures),
        ("degeneracy", lambda tmp: assert_f8_degeneracy()),
        ("vacuity", lambda tmp: assert_f9_vacuity()),
        ("fold", lambda tmp: assert_f19_fold_per_slice()),
        ("static", lambda tmp: assert_no_shell_true()),
    )
    for name, fn in stages:
        try:
            with tempfile.TemporaryDirectory(prefix="mr-slice-quality-%s-" % name) as tmp:
                fn(tmp)
        except Exception as exc:  # noqa: BLE001 — a stage must report, never traceback
            check(False, "STAGE-%s" % name,
                  "the fixture stage itself raised %s: %s" % (type(exc).__name__, exc))

    for path in _WATCHED:
        hits = _fixture_bytes_in(path)
        check(not hits, "P1-no-pollution[%s]" % os.path.basename(path),
              "%s contains fixture marker(s) %s — a fixture reached the real corpus instead of its "
              "tempdir. The ledger is append-only (ADR-0011) and a test row in it is unremovable."
              % (path, hits))
    leftovers = _fixture_leftovers_in_mem()
    check(not leftovers, "P1-no-fixture-leftovers-in-MEM",
          "the selftest left fixture artifact(s) in %s: %s" % (MEM, leftovers))

    if _FAILURES:
        for id_, detail in _FAILURES:
            line = "SLICE-QUALITY-SELFTEST-FAIL %s" % id_
            if detail:
                line += ": %s" % detail
            print(line)
        print("SLICE-QUALITY-SELFTEST-FAIL summary: %d of %d assertion(s) failed"
              % (len(_FAILURES), _ASSERTIONS))
        return 1
    print("SLICE-QUALITY-SELFTEST-OK %d assertions" % _ASSERTIONS)
    return 0


