# F16 — skills_invoked. Synthetic stream-json logs. Exercised BOTH as a unit and THROUGH derive:
# replacing derive's call to this counter with a literal `None` scored 418/419 against the previous
# battery, because nothing ever asserted a non-null value coming out of derive.
# =================================================================================================
def _assistant_event(blocks, msg_id):
    return json.dumps({
        "type": "assistant",
        "message": {"id": msg_id, "role": "assistant", "content": blocks},
        "session_id": "fixture",
    })


def _skill_block(block_id, name="Skill"):
    return {"type": "tool_use", "id": block_id, "name": name, "input": {"command": "code-intel"}}


def _build_skill_log_real():
    """Returns (log_text, expected_count). The count is DERIVED from the block ids written, so the
    fixture and its expectation cannot drift apart.

    Shape: one block repeated with the SAME id (streaming), TWO distinct blocks inside ONE message
    (which is why the dedupe key must be the BLOCK id, not the message id), a `Read` block, a
    `SkillJump` block (the exact-name rule), prose, garbage and a blank line."""
    ids = ["toolu_A", "toolu_B", "toolu_C", "toolu_D", "toolu_E"]
    lines = [
        json.dumps({"type": "system", "subtype": "init", "tools": ["Task", "Bash", "Skill", "Read"]}),
        _assistant_event([{"type": "text", "text": "planning"}], "msg_0"),
        _assistant_event([_skill_block(ids[0])], "msg_1"),
        _assistant_event([_skill_block(ids[0])], "msg_1"),      # streaming duplicate, same block id
        _assistant_event([_skill_block(ids[1]), _skill_block("toolu_R", name="Read")], "msg_2"),
        "",                                                      # blank line, must not raise
        "{ this line is not json at all",                        # garbage, must not raise
        _assistant_event([_skill_block(ids[2])], "msg_3"),
        # TWO DISTINCT Skill blocks in ONE assistant message. A dedupe keyed on the message id
        # counts these as one and reports 4.
        _assistant_event([_skill_block(ids[3]), _skill_block(ids[4])], "msg_4"),
        # NEGATIVE CONTROL for the exact-name rule: a different tool whose name merely starts with
        # `Skill`. A `startswith`/`in` name test counts it and reports 6.
        _assistant_event([_skill_block("toolu_J", name="SkillJump")], "msg_5"),
        json.dumps({"type": "user", "message": {"role": "user", "content": [
            {"type": "tool_result", "tool_use_id": ids[2], "content": "the Skill returned ok"}]}}),
    ]
    return "\n".join(lines) + "\n", len(ids)


def _build_skill_log_prose():
    """ZERO Skill tool_use blocks, but the WORD `Skill` everywhere a substring counter would find
    it: the init event's tool allowlist, assistant prose, a tool_result echoing a log line that
    itself contains `"name":"Skill"` (a log-of-a-log), and a Rust type name. Measured in the real
    corpus: 69 occurrences of the word in one pass log for a slice that invoked zero."""
    inner = '{"type":"tool_use","id":"toolu_X","name":"Skill"}'
    lines = [
        json.dumps({"type": "system", "subtype": "init",
                    "tools": ["Task", "Bash", "Skill", "Read", "Edit"]}),
        _assistant_event([{"type": "text",
                           "text": "I could use the Skill tool here. Skill Skill Skill /simplify."}],
                         "msg_0"),
        json.dumps({"type": "user", "message": {"role": "user", "content": [
            {"type": "tool_result", "tool_use_id": "t1",
             "content": "stdout: ... " + inner + " ... 3 matches"}]}}),
        _assistant_event([{"type": "tool_use", "id": "toolu_Y", "name": "Read",
                           "input": {"file_path": "server/src/skill.rs",
                                     "pattern": "SkillRow SkillDef Skill"}}], "msg_1"),
    ]
    return "\n".join(lines) + "\n"


def assert_f16_skills(tmp):
    real_text, real_expected = _build_skill_log_real()
    real = os.path.join(tmp, "mr_pass_f16real.log")
    _write(real, real_text)
    ok, got = call(count_skill_invocations, real)
    if ok:
        check(got == real_expected, "F16-real-blocks",
              "expected %d distinct Skill tool_use block ids. %d means the streaming duplicate was "
              "counted twice; %d means the dedupe key is the MESSAGE id (the two blocks in msg_4 "
              "collapsed); %d means a startswith/substring name test counted the SkillJump block. "
              "got %r" % (real_expected, real_expected + 1, real_expected - 1,
                          real_expected + 1, got))
    else:
        check(False, "F16-real-blocks", got)

    prose = os.path.join(tmp, "mr_pass_f16prose.log")
    _write(prose, _build_skill_log_prose())
    ok, got = call(count_skill_invocations, prose)
    if ok:
        check(got == 0, "F16-prose-only",
              "expected 0 — every occurrence of the word `Skill` here is an allowlist entry, prose, "
              "a log-of-a-log tool_result or a Rust type name; a substring counter returns >=5. "
              "got %r" % (got,))
    else:
        check(False, "F16-prose-only", got)

    absent = os.path.join(tmp, "mr_pass_f16absent.log")
    ok, got = call(count_skill_invocations, absent)
    if ok:
        check(got is None, "F16-absent-log-null",
              "an ABSENT log must yield None, never 0 — `no log` and `a run that used no skills` "
              "are different facts (A2). got %r" % (got,))
    else:
        check(False, "F16-absent-log-null", got)

    empty = os.path.join(tmp, "mr_pass_f16empty.log")
    _write(empty, "")
    ok, got = call(count_skill_invocations, empty)
    if ok:
        check(got is None, "F16-empty-log-null",
              "a log with zero parseable JSON objects is indistinguishable from an unwritten one "
              "and must yield None, not 0. got %r" % (got,))
    else:
        check(False, "F16-empty-log-null", got)


