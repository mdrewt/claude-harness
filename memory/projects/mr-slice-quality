              "`git status --porcelain` is non-empty, so quality_source must be 'partial'; got %r"
              % (d.get(QUALITY_KEY),))
        for col in ("files_changed", "prod_lines_added", "prod_lines_deleted", "test_lines_added"):
            check(d.get(col) is None, "F5-%s-null" % col,
                  "a dirty tree's diff columns must be None, not the committed-only number "
                  "(%s=%r) and certainly not 0" % (col, d.get(col)))
        check(d.get("ears_criteria_count") == EXPECT_A_EARS, "F5-ears-still-measured",
              "`partial` scopes the DIFF measurement only — ears_criteria_count comes from the spec "
              "and is unaffected by a dirty tree; expected %d, got %r"
              % (EXPECT_A_EARS, d.get("ears_criteria_count")))
        check(d.get("skills_invoked") == fx["skills_a"], "F5-skills-still-measured",
              "`partial` scopes the DIFF measurement only; skills_invoked must still be %d, got %r"
              % (fx["skills_a"], d.get("skills_invoked")))
        check(isinstance(d.get("reason"), str) and d.get("reason"), "F5-reason",
              "`partial` must carry a non-empty reason for the QUALITY(partial): ... note; got %r"
              % (d.get("reason"),))
    os.remove(scratch)

    # ---------------------------------------------------------------------------------------------
    # F4b — THE HEADLINE TOOTH (plan R-C, anti-pattern A2).
    #
    # Remove the worktree but leave its directory in place, which is the shape production actually
    # produces: `.claude/worktrees/` lives INSIDE the harness repo, the worktree is deleted BEFORE
    # the MERGED row is written, and the enclosing repo remains. `git -C <that path>` then walks UP
    # to <root>, returns rc 0, and — because <root>'s HEAD is `main` — reports an EMPTY diff.
    #
    # A "check isdir, then check returncode" implementation therefore emits
    #     files_changed=0 prod_lines_added=0 ... quality_source=derived
    # confidently, about a tree it never inspected. That is A2 in its purest form and it is the
    # NORMAL post-merge state. Only an IDENTITY assertion (rev-parse --show-toplevel == the
    # resolved worktree path) catches it.
    # ---------------------------------------------------------------------------------------------
    rc, _o, _err = _git(root, ["worktree", "remove", "--force", wt_a], env)
    if rc != 0:
        shutil.rmtree(wt_a, ignore_errors=True)
        _git(root, ["worktree", "prune"], env)
    os.makedirs(wt_a, exist_ok=True)   # exists, but is NOT a worktree — the walk-up shape
    rc_top, top, _e = _safe_run(["git", "-C", wt_a, "rev-parse", "--show-toplevel"], env=env)
    check(rc_top == 0 and os.path.realpath(top.strip() or "/nonexistent") == os.path.realpath(root),
          "F4b-fixture-is-live",
          "the fixture no longer reproduces the walk-up (rc=%r toplevel=%r, expected %r) — without "
          "it F4b proves nothing" % (rc_top, top.strip(), root))
    d = _derive_dict("F4b-worktree-walks-up", FX_SLICE, root, log_dir)
    if d is not None:
        check(d.get(QUALITY_KEY) == "unavailable", "F4b-quality-source",
              "the resolved path is inside the ENCLOSING repo, not the slice worktree, so the row "
              "is unmeasurable: expected quality_source='unavailable', got %r. 'derived' here means "
              "the identity assertion (rev-parse --show-toplevel) is missing" % (d.get(QUALITY_KEY),))
        for col in COLUMNS:
            check(col in d and d.get(col) is None, "F4b-%s-null-not-zero" % col,
                  "expected %s PRESENT and None; got %r. A 0 is the fabricated zero R-C describes — "
                  "git walked up into <root>, whose HEAD is `main`, and honestly reported an empty "
                  "diff for the wrong tree" % (col, d.get(col)))
        check(isinstance(d.get("reason"), str) and d.get("reason"), "F4b-reason",
              "`unavailable` must carry a non-empty reason; got %r" % (d.get("reason"),))

    # ---------------------------------------------------------------------------------------------
    # F4a — the simpler direction: the path does not exist at all.
    # ---------------------------------------------------------------------------------------------
    shutil.rmtree(wt_a, ignore_errors=True)
    d = _derive_dict("F4a-worktree-absent", FX_SLICE, root, log_dir)
    if d is not None:
        check(d.get(QUALITY_KEY) == "unavailable", "F4a-quality-source",
              "an absent worktree is `unavailable`; got %r" % (d.get(QUALITY_KEY),))
        for col in COLUMNS:
            check(col in d and d.get(col) is None, "F4a-%s-null-not-zero" % col,
                  "expected %s PRESENT and None, got %r" % (col, d.get(col)))


# =================================================================================================
# F8/F9/F19 — variance. Pure: rows in, (rc, lines) out. No ledger is read or written.
# =================================================================================================
def _healthy_rows():
    """Ten post-cutover closing rows, one per slice, every column varied and every
    `master_ci_after` CONFORMANT. Nothing in this fixture sits on a threshold boundary: the
    boundary cases live in their own fixtures so that a single off-by-one there cannot move twenty
    unrelated assertions."""
    fc = [3, 7, 12, 5, 9, 2, 14, 6, 8, 11]
    pa = [40, 120, 15, 300, 7, 55, 220, 18, 90, 5]
    pd = [2, 30, 1, 11, 4, 60, 7, 3, 22, 9]
    ta = [10, 4, 45, 120, 8, 33, 2, 17, 60, 25]
    ec = [4, 5, 3, 6, 4, 7, 5, 3, 4, 6]
    sk = [1, 5, 2, 3, 1, 2, 4, 1, 6, 3]
    rows = []
    for i in range(10):
        rows.append({
            "ts": "2026-08-1%dT00:00:00Z" % (i % 10),
            "slice": "fx-%02d" % i,
            "outcome": "FINISHED(EXIT=0)",
            "quality_source": "derived",
            # Derived from the vocabulary, never hand-listed, so a change to CI_CONFORMANT cannot
            # leave a stale literal behind.
            "master_ci_after": CI_CONFORMANT[i % len(CI_CONFORMANT)],
            "files_changed": fc[i],
            "prod_lines_added": pa[i],
            "prod_lines_deleted": pd[i],
            "test_lines_added": ta[i],
            "ears_criteria_count": ec[i],
            "skills_invoked": sk[i],
        })
    return rows


def _mutate(rows, col, values):
    out = []
    for i, r in enumerate(rows):
        d = dict(r)
        d[col] = values[i]
        out.append(d)
    return out


def _run_variance(label, rows):
    """Returns (rc, lines) or (None, []) after recording a failure."""
    ok, got = call(variance, rows)
    if not ok:
        check(False, label, got)
        return None, []
    if not check(isinstance(got, tuple) and len(got) == 2, label,
                 "variance must return (exit_code, lines), got %r" % (got,)):
        return None, []
    rc, lines = got
    if not check(isinstance(lines, (list, tuple)), label,
                 "variance's second element must be a list of report lines, got %r" % (type(lines),)):
        return None, []
    return rc, list(lines)


def _degen_line(lines, col, kind=None):
    for ln in lines:
        s = str(ln)
        if not s.startswith("DEGENERATE"):
            continue
        if col in s and (kind is None or kind in s):
            return s
    return None


def _check_degenerate(lines, col, kind, label):
    """One DEGENERATE line naming that column and EXACTLY that kind.

    The exclusivity half is not pedantry: a single blob line listing all four kind tokens satisfies
    every kind assertion in this file while discriminating nothing, and that shape was built and
    scored. The ladder's ORDER is what the kind token reports, so it must be singular."""
    ln = _degen_line(lines, col, kind)
    if not check(ln is not None, label,
                 "no `DEGENERATE ... %s ... %s` line; lines=%s" % (col, kind, lines)):
        return
    others = [k for k in DEGEN_KINDS if k != kind and k in ln]
    check(not others, label + "-single-kind",
          "the DEGENERATE line for %s names %s in addition to %s — a line naming several kinds "
          "reports no verdict at all: %r" % (col, others, kind, ln))


def _has_token(lines, token):
    """Substring match ANCHORED on the right, so `n_slices=10` does not match `n_slices=100`."""
    pat = re.compile(re.escape(token) + r"(?![0-9A-Za-z._-])")
    return any(pat.search(str(ln)) for ln in lines)


def _ok_line(lines, col):
    for ln in lines:
        s = str(ln)
        if s.startswith("OK ") and re.search(r"\bOK\s+" + re.escape(col) + r"\b", s):
            return s
    return None


def assert_f8_degeneracy():
    healthy = _healthy_rows()

    rc, lines = _run_variance("F8-healthy", healthy)
    if rc is not None:
        check(rc == 0, "F8-healthy",
              "a healthy 10-slice fixture must exit 0; got %r. lines=%s" % (rc, lines[:14]))
        check(_has_token(lines, "n_slices=10"), "F8-healthy-n-slices",
              "the report must carry `INFO n_slices=10`; lines=%s" % (lines[:14],))
        check(_has_token(lines, "quality_source"), "F8-healthy-quality-distribution",
              "the quality_source distribution is a FIRST-CLASS line (R-F: the missingness is "
              "non-random and correlates with well-behaved slices); lines=%s" % (lines[:14],))
        check(_has_token(lines, "unavailable_rate"), "F8-healthy-unavailable-rate",
              "the unavailable rate is a first-class line (R-F); lines=%s" % (lines[:14],))
        # E4's SUCCESS output. Without this a `variance` that prints three INFO lines and exits 0
        # satisfies "print a variance summary" while reporting nothing per column.
        for col in COLUMNS:
            ln = _ok_line(lines, col)
            check(ln is not None and "null_rate=" in ln and "distinct=" in ln,
                  "E4-ok-line[%s]" % col,
                  "every column needs an `OK <col> ... null_rate=... distinct=...` line on a "
                  "healthy run — `healthy` must be a reported measurement, not silence. got %r"
                  % (ln,))

    rc, lines = _run_variance("F8-all-null", _mutate(healthy, "files_changed", [None] * 10))
    if rc is not None:
        check(rc == 1, "F8-all-null", "an all-null column must exit 1 DEGENERATE; got %r" % rc)
        _check_degenerate(lines, "files_changed", "all-null", "F8-all-null-named")

    rc, lines = _run_variance("F8-all-identical", _mutate(healthy, "files_changed", [5] * 10))
    if rc is not None:
        check(rc == 1, "F8-all-identical",
              "an all-identical column must exit 1 DEGENERATE (the spec's literal Tests clause); "
              "got %r" % rc)
        _check_degenerate(lines, "files_changed", "all-identical", "F8-all-identical-named")

    # half-null: 5 nulls, 5 DISTINCT non-nulls, so only the >=0.5 null_rate clause can fire. This
    # clause descends directly from the measured 65.8%-empty master_ci_after — without it that
    # column would have passed as "has variance".
    rc, lines = _run_variance(
        "F8-half-null",
        _mutate(healthy, "files_changed", [3, 7, 12, 5, 9, None, None, None, None, None]))
    if rc is not None:
        check(rc == 1, "F8-half-null",
              "null_rate == 0.5 must exit 1 DEGENERATE(half-blind); got %r. A `> 0.5` comparison "
              "instead of `>= 0.5` passes this and is the bug the fixture is aimed at" % rc)
        _check_degenerate(lines, "files_changed", "half-blind", "F8-half-null-named")

    rc, lines = _run_variance("F8-all-zero", _mutate(healthy, "skills_invoked", [0] * 10))
    if rc is not None:
        check(rc == 1, "F8-all-zero",
              "an all-zero column must exit 1 — `0` is non-null and passes every null-based test, "
              "which is exactly the A2 hole; got %r" % rc)
        # all-identical fires first on the ladder; the kind is asserted rather than assumed.
        _check_degenerate(lines, "skills_invoked", "all-identical", "F8-all-zero-named")

    # zero_rate EXACTLY 0.5, with distinct>1 so all-identical cannot fire: the `>` vs `>=` twin of
    # the half-null boundary above.
    rc, lines = _run_variance(
        "F8-zero-rate-boundary",
        _mutate(healthy, "skills_invoked", [0, 0, 0, 0, 0, 2, 3, 4, 5, 6]))
    if rc is not None:
        check(rc == 1, "F8-zero-rate-boundary",
              "zero_rate == 0.5 must exit 1 DEGENERATE(silent-zero-suspect); got %r. A `> 0.5` "
              "comparison passes this" % rc)
        _check_degenerate(lines, "skills_invoked", "silent-zero-suspect", "F8-zero-rate-boundary-named")

    rc, lines = _run_variance("F8-below-floor", healthy[:7])
    if rc is not None:
        check(rc == 2, "F8-below-floor",
              "7 slices is below N_MIN_SLICES=%d and must exit 2 INSUFFICIENT-DATA — NOT 0. "
              "Conflating `no data yet` with `collapsed schema` is the dishonesty this slice "
              "exists to remove; got %r" % (N_MIN_SLICES, rc))
        check(_has_token(lines, "INSUFFICIENT-DATA"), "F8-below-floor-named",
              "the report must say INSUFFICIENT-DATA; lines=%s" % (lines,))
        check(_has_token(lines, "n_slices=7"), "F8-below-floor-count",
              "the report must state n_slices=7; lines=%s" % (lines,))


def assert_e3_conformance():
    """E3 with teeth (orchestrator decision B). The denominator is POST-CUTOVER rows only — those
    carrying a `quality_source` key — and NON-CONFORMANT means `master_ci_after` is not an actual
    verdict: `unknown`, `not-recorded`, `""`, an absent key and any surviving legacy raw string all
    count against it.

    Counting only the two labels `unknown`/`not-recorded` scores the motivating corpus at 0.000 and
    passes, which is how a column that is empty on 65.8% of rows survived the original design."""
    # Boundary: exactly 1 of 10 == 0.10, which is NOT > 0.10 -> still green. Kept in its own
    # fixture so a threshold off-by-one cannot silently move the healthy battery.
    ci = [CI_CONFORMANT[i % len(CI_CONFORMANT)] for i in range(10)]
    ci[9] = "unknown"
    rc, lines = _run_variance("E3-boundary-exactly-10pct", _mutate(_healthy_rows(), "master_ci_after", ci))
    if rc is not None:
        check(rc == 0, "E3-boundary-exactly-10pct",
              "exactly 0.10 non-conformant is NOT > 0.10 and must stay green, so the threshold "
              "cannot be satisfied by always failing; got %r" % rc)

    # Over threshold, via the two labels.
    ci2 = list(ci)
    ci2[8] = "not-recorded"
    rc, lines = _run_variance("E3-over-threshold-labels",
                              _mutate(_healthy_rows(), "master_ci_after", ci2))
    if rc is not None:
        check(rc == 1, "E3-over-threshold-labels",
              "2 of 10 post-cutover rows carrying unknown/not-recorded is 0.20 > 0.10 and must "
              "exit 1 (a report with no threshold is not a gate); got %r" % rc)
        check(_degen_line(lines, "master_ci_after") is not None, "E3-over-threshold-named",
              "the report must name master_ci_after; lines=%s" % (lines,))

    # THE S2 KILLER: over threshold via values that are neither label — a legacy raw string, an
    # empty string, and an ABSENT key. An implementation counting only the two labels scores 0.000
    # here and passes.
    rows = _healthy_rows()
    rows[0]["master_ci_after"] = "GREEN@15bd08b"      # a real, surviving legacy raw string
    rows[1]["master_ci_after"] = ""
    del rows[2]["master_ci_after"]                     # key absent entirely
    rc, lines = _run_variance("E3-nonconformant-not-just-labels", rows)
    if rc is not None:
        check(rc == 1, "E3-nonconformant-not-just-labels",
              "3 of 10 post-cutover rows carry a value outside %s (a legacy raw string, \"\" and an "
              "absent key) — 0.30 > 0.10 and must exit 1; got %r. Counting only the `unknown` and "
              "`not-recorded` LABELS scores the motivating corpus at 0.000 and passes"
              % (list(CI_CONFORMANT), rc))
        check(_degen_line(lines, "master_ci_after") is not None,
              "E3-nonconformant-not-just-labels-named",
              "the report must name master_ci_after; lines=%s" % (lines,))

    # SCOPE: pre-cutover rows (no `quality_source` key) are outside the denominator entirely. Five
    # legacy rows with raw CI strings must NOT drag the rate over the threshold — that scoping is
    # what stops this gate from being tuned to fail against its own history.
    legacy = []
    legacy_ci = ["GREEN@15bd08b", "success (348326ba)", "n/a (no merge this tick)",
                 "in_progress", ""]
    for i, raw in enumerate(legacy_ci):
        legacy.append({"ts": "2026-07-0%dT00:00:00Z" % (i + 1), "slice": "legacy-%d" % i,
                       "outcome": "MERGED", "master_ci_after": raw})
    rc, lines = _run_variance("E3-pre-cutover-excluded", _healthy_rows() + legacy)
    if rc is not None:
        check(rc == 0, "E3-pre-cutover-excluded",
              "rows with no `quality_source` key are PRE-cutover and are not part of the E3 "
              "denominator; 5 legacy raw strings alongside 10 conformant post-cutover rows must "
              "stay green, got %r. (Their missing columns raise null_rate to 5/15 = 0.33, which is "
              "below the 0.5 half-blind clause, so this fixture isolates the CI scope.)" % rc)


def assert_f9_vacuity():
    """F9 — THE VACUITY SWEEP. Every column against every degeneracy shape.

    Kills: an implementation that ladders `files_changed` and reports OK for everything else (the
    cheapest way to pass F8); one that iterates a hardcoded subset of the columns; and one that
    implements only the clause the previous battery happened to exercise per column — `all-identical`
    used to be tested on `files_changed` alone and the zero clauses on `skills_invoked` alone."""
    healthy = _healthy_rows()
    shapes = (
        ("all-null", [None] * 10),
        ("all-identical", [5] * 10),
        ("half-blind", [3, 7, 12, 5, 9, None, None, None, None, None]),
        # zero_rate exactly 0.5 with distinct>1, so the silent-zero clause is the only one that
        # can fire — the per-column form of the `>` vs `>=` boundary.
        ("silent-zero-suspect", [0, 0, 0, 0, 0, 2, 3, 4, 5, 6]),
    )
    for col in COLUMNS:
        for kind, values in shapes:
            lab = "F9-%s[%s]" % (kind, col)
            rc, lines = _run_variance(lab, _mutate(healthy, col, values))
            if rc is None:
                continue
            check(rc == 1, lab,
                  "%s shaped as %s must exit 1 DEGENERATE; got %r" % (col, kind, rc))
            _check_degenerate(lines, col, kind, lab + "-named")


def assert_f19_fold_per_slice():
    """F19 — one observation per slice.

    (a) Every slice gets a later `replayed` row. If the fold takes the last row rather than
        preferring `derived`, HALF of them are null and the other half are all 999 — either clause
        REDs. A correct fold sees the original ten and exits 0. This is a VALUE assertion: the
        earlier version only matched a `derived=10 replayed=0` token, which a distribution line
        can print without the fold being right.
    (b) A corpus of 7 distinct slices spread over 10 rows is BELOW the floor. An unfolded
        implementation counts 10 and reports a green gate over a 7-slice sample — exactly the
        "non-null on 5 rows is not a gate" failure ADR-0010 names."""
    healthy = _healthy_rows()

    replays = []
    for i in range(10):
        d = dict(healthy[i])
        d["ts"] = "2026-08-20T00:00:0%dZ" % (i % 10)
        d["outcome"] = "MERGED"
        d["quality_source"] = "replayed"
        d["files_changed"] = None if i < 5 else 999
        replays.append(d)
    rc, lines = _run_variance("F19a-fold", healthy + replays)
    if rc is not None:
        check(rc == 0, "F19a-fold-exit",
              "20 rows over 10 slices is still a healthy 10-slice sample; got %r. A last-row-wins "
              "fold sees 5 nulls and 5x999 -> half-blind or all-identical -> 1" % rc)
        check(_has_token(lines, "n_slices=10"), "F19a-fold-n-slices",
              "expected `n_slices=10` after folding (20 rows, 10 slices); lines=%s" % (lines[:14],))
        check(_has_token(lines, "n_rows=20"), "F19a-fold-n-rows",
              "expected `n_rows=20` so a reader can see the fold happened; lines=%s" % (lines[:14],))
        check(_has_token(lines, "derived=10") and _has_token(lines, "replayed=0"),
              "F19a-fold-prefers-derived",
              "the distribution must show derived=10 replayed=0 — the fold PREFERS `derived` over "
              "`replayed`, so a replayed row can never displace the measurement it copied. "
              "lines=%s" % (lines[:14],))

    rows_b = list(healthy[:7])
    for i in range(3):
        d = dict(healthy[0])
        d["ts"] = "2026-08-21T00:00:0%dZ" % i
        d["outcome"] = "MERGED"
        d["files_changed"] = 40 + i
        rows_b.append(d)
    rc, lines = _run_variance("F19b-fold-floor", rows_b)
    if rc is not None:
        check(rc == 2, "F19b-fold-floor",
              "10 rows drawn from 7 slices is below N_MIN_SLICES=%d and must exit 2; got %r — 0 "
              "means rows were counted instead of slices" % (N_MIN_SLICES, rc))
        check(_has_token(lines, "n_slices=7"), "F19b-fold-floor-count",
              "expected `n_slices=7`; lines=%s" % (lines[:14],))

    # Non-closing rows must never reach the statistics at all (D2/A4): they carry no columns, and
    # counting them would inflate both n_slices and every zero rate.
    noise = []
    for i in range(5):
        noise.append({"ts": "2026-08-17T00:00:00Z", "slice": "noise-%d" % i,
                      "outcome": "tick-ok src=cron", "files_changed": 0,
                      "prod_lines_added": 0, "prod_lines_deleted": 0, "test_lines_added": 0,
                      "ears_criteria_count": 0, "skills_invoked": 0,
                      "quality_source": "unavailable", "master_ci_after": ""})
    rc, lines = _run_variance("F19c-non-closing-excluded", healthy + noise)
    if rc is not None:
        check(rc == 0, "F19c-non-closing-excluded-exit",
              "non-closing rows must be filtered before anything is computed; got %r" % rc)
        check(_has_token(lines, "n_slices=10"), "F19c-non-closing-excluded",
              "expected n_slices=10 — the 5 `tick-ok` rows are not slice closures and their zeros "
              "must not enter the zero_rate; lines=%s" % (lines[:14],))


# =================================================================================================
# CLI — the spec's Tests clause says "the query SCRIPT REDs on a synthetic ledger", not "a function
# returns 1". Everything above tests `variance()` in-process; this runs the committed script.
# =================================================================================================
def _write_ledger(path, rows, extra_lines=()):
    with open(path, "w") as fh:
        for r in rows:
            fh.write(json.dumps(r) + "\n")
        for ln in extra_lines:
            fh.write(ln + "\n")


def _run_variance_cli(path):
    return _safe_run([sys.executable, os.path.abspath(__file__), "variance", "--ledger", path])


def assert_variance_cli(tmp):
    healthy = _healthy_rows()

    p = os.path.join(tmp, "healthy.jsonl")
    _write_ledger(p, healthy)
    rc, out, err = _run_variance_cli(p)
    check(rc == 0, "CLI-healthy-rc0",
          "`mr-slice-quality variance --ledger <healthy>` must exit 0; rc=%r stderr=%r"
          % (rc, err.strip()[:200]))
    check("n_slices=10" in out, "CLI-healthy-stdout",
          "the report goes to STDOUT (a consumer pipes it); got %r" % (out[:300],))

    p = os.path.join(tmp, "allnull.jsonl")
    _write_ledger(p, _mutate(healthy, "files_changed", [None] * 10))
    rc, out, err = _run_variance_cli(p)
    check(rc == 1, "CLI-all-null-rc1",
          "the SCRIPT must exit 1 on an all-null column — this is the spec's literal proof-of-teeth "
          "clause; rc=%r stderr=%r" % (rc, err.strip()[:200]))
    check("DEGENERATE" in out and "files_changed" in out, "CLI-all-null-stdout",
          "stdout must name the degenerate column; got %r" % (out[:300],))

    p = os.path.join(tmp, "belowfloor.jsonl")
    _write_ledger(p, healthy[:7])
    rc, out, err = _run_variance_cli(p)
    check(rc == 2, "CLI-below-floor-rc2",
          "the SCRIPT must exit 2 INSUFFICIENT-DATA below the floor, never 0; rc=%r stderr=%r"
          % (rc, err.strip()[:200]))

    # A corrupt line in an append-only ledger is a fact of life (a partial write, a crashed
    # writer). It must be skipped, not fatal, and must not change the verdict.
    p = os.path.join(tmp, "garbage.jsonl")
    _write_ledger(p, healthy, extra_lines=("{ this is not json", "", "   "))
    rc, out, err = _run_variance_cli(p)
    check(rc == 0, "CLI-unparseable-line-skipped",
          "an unparseable ledger line must be skipped, not crash the query and not flip the "
          "verdict; rc=%r stderr=%r" % (rc, err.strip()[:200]))

    # A missing ledger is an IO error, not a green gate.
    rc, out, err = _run_variance_cli(os.path.join(tmp, "does-not-exist.jsonl"))
    check(rc == 3, "CLI-missing-ledger-rc3",
          "a missing ledger must exit 3 (usage/IO), never 0; rc=%r" % (rc,))


# =================================================================================================
# T4 — STATIC assertions about mr-native-tick.sh. The implementer could otherwise skip that file
# entirely and stay green: nothing else in the slice observes it.
#
# Read from $MEM's copy — the gate attesting the corpus it ships beside, NOT the subject-root
# singleton the measurement uses (see TWO ROOTS in the module header): a worktree that edits the
# tick must be gated on its own edit. Anchored by CONTENT, never by line number.
# =================================================================================================
def assert_tick_call_sites():
    tick = os.path.join(MEM, "mr-native-tick.sh")
    if not check(os.path.isfile(tick), "T4-tick-present",
                 "mr-native-tick.sh not found at %s — extraction has rotted" % tick):
        return
    try:
        with open(tick, errors="replace") as fh:
            src = fh.read()
    except OSError as exc:
        check(False, "T4-tick-readable", "cannot read %s: %s" % (tick, exc))
        return

    # Join backslash continuations so a two-line invocation is examined as one statement — the
    # FINISHED write is written across two lines and its flags could land on either.
    joined = src.replace("\\\n", " ")
    all_writes = [ln.strip() for ln in joined.splitlines()
                  if re.search(r"mr-record\"?\s+ledger\b", ln) and not ln.lstrip().startswith("#")]
    # ORCHESTRATOR CORRECTION (2026-08-18, plan-review round): the original expectation was
    # `len(all_writes) == 2` and it was factually WRONG about production — mr-native-tick.sh has
    # THREE ledger writers, and the third is legitimate. The reconcile pair (`--run_id
    # "wrapper-reconcile"`, the FINISHED and CRASHED writes) emits SLICE rows and is what T4 gates;
    # the SUPERVISOR write emits a `tick-ok` BOOKKEEPING row, which is NOT a closing row and must
    # therefore never claim a CI verdict. Partitioning is strictly stronger than the count it
    # replaces: it pins the exclusion as a property instead of leaving it as an off-by-one.
    stmts = [s for s in all_writes if "wrapper-reconcile" in s]
    others = [s for s in all_writes if "wrapper-reconcile" not in s]
    if not check(len(stmts) == 2, "T4-two-reconcile-ledger-writes",
                 "expected exactly 2 `--run_id \"wrapper-reconcile\"` ledger invocations in "
                 "mr-native-tick.sh (the FINISHED and CRASHED reconcile writes, the only writers "
                 "that close a SLICE), found %d — extraction has rotted or the reconcile grew a "
                 "third writer that also needs the flags" % len(stmts)):
        return
    for stmt in others:
        check(re.search(r"--ci\s", stmt) is None,
              "T4-supervisor-write-claims-no-ci",
              "a non-reconcile ledger write in mr-native-tick.sh passes `--ci`. SUPERVISOR "
              "`tick-ok` rows are wrapper bookkeeping, not closing rows (mr-record refuses them "
              "without MR_RECORD_WRAPPER=1), so they must not claim a master-CI verdict — doing "
              "so would put a vocabulary value on a row the reader never folds. line=%s"
              % stmt[:200])
    for stmt in stmts:
        tag = "FINISHED" if "FINISHED" in stmt else ("CRASHED" if "CRASHED" in stmt else "?")
        check(re.search(r"--ci\s+\"?not-applicable\"?", stmt) is not None,
              "T4-ci-not-applicable[%s]" % tag,
              "the %s reconcile write must pass `--ci not-applicable`: these are PRE-MERGE rows, "
              "so `master CI after this slice` is not yet a defined property, and that single "
              "change converts most of the measured 65.8%%-empty mass into a truthful "
              "closed-vocabulary value. line=%s" % (tag, stmt[:200]))
        check(re.search(r"\btimeout\s+60\s+\"?\$?\{?MEM", stmt) is not None
              or re.search(r"\btimeout\s+60\b[^\n]*mr-record", stmt) is not None,
              "T4-timeout-60[%s]" % tag,
              "the %s reconcile write must be prefixed by `timeout 60` (R-D): the tick bumps both "
              "heartbeats BEFORE the reconcile and takes its flock 184 lines later, so a stall "
              "here leaves the loop looking alive while nothing progresses — byte-for-byte the "
              "~2-days-undetected failure the README records. Precedent: the handoff write already "
              "does this. line=%s" % (tag, stmt[:200]))

    sc = [ln.strip() for ln in joined.splitlines()
          if re.search(r"\$MEM/mr-selfcheck", ln) and not ln.lstrip().startswith("#")]
    if check(len(sc) >= 1, "T4-selfcheck-invocation-present",
             "no live `$MEM/mr-selfcheck` invocation found in mr-native-tick.sh"):
        for ln in sc:
            check(re.search(r"\btimeout\s+300\b", ln) is not None, "T4-selfcheck-timeout-300",
                  "the mr-selfcheck invocation must be wrapped in `timeout 300`. This slice adds a "
                  "behavioural block to mr-selfcheck that runs a real git fixture and a real "
                  "mr-record, so the gate is no longer instantaneous — and it runs inside the "
                  "tick's post-heartbeat, pre-flock window. line=%s" % ln[:200])


# =================================================================================================
# Static safety pins. The module header claims two properties; without these they are decoration.
# The region split is by BANNER, and a failure to find the banners is itself a failure.
# =================================================================================================
_IMPL_BANNER = "===== IMPLEMENTER-OWNED REGION ====="
_TESTER_BANNER = "===== TESTER-OWNED REGION ====="


def _implementer_region():
    try:
        with open(os.path.abspath(__file__), errors="replace") as fh:
            src = fh.read()
    except OSError as exc:
        return None, "cannot read own source: %s" % exc
    i = src.find(_IMPL_BANNER)
    j = src.find(_TESTER_BANNER)
    if i < 0 or j < 0 or j <= i:
        return None, "region banners not found (impl=%d tester=%d) — the static pins below are " \
                     "scanning nothing" % (i, j)
    return src[i:j], None


def assert_static_safety():
    region, err = _implementer_region()
    if not check(region is not None, "S1-region-split", err or ""):
        return
    # Needles are ASSEMBLED at runtime: a checker that spells out the forbidden token is itself a
    # hit, which is how the previous version of this check made --selftest permanently unfixable.
    shell_pat = re.compile("shell" + r"\s*=\s*" + "True")
    check(shell_pat.search(region) is None, "S1-no-shell-hop",
          "the implementer region must never run a subprocess through a shell — every git call is "
          "list-argv by contract (R-D), and a shell hop turns an unsanitised slice id into a command")
    subproc_pat = re.compile(r"\bsubprocess\s*\.")
    hits = subproc_pat.findall(region)
    check(not hits, "S16-subprocess-only-via-safe-run",
          "the implementer region references `subprocess.` %d time(s). Every child process must go "
          "through _safe_run in the SHARED region, which is what refuses to execute the tick, spawn "
          "a paid session, or name the kill-switch flag — the module header claims that property "
          "and this is what enforces it" % len(hits))


# =================================================================================================
# Non-pollution. The ledger is the durable standdown record and is append-only (ADR-0011); nothing
# in a TEST may add a byte to it. Both the SELF-LOCATED copies and the hardcoded PRODUCTION copies
# are watched, because mr-record's `MEM=` points at the production path regardless of which copy of
# a tool is invoked — a buggy implementation writes THERE while the self-located files stay clean.
#
# Deliberately NOT a byte/sha snapshot: the real ledger legitimately GROWS while this runs
# (mr-selfcheck is invoked from the hourly tick, which also writes rows), so a hash compare would
# be a flake — and a flaky gate gets disabled. The stable property is narrower: NONE OF OUR BYTES
# may appear in the real corpus.
# =================================================================================================
_WATCHED = [
    os.path.join(MEM, "monster-realm-usage-ledger.jsonl"),
    os.path.join(MEM, "monster-realm-handoff.md"),
    os.path.join(PROD_HARNESS_ROOT, "memory", "projects", "monster-realm-usage-ledger.jsonl"),
    os.path.join(PROD_HARNESS_ROOT, "memory", "projects", "monster-realm-handoff.md"),
]
_FIXTURE_MARKERS = ("lp-fixture-", "f18-root", "mr-slice-quality-repo-", "seam-fixture-slice")


def _fixture_bytes_in(path):
    """Returns (markers_found, io_error). An UNREADABLE watched file is NOT treated as clean —
    that distinction is the difference between `nothing was written` and `we could not look`."""
    try:
        with open(path, errors="replace") as fh:
            text = fh.read()
    except FileNotFoundError:
        return [], None
    except OSError as exc:
        return [], "%s: %s" % (type(exc).__name__, exc)
    return [m for m in _FIXTURE_MARKERS if m in text], None


def _fixture_leftovers_in_mem():
    try:
        names = os.listdir(MEM)
    except OSError as exc:
        return None, "%s: %s" % (type(exc).__name__, exc)
    return sorted(n for n in names if any(m in n for m in _FIXTURE_MARKERS)), None


# =================================================================================================
# Main
# =================================================================================================
def selftest():
    stages = (
        ("classification", lambda tmp: assert_f3_classification()),
        ("ci-red", lambda tmp: assert_f10_ci_never_greens_a_red()),
        ("ci-map", lambda tmp: assert_f11_ci_mapping()),
        ("ci-absent", lambda tmp: assert_f12_absent_ci()),
        ("is-closing", lambda tmp: assert_is_closing()),
        ("worktree-path", lambda tmp: assert_worktree_path_for()),
        ("root-seam", assert_root_env_seam),
        ("skills", assert_f16_skills),
        ("ears", assert_f17_ears),
        ("bad-slice-ids", assert_f18_bad_slice_ids),
        ("repo", assert_repo_fixtures),
        ("degeneracy", lambda tmp: assert_f8_degeneracy()),
        ("e3-conformance", lambda tmp: assert_e3_conformance()),
        ("vacuity", lambda tmp: assert_f9_vacuity()),
        ("fold", lambda tmp: assert_f19_fold_per_slice()),
        ("variance-cli", assert_variance_cli),
        ("tick-call-sites", lambda tmp: assert_tick_call_sites()),
        ("static", lambda tmp: assert_static_safety()),
    )
    for name, fn in stages:
        try:
            with tempfile.TemporaryDirectory(prefix="mr-slice-quality-%s-" % name) as tmp:
                fn(tmp)
        except Exception as exc:  # noqa: BLE001 — a stage must report, never traceback
            check(False, "STAGE-%s" % name,
                  "the fixture stage itself raised %s: %s" % (type(exc).__name__, exc))

    for path in _WATCHED:
        hits, io_err = _fixture_bytes_in(path)
        check(io_err is None, "P1-watched-readable[%s]" % os.path.basename(path),
              "could not read %s to verify non-pollution (%s) — `unreadable` is not `clean`"
              % (path, io_err))
        check(not hits, "P1-no-pollution[%s]" % os.path.basename(path),
              "%s contains fixture marker(s) %s — a fixture reached the real corpus instead of "
              "its tempdir. The ledger is append-only (ADR-0011) and a test row in it is "
              "unremovable." % (path, hits))
    leftovers, io_err = _fixture_leftovers_in_mem()
    check(io_err is None, "P1-mem-listable",
          "could not list %s to verify non-pollution (%s)" % (MEM, io_err))
    check(not leftovers, "P1-no-fixture-leftovers-in-MEM",
          "the selftest left fixture artifact(s) in %s: %s" % (MEM, leftovers))

    if _FAILURES:
        for id_, detail in _FAILURES:
            line = "SLICE-QUALITY-SELFTEST-FAIL %s" % id_
            if detail:
                line += ": %s" % detail
            print(line)
        print("SLICE-QUALITY-SELFTEST-FAIL summary: %d of %d assertion(s) failed "
              "(~40 are dependent restatements — read the ids, not the count)"
              % (len(_FAILURES), _ASSERTIONS))
        return 1
    print("SLICE-QUALITY-SELFTEST-OK %d assertions" % _ASSERTIONS)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
