def variance(rows):
    """Read the new columns over a list of ledger row dicts and report. Returns (exit_code, lines).

    exit_code: 0 OK, 1 DEGENERATE, 2 INSUFFICIENT-DATA.  `lines` is a list of report strings.

    PIPELINE (plan R-F, which SUPERSEDES the original D6):
      1. Keep only rows where `is_closing(row["slice"], row["outcome"])`.
      2. FOLD to one observation per slice. Preference order
             derived > replayed > partial > unavailable > (no quality_source key)
         and among equally-preferred rows for the same slice the LAST in input order wins (the
         ledger is append-only, so last == newest). This is what makes ledger-replay statistically
         harmless and it is what the spec's phrase "slice-size denominator" asks for; `N_MIN_ROWS`
         is therefore redundant and was CUT.
      3. Per column, over the folded observations (a "null" is key-absent OR None):
             n_slices < N_MIN_SLICES  -> INSUFFICIENT-DATA        (exit 2, and NOT green)
             null_rate == 1.0         -> DEGENERATE all-null
             distinct(non-null) <= 1  -> DEGENERATE all-identical
             null_rate >= 0.5         -> DEGENERATE half-blind    (descends from the measured
                                                                   master_ci_after 65.8% empty)
             zero_rate >= 0.5         -> DEGENERATE silent-zero-suspect   (descends from A2; a
                                                                   systematically-zero column
                                                                   passes every null-based test)
         Exactly ONE kind is reported per degenerate column — the first that fires. A line naming
         several kinds discriminates nothing and is a gate failure.
      4. `master_ci_after` is EXCLUDED from that ladder (the harness has no remote CI, so it is
         permanently `not-applicable` for harness slices and `distinct <= 1` would be a guaranteed
         false RED) and instead gets a CONFORMANCE check (orchestrator decision B):
            * denominator: POST-CUTOVER folded observations only, defined mechanically as those
              carrying a `quality_source` key — the marker this slice introduces. Scoping this way
              is what makes the historical 12.7% `unknown` rate irrelevant instead of a threshold
              tuned to fail against its own corpus.
            * non-conformant: `master_ci_after` NOT in CI_CONFORMANT. That includes `unknown`,
              `not-recorded`, `""`, an absent key, AND any surviving legacy raw string. Counting
              only the two labels scores the motivating corpus at 0.000 and passes.
            * DEGENERATE master_ci_after when the non-conformant share > CI_UNKNOWN_RATE_MAX.
      5. Overall: any DEGENERATE -> 1; else n_slices < N_MIN_SLICES -> 2; else 0.

    LINE CONTRACT (fixed, machine-checkable; the fixtures match on these tokens). `n_rows` counts
    the CLOSING rows that entered the fold; every other statistic — including the quality_source
    distribution and the unavailable rate — is computed over the FOLDED observations, so the two
    numbers together let a reader see that the fold happened:
        INFO n_rows=<int>
        INFO n_slices=<int>
        INFO quality_source derived=<n> replayed=<n> partial=<n> unavailable=<n> absent=<n>
        INFO unavailable_rate=<float>
        OK <column> n=<n> null_rate=<f> zero_rate=<f> distinct=<n>
        DEGENERATE <column> <one of DEGEN_KINDS> <detail...>
        INSUFFICIENT-DATA <column> n_slices=<n> floor=<N_MIN_SLICES>
        OK master_ci_after post_cutover=<n> nonconformant_rate=<f>
        DEGENERATE master_ci_after nonconformant-rate=<f> threshold=0.10
    EVERY column gets a line every run — an `OK` line for a healthy column must carry both
    `null_rate=` and `distinct=`, so "healthy" is a reported measurement rather than silence.
    The quality_source distribution and the unavailable rate are FIRST-CLASS lines because the
    missingness is non-random: mr-native-tick.sh:57-78 skips the FINISHED write whenever a
    cost-bearing row already exists within 12h — i.e. whenever the slice agent self-recorded — so
    `unavailable` correlates with WELL-BEHAVED slices.

    No `--min-rows` override and no `MR_*_MEM` override (A5): an override is a surface for greening
    the gate vacuously.
    """
    raise NotImplementedError(
        "lp-02 RED: variance() is not implemented — the fold-per-slice degeneracy report (plan R-F, "
        "EARS-4 and the proof-of-teeth clause) does not exist yet")


def _load_ledger_rows(path):
    """Read a JSONL ledger into a list of dicts. Unparseable lines are skipped. Raises OSError."""
    rows = []
    with open(path, errors="replace") as fh:
        for line in fh:
            line = line.strip()
            if not line:
                continue
            try:
                obj = json.loads(line)
            except Exception:
                continue
            if isinstance(obj, dict):
                rows.append(obj)
    return rows


def main(argv):
    if not argv:
        sys.stderr.write(USAGE)
        return 3
    cmd = argv[0]
    if cmd in ("--selftest", "selftest"):
        return selftest()
    if cmd in ("-h", "--help"):
        sys.stdout.write(USAGE)
        return 0
    if cmd == "derive":
        if len(argv) != 2:
            sys.stderr.write(USAGE)
            return 3
        try:
            out = derive(argv[1])
        except NotImplementedError as exc:
            sys.stderr.write("SLICE-QUALITY-NOTIMPL: %s\n" % exc)
            return 3
        sys.stdout.write(json.dumps(out) + "\n")
        return 0
    if cmd == "variance":
        ledger = os.path.join(MEM, "monster-realm-usage-ledger.jsonl")
        rest = argv[1:]
        if rest[:1] == ["--ledger"]:
            if len(rest) != 2:
                sys.stderr.write(USAGE)
                return 3
            ledger = rest[1]
        elif rest:
            sys.stderr.write(USAGE)
            return 3
        try:
            rows = _load_ledger_rows(ledger)
        except OSError as exc:
            sys.stderr.write("ERR cannot read ledger %s: %s\n" % (ledger, exc))
            return 3
        try:
            rc, lines = variance(rows)
        except NotImplementedError as exc:
            sys.stderr.write("SLICE-QUALITY-NOTIMPL: %s\n" % exc)
            return 3
        for ln in lines:
            sys.stdout.write(ln + "\n")
        return rc
    sys.stderr.write(USAGE)
    return 3


