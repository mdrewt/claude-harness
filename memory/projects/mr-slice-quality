def _fx_b_plan():
    """Repo B's file plan. Sizes derive from os.getpid(): deterministic inside one run, different
    across runs, so nothing here is transcribable. (Precedent: mr-telemetry-selftest's generated
    corpus, which closed a proven lookup-table cheat in lp-01.)

    Each entry is (path, klass, base_n, head_n, base_tag, head_tag).
      base_n None -> created on the branch;  head_n None -> deleted on the branch.
    Content is `<tag><i>` per line, so a size change is a pure suffix append/truncation (added or
    deleted is exactly the difference) and a TAG change rewrites every line (added == deleted == n).
    """
    def sz(i):
        return 5 + (os.getpid() + i * 7) % 13          # 5..17, never small enough to underflow

    return [
        # (path, klass, base_n, head_n, base_tag, head_tag)
        ("src/alpha.rs", "prod", None, sz(0), "a", "a"),              # created
        ("src/beta.rs", "prod", sz(1), None, "b", "b"),               # DELETED outright
        ("src/gamma.rs", "prod", sz(2), sz(2) - 2, "c", "c"),         # shrunk
        ("src/delta.rs", "prod", sz(3), sz(3), "d", "D"),             # every line rewritten
        ("tests/seg.py", "test", sz(4), sz(4) + 3, "e", "e"),         # D5.1 segment rule
        ("src/x.test.ts", "test", None, sz(5), "f", "f"),             # D5.1 basename rule
        ("memory/projects/mr-selfcheck", "test", sz(6), sz(6) - 3, "g", "g"),  # carve-out + TEST DELETION
        ("src/latest.ts", "prod", None, sz(7), "h", "h"),             # negative control (substring)
        ("src/bindings.ts", "prod", None, sz(8), "i", "i"),           # negative control (segment)
        ("client/src/module_bindings/gen.ts", "other", None, sz(9), "j", "j"),  # widened clause
        ("docs/note.md", "other", sz(10), sz(10) + 4, "k", "k"),      # OTHER, contributes nothing
    ]


def _fx_b_expect(plan):
    """The expectation, COMPUTED from the same plan the files are written from."""
    exp = {"files_changed": len(plan), "prod_lines_added": 0, "prod_lines_deleted": 0,
           "test_lines_added": 0, "test_lines_deleted_ignored": 0}
    for _path, klass, bn, hn, bt, ht in plan:
        if bn is None:
            add, dele = hn, 0
        elif hn is None:
            add, dele = 0, bn
        elif bt != ht:
            add, dele = hn, bn
        elif hn > bn:
            add, dele = hn - bn, 0
        elif hn < bn:
            add, dele = 0, bn - hn
        else:
            add, dele = 0, 0
        if klass == "prod":
            exp["prod_lines_added"] += add
            exp["prod_lines_deleted"] += dele
        elif klass == "test":
            exp["test_lines_added"] += add
            exp["test_lines_deleted_ignored"] += dele
    return exp


def _lines_of(tag, n):
    return "".join("%s%d\n" % (tag, i) for i in range(n))


