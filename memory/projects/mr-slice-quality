def _derive_dict(label, slice_, root, log_dir):
    ok, got = call(derive, slice_, root, log_dir)
    if not ok:
        check(False, label, got)
        return None
    if not check(isinstance(got, dict), label, "derive must return a dict, got %r" % (got,)):
        return None
    missing = [k for k in tuple(COLUMNS) + (QUALITY_KEY, "reason") if k not in got]
    if not check(not missing, label + "-keys",
                 "derive's dict is missing required key(s): %s (E1 names six columns; "
                 "quality_source and reason are the plan's D3/R-G additions, and ALL of them are "
                 "present on every return so mr-record can emit them unconditionally)" % missing):
        return None
    return got


def assert_repo_fixtures(tmp):
    fx = _build_fixture_repos(tmp)
    labels = ("F1-binary-record", "F2-rename-once", "F4a-worktree-absent", "F4b-worktree-walks-up",
              "F5-dirty-partial", "F6-genuine-zero", "F7a-real-repo-counts", "F7b-computed-counts",
              "F7b-project-routed", "F16-through-derive")
    if fx.get("error"):
        for lab in labels:
            check(False, lab, "fixture repos could not be built: %s" % fx["error"])
        return
    root, env, log_dir = fx["root"], fx["env"], fx["log_dir"]
    wt_a, wt_b = fx["wt_a"], fx["wt_b"]

    # ---------------------------------------------------------------------------------------------
    # F7a (+F1, +F2): repo A's exactly-known shape.
    # ---------------------------------------------------------------------------------------------
    d = _derive_dict("F7a-real-repo-counts", FX_SLICE, root, log_dir)
    if d is not None:
        check(d.get("files_changed") == EXPECT_A_FILES, "F7a-files-changed",
              "expected files_changed=%d (7 text records + 1 binary; the rename is ONE record). "
              "got %r — %d means the rename was counted as an add+delete pair, i.e. `-M` is missing "
              "and every renamed file inflates the denominator"
              % (EXPECT_A_FILES, d.get("files_changed"), EXPECT_A_FILES + 1))
        check(d.get("prod_lines_added") == EXPECT_A_PROD_ADD, "F7a-prod-added",
              "expected prod_lines_added=%d (5 from src/prod.py + 1 from src/keep.py + 0 from the "
              "rename); got %r. 15+ means OTHER paths (docs/, Cargo.lock, bindings) were summed as "
              "production" % (EXPECT_A_PROD_ADD, d.get("prod_lines_added")))
        check(d.get("prod_lines_deleted") == EXPECT_A_PROD_DEL, "F7a-prod-deleted",
              "expected prod_lines_deleted=%d (src/keep.py only); got %r. 4 means the rename was "
              "read as a delete of oldname.py" % (EXPECT_A_PROD_DEL, d.get("prod_lines_deleted")))
        check(d.get("test_lines_added") == EXPECT_A_TEST_ADD, "F7a-test-added",
              "expected test_lines_added=%d (src/thing_tests.rs); got %r. 0 means `*_tests.rs` is "
              "not in the TEST clause" % (EXPECT_A_TEST_ADD, d.get("test_lines_added")))
        check(d.get("ears_criteria_count") == EXPECT_A_EARS, "F7a-ears",
              "expected ears_criteria_count=%d from the fixture spec section; got %r"
              % (EXPECT_A_EARS, d.get("ears_criteria_count")))
        check(d.get(QUALITY_KEY) == "derived", "F7a-quality-source",
              "a clean worktree whose identity checks out is `derived`; got %r" % (d.get(QUALITY_KEY),))
        check(d.get("reason") == "", "F7a-reason-empty",
              "`derived` carries no QUALITY(...) note; reason must be empty, got %r" % (d.get("reason"),))
        # F16 THROUGH derive: the real pass log lives at <log_dir>/mr_pass_<slice>.log.
        check(d.get("skills_invoked") == fx["skills_a"], "F16-through-derive",
              "expected skills_invoked=%d, read from <log_dir>/mr_pass_%s.log; got %r. A literal "
              "None here (the shape a red-team used to score 418/419) is indistinguishable from "
              "`no log` and hides the column entirely"
