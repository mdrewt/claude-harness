        # F1/F2 restated so a regression reports the DEFECT CLASS, not just "a number moved".
        check(d.get("files_changed") == EXPECT_A_FILES, "F1-binary-record",
              "the binary record (dash TAB dash TAB assets/blob.bin) must count toward "
              "files_changed and contribute 0 lines — never int('-'), which raises ValueError and, "
