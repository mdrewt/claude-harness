              "a measured zero is `derived`, not `unavailable`; got %r" % (d.get(QUALITY_KEY),))
        check(d.get("ears_criteria_count") == 1, "F6-ears",
              "the clean fixture's spec section carries 1 SHALL; got %r" % (d.get("ears_criteria_count"),))

    # ---------------------------------------------------------------------------------------------
    # F5: dirty worktree -> `partial`, the FOUR diff columns null, ears/skills still measured.
    # CRASHED and PARKED rows are exactly the uncommitted-WIP case, so an implementation that
    # reports the committed diff here publishes a number that is not the slice's size.
    # ---------------------------------------------------------------------------------------------
    scratch = os.path.join(wt, "scratch-wip.txt")
    _write(scratch, "uncommitted work in progress\n")
    d = _derive_dict("F5-dirty-partial", FX_SLICE, root, log_dir)
    if d is not None:
        check(d.get(QUALITY_KEY) == "partial", "F5-quality-source",
              "`git status --porcelain` is non-empty, so quality_source must be 'partial'; got %r"
              % (d.get(QUALITY_KEY),))
        for col in ("files_changed", "prod_lines_added", "prod_lines_deleted", "test_lines_added"):
            check(d.get(col) is None, "F5-%s-null" % col,
                  "a dirty tree's diff columns must be None, not the committed-only number "
                  "(%s=%r) and certainly not 0" % (col, d.get(col)))
        check(d.get("ears_criteria_count") == EXPECT_EARS, "F5-ears-still-measured",
              "`partial` scopes the DIFF measurement only — ears_criteria_count comes from the spec "
              "and is unaffected by a dirty tree; expected %d, got %r"
              % (EXPECT_EARS, d.get("ears_criteria_count")))
        check(isinstance(d.get("reason"), str) and d.get("reason"), "F5-reason",
              "`partial` must carry a non-empty reason for the QUALITY(partial): ... note; got %r"
              % (d.get("reason"),))
    os.remove(scratch)

    # ---------------------------------------------------------------------------------------------
    # F4b — THE HEADLINE TOOTH (plan R-C, anti-pattern A2).
    #
    # Remove the worktree but leave its directory in place, which is the shape production actually
    # produces: `.claude/worktrees/` lives INSIDE the harness repo, the worktree is deleted BEFORE
    # the MERGED row is written, and the enclosing repo remains. `git -C <that path>` then walks UP
    # to <root>, returns rc 0, and — because <root>'s HEAD is `main` — reports an EMPTY diff.
    #
    # A "check isdir, then check returncode" implementation therefore emits
    #     files_changed=0 prod_lines_added=0 ... quality_source=derived
    # confidently, about a tree it never inspected. That is A2 in its purest form and it is the
    # NORMAL post-merge state. Only an IDENTITY assertion (rev-parse --show-toplevel == the
    # resolved worktree path) catches it, which is precisely what this fixture forces.
    # ---------------------------------------------------------------------------------------------
    env = _git_env(os.path.join(tmp, "fakehome"))
    rc, _o, err = _git(root, ["worktree", "remove", "--force", wt], env)
    if rc != 0:
        shutil.rmtree(wt, ignore_errors=True)
        _git(root, ["worktree", "prune"], env)
    os.makedirs(wt, exist_ok=True)   # the dir exists, but it is NOT a worktree — the walk-up shape
    rc_top, top, _e = _safe_run(["git", "-C", wt, "rev-parse", "--show-toplevel"], env=env)
    check(rc_top == 0 and os.path.realpath(top.strip() or "/nonexistent") == os.path.realpath(root),
          "F4b-fixture-is-live",
          "the fixture no longer reproduces the walk-up (rc=%r toplevel=%r, expected %r) — without "
          "it F4b proves nothing" % (rc_top, top.strip(), root))
    d = _derive_dict("F4b-worktree-walks-up", FX_SLICE, root, log_dir)
    if d is not None:
        check(d.get(QUALITY_KEY) == "unavailable", "F4b-quality-source",
              "the resolved path is inside the ENCLOSING repo, not the slice worktree, so the row "
              "is unmeasurable: expected quality_source='unavailable', got %r. 'derived' here means "
              "the identity assertion (rev-parse --show-toplevel) is missing"
              % (d.get(QUALITY_KEY),))
        for col in COLUMNS:
            check(d.get(col) is None, "F4b-%s-null-not-zero" % col,
                  "expected %s=None; got %r. A 0 is the fabricated zero R-C describes — git walked "
                  "up into <root>, whose HEAD is `main`, and honestly reported an empty diff for "
                  "the wrong tree" % (col, d.get(col)))
        check(isinstance(d.get("reason"), str) and d.get("reason"), "F4b-reason",
              "`unavailable` must carry a non-empty reason; got %r" % (d.get("reason"),))

    # ---------------------------------------------------------------------------------------------
    # F4a — the simpler direction: the path does not exist at all.
    # ---------------------------------------------------------------------------------------------
    shutil.rmtree(wt, ignore_errors=True)
    d = _derive_dict("F4a-worktree-absent", FX_SLICE, root, log_dir)
    if d is not None:
        check(d.get(QUALITY_KEY) == "unavailable", "F4a-quality-source",
              "an absent worktree is `unavailable`; got %r" % (d.get(QUALITY_KEY),))
        for col in COLUMNS:
            check(d.get(col) is None, "F4a-%s-null-not-zero" % col,
                  "expected %s=None, got %r" % (col, d.get(col)))


# =================================================================================================
# F8/F9/F19 — variance. Pure: rows in, (rc, lines) out. No ledger is read or written.
# =================================================================================================
def _healthy_rows():
    fc = [3, 7, 12, 5, 9, 2, 14, 6, 8, 11]
    pa = [40, 120, 15, 300, 7, 55, 220, 18, 90, 5]
    pd = [2, 30, 0, 11, 4, 60, 7, 0, 22, 9]
    ta = [10, 0, 45, 120, 8, 33, 0, 17, 60, 25]
    ec = [4, 5, 3, 6, 4, 7, 5, 3, 4, 6]
    sk = [1, 0, 2, 3, 1, 2, 4, 1, 0, 3]
    # Exactly 1 of 10 is `unknown` -> a 0.10 share, which is NOT > 0.10 and therefore passes. The
    # boundary is chosen deliberately: the R-B threshold fixture below adds ONE more and must RED.
    ci = ["not-applicable", "green", "not-applicable", "green", "pending",
          "not-applicable", "green", "not-applicable", "red", "unknown"]
    rows = []
    for i in range(10):
        rows.append({
            "ts": "2026-08-1%dT00:00:00Z" % (i % 10),
            "slice": "fx-%02d" % i,
            "outcome": "FINISHED(EXIT=0)",
            "quality_source": "derived",
            "master_ci_after": ci[i],
            "files_changed": fc[i],
            "prod_lines_added": pa[i],
            "prod_lines_deleted": pd[i],
            "test_lines_added": ta[i],
            "ears_criteria_count": ec[i],
            "skills_invoked": sk[i],
        })
    return rows


def _mutate(rows, col, values):
    out = []
    for i, r in enumerate(rows):
        d = dict(r)
        d[col] = values[i]
        out.append(d)
    return out


def _run_variance(label, rows):
    """Returns (rc, lines) or (None, []) after recording a failure."""
    ok, got = call(variance, rows)
    if not ok:
        check(False, label, got)
        return None, []
    if not check(isinstance(got, tuple) and len(got) == 2, label,
                 "variance must return (exit_code, lines), got %r" % (got,)):
        return None, []
    rc, lines = got
    if not check(isinstance(lines, (list, tuple)), label,
                 "variance's second element must be a list of report lines, got %r" % (type(lines),)):
        return None, []
    return rc, list(lines)


def _degen_line(lines, col, kind=None):
    for ln in lines:
        if not str(ln).startswith("DEGENERATE"):
            continue
        if col in str(ln) and (kind is None or kind in str(ln)):
            return str(ln)
    return None


def _has_token(lines, token):
    return any(token in str(ln) for ln in lines)


def assert_f8_degeneracy():
    healthy = _healthy_rows()

    rc, lines = _run_variance("F8-healthy", healthy)
    if rc is not None:
        check(rc == 0, "F8-healthy",
              "a healthy 10-slice fixture must exit 0; got %r. lines=%s" % (rc, lines[:12]))
        check(_has_token(lines, "n_slices=10"), "F8-healthy-n-slices",
              "the report must carry `INFO n_slices=10`; lines=%s" % (lines[:12],))
        check(_has_token(lines, "quality_source"), "F8-healthy-quality-distribution",
              "the quality_source distribution is a FIRST-CLASS line (R-F: the missingness is "
              "non-random and correlates with well-behaved slices); lines=%s" % (lines[:12],))
        check(_has_token(lines, "unavailable_rate"), "F8-healthy-unavailable-rate",
              "the unavailable rate is a first-class line (R-F); lines=%s" % (lines[:12],))

    # all-null
    rc, lines = _run_variance("F8-all-null", _mutate(healthy, "files_changed", [None] * 10))
    if rc is not None:
        check(rc == 1, "F8-all-null", "an all-null column must exit 1 DEGENERATE; got %r" % rc)
        check(_degen_line(lines, "files_changed", "all-null") is not None, "F8-all-null-named",
              "the report must name files_changed and the all-null kind; lines=%s" % (lines,))

    # all-identical (the spec's literal proof-of-teeth clause, non-null)
    rc, lines = _run_variance("F8-all-identical", _mutate(healthy, "files_changed", [5] * 10))
    if rc is not None:
        check(rc == 1, "F8-all-identical",
              "an all-identical column must exit 1 DEGENERATE (the spec's literal Tests clause); "
              "got %r" % rc)
        check(_degen_line(lines, "files_changed", "all-identical") is not None,
              "F8-all-identical-named",
              "the report must name files_changed and the all-identical kind; lines=%s" % (lines,))

    # half-null: 5 nulls, 5 DISTINCT non-nulls, so only the >=0.5 null_rate clause can fire. This
    # is the clause that descends directly from the measured 65.8%-empty master_ci_after — without
    # it that column would have passed as "has variance".
    rc, lines = _run_variance(
        "F8-half-null",
        _mutate(healthy, "files_changed", [3, 7, 12, 5, 9, None, None, None, None, None]))
    if rc is not None:
        check(rc == 1, "F8-half-null",
              "null_rate == 0.5 must exit 1 DEGENERATE(half-blind); got %r. A `> 0.5` comparison "
              "instead of `>= 0.5` passes this and is the bug the fixture is aimed at" % rc)
        check(_degen_line(lines, "files_changed", "half-blind") is not None, "F8-half-null-named",
              "the report must name files_changed and the half-blind kind; lines=%s" % (lines,))

    # all-zero
    rc, lines = _run_variance("F8-all-zero", _mutate(healthy, "skills_invoked", [0] * 10))
    if rc is not None:
        check(rc == 1, "F8-all-zero",
              "an all-zero column must exit 1 — `0` is non-null and passes every null-based test, "
              "which is exactly the A2 hole; got %r" % rc)
        check(_degen_line(lines, "skills_invoked") is not None, "F8-all-zero-named",
              "the report must name skills_invoked; lines=%s" % (lines,))

    # silent-zero-suspect: >=50% zeros but genuinely varied elsewhere, so all-identical cannot fire.
    rc, lines = _run_variance(
        "F8-silent-zero",
        _mutate(healthy, "skills_invoked", [0, 0, 0, 0, 0, 0, 2, 3, 4, 5]))
    if rc is not None:
        check(rc == 1, "F8-silent-zero",
              "zero_rate 0.6 must exit 1 DEGENERATE(silent-zero-suspect); got %r" % rc)
        check(_degen_line(lines, "skills_invoked", "silent-zero") is not None,
              "F8-silent-zero-named",
              "the report must name skills_invoked and the silent-zero kind; lines=%s" % (lines,))

    # below floor
    rc, lines = _run_variance("F8-below-floor", healthy[:7])
    if rc is not None:
        check(rc == 2, "F8-below-floor",
              "7 slices is below N_MIN_SLICES=%d and must exit 2 INSUFFICIENT-DATA — NOT 0. "
              "Conflating `no data yet` with `collapsed schema` is the dishonesty this slice "
              "exists to remove; got %r" % (N_MIN_SLICES, rc))
        check(_has_token(lines, "INSUFFICIENT-DATA"), "F8-below-floor-named",
              "the report must say INSUFFICIENT-DATA; lines=%s" % (lines,))
        check(_has_token(lines, "n_slices=7"), "F8-below-floor-count",
              "the report must state n_slices=7; lines=%s" % (lines,))

    # E3 teeth (R-B): (unknown + not-recorded) share > 0.10 on the folded observations.
    ci_bad = ["not-applicable", "green", "not-applicable", "green", "pending",
              "not-applicable", "green", "not-recorded", "red", "unknown"]
    rc, lines = _run_variance("F8-ci-threshold", _mutate(_healthy_rows(), "master_ci_after", ci_bad))
    if rc is not None:
        check(rc == 1, "F8-ci-threshold",
              "2 of 10 closing rows carrying unknown/not-recorded is 0.20 > 0.10 and must exit 1 "
              "(a report with no threshold is not a gate); got %r" % rc)
        check(_degen_line(lines, "master_ci_after") is not None, "F8-ci-threshold-named",
              "the report must name master_ci_after; lines=%s" % (lines,))
    # ...and the boundary stays green, so the threshold cannot be satisfied by always failing.
    rc, lines = _run_variance("F8-ci-threshold-boundary", _healthy_rows())
    if rc is not None:
        check(rc == 0, "F8-ci-threshold-boundary",
              "exactly 0.10 is NOT > 0.10 and must stay green; got %r" % rc)


def assert_f9_vacuity():
    """F9 — THE VACUITY TOOTH. Blank each of the six columns in turn.

    Kills: an implementation that computes the ladder for `files_changed` and then reports OK for
    everything else (the cheapest way to make F8 pass), and any implementation that iterates a
    hardcoded subset of the columns. Every one of the six must be able to RED on its own, and the
    report must NAME the offending column — a bare exit 1 does not tell a reader which column
    collapsed, which is the entire deliverable of E4."""
    healthy = _healthy_rows()
    for col in COLUMNS:
        rc, lines = _run_variance("F9-blank[%s]" % col, _mutate(healthy, col, [None] * 10))
        if rc is None:
            continue
        check(rc == 1, "F9-blank[%s]" % col,
              "blanking %s must exit 1 DEGENERATE; got %r. An implementation that only checks "
              "files_changed returns 0 here for the other five columns" % (col, rc))
        check(_degen_line(lines, col, "all-null") is not None, "F9-named[%s]" % col,
              "the report must name %s as all-null; lines=%s" % (col, lines))


def assert_f19_fold_per_slice():
    """F19 — one observation per slice.

    (a) A slice with 4 closing rows votes ONCE, and the fold prefers `derived` over `replayed`, so
        a replayed row can never displace the measurement it copied.
    (b) A corpus of 7 distinct slices spread over 10 rows is BELOW the floor. An unfolded
        implementation counts 10 and reports a green gate over a 7-slice sample — which is exactly
        the "non-null on 5 rows is not a gate" failure ADR-0010 names."""
    healthy = _healthy_rows()

    replays = []
    for i in range(3):
        d = dict(healthy[0])
        d["outcome"] = "MERGED"
        d["quality_source"] = "replayed"
        d["files_changed"] = 999 + i          # different numbers, same slice
        replays.append(d)
    rows_a = healthy + replays
    rc, lines = _run_variance("F19a-fold", rows_a)
    if rc is not None:
        check(rc == 0, "F19a-fold-exit",
              "13 rows over 10 slices is still a healthy 10-slice sample; got %r" % rc)
        check(_has_token(lines, "n_slices=10"), "F19a-fold-n-slices",
              "expected `n_slices=10` after folding (13 rows, 10 slices); lines=%s" % (lines[:12],))
        check(_has_token(lines, "n_rows=13"), "F19a-fold-n-rows",
              "expected `n_rows=13` so a reader can see the fold happened; lines=%s" % (lines[:12],))
        check(_has_token(lines, "derived=10") and _has_token(lines, "replayed=0"),
              "F19a-fold-prefers-derived",
              "the fold must PREFER quality_source='derived': expected derived=10 replayed=0 in the "
              "distribution line. A last-row-wins fold reports replayed=1 and publishes 999 as "
              "fx-00's size. lines=%s" % (lines[:12],))

    rows_b = []
    for i in range(7):
        rows_b.append(healthy[i])
    for i in range(3):
        d = dict(healthy[0])
        d["outcome"] = "MERGED"
        d["files_changed"] = 40 + i
        rows_b.append(d)
    rc, lines = _run_variance("F19b-fold-floor", rows_b)
    if rc is not None:
        check(rc == 2, "F19b-fold-floor",
              "10 rows drawn from 7 slices is below N_MIN_SLICES=%d and must exit 2; got %r — 0 "
              "means rows were counted instead of slices" % (N_MIN_SLICES, rc))
        check(_has_token(lines, "n_slices=7"), "F19b-fold-floor-count",
              "expected `n_slices=7`; lines=%s" % (lines[:12],))

    # Non-closing rows must never reach the statistics at all (D2/A4): they carry no columns, and
    # counting them would inflate both n_slices and every zero rate.
    noise = []
    for i in range(5):
        noise.append({"ts": "2026-08-17T00:00:00Z", "slice": "noise-%d" % i,
                      "outcome": "tick-ok src=cron", "files_changed": 0,
                      "prod_lines_added": 0, "prod_lines_deleted": 0, "test_lines_added": 0,
                      "ears_criteria_count": 0, "skills_invoked": 0,
                      "quality_source": "unavailable", "master_ci_after": ""})
    rc, lines = _run_variance("F19c-non-closing-excluded", healthy + noise)
    if rc is not None:
        check(rc == 0, "F19c-non-closing-excluded-exit",
              "non-closing rows must be filtered before anything is computed; got %r" % rc)
        check(_has_token(lines, "n_slices=10"), "F19c-non-closing-excluded",
              "expected n_slices=10 — the 5 `tick-ok` rows are not slice closures and their zeros "
              "must not enter the zero_rate; lines=%s" % (lines[:12],))


