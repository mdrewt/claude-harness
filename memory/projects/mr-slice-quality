def _init_repo(path, default_branch, env):
    os.makedirs(path)
    for args in (["-c", "init.defaultBranch=" + default_branch, "init"],
                 ["config", "user.email", "lp02@fixture.invalid"],
                 ["config", "user.name", "lp02 fixture"],
                 ["config", "commit.gpgsign", "false"],
                 ["config", "diff.renames", "true"]):
        rc, _o, err = _git(path, args, env)
        if rc != 0:
            return "git %s in %s failed rc=%r: %s" % (args[0], path, rc, err.strip()[:140])
    return None


def _commit_all(path, message, env):
    for args in (["add", "-A"], ["commit", "-m", message]):
        rc, _o, err = _git(path, args, env)
        if rc != 0:
            return "git %s in %s failed rc=%r: %s" % (args[0], path, rc, err.strip()[:140])
    return None


