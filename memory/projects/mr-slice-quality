def _assistant_event(blocks, msg_id):
    return json.dumps({
        "type": "assistant",
        "message": {"id": msg_id, "role": "assistant", "content": blocks},
        "session_id": "fixture",
    })


def _skill_block(block_id, name="Skill"):
    return {"type": "tool_use", "id": block_id, "name": name, "input": {"command": "code-intel"}}


def _build_skill_log_real():
    """3 DISTINCT Skill tool_use blocks; the first is repeated with the SAME block id, which is what
    the stream actually does as a block arrives. Expected: 3, not 4."""
    lines = [
        json.dumps({"type": "system", "subtype": "init", "tools": ["Task", "Bash", "Skill", "Read"]}),
        _assistant_event([{"type": "text", "text": "planning"}], "msg_0"),
        _assistant_event([_skill_block("toolu_A")], "msg_1"),
        _assistant_event([_skill_block("toolu_A")], "msg_1"),      # streaming duplicate
        _assistant_event([_skill_block("toolu_B"), _skill_block("toolu_R", name="Read")], "msg_2"),
        "",                                                         # blank line, must not raise
        "{ this line is not json at all",                           # garbage, must not raise
        _assistant_event([_skill_block("toolu_C")], "msg_3"),
        json.dumps({"type": "user", "message": {"role": "user", "content": [
            {"type": "tool_result", "tool_use_id": "toolu_C", "content": "the Skill returned ok"}]}}),
    ]
    return "\n".join(lines) + "\n"


def _build_skill_log_prose():
    """ZERO Skill tool_use blocks, but the WORD `Skill` everywhere a substring counter would find
    it: the init event's tool allowlist, assistant prose, a tool_result echoing a log line that
    itself contains `"name":"Skill"` (a log-of-a-log), and a Rust type name. Measured in the real
    corpus: 69 occurrences of the word in one pass log for a slice that invoked zero."""
    inner = '{"type":"tool_use","id":"toolu_X","name":"Skill"}'
    lines = [
        json.dumps({"type": "system", "subtype": "init",
                    "tools": ["Task", "Bash", "Skill", "Read", "Edit"]}),
        _assistant_event([{"type": "text",
                           "text": "I could use the Skill tool here. Skill Skill Skill /simplify."}],
                         "msg_0"),
        json.dumps({"type": "user", "message": {"role": "user", "content": [
            {"type": "tool_result", "tool_use_id": "t1",
             "content": "stdout: ... " + inner + " ... 3 matches"}]}}),
        _assistant_event([{"type": "tool_use", "id": "toolu_Y", "name": "Read",
                           "input": {"file_path": "server/src/skill.rs",
                                     "pattern": "SkillRow SkillDef Skill"}}], "msg_1"),
    ]
    return "\n".join(lines) + "\n"


