              "a COMPOUND multi-verdict string must never collapse to one half; expected 'unknown', "
              "got %r for raw=%r" % (value, raw))


def assert_f11_ci_mapping():
    for raw, expected in CI_MAP_TABLE:
        lab = "F11-map[%s]" % raw[:44]
        pair = _ci_pair(raw, lab)
        if pair is None:
            continue
        value, note = pair
        check(value == expected, lab, "expected %r, got %r for raw=%r" % (expected, value, raw))
        check(value in CI_VOCAB, "F11-vocab[%s]" % raw[:32],
              "%r is outside the closed vocabulary %s" % (value, list(CI_VOCAB)))
        check(note is None, "F11-note-absent[%s]" % raw[:32],
              "raw_note must be None for a MAPPED value; got %r" % (note,))

    # Unmappable -> unknown + the raw string preserved, rc 0 (never a die()).
    weird = "zzqq not a verdict at all"
    pair = _ci_pair(weird, "F11-unmappable-value")
    if pair is not None:
        check(pair[0] == "unknown", "F11-unmappable-value",
              "an unmappable string must map to 'unknown', got %r" % (pair[0],))
        check(pair[1] == weird, "F11-unmappable-note",
              "the raw string must be preserved for `notes`; expected %r, got %r" % (weird, pair[1]))

    # ...and the preserved note is the STRIPPED raw, per the contract.
    padded = "  zzqq not a verdict  "
    pair = _ci_pair(padded, "F11-unmappable-stripped")
    if pair is not None:
        check(pair[0] == "unknown" and pair[1] == padded.strip(), "F11-unmappable-stripped",
              "expected ('unknown', %r) for a padded unmappable string, got %r"
              % (padded.strip(), pair))

    # M7: `--ci` is LLM-supplied and unbounded, and every mr-record call re-reads the ledger tail.
    long_raw = "qq" * 300
    pair = _ci_pair(long_raw, "F11-long-unmappable-value")
    if pair is not None:
        check(pair[0] == "unknown", "F11-long-unmappable-value",
              "expected 'unknown' for a 600-char blob, got %r" % (pair[0],))
        check(isinstance(pair[1], str) and len(pair[1]) == CI_RAW_NOTE_MAX, "F11-long-note-truncated",
              "the preserved raw note must be truncated to %d chars, got %r"
              % (CI_RAW_NOTE_MAX, None if pair[1] is None else len(pair[1])))

    # The contract says NEVER raises. mr-record hands this whatever the supervisor typed, and a
    # crash here is a lost ledger row (R1).
    for bad in (12345, [], {}, 3.5, True):
        lab = "F11-non-string[%s]" % type(bad).__name__
        pair = _ci_pair(bad, lab)
        if pair is None:
            continue
        check(pair[0] in CI_VOCAB, lab,
              "a non-string input must still return a value inside the closed vocabulary, got %r"
              % (pair[0],))


def assert_f12_absent_ci():
    """F12 (closing-row half). An ABSENT `--ci` on a closing row becomes `not-recorded`, which is
    the value that finally distinguishes "nobody claimed anything" from "someone claimed something
    unparseable" (`unknown`). This is not academic: the newest MERGED row in the live ledger carries
    `""` because the supervisor simply omitted `--ci`, so the measured 65.8%-empty defect survived
    the original D4 untouched on exactly the row class the spec cares about.

    The NON-closing half (the value stays `""`, no churn on the ~400 tick-ok rows) needs a real
    appended row and is asserted against the real mr-record inside mr-selfcheck."""
    for raw, label in ((None, "None"), ("", "empty"), ("   ", "whitespace")):
        lab = "F12-absent-ci[%s]" % label
        pair = _ci_pair(raw, lab)
        if pair is None:
            continue
        check(pair[0] == "not-recorded", lab,
              "an absent/empty --ci on a closing row must be 'not-recorded', got %r" % (pair[0],))
        check(pair[1] is None, "F12-absent-ci-note[%s]" % label,
              "raw_note is reserved for `unknown`; got %r" % (pair[1],))


def assert_is_closing():
