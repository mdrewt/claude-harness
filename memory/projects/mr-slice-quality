# =================================================================================================
# F18 — slice-id sanitisation. 64 real ledger rows carry ids that fail SLICE_ID_RE, including one
# containing a path separator; mr-record:34 validates only non-emptiness. A `../` id reaching a
# path join is a write-anywhere primitive, so this fixture asserts BOTH the verdict and that the
# whole temp tree is byte-for-byte unchanged afterwards.
# =================================================================================================
BAD_SLICE_IDS = [
    "lp/02",
    "../etc/passwd",
    "..",
    "a/../../b",
    "lp 02",
    "lp\t02",
    "",
    "x" * 65,
    "lp-02\n",
]


def _tree_snapshot(root):
    out = {}
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames.sort()
        for name in sorted(filenames):
            p = os.path.join(dirpath, name)
            try:
                st = os.lstat(p)
                out[os.path.relpath(p, root)] = (st.st_size, int(st.st_mtime))
            except OSError:
                out[os.path.relpath(p, root)] = ("unstatable",)
        for name in sorted(dirnames):
            out[os.path.relpath(os.path.join(dirpath, name), root) + "/"] = ("dir",)
    return out


def assert_f18_bad_slice_ids(tmp):
    root = os.path.join(tmp, "f18-root")
    os.makedirs(os.path.join(root, "memory", "projects"))
    os.makedirs(os.path.join(root, ".claude", "worktrees"))
    before = _tree_snapshot(tmp)
    for bad in BAD_SLICE_IDS:
        lab = "F18-bad-id[%r]" % bad
        ok, got = call(derive, bad, root)
        if not ok:
            check(False, lab, got)
            continue
        if not check(isinstance(got, dict), lab, "derive must return a dict, got %r" % (got,)):
            continue
        check(got.get(QUALITY_KEY) == "unavailable", lab,
              "a slice id failing [A-Za-z0-9._-]{1,64} must yield quality_source='unavailable' "
              "(never a die(), never a path join); got %r" % (got.get(QUALITY_KEY),))
        for col in COLUMNS:
            # PRESENT-and-null, not merely absent-or-null: derive's dict contract is that all six
            # keys exist on every return, so mr-record can emit them unconditionally on a closing
            # row (orchestrator decision on the E1-literal reading).
            check(col in got and got.get(col) is None, "F18-null[%s][%r]" % (col, bad),
                  "expected the key %s to be PRESENT and null; present=%s value=%r"
                  % (col, col in got, got.get(col)))
        check(isinstance(got.get("reason"), str) and got.get("reason"),
              "F18-reason[%r]" % bad,
              "an `unavailable` verdict must carry a non-empty reason for the QUALITY(...) note; "
              "got %r" % (got.get("reason"),))
    after = _tree_snapshot(tmp)
    check(before == after, "F18-no-path-touched",
          "derive() with a hostile slice id changed the filesystem. added=%s removed=%s"
          % (sorted(set(after) - set(before)), sorted(set(before) - set(after))))

    # CLI half. mr-record PARSES this stdout, so the contract is `rc 0 + exactly one JSON object`
    # even for a hostile id — a helper that fails its caller turns a data-quality problem into the
    # row-loss problem R1 exists to prevent. Invoked through sys.executable exactly as mr-record
    # does (mr-record:64-69), so neither a missing exec bit nor an asdf shim can masquerade as a
    # failing assertion.
    rc, out, err = _safe_run([sys.executable, os.path.abspath(__file__), "derive", "lp/02"])
    if rc is None:
        check(False, "F18-cli-contract", "the derive CLI did not return: %s" % err.strip()[:160])
        return
    check(rc == 0, "F18-cli-contract",
          "`mr-slice-quality derive <hostile id>` must exit 0 and print JSON; rc=%r stderr=%r"
          % (rc, err.strip()[:200]))
    try:
        obj = json.loads(out.strip() or "null")
    except Exception as exc:  # noqa: BLE001
        obj = None
        check(False, "F18-cli-json",
              "stdout must be exactly one JSON object (%s): %r" % (exc, out[:200]))
    if isinstance(obj, dict):
        check(obj.get(QUALITY_KEY) == "unavailable", "F18-cli-json",
              "expected quality_source='unavailable' on stdout, got %r" % (obj.get(QUALITY_KEY),))


