def _load_ledger_rows(path):
    """Read a JSONL ledger into a list of dicts. Unparseable lines are skipped. Raises OSError."""
    rows = []
    with open(path, errors="replace") as fh:
        for line in fh:
            line = line.strip()
            if not line:
                continue
            try:
                obj = json.loads(line)
            except Exception:
                continue
            if isinstance(obj, dict):
                rows.append(obj)
    return rows


