        check(d.get("prod_lines_added") == EXPECT_A_PROD_ADD
              and d.get("prod_lines_deleted") == EXPECT_A_PROD_DEL, "F2-rename-once",
              "the rename oldname.py => src/renamed.py must count ONCE, contribute 0 lines and be "
              "classified on the DESTINATION. got added=%r deleted=%r"
              % (d.get("prod_lines_added"), d.get("prod_lines_deleted")))

    # ---------------------------------------------------------------------------------------------
    # F7b — repo B: PROJECT-routed, pid-derived sizes, deletion-heavy, classification IN the diff.
