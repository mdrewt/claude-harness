_ASSERTIONS = 0
_FAILURES = []


def check(cond, id_, detail=""):
    global _ASSERTIONS
    _ASSERTIONS += 1
    if not cond:
        _FAILURES.append((id_, detail))
    return bool(cond)


def call(fn, *args, **kwargs):
    """Invoke an IMPLEMENTER-OWNED function without ever letting a traceback escape.

    Returns (True, value) or (False, "<one-line reason>"). During the RED phase every call returns
    (False, "NOT IMPLEMENTED — ...") so each fixture can report exactly what is missing instead of
    exploding at the first `derive(...)`."""
    try:
        return True, fn(*args, **kwargs)
    except NotImplementedError as exc:
        return False, "NOT IMPLEMENTED — %s" % exc
    except Exception as exc:  # noqa: BLE001 — a fixture must report, never crash the battery
        return False, "%s: %s" % (type(exc).__name__, exc)


# -------------------------------------------------------------------------------------------------
# Subprocess guard. Centralises EVERY subprocess call this file makes so "never executes the tick,
# never spawns a paid session, never names the kill-switch flag" is a RUNTIME property rather than
# a convention. Same shape as mr-telemetry-selftest's guard, extended with gh/ollama because this
# tool's charter forbids them outright.
# -------------------------------------------------------------------------------------------------
_FORBIDDEN_ARGV0 = {"mr-native-tick.sh"}
_FORBIDDEN_ANYWHERE = {"claude", "gh", "ollama"}
_KILL_SWITCH_BASENAME = ".native-supervisor-disabled"


def _safe_run(argv, cwd=None, timeout=120, env=None):
    b0 = os.path.basename(str(argv[0]))
    if b0 in _FORBIDDEN_ARGV0:
        raise RuntimeError("REFUSED: mr-slice-quality must never execute %s" % b0)
    for a in argv:
        sa = str(a)
        if os.path.basename(sa) in _FORBIDDEN_ANYWHERE or sa.strip() in _FORBIDDEN_ANYWHERE:
            raise RuntimeError("REFUSED: mr-slice-quality must never invoke %r (argv=%r)" % (sa, argv))
        if _KILL_SWITCH_BASENAME in sa:
            raise RuntimeError("REFUSED: mr-slice-quality must never touch the kill-switch flag path")
    try:
        r = subprocess.run(argv, cwd=cwd, env=env, capture_output=True, text=True, timeout=timeout)
        return r.returncode, r.stdout or "", r.stderr or ""
    except FileNotFoundError as exc:
        return None, "", "NOT-FOUND: %s" % exc
    except subprocess.TimeoutExpired:
        return None, "", "TIMEOUT after %ss" % timeout


