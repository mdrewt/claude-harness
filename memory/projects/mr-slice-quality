def _ci_pair(raw, label):
    """Returns (value, note) or None after recording a failure."""
    ok, got = call(normalize_ci, raw)
    if not ok:
        check(False, label, got)
        return None
    if not check(isinstance(got, tuple) and len(got) == 2, label,
                 "normalize_ci must return (value, raw_note), got %r" % (got,)):
        return None
    return got


