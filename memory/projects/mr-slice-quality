_ASSERTIONS = 0
_FAILURES = []


def check(cond, id_, detail=""):
    global _ASSERTIONS
    _ASSERTIONS += 1
    if not cond:
        _FAILURES.append((id_, detail))
    return bool(cond)


def call(fn, *args, **kwargs):
    """Invoke an IMPLEMENTER-OWNED function without ever letting a traceback escape.

    Returns (True, value) or (False, "<one-line reason>"). During the RED phase every call returns
    (False, "NOT IMPLEMENTED — ...") so each fixture can report exactly what is missing instead of
    exploding at the first `derive(...)`."""
    try:
        return True, fn(*args, **kwargs)
    except NotImplementedError as exc:
        return False, "NOT IMPLEMENTED — %s" % exc
    except Exception as exc:  # noqa: BLE001 — a fixture must report, never crash the battery
        return False, "%s: %s" % (type(exc).__name__, exc)


def _git_env(home):
    """A hermetic git environment. The user's ~/.gitconfig can flip results under this battery's
    feet — `diff.renames=false` alone turns fixture A's files_changed from 8 into 9 — so HOME is
    redirected, system/global config is disabled, and any inherited repo pointers are removed."""
    env = dict(os.environ)
    env.update({
        "HOME": home,
        "GIT_CONFIG_NOSYSTEM": "1",
        "GIT_CONFIG_GLOBAL": os.devnull,
        "GIT_TERMINAL_PROMPT": "0",
        "GIT_OPTIONAL_LOCKS": "0",
        "GIT_AUTHOR_NAME": "lp02 fixture",
        "GIT_AUTHOR_EMAIL": "lp02@fixture.invalid",
        "GIT_COMMITTER_NAME": "lp02 fixture",
        "GIT_COMMITTER_EMAIL": "lp02@fixture.invalid",
    })
    for leaked in ("GIT_DIR", "GIT_WORK_TREE", "GIT_INDEX_FILE", "XDG_CONFIG_HOME"):
        env.pop(leaked, None)
    return env


def _git(cwd, args, env):
    return _safe_run(["git", "-C", cwd] + list(args), env=env)


def _write(path, text):
    d = os.path.dirname(path)
    if d and not os.path.isdir(d):
        os.makedirs(d)
    with open(path, "w") as fh:
        fh.write(text)


def _write_bytes(path, data):
    d = os.path.dirname(path)
