def _derive_dict(label, slice_, root, log_dir):
    ok, got = call(derive, slice_, root, log_dir)
    if not ok:
        check(False, label, got)
        return None
    if not check(isinstance(got, dict), label, "derive must return a dict, got %r" % (got,)):
        return None
    missing = [k for k in tuple(COLUMNS) + (QUALITY_KEY, "reason") if k not in got]
    if not check(not missing, label + "-keys",
                 "derive's dict is missing required key(s): %s (E1 names six columns; "
                 "quality_source and reason are the plan's D3/R-G additions)" % missing):
        return None
    return got


