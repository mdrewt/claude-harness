# Static safety pin (R-D). `shell=True` is never legitimate in this tool: every git call is
# list-argv by contract, and a shell hop is how an unsanitised slice id becomes a command.
# =================================================================================================
def assert_no_shell_true():
    # The needle is ASSEMBLED at runtime rather than written as a literal: a checker that spells
    # out the forbidden token is itself a hit and would red permanently on its own source.
    needle = "shell" + "=" + "True"
    try:
        with open(os.path.abspath(__file__), errors="replace") as fh:
            src = fh.read()
    except OSError as exc:
        check(False, "S1-source-readable", "cannot read own source: %s" % exc)
        return
    check(needle not in src, "S1-no-shell-hop",
          "mr-slice-quality must never run a subprocess through a shell — every git call is "
          "list-argv by contract (R-D), and a shell hop turns an unsanitised slice id into a command")


# =================================================================================================
# Non-pollution. The ledger is the durable standdown record and is append-only (ADR-0011); nothing
# in a TEST may add a byte to it. Both the SELF-LOCATED copies (this worktree) and the hardcoded
# PRODUCTION copies are watched, because mr-record's `MEM=` points at the production path
# regardless of which copy of a tool is invoked — a buggy implementation writes THERE while the
# self-located files stay clean, which is a false green on exactly the property this check exists
# for (the same blind spot mr-telemetry-selftest's T10 had to close).
#
# Deliberately NOT a byte/sha snapshot of those files: the real ledger legitimately GROWS while
# this runs (mr-selfcheck is invoked from the hourly tick, which also writes rows), so a hash
# compare would be a flake, and a flaky gate gets disabled — the failure mode this corpus keeps
# re-learning. The property that actually matters is narrower and stable: NONE OF OUR BYTES may
# appear in the real corpus, and none of our fixture artifacts may be left behind in $MEM.
# =================================================================================================
_PROD_MEM = "/home/mdrewt/projects/ai-apps/claude-harness/memory/projects"
_WATCHED = [
    os.path.join(MEM, "monster-realm-usage-ledger.jsonl"),
    os.path.join(MEM, "monster-realm-handoff.md"),
    os.path.join(_PROD_MEM, "monster-realm-usage-ledger.jsonl"),
    os.path.join(_PROD_MEM, "monster-realm-handoff.md"),
]
_FIXTURE_MARKERS = ("lp-fixture-", "f18-root", "mr-slice-quality-repo-")


def _fixture_bytes_in(path):
    try:
        with open(path, errors="replace") as fh:
            text = fh.read()
    except OSError:
        return []
    return [m for m in _FIXTURE_MARKERS if m in text]


def _fixture_leftovers_in_mem():
    try:
        names = os.listdir(MEM)
    except OSError:
        return []
    return sorted(n for n in names if any(m in n for m in _FIXTURE_MARKERS))


