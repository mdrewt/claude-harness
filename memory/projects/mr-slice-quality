    # nulling everything that looks empty. Its pass log is the PROSE one -> skills_invoked == 0,
    # the other half of the "0 is a real measurement" property.
    # ---------------------------------------------------------------------------------------------
    d = _derive_dict("F6-genuine-zero", FX_SLICE_CLEAN, root, log_dir)
    if d is not None:
        for col in ("files_changed", "prod_lines_added", "prod_lines_deleted", "test_lines_added"):
            check(d.get(col) == 0, "F6-%s" % col,
                  "a clean worktree sitting at merge-base has a genuine %s=0; got %r" % (col, d.get(col)))
        check(d.get(QUALITY_KEY) == "derived", "F6-quality-source",
              "a measured zero is `derived`, not `unavailable`; got %r" % (d.get(QUALITY_KEY),))
        check(d.get("ears_criteria_count") == EXPECT_CLEAN_EARS, "F6-ears",
              "the clean fixture's spec section carries %d SHALL; got %r"
              % (EXPECT_CLEAN_EARS, d.get("ears_criteria_count")))
        check(d.get("skills_invoked") == 0, "F6-skills-measured-zero",
              "this slice's pass log is the prose-only one: a MEASURED 0, which must be "
              "distinguishable from the None fixture B gets; got %r" % (d.get("skills_invoked"),))

    # ---------------------------------------------------------------------------------------------
    # F5: dirty worktree -> `partial`, the FOUR diff columns null, ears/skills still measured.
