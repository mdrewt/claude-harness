def normalize_ci(raw):
    """Map an arbitrary `--ci` string onto the closed vocabulary (E3, plan R-B).

    Returns a 2-tuple ``(value, raw_note)``:
      * ``value``    — exactly one of CI_VOCAB.
      * ``raw_note`` — ``None`` unless ``value == "unknown"``, in which case it is the stripped raw
                       string truncated to CI_RAW_NOTE_MAX chars (mr-record puts it in `notes`).

    NEVER raises, never dies, never returns anything outside CI_VOCAB (A3: `mr-record`'s contract
    is that a row is never lost; dying on an unmappable `--ci` would trade a data-QUALITY problem
    for a data-LOSS one the first time the supervisor types `GREEN (abc1234)`).

    Precedence scan over the WHOLE string, never the head token (the head-token rule specified in
    the original plan mismapped 21 real rows to `green`, headed by
    'GREEN (CI wf); Nightly RED (mutation job, ...)' — compound verdicts are HOW the supervisor
    writes reds):
      0. empty / None / whitespace-only              -> ("not-recorded", None)
      1. a red token anywhere                        -> ("red", None)
         red tokens are word-bounded: red, fail, fails, failed, failing, failure, broken.
         Word-bounded is load-bearing, not cosmetic: the real corpus value `rerun-triggered`
         CONTAINS the substring "red" (trigge-RED) and is a PENDING row.
      2. else two or more distinct verdict FAMILIES present -> ("unknown", <raw>)
         (never collapse a compound verdict to one of its halves)
      3. else map the single family:
              green   <- green, success, pass, ok
              pending <- pending, in_progress, queued, rerun*
              not-applicable <- n/a, not-applicable, no-remote-ci*
         The `no-remote-ci*` pattern is matched as a UNIT and consumes the rest of the token, so
         the real corpus value `no-remote-ci-local-gate-green` is `not-applicable` (there is no
         remote CI on the harness repo; the trailing word describes the LOCAL gate) rather than a
         rule-2 compound. R-B names this string explicitly as one the new rule handles.
      4. else -> ("unknown", <raw truncated>)
    """
    raise NotImplementedError(
        "lp-02 RED: normalize_ci() is not implemented — the closed-vocabulary `--ci` mapper (E3, "
        "plan R-B precedence scan) does not exist yet")


