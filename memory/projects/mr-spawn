  # error branch below would silently never fire. Reproduced; keep these two statements apart.
  local blk
  blk=$(mr_skills "$raw") || {
    brief_notice SKILLS-MAP-ERROR "required-skill mapping failed for touches=$(echo "$raw" | head -c 200); brief rendered WITHOUT the skills block (advisory — the spawn continues)"
    blk=""
  }
  # S/V stay environment-passed (unchanged from the original block); the three moved inputs do not.
  export S V
  # F2: a render failure is a REFUSAL (template drift must not ship a mangled brief), but this
  # file promises "one status JSON line" and mr-spawn:6 has discarded stderr — so a bare `exit 1`
  # here is a silent death. Say what happened first, then propagate. `rc=$?` must be the very
  # next statement after the heredoc: any command in between (including `local`) overwrites it.
  /usr/bin/python3 - "$tpl" "$out" "$blk" <<'PYBRIEF'
import json, os, sys
S=os.environ["S"]; v=json.load(open(os.environ["V"]))
# lp-skills F1 — SINGLE-PASS SUBSTITUTION. The renderer applies the keys below as a CHAIN of
# .replace() calls, so with a plain string every later key re-scans text an earlier key's VALUE
# inserted. `touches`/`target_desc`/`resume_block` are freeform planner prose and this corpus
# writes literal `<SLICE>`-shaped tokens constantly, so that quirk (a) let a `<SLICE>` arriving
# inside `touches` survive to the end, where the leftover assert mistook it for template drift
# and SystemExited — killing the spawn silently — and (b) let a value carrying `<SKILLS_BLOCK>`
# duplicate and RELOCATE the real skills header, i.e. a template-injection primitive for every
# placeholder ordered after `<TOUCHES>`. Both are pre-existing second-order quirks of the chain;
# the leftover assert is what turned (a) into an abort.
#
# So the document is carried as SEGMENTS: plain str = still template (rescannable), _Done = an
# already-substituted value that no later key may look at. Values become literal text, exactly
# once, wherever the TEMPLATE put them. A welcome consequence: substitution ORDER no longer
# affects the result. Literal string ops only — no regex, per house doctrine.
class _Done(str):
    """A substituted value. Final text; later keys skip it."""


class _Doc(list):
    def replace(self, key, val):
        out = _Doc()
        for seg in self:
            if isinstance(seg, _Done) or key not in seg:
                out.append(seg)
                continue
            for i, part in enumerate(seg.split(key)):
                if i:
                    out.append(_Done(val))
                out.append(part)
        return out

    def __contains__(self, key):
        # Template-derived segments ONLY: a placeholder that arrived inside a value is data.
        return any(key in seg for seg in self if not isinstance(seg, _Done))

    def __str__(self):
        return "".join(self)

tpl=_Doc([open(sys.argv[1]).read()])
_t=v.get("touches","")
touches_str=", ".join(_t) if isinstance(_t,list) else str(_t)
tier=v.get("tier") or (_ for _ in ()).throw(SystemExit("vars.json missing required field: tier (hard|routine|content)"))
tier_block=("QUALITY TIER: HARD — invoke the tester subagent with model opus; depth over speed; this session runs at xhigh effort.\n" if tier=="hard"
 else "QUALITY TIER: CONTENT — data-drop slice: right-size the lens battery (reviewer + verifier mandatory; add red-team/domain auditors ONLY if the slice touches validation/parsing/security surfaces). Depth comes from the content gates (parity/determinism/schema-snapshot), not redundant lenses. Lenses run on their DECLARED agent models (sonnet-class) — do not bump lens models upward on a content slice (THIS OVERRIDES the build-loop prompt bump-one-tier default for this slice). The tester requirement is UNCHANGED — meaningful tests first, always.\n" if tier=="content" else "")
rb=v.get("resume_block","") or ""
repo=os.environ["REPO"]
