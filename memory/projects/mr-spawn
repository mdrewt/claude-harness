]


def _check(raw, expected):
    """The single comparator every fixture-driven test below goes through. Calls the REAL
    skills_for(tokens_of(raw)) -- never a second hand-rolled copy of the mapping."""
    return skills_for(tokens_of(raw)) == list(expected)


def t1_fixture_register():
    bad = 0
    for raw, want, why in FIXTURES:
        if not _check(raw, want):
            got = skills_for(tokens_of(raw))
            print("SKILLS-SELFTEST-FAIL t1-fixture want=%s got=%s (%s)\n    touches: %s"
                  % (want, got, why, raw))
            bad = 1
    return bad


def t2_proof_of_teeth():
    """EARS proof-of-teeth: a server-module/** fixture OMITTING spacetimedb-reducer must be
    REJECTED by the comparator, plus the anti-degeneracy control (precedent: mr-repo-of's own
    `len(verdicts) < 4` control) so a stuck always-all-six or always-empty impl cannot pass."""
    bad = 0
    if _check("server-module/src/battle.rs", ["spacetimedb-reducer", "code-intel"]) is not True:
        print("SKILLS-SELFTEST-FAIL t2-positive: server-module/src/battle.rs must match "
              "[spacetimedb-reducer, code-intel]")
        bad = 1
    if _check("server-module/src/battle.rs", ["code-intel"]) is not False:
        print("SKILLS-SELFTEST-FAIL t2-negative-control: a server-module/** fixture OMITTING "
              "spacetimedb-reducer wrongly compared equal -- the comparator has degenerated")
        bad = 1
    distinct = set(tuple(skills_for(tokens_of(raw))) for raw, _want, _why in FIXTURES)
    if len(distinct) < 4:
        print("SKILLS-SELFTEST-FAIL t2-degenerate: only %d distinct skill-set(s) across the "
              "register (%s) -- a stuck always-all-six or always-empty implementation would pass "
              "every same-verdict fixture" % (len(distinct), sorted(distinct)))
        bad = 1
    empties = [s for s in distinct if s == ()]
    if len(empties) != 1:
        print("SKILLS-SELFTEST-FAIL t2-degenerate-empty: expected exactly ONE distinct empty "
              "skill-set across the register, found %d" % len(empties))
        bad = 1
    return bad


def t3_rf4_shape():
    """RF-4: the brief is multiplied by ~500 turns, so the block must be exactly 1 header line
    plus 1 line per skill, every line <=100 chars, and the empty case must be "" BY IDENTITY."""
    bad = 0
    if render_block([]) is not "":
        print("SKILLS-SELFTEST-FAIL t3-empty-identity: render_block([]) must be the identity "
              "empty string")
        bad = 1
    for raw, _want, why in FIXTURES:
        skills = skills_for(tokens_of(raw))
        block = render_block(skills)
        if not skills:
            if block is not "":
                print("SKILLS-SELFTEST-FAIL t3-empty-row: %r -> empty skill list must render "
                      "'' exactly (%s)" % (raw, why))
                bad = 1
            continue
        if not block.startswith("\n\n"):
            print("SKILLS-SELFTEST-FAIL t3-leading-blank-lines: block for %r does not start "
                  "with exactly '\\n\\n'" % raw)
            bad = 1
        lines = block.strip("\n").splitlines()
        if len(lines) != len(skills) + 1:
            print("SKILLS-SELFTEST-FAIL t3-line-count: %r expected %d lines (1 header + %d "
                  "skills), got %d" % (raw, len(skills) + 1, len(skills), len(lines)))
            bad = 1
        for ln in lines:
            if len(ln) > 100:
                print("SKILLS-SELFTEST-FAIL t3-line-length: line exceeds 100 chars (%d) for "
                      "%r: %r" % (len(ln), raw, ln))
                bad = 1
    return bad


def t4_template_placement(selfdir):
    """Reads the template SELF-LOCATED (never the hardcoded MEM) so a pre-merge worktree run
    tests ITS OWN copy, not main's placeholder-free one."""
    bad = 0
    path = os.path.join(selfdir, "mr-brief-template.md")
    try:
        with open(path) as f:
            text = f.read()
    except OSError as exc:
        print("SKILLS-SELFTEST-FAIL t4-template-missing: %s (%s)" % (path, exc))
        return 1
    count = text.count("<SKILLS_BLOCK>")
    if count != 1:
        print("SKILLS-SELFTEST-FAIL t4-placeholder-count: expected exactly 1 <SKILLS_BLOCK>, "
              "found %d" % count)
        bad = 1
    anchors = [ln for ln in text.splitlines() if "Test-first, gated" in ln]
    if len(anchors) != 1:
        print("SKILLS-SELFTEST-FAIL t4-anchor-line: expected exactly 1 line containing "
              "'Test-first, gated', found %d" % len(anchors))
        bad = 1
    elif not anchors[0].endswith("<SKILLS_BLOCK>"):
        print("SKILLS-SELFTEST-FAIL t4-placeholder-position: <SKILLS_BLOCK> must be at the END "
              "of the 'Test-first, gated' line; line=%r" % anchors[0])
        bad = 1
    return bad


def t5_map_integrity():
    """The only check validated against the FILESYSTEM instead of expectations baked into this
    file: catches a wrong `root` (4 skills live under PROJ, 2 under HARNESS)."""
    bad = 0
    for row in SKILL_MAP:
        name, root = row[0], row[1]
        skill_path = os.path.join(root, ".claude", "skills", name, "SKILL.md")
        if not os.path.isfile(skill_path):
            print("SKILLS-SELFTEST-FAIL t5-map-integrity: %s -> %s does not exist"
                  % (name, skill_path))
            bad = 1
    return bad


def t6_end_to_end(selfdir):
    """The highest-value tooth: without this, every other test can be green while the block
    never reaches the WRITTEN brief bytes. Drives the REAL --render-brief mode end to end,
    against the REAL self-located template (never a temp copy) -- deliberately strengthens the
    plan's literal wording rather than drifting from it: same file t4 pins the placement of."""
    bad = 0
    self_path = os.path.join(selfdir, "mr-spawn")
    tpl_path = os.path.join(selfdir, "mr-brief-template.md")
    if not os.path.isfile(self_path) or not os.path.isfile(tpl_path):
        print("SKILLS-SELFTEST-FAIL t6-missing-inputs: self=%s tpl=%s" % (self_path, tpl_path))
        return 1
    tmpdir = tempfile.mkdtemp(prefix="mr-skills-t6-")
    try:
        vars_json = os.path.join(tmpdir, "vars.json")
        with open(vars_json, "w") as f:
            json.dump({
                "slice": "lp-skills-t6-fixture", "model": "sonnet", "effort": "high", "adr": "",
                "touches": "server-module/src/x.rs", "target_desc": "t6 fixture",
                "resume_block": "", "tier": "routine",
            }, f)
        env = dict(os.environ)
        env.update({
            "S": "lp-skills-t6-fixture", "V": vars_json, "MEM": selfdir,
            "REPO": "harness", "PR_REPO": "mdrewt/claude-harness", "BASE_BRANCH": "main",
            "WT_ROOT": os.path.join(HARNESS, ".claude", "worktrees"), "CAP": "60",
        })
        out_path = os.path.join(tmpdir, "brief.md")
        try:
            r = _run(["bash", self_path, "--render-brief", tpl_path, out_path,
                      "server-module/src/x.rs"], timeout=60, env=env)
        except subprocess.TimeoutExpired:
            print("SKILLS-SELFTEST-FAIL t6-timeout")
            return 1
        if not os.path.isfile(out_path):
            print("SKILLS-SELFTEST-FAIL t6-no-output: rc=%s stdout=%r stderr=%r"
                  % (r.returncode, r.stdout[-300:], r.stderr[-300:]))
            return 1
        with open(out_path, errors="replace") as f:
            written = f.read()
        if "spacetimedb-reducer" not in written:
            print("SKILLS-SELFTEST-FAIL t6-missing-skill-name: rendered brief does not name "
                  "spacetimedb-reducer")
            bad = 1
        if "Must-apply skills" not in written:
            print("SKILLS-SELFTEST-FAIL t6-missing-header: rendered brief has no skills header")
            bad = 1
        placeholders = ["<SLICE>", "<ADR_NUM>", "<TOUCHES>", "<TARGET_DESC>", "<RESUME_BLOCK>",
                         "<TIER_BLOCK>", "<REPO_BLOCK>", "<PR_REPO>", "<BASE_BRANCH>",
                         "<WT_ROOT>", "<CAP_USD>", "<SKILLS_BLOCK>"]
        leftover = [p for p in placeholders if p in written]
        if leftover:
            print("SKILLS-SELFTEST-FAIL t6-leftover-placeholder: %s survived substitution"
                  % leftover)
            bad = 1

        out_path2 = os.path.join(tmpdir, "brief-empty.md")
        r2 = _run(["bash", self_path, "--render-brief", tpl_path, out_path2,
                   "memory/projects/mr-spawn"], timeout=60, env=env)
        if not os.path.isfile(out_path2):
            print("SKILLS-SELFTEST-FAIL t6-empty-no-output: rc=%s stderr=%r"
                  % (r2.returncode, r2.stderr[-300:]))
            bad = 1
        else:
            with open(out_path2, errors="replace") as f:
                written2 = f.read()
            if "Must-apply skills" in written2:
                print("SKILLS-SELFTEST-FAIL t6-empty-touches-emitted-header: empty touches must "
                      "render NO skills header at all")
                bad = 1
    finally:
        shutil.rmtree(tmpdir, ignore_errors=True)
    return bad


def t7_no_echo_regression():
    """HELD-OUT PROPERTY rows (fresh uuid4 every run) defeat a `skills_for` that is really a
    fixture-overfit lookup table -- a dict keyed on FIXTURES' raw strings returns [] for a path
    it has never seen. Per path: (i) skills_for(tokens_of(path)) must still compute the right
    set from first principles; (ii) render_block must not echo the marker (the brief runs as a
    prompt under --dangerously-skip-permissions -- emitted text must come ONLY from SKILL_MAP)."""
    bad = 0
    cases = [
        ("server-module", ["spacetimedb-reducer", "code-intel"]),
        ("game-core", ["game-core-testing", "code-intel"]),
    ]
    for root, want in cases:
        marker = uuid.uuid4().hex
        raw = "%s/src/%s.rs" % (root, marker)
        got = skills_for(tokens_of(raw))
        if got != want:
            print("SKILLS-SELFTEST-FAIL t7-held-out-property: %r want=%s got=%s -- a lookup "
                  "table keyed on FIXTURES strings cannot have known this path" % (raw, want, got))
            bad = 1
        block = render_block(got)
        if marker in block:
            print("SKILLS-SELFTEST-FAIL t7-no-echo: rendered block echoed caller-controlled "
                  "input %r" % marker)
            bad = 1
    return bad


def t8_zero_arg_usage(selfdir):
    """Baseline (verified against unmodified main): mr-spawn:6's `exec 9>&- 2>/dev/null || true`
    discards stderr for the REST OF THE SCRIPT, including the `${1:?...}` refusal's own message
    -- zero-arg `bash mr-spawn` prints NOTHING and exits rc=1; there is no "usage:" text to pin.
    Pinned instead: (a) rc stays non-zero -- the new `case "${1:-}"` dispatch must not swallow
    the zero-arg case into success; (b) no 'unbound variable' leaks -- what a bare `$1` (instead
    of `${1:-}`) in the new dispatch would produce under `set -u`."""
    bad = 0
    self_path = os.path.join(selfdir, "mr-spawn")
    if not os.path.isfile(self_path):
        print("SKILLS-SELFTEST-FAIL t8-missing-self: %s" % self_path)
        return 1
    try:
        r = _run(["bash", self_path])
    except subprocess.TimeoutExpired:
        print("SKILLS-SELFTEST-FAIL t8-timeout")
        return 1
    combined = (r.stdout or "") + (r.stderr or "")
    if r.returncode == 0:
        print("SKILLS-SELFTEST-FAIL t8-zero-arg-must-refuse: zero-arg invocation exited 0 "
              "(expected non-zero -- the ${1:?...} refusal must still fire)")
        bad = 1
    if "unbound variable" in combined:
        print("SKILLS-SELFTEST-FAIL t8-unbound-variable: zero-arg invocation printed 'unbound "
              "variable' -- the new dispatch must use ${1:-}, never a bare $1: %r"
              % combined[-300:])
        bad = 1
    return bad


def t9_live_path_wired(selfdir):
    """STATIC SELF-SOURCE PROXY (cf. mr-selfcheck's A6: proves WIRING, not runtime behavior).
    Paired with t6 (which exercises build_brief's real behavior via --render-brief), this closes
    the R2 gap: build_brief could be correct but reachable ONLY from --render-brief, leaving the
    real `mr-spawn <slice>` path rendering a brief with a literal, unsubstituted <SKILLS_BLOCK>
    token -- never exercising the live path for real, which must NEVER run here (hold gate, git
    fetch, IDE probe, a real launch). Scoped to the BASH region after this heredoc's own
    terminator (tag discovered dynamically from the opener, never hardcoded) so this test's
    source -- which necessarily quotes its own anchors -- can never match itself.

    (i) build_brief is called AFTER the live entry point (`S="${1:?`); (ii) the substitution
    call `tpl.replace(k,val)` exists EXACTLY ONCE in that region (0 = anchor drifted, >1 = a
    second copy of the render logic -- the R2 failure mode); (iii) `<SKILLS_BLOCK>` appears in
    the `for k,val in [...]:` list feeding that call."""
    bad = 0
    self_path = os.path.join(selfdir, "mr-spawn")
    try:
        src = open(self_path).read()
    except OSError as exc:
        print("SKILLS-SELFTEST-FAIL t9-missing-self: %s (%s)" % (self_path, exc))
        return 1

    # Same opener shape mr-selfcheck's own py-heredoc scanner looks for -- discovered, never
    # hardcoded, so this test's own source is never the thing it is searching for.
    opener = re.search(r"^[^\n]*python3[^\n]*<<-?'([A-Za-z0-9_]+)'[^\n]*$", src, re.M)
    term = opener and re.search(r"\n" + re.escape(opener.group(1)) + r"\n", src)
    if not term:
        print("SKILLS-SELFTEST-FAIL t9-no-heredoc-anchor: could not locate this heredoc's own "
              "opener+terminator by content -- cannot scope the scan away from this test's source")
        return 1
    bash_region = src[term.end():]

    entry_idx = bash_region.find('S="${1:?')
    if entry_idx == -1:
        print("SKILLS-SELFTEST-FAIL t9-no-entry-point: live entry point not found by content")
        bad = 1
    elif "build_brief" not in bash_region[entry_idx:]:
        print("SKILLS-SELFTEST-FAIL t9-live-path-unwired: no build_brief call after the live "
              "entry point -- `mr-spawn <slice>` would render an unsubstituted <SKILLS_BLOCK>")
        bad = 1

    anchor = "tpl.replace(k,val)"
    count = bash_region.count(anchor)
    if count != 1:
        print("SKILLS-SELFTEST-FAIL t9-duplicate-render-logic: expected %r exactly ONCE in the "
              "bash region, found %d (0=anchor drifted, >1=second render copy, the R2 failure "
              "mode)" % (anchor, count))
        bad = 1
    else:
        idx = bash_region.find(anchor)
        loop_start = bash_region.rfind("for k,val in [", 0, idx)
        if loop_start == -1 or "<SKILLS_BLOCK>" not in bash_region[loop_start:idx]:
            print("SKILLS-SELFTEST-FAIL t9-skills-block-not-substituted: <SKILLS_BLOCK> missing "
                  "from the `for k,val in [...]:` substitution list feeding %r" % anchor)
            bad = 1
    return bad


def selftest(selfdir):
    bad = 0
    battery = [
        ("t1-fixture-register", t1_fixture_register, ()),
        ("t2-proof-of-teeth", t2_proof_of_teeth, ()),
        ("t3-rf4-shape", t3_rf4_shape, ()),
        ("t4-template-placement", t4_template_placement, (selfdir,)),
        ("t5-map-integrity", t5_map_integrity, ()),
        ("t6-end-to-end", t6_end_to_end, (selfdir,)),
        ("t7-no-echo-regression", t7_no_echo_regression, ()),
        ("t8-zero-arg-usage", t8_zero_arg_usage, (selfdir,)),
        ("t9-live-path-wired", t9_live_path_wired, (selfdir,)),
    ]
    for name, fn, args in battery:
        try:
            r = fn(*args)
        except Exception as exc:
            print("SKILLS-SELFTEST-FAIL %s crashed: %s: %s" % (name, type(exc).__name__, exc))
            bad = 1
            continue
        if r:
            bad = 1
    if not bad:
        print("SKILLS-SELFTEST-OK %d fixtures" % len(FIXTURES))
    return 1 if bad else 0

# ===== END GATING TESTS =====

def main(argv):
    if len(argv) >= 2 and argv[1] == "--selftest":
        selfdir = argv[2] if len(argv) >= 3 else None
        return selftest(selfdir)
    raw = argv[1] if len(argv) >= 2 else ""
    skills = skills_for(tokens_of(raw))
    sys.stdout.write(render_block(skills))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
PYSKILLS
}

case "${1:-}" in
  --selftest)
    mr_skills --selftest "$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
    exit $?
    ;;
  --render-brief)
    build_brief "${4:-}" "${2:-}" "${3:-}"
    exit $?
    ;;
esac

S="${1:?usage: mr-spawn <slice> [--dry]}"; DRY="${2:-}"
V="/tmp/mr_pass_$S.vars.json"; B="/tmp/mr_pass_$S.md"
emit(){ SLICE="$S" ST="$1" DET="$2" /usr/bin/python3 -c "import json,os;print(json.dumps({'slice':os.environ['SLICE'],'status':os.environ['ST'],'detail':' '.join(os.environ['DET'].split())[:600]}))"; }
status(){ emit "$1" "$2"; exit "${3:-0}"; }
fail_evidence(){ printf 'kind=%s seen=%s log_tail=%s err_tail=%s' "${LAST_FAIL_KIND:-?}" "${LAST_SEEN_MODEL:-none}" "$(tail -n 5 "/tmp/mr_pass_$S.log" 2>/dev/null | tr '\n' ' ' | head -c 200)" "$(tail -n 5 "/tmp/mr_pass_$S.err" 2>/dev/null | tr '\n' ' ' | head -c 200)"; }
[ -r "$V" ] || status FAIL "vars.json missing: $V" 1
# lp-09: no launch while ANY hold is present, regardless of provenance. The tick gates itself at
# gate -1, but a spawn can also be reached from an event tick or a hand-run; this is the launch-level
# refusal, which is where the money is actually committed.
if [ -f "$MEM/.native-supervisor-disabled" ]; then
  status HOLD-PRESENT "$("$MEM/mr-hold" status 2>/dev/null || echo 'hold present') — refusing to launch"
fi
# lp-00 repo routing — cheapest gate first, before the probe and before any launch cost.
# mr-repo-of is the SSOT (mr-launch.sh reads the same verdict via the lock), so the rule cannot
# drift between spawner and launcher. MIXED/EXTERNAL are REJECTIONS on purpose: a slice whose
# declared paths span both repos must be re-declared or split by a human. Splitting it silently is
# how half a diff ends up stranded, ungated, in a main checkout.
TOUCHES_RAW=$(/usr/bin/python3 -c "
import json
t=json.load(open('$V')).get('touches','')
print(', '.join(t) if isinstance(t,list) else str(t))" 2>/dev/null)
REPO=$("$MEM/mr-repo-of" "$TOUCHES_RAW" 2>/dev/null || echo ROUTE-ERROR)
case "$REPO" in
  harness) PR_REPO="mdrewt/claude-harness"; BASE_BRANCH="main";   WT_ROOT="$HARNESS/.claude/worktrees" ;;
  project) PR_REPO="mdrewt/monster-realm";  BASE_BRANCH="master"; WT_ROOT="$PROJ/.claude/worktrees" ;;
  MIXED)    status REPO-MIXED "declared touches span BOTH repos; re-declare or split the slice — refusing to split it silently. touches=$(echo "$TOUCHES_RAW" | head -c 300)" ;;
  EXTERNAL) status REPO-EXTERNAL "declared touches include a path in neither repo (no worktree, no PR target); this slice needs an attended session. touches=$(echo "$TOUCHES_RAW" | head -c 300)" ;;
  *)        status REPO-UNRESOLVED "mr-repo-of returned '$REPO' for touches=$(echo "$TOUCHES_RAW" | head -c 200)" ;;
esac
export REPO PR_REPO BASE_BRANCH WT_ROOT
# lp-00 sync precondition. The brief tells the run to branch from `origin/<BASE_BRANCH>`, so if the
# local default branch is AHEAD of its remote the slice builds on a base missing that work and its
# PR silently reverts it. Measured at authoring time: monster-realm was 0/0, but the harness was
# **9 commits ahead** of origin/main — every one an unpushed `chore(mr-sup):` — so the first harness
# slice would have hit this. Cheap mechanical gate; turns an expensive silent failure into a free
# loud one. Applies to both repos: it is a no-op whenever the branch is in sync.
SYNCDIR=$([ "$REPO" = harness ] && echo "$HARNESS" || echo "$PROJ")
timeout 30 git -C "$SYNCDIR" fetch origin --quiet 2>/dev/null || true   # bounded: an unbounded fetch stalls every spawn on a slow link
if ! git -C "$SYNCDIR" rev-parse --verify --quiet "refs/remotes/origin/$BASE_BRANCH" >/dev/null; then
  status REPO-OUT-OF-SYNC "$SYNCDIR has no origin/$BASE_BRANCH ref; the brief branches from it, so the run would fail after launch. Fetch or create the remote branch first."
fi
# Fail CLOSED on a rev-list error: an unreadable count must not read as "in sync" — that is exactly
# the false-green shape this gate exists to prevent.
AHEAD=$(git -C "$SYNCDIR" rev-list --count "origin/$BASE_BRANCH".."$BASE_BRANCH" 2>/dev/null || echo ERR)
BEHIND=$(git -C "$SYNCDIR" rev-list --count "$BASE_BRANCH".."origin/$BASE_BRANCH" 2>/dev/null || echo ERR)
case "$AHEAD$BEHIND" in *ERR*) status REPO-OUT-OF-SYNC "$SYNCDIR: could not compute divergence vs origin/$BASE_BRANCH (ahead=$AHEAD behind=$BEHIND)";; esac
# Same failure as the divergence check, different cause: work that exists ONLY in the main
# checkout's working tree is invisible to a worktree branched from origin. Real case that exposed
# this hole in the gate: 2026-08-16, the SpacetimeDB 2.8.1 migration sat as 48 uncommitted files
# while origin/master was still 1.x, so a slice would have built against the pre-bump syntax.
# ADVISORY, not a refusal — a dirty project tree is routine (doctrine says stash strays, not commit
# them) and blocking on it would stop ordinary work. The supervisor decides.
DIRTY=$(git -C "$SYNCDIR" status --porcelain --untracked-files=no 2>/dev/null | wc -l)
[ "${DIRTY:-0}" -gt 0 ] && emit DIRTY-TREE-ADVISORY "$SYNCDIR has $DIRTY uncommitted tracked change(s); the slice branches from origin/$BASE_BRANCH and will NOT see them. Confirm that is intended before relying on this run."
if [ "${AHEAD:-0}" != 0 ] || [ "${BEHIND:-0}" != 0 ]; then
  status REPO-OUT-OF-SYNC "$SYNCDIR $BASE_BRANCH is ahead=$AHEAD behind=$BEHIND vs origin/$BASE_BRANCH; the brief branches from origin/$BASE_BRANCH, so the slice would build on the wrong base. Push (or ff-only sync) first, then re-spawn."
fi
# mechanical active-session probe (mirror of tick gate 3)
IDE=$(ps -eo cmd 2>/dev/null | grep -F -- '--replay-user-messages' | grep -F -- '--input-format' | grep -v grep | head -1)
# cost-cap respawn gate (review F13) + cap resolution
CAPO=$(/usr/bin/python3 -c "import json;d=json.load(open('/tmp/mr_pass_$S.vars.json'));print(d.get('cap_override') or '')" 2>/dev/null)
if [ -f "$MEM/.costpark-$S" ] && [ -z "$CAPO" ]; then
  status COSTPARK-GATE "slice was cost-cap parked ($(head -c 80 "$MEM/.costpark-$S")); relaunch requires cap_override in pass-vars"
fi
[ -n "$CAPO" ] && rm -f "$MEM/.costpark-$S"
CAP=$(/usr/bin/python3 -c "
import json
v=json.load(open('/tmp/mr_pass_$S.vars.json'))
c=json.load(open('$MEM/mr-budget-config.json'))
caps=c.get('slice_caps_usd',{})
print(v.get('cap_override') or v.get('cap_usd') or caps.get(v.get('tier',''),caps.get('default',60)))" 2>/dev/null || echo 60)
export CAP
# pre-launch cost-flag hygiene (review F-C/F-G: spawn owns cleanup; a watcher must never erase live state)
rm -f "/tmp/mr_warn_$S" "/tmp/mr_costwatch_$S.fired" "/tmp/mr_cap_topup_$S" "/tmp/mr_wrap_$S"
grep -q "cost-cap" "/tmp/mr_stop_$S.reason" 2>/dev/null && rm -f "/tmp/mr_stop_$S" "/tmp/mr_stop_$S.reason"
# lp-11a: this probe had TWO independent defects, both measured over 2026-08-17. It tripped on 10
# of 14 ticks, and every trip costs a WHOLE tick, because doctrine (correctly) forbids hand-launching
# around it. Neither defect was in the doctrine — both were here.
#
# (1) SCOPE. It scanned BOTH repos regardless of which one the slice targets. lp-00 added repo
#     routing 60 lines above and never wired it in down here, so lp-01 — a HARNESS slice — was
#     refused twice (10:43Z, 11:00Z) over a write to ARCHITECTURE.md in monster-realm, a repo it
#     does not touch. It now scans $SYNCDIR: the repo this slice will actually write to.
#
# (2) AUTHORSHIP. The question this probe exists to answer is "is a human working here?", but all
#     it could actually see was "was this file written recently" — and the tick's own
#     `git merge --ff-only` writes land squarely inside the 6-minute window. So the loop kept
#     tripping over its own merges (06:54Z, and the same class back to 2026-08-09). A human edit
#     leaves a file DIRTY or untracked; a merge leaves it clean and byte-identical to HEAD. Asking
#     git separates the two exactly, with none of the time-based guesswork that caused the misread.
#
# FAILS CLOSED: if git cannot answer (not a repo, git absent), the candidate counts as a human
# write and the probe trips — the pre-lp-11a behaviour. Candidates are capped because this runs on
# every spawn.
#
# ORDER MATTERS, and the obvious order is wrong. Enumerating recent files first and then asking git
# about each needs a cap to stay cheap — and a cap applied to the RECENT set is unsound, because a
# merge that rewrites 50 clean files can crowd the one dirty file a human just edited out of the
# window, silently. So the sets are taken the other way round: ask git for the dirty/untracked set
# (a human's working set — small, and a merge adds nothing to it), then keep only those touched
# inside the window. No cap is needed, and nothing can be crowded out.
#
# `-z` because porcelain paths are quoted/escaped when they contain spaces or unicode, and a rename
# entry carries two NUL-separated paths; splitting on NUL sidesteps all of that. `-uall` lists
# untracked FILES rather than collapsing them into a `dir/` entry that no mtime check could read.
# Python runs git ITSELF rather than reading a shell variable. That is not a style preference: NUL
# is the one byte a bash variable cannot carry, so `GST=$(git status -z)` silently DROPS every
# separator and the whole listing arrives as a single run-on entry. With exactly one dirty file that
# still happens to work, which is precisely how it survived the first round of testing here — with
# several it yields one garbage path, finds nothing, and the probe under-trips: a launch straight
# into a repo somebody is editing. Owning the subprocess also lets the fail-closed branch key off
# git's real return code instead of a pipeline's last stage.
WRITES=$(/usr/bin/python3 -c "
import os, subprocess, sys, time
root, mem = sys.argv[1], sys.argv[2]
try:
    r = subprocess.run(['git', '-C', root, 'status', '--porcelain', '-z', '-uall'],
                       capture_output=True, timeout=30)
except Exception as e:
    print('%s (git status could not run: %s — failing closed)' % (root, type(e).__name__)); raise SystemExit(0)
if r.returncode != 0:
    print('%s (git status rc=%d — cannot attribute recent writes, failing closed)' % (root, r.returncode))
    raise SystemExit(0)
SKIP = ('/.git/', '/node_modules/', '/target/', '/.claude/worktrees/', '/.codegraph/')
cutoff = time.time() - 360
for ent in r.stdout.split(b'\0'):
    if not ent:
        continue
    # 'XY path'; a rename's second NUL-separated field is a bare path with no status prefix.
    raw = ent[3:] if len(ent) > 3 and ent[2:3] == b' ' else ent
    p = os.path.join(root, raw.decode('utf-8', 'replace'))
    if p.startswith(mem.rstrip('/') + '/') or any(s in p for s in SKIP):
        continue
    try:
        if os.path.getmtime(p) >= cutoff:
            print(p); break
    except OSError:
        continue" "$SYNCDIR" "$MEM" 2>/dev/null) \
  || WRITES="$SYNCDIR (probe helper failed — failing closed)"
[ -n "$IDE" ] && status PROBE-TRIPPED "resident IDE claude session"
[ -n "$WRITES" ] && status PROBE-TRIPPED "recent human writes: $WRITES"
# build brief
export S V B MEM
/usr/bin/python3 - <<'PY' || exit 1
import json, os
S=os.environ["S"]; v=json.load(open(os.environ["V"]))
tpl=open(os.environ["MEM"]+"/mr-brief-template.md").read()
_t=v.get("touches","")
touches_str=", ".join(_t) if isinstance(_t,list) else str(_t)
tier=v.get("tier") or (_ for _ in ()).throw(SystemExit("vars.json missing required field: tier (hard|routine|content)"))
tier_block=("QUALITY TIER: HARD — invoke the tester subagent with model opus; depth over speed; this session runs at xhigh effort.\n" if tier=="hard"
 else "QUALITY TIER: CONTENT — data-drop slice: right-size the lens battery (reviewer + verifier mandatory; add red-team/domain auditors ONLY if the slice touches validation/parsing/security surfaces). Depth comes from the content gates (parity/determinism/schema-snapshot), not redundant lenses. Lenses run on their DECLARED agent models (sonnet-class) — do not bump lens models upward on a content slice (THIS OVERRIDES the build-loop prompt bump-one-tier default for this slice). The tester requirement is UNCHANGED — meaningful tests first, always.\n" if tier=="content" else "")
rb=v.get("resume_block","") or ""
repo=os.environ["REPO"]
# The gate differs by repo and saying so is load-bearing. monster-realm `just ci` is the real gate.
# Harness `just ci` runs only scripts/tests/{harness,invariants,adr-lint}.test.mjs and lints only
# scripts/ — so for a slice touching solely memory/projects/** it CANNOT fail. Gating a harness
# slice on it would be a green light that means nothing, which is the defect class lp-00 removes.
repo_block=("REPO: **harness** (`mdrewt/claude-harness`). Worktree from `origin/main`; PR on the harness repo.\n"
 "GATE — read this, it is not the project gate: harness `just ci` runs only `scripts/tests/*` and lints only `scripts/`, so for a slice touching solely `memory/projects/**` it **cannot fail** and proves nothing. Your gate is **`memory/projects/mr-selfcheck` printing SELFCHECK-OK** plus **the `--selftest` of every tool you touched or added**. mr-selfcheck DERIVES its tool set (lp-00), so a new executable `mr-*` is picked up automatically — but it must carry a bash or python shebang or the gate fails it as unclassifiable, and anything with real logic should ship a `--selftest` wired in beside mr-cost-sum's. Run harness `just ci` too (cheap, catches script-lint regressions), but never report it as the gate.\n"
 "There is no remote CI on this repo and no branch protection, so 'PR open + local gate green' IS the terminal state; the supervisor merges.\n"
 if repo=="harness" else
 "REPO: **project** (`mdrewt/monster-realm`). Worktree from `origin/master`; PR on the project repo.\n"
 "GATE: the full `just ci` (the exact gate remote runs — incl. Semgrep/security) green locally before opening the PR.\n")
for k,val in [("<SLICE>",v["slice"]),("<ADR_NUM>",str(v.get("adr",""))),("<TOUCHES>",touches_str),
              ("<TARGET_DESC>",str(v.get("target_desc",""))),("<RESUME_BLOCK>",str(rb)),("<TIER_BLOCK>",tier_block),
              ("<REPO_BLOCK>",repo_block),("<PR_REPO>",os.environ["PR_REPO"]),
              ("<BASE_BRANCH>",os.environ["BASE_BRANCH"]),("<WT_ROOT>",os.environ["WT_ROOT"]),
              ("<CAP_USD>",str(__import__("os").environ.get("CAP","60")))]:
    tpl=tpl.replace(k,val)
open(os.environ["B"],"w").write(tpl)
print("brief-built bytes=%d tier=%s repo=%s" % (len(tpl),tier,repo))
PY
MODEL=$(/usr/bin/python3 -c "import json;print(json.load(open('$V')).get('model','opus'))")
EFFORT=$(/usr/bin/python3 -c "import json;print(json.load(open('$V')).get('effort','high'))")
rm -f "/tmp/mr_stop_$S" /tmp/mr_stop_all
if [ "$DRY" = "--dry" ]; then status DRY "brief built; model=$MODEL effort=$EFFORT; no launch"; fi
RID="mr-spawn-$(date -u +%Y%m%dT%H%M%SZ)-$$"
attempt_launch(){
  setsid bash "$MEM/mr-launch.sh" "$S" "$MODEL" "$EFFORT" "$REPO" >/dev/null 2>&1 & LEADER=$!
  LAST_SEEN_MODEL=""
  disown 2>/dev/null || true
  sleep 4
  # detachment assert: leader must be its own session
  SESS=$(ps -o sess= -p "$LEADER" 2>/dev/null | tr -d ' ')
  if [ -z "$SESS" ] || [ "$SESS" != "$LEADER" ]; then LAST_FAIL_KIND="detach"; return 1; fi
  # model-class assert: poll log <=90s for first model id; must match requested class
  local want="$MODEL" seen=""
  for i in $(seq 1 30); do
    seen=$(grep -m1 -o '"model":"claude-[a-z0-9.-]*"' "/tmp/mr_pass_$S.log" 2>/dev/null | head -1)
    [ -n "$seen" ] && break; sleep 3
  done
  LAST_SEEN_MODEL="$seen"
  case "$want" in
    opus|claude-opus*)   echo "$seen" | grep -q "claude-opus"  || { LAST_FAIL_KIND="model-mismatch"; return 2; };;
    fable|claude-fable*) echo "$seen" | grep -q "claude-fable" || { LAST_FAIL_KIND="model-mismatch"; return 2; };;
    sonnet|claude-sonnet*) echo "$seen" | grep -q "claude-sonnet" || { LAST_FAIL_KIND="model-mismatch"; return 2; };;
    *) LAST_FAIL_KIND="model-unassertable"; echo "$seen" | grep -q "claude-" || { LAST_FAIL_KIND="model-mismatch"; return 2; };;
  esac
  return 0
}
kill_attempt(){
  [ -n "${LEADER:-}" ] || return 0
  CPID=$(pgrep -P "$LEADER" 2>/dev/null | head -1)
  kill -TERM "$LEADER" ${CPID:+$CPID} 2>/dev/null; sleep 3
  kill -KILL "$LEADER" ${CPID:+$CPID} 2>/dev/null || true
}
if ! attempt_launch; then
  kill_attempt
  emit RETRY "first launch failed assert; retrying once — $(fail_evidence)"
  if ! attempt_launch; then kill_attempt; status FAIL "launch asserts failed twice — $(fail_evidence)" 1; fi
fi
CPID=$(pgrep -P "$LEADER" 2>/dev/null | head -1)
export S V MEM RID LEADER CPID MODEL EFFORT B REPO PR_REPO BASE_BRANCH
if ! /usr/bin/python3 - <<'PYLOCK'
import json, os, datetime
v=json.load(open(os.environ["V"]))
t=v.get("touches","")
touches=t if isinstance(t,list) else [x.strip() for x in str(t).split(",") if x.strip()]
lock={"run_id":os.environ["RID"],"slice":os.environ["S"],
 "session_leader":int(os.environ["LEADER"]),"claude_pid":int(os.environ.get("CPID") or 0),
 "started_utc":datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
 "brief":os.environ["B"],"done_flag":"/tmp/mr_pass_%s.done"%os.environ["S"],
 "adr_reserved":str(v.get("adr","")),"touches":touches,
 "model":os.environ["MODEL"],"effort":os.environ["EFFORT"],"tier":v.get("tier","routine"),
 "repo":os.environ["REPO"],"pr_repo":os.environ["PR_REPO"],"base_branch":os.environ["BASE_BRANCH"]}
open(os.environ["MEM"]+"/.harness-runner."+os.environ["S"]+".lock","w").write(json.dumps(lock,indent=1))
PYLOCK
then kill_attempt; status FAIL "lock write failed after launch (attempt killed)" 1; fi
TIER=$(/usr/bin/python3 -c "import json;print(json.load(open('$V')).get('tier','routine'))" 2>/dev/null)
setsid bash "$MEM/mr-cost-watch" watch "$S" "$CAP" "$LEADER" >/dev/null 2>&1 & disown   # zero-token cap watcher (monitor until costwatch_enforce=true)
# auto-flip covered feedback items to IN-WORK (doctrine §8; mechanical so no run has to remember)
ITEMS=$(/usr/bin/python3 -c "import json,sys;d=json.load(open('/tmp/mr_pass_$S.vars.json'));i=d.get('items') or [];print(' '.join(i) if isinstance(i,list) else str(i))" 2>/dev/null)
for IT in $ITEMS; do
  FR=$("$MEM/mr-feedback" set "$IT" --state IN-WORK 2>&1)
  case "$FR" in FEEDBACK-SET*) :;; *) emit ITEMS-FLIP-FAIL "$IT: $FR";; esac   # emit only — status() exits
done
status LAUNCHED "leader=$LEADER claude_pid=${CPID:-?} model=$MODEL effort=$EFFORT tier=${TIER:-?} repo=$REPO pr_repo=$PR_REPO brief_bytes=$(stat -c %s "$B" 2>/dev/null || echo ?) rid=$RID"
