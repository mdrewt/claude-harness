def _check(raw, expected):
    """The single comparator every fixture-driven test below goes through. Calls the REAL
    skills_for(tokens_of(raw)) -- never a second hand-rolled copy of the mapping."""
    return skills_for(tokens_of(raw)) == list(expected)


def t1_fixture_register():
    bad = 0
    for raw, want, why in FIXTURES:
        if not _check(raw, want):
            got = skills_for(tokens_of(raw))
            print("SKILLS-SELFTEST-FAIL t1-fixture want=%s got=%s (%s)\n    touches: %s"
                  % (want, got, why, raw))
            bad = 1
    return bad


def t2_proof_of_teeth():
    """EARS proof-of-teeth: a server-module/** fixture OMITTING spacetimedb-reducer must be
    REJECTED by the comparator, plus the anti-degeneracy control (precedent: mr-repo-of's own
    `len(verdicts) < 4` control) so a stuck always-all-six or always-empty impl cannot pass."""
    bad = 0
    if _check("server-module/src/battle.rs", ["spacetimedb-reducer", "code-intel"]) is not True:
        print("SKILLS-SELFTEST-FAIL t2-positive: server-module/src/battle.rs must match "
              "[spacetimedb-reducer, code-intel]")
        bad = 1
    if _check("server-module/src/battle.rs", ["code-intel"]) is not False:
        print("SKILLS-SELFTEST-FAIL t2-negative-control: a server-module/** fixture OMITTING "
              "spacetimedb-reducer wrongly compared equal -- the comparator has degenerated")
        bad = 1
    distinct = set(tuple(skills_for(tokens_of(raw))) for raw, _want, _why in FIXTURES)
    if len(distinct) < 4:
        print("SKILLS-SELFTEST-FAIL t2-degenerate: only %d distinct skill-set(s) across the "
              "register (%s) -- a stuck always-all-six or always-empty implementation would pass "
              "every same-verdict fixture" % (len(distinct), sorted(distinct)))
        bad = 1
    empties = [s for s in distinct if s == ()]
    if len(empties) != 1:
        print("SKILLS-SELFTEST-FAIL t2-degenerate-empty: expected exactly ONE distinct empty "
              "skill-set across the register, found %d" % len(empties))
        bad = 1
    return bad


def t3_rf4_shape():
    """RF-4: the brief is multiplied by ~500 turns, so the block must be exactly 1 header line
    plus 1 line per skill, every line <=100 chars, and the empty case must be "" BY IDENTITY."""
    bad = 0
    if render_block([]) is not "":
        print("SKILLS-SELFTEST-FAIL t3-empty-identity: render_block([]) must be the identity "
              "empty string")
        bad = 1
    for raw, _want, why in FIXTURES:
        skills = skills_for(tokens_of(raw))
        block = render_block(skills)
        if not skills:
            if block is not "":
                print("SKILLS-SELFTEST-FAIL t3-empty-row: %r -> empty skill list must render "
                      "'' exactly (%s)" % (raw, why))
                bad = 1
            continue
        if not block.startswith("\n\n"):
            print("SKILLS-SELFTEST-FAIL t3-leading-blank-lines: block for %r does not start "
                  "with exactly '\\n\\n'" % raw)
            bad = 1
        lines = block.strip("\n").splitlines()
        if len(lines) != len(skills) + 1:
            print("SKILLS-SELFTEST-FAIL t3-line-count: %r expected %d lines (1 header + %d "
                  "skills), got %d" % (raw, len(skills) + 1, len(skills), len(lines)))
            bad = 1
        for ln in lines:
            if len(ln) > 100:
                print("SKILLS-SELFTEST-FAIL t3-line-length: line exceeds 100 chars (%d) for "
                      "%r: %r" % (len(ln), raw, ln))
                bad = 1
    return bad


def t4_template_placement(selfdir):
    """Reads the template SELF-LOCATED (never the hardcoded MEM) so a pre-merge worktree run
    tests ITS OWN copy, not main's placeholder-free one."""
    bad = 0
    path = os.path.join(selfdir, "mr-brief-template.md")
    try:
        with open(path) as f:
            text = f.read()
    except OSError as exc:
        print("SKILLS-SELFTEST-FAIL t4-template-missing: %s (%s)" % (path, exc))
        return 1
    count = text.count("<SKILLS_BLOCK>")
    if count != 1:
        print("SKILLS-SELFTEST-FAIL t4-placeholder-count: expected exactly 1 <SKILLS_BLOCK>, "
              "found %d" % count)
        bad = 1
    anchors = [ln for ln in text.splitlines() if "Test-first, gated" in ln]
    if len(anchors) != 1:
        print("SKILLS-SELFTEST-FAIL t4-anchor-line: expected exactly 1 line containing "
              "'Test-first, gated', found %d" % len(anchors))
        bad = 1
    elif not anchors[0].endswith("<SKILLS_BLOCK>"):
        print("SKILLS-SELFTEST-FAIL t4-placeholder-position: <SKILLS_BLOCK> must be at the END "
              "of the 'Test-first, gated' line; line=%r" % anchors[0])
        bad = 1
    return bad


