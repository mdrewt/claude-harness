#!/bin/bash
# mr-spawn <slice> [--dry] — build brief + lock + detached launch + asserts, from /tmp/mr_pass_<slice>.vars.json
# vars.json: {slice, model, effort, adr, touches, target_desc, resume_block, tier}
# Kills a failed first attempt BY RECORDED PID before its single retry. Prints one status JSON line.
set -u
exec 9>&- 2>/dev/null || true   # drop inherited tick-flock fd (prevents lock wedge)
unset MR_TICK_DRYRUN 2>/dev/null || true
MEM=/home/mdrewt/projects/ai-apps/claude-harness/memory/projects
HARNESS=/home/mdrewt/projects/ai-apps/claude-harness
PROJ=$HARNESS/projects/monster-realm
S="${1:?usage: mr-spawn <slice> [--dry]}"; DRY="${2:-}"
V="/tmp/mr_pass_$S.vars.json"; B="/tmp/mr_pass_$S.md"
emit(){ SLICE="$S" ST="$1" DET="$2" /usr/bin/python3 -c "import json,os;print(json.dumps({'slice':os.environ['SLICE'],'status':os.environ['ST'],'detail':' '.join(os.environ['DET'].split())[:600]}))"; }
status(){ emit "$1" "$2"; exit "${3:-0}"; }
fail_evidence(){ printf 'kind=%s seen=%s log_tail=%s err_tail=%s' "${LAST_FAIL_KIND:-?}" "${LAST_SEEN_MODEL:-none}" "$(tail -n 5 "/tmp/mr_pass_$S.log" 2>/dev/null | tr '\n' ' ' | head -c 200)" "$(tail -n 5 "/tmp/mr_pass_$S.err" 2>/dev/null | tr '\n' ' ' | head -c 200)"; }
[ -r "$V" ] || status FAIL "vars.json missing: $V" 1
# mechanical active-session probe (mirror of tick gate 3)
IDE=$(ps -eo cmd 2>/dev/null | grep -F -- '--replay-user-messages' | grep -F -- '--input-format' | grep -v grep | head -1)
# cost-cap respawn gate (review F13) + cap resolution
CAPO=$(/usr/bin/python3 -c "import json;d=json.load(open('/tmp/mr_pass_$S.vars.json'));print(d.get('cap_override') or '')" 2>/dev/null)
if [ -f "$MEM/.costpark-$S" ] && [ -z "$CAPO" ]; then
  status COSTPARK-GATE "slice was cost-cap parked ($(head -c 80 "$MEM/.costpark-$S")); relaunch requires cap_override in pass-vars"
fi
[ -n "$CAPO" ] && rm -f "$MEM/.costpark-$S"
CAP=$(/usr/bin/python3 -c "
import json
v=json.load(open('/tmp/mr_pass_$S.vars.json'))
c=json.load(open('$MEM/mr-budget-config.json'))
caps=c.get('slice_caps_usd',{})
print(v.get('cap_override') or v.get('cap_usd') or caps.get(v.get('tier',''),caps.get('default',60)))" 2>/dev/null || echo 60)
export CAP
# pre-launch cost-flag hygiene (review F-C/F-G: spawn owns cleanup; a watcher must never erase live state)
rm -f "/tmp/mr_warn_$S" "/tmp/mr_costwatch_$S.fired" "/tmp/mr_cap_topup_$S" "/tmp/mr_wrap_$S"
grep -q "cost-cap" "/tmp/mr_stop_$S.reason" 2>/dev/null && rm -f "/tmp/mr_stop_$S" "/tmp/mr_stop_$S.reason"
WRITES=$(find "$HARNESS" "$PROJ" -type f -not -path '*/.git/*' -not -path '*/node_modules/*' -not -path '*/target/*' -not -path '*/.claude/worktrees/*' -not -path "$MEM/*" -mmin -6 2>/dev/null | head -1)
[ -n "$IDE" ] && status PROBE-TRIPPED "resident IDE claude session"
[ -n "$WRITES" ] && status PROBE-TRIPPED "recent human writes: $WRITES"
# build brief
export S V B MEM
/usr/bin/python3 - <<'PY' || exit 1
import json, os
S=os.environ["S"]; v=json.load(open(os.environ["V"]))
tpl=open(os.environ["MEM"]+"/mr-brief-template.md").read()
_t=v.get("touches","")
touches_str=", ".join(_t) if isinstance(_t,list) else str(_t)
tier=v.get("tier") or (_ for _ in ()).throw(SystemExit("vars.json missing required field: tier (hard|routine|content)"))
tier_block=("QUALITY TIER: HARD — invoke the tester subagent with model opus; depth over speed; this session runs at xhigh effort.\n" if tier=="hard"
 else "QUALITY TIER: CONTENT — data-drop slice: right-size the lens battery (reviewer + verifier mandatory; add red-team/domain auditors ONLY if the slice touches validation/parsing/security surfaces). Depth comes from the content gates (parity/determinism/schema-snapshot), not redundant lenses. Lenses run on their DECLARED agent models (sonnet-class) — do not bump lens models upward on a content slice (THIS OVERRIDES the build-loop prompt bump-one-tier default for this slice). The tester requirement is UNCHANGED — meaningful tests first, always.\n" if tier=="content" else "")
rb=v.get("resume_block","") or ""
for k,val in [("<SLICE>",v["slice"]),("<ADR_NUM>",str(v.get("adr",""))),("<TOUCHES>",touches_str),
              ("<TARGET_DESC>",str(v.get("target_desc",""))),("<RESUME_BLOCK>",str(rb)),("<TIER_BLOCK>",tier_block),("<CAP_USD>",str(__import__("os").environ.get("CAP","60")))]:
    tpl=tpl.replace(k,val)
open(os.environ["B"],"w").write(tpl)
print("brief-built bytes=%d tier=%s" % (len(tpl),tier))
PY
MODEL=$(/usr/bin/python3 -c "import json;print(json.load(open('$V')).get('model','opus'))")
EFFORT=$(/usr/bin/python3 -c "import json;print(json.load(open('$V')).get('effort','high'))")
rm -f "/tmp/mr_stop_$S" /tmp/mr_stop_all
if [ "$DRY" = "--dry" ]; then status DRY "brief built; model=$MODEL effort=$EFFORT; no launch"; fi
RID="mr-spawn-$(date -u +%Y%m%dT%H%M%SZ)-$$"
attempt_launch(){
  setsid bash "$MEM/mr-launch.sh" "$S" "$MODEL" "$EFFORT" >/dev/null 2>&1 & LEADER=$!
  LAST_SEEN_MODEL=""
  disown 2>/dev/null || true
  sleep 4
  # detachment assert: leader must be its own session
  SESS=$(ps -o sess= -p "$LEADER" 2>/dev/null | tr -d ' ')
  if [ -z "$SESS" ] || [ "$SESS" != "$LEADER" ]; then LAST_FAIL_KIND="detach"; return 1; fi
  # model-class assert: poll log <=90s for first model id; must match requested class
  local want="$MODEL" seen=""
  for i in $(seq 1 30); do
    seen=$(grep -m1 -o '"model":"claude-[a-z0-9.-]*"' "/tmp/mr_pass_$S.log" 2>/dev/null | head -1)
    [ -n "$seen" ] && break; sleep 3
  done
  LAST_SEEN_MODEL="$seen"
  case "$want" in
    opus|claude-opus*)   echo "$seen" | grep -q "claude-opus"  || { LAST_FAIL_KIND="model-mismatch"; return 2; };;
    fable|claude-fable*) echo "$seen" | grep -q "claude-fable" || { LAST_FAIL_KIND="model-mismatch"; return 2; };;
    sonnet|claude-sonnet*) echo "$seen" | grep -q "claude-sonnet" || { LAST_FAIL_KIND="model-mismatch"; return 2; };;
    *) LAST_FAIL_KIND="model-unassertable"; echo "$seen" | grep -q "claude-" || { LAST_FAIL_KIND="model-mismatch"; return 2; };;
  esac
  return 0
}
kill_attempt(){
  [ -n "${LEADER:-}" ] || return 0
  CPID=$(pgrep -P "$LEADER" 2>/dev/null | head -1)
  kill -TERM "$LEADER" ${CPID:+$CPID} 2>/dev/null; sleep 3
  kill -KILL "$LEADER" ${CPID:+$CPID} 2>/dev/null || true
}
if ! attempt_launch; then
  kill_attempt
  emit RETRY "first launch failed assert; retrying once — $(fail_evidence)"
  if ! attempt_launch; then kill_attempt; status FAIL "launch asserts failed twice — $(fail_evidence)" 1; fi
fi
CPID=$(pgrep -P "$LEADER" 2>/dev/null | head -1)
export S V MEM RID LEADER CPID MODEL EFFORT B
if ! /usr/bin/python3 - <<'PYLOCK'
import json, os, datetime
v=json.load(open(os.environ["V"]))
t=v.get("touches","")
touches=t if isinstance(t,list) else [x.strip() for x in str(t).split(",") if x.strip()]
lock={"run_id":os.environ["RID"],"slice":os.environ["S"],
 "session_leader":int(os.environ["LEADER"]),"claude_pid":int(os.environ.get("CPID") or 0),
 "started_utc":datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
 "brief":os.environ["B"],"done_flag":"/tmp/mr_pass_%s.done"%os.environ["S"],
 "adr_reserved":str(v.get("adr","")),"touches":touches,
 "model":os.environ["MODEL"],"effort":os.environ["EFFORT"],"tier":v.get("tier","routine")}
open(os.environ["MEM"]+"/.harness-runner."+os.environ["S"]+".lock","w").write(json.dumps(lock,indent=1))
PYLOCK
then kill_attempt; status FAIL "lock write failed after launch (attempt killed)" 1; fi
TIER=$(/usr/bin/python3 -c "import json;print(json.load(open('$V')).get('tier','routine'))" 2>/dev/null)
setsid bash "$MEM/mr-cost-watch" watch "$S" "$CAP" "$LEADER" >/dev/null 2>&1 & disown   # zero-token cap watcher (monitor until costwatch_enforce=true)
# auto-flip covered feedback items to IN-WORK (doctrine §8; mechanical so no run has to remember)
ITEMS=$(/usr/bin/python3 -c "import json,sys;d=json.load(open('/tmp/mr_pass_$S.vars.json'));i=d.get('items') or [];print(' '.join(i) if isinstance(i,list) else str(i))" 2>/dev/null)
for IT in $ITEMS; do
  FR=$("$MEM/mr-feedback" set "$IT" --state IN-WORK 2>&1)
  case "$FR" in FEEDBACK-SET*) :;; *) emit ITEMS-FLIP-FAIL "$IT: $FR";; esac   # emit only — status() exits
done
status LAUNCHED "leader=$LEADER claude_pid=${CPID:-?} model=$MODEL effort=$EFFORT tier=${TIER:-?} brief_bytes=$(stat -c %s "$B" 2>/dev/null || echo ?) rid=$RID"
