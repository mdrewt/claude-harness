#!/bin/bash
# mr-spawn <slice> [--dry] — build brief + lock + detached launch + asserts, from /tmp/mr_pass_<slice>.vars.json
# vars.json: {slice, model, effort, adr, touches, target_desc, resume_block, tier}
# Kills a failed first attempt BY RECORDED PID before its single retry. Prints one status JSON line.
set -u
exec 9>&- 2>/dev/null || true   # drop inherited tick-flock fd (prevents lock wedge)
unset MR_FORCE MR_TICK_DRYRUN 2>/dev/null || true   # lp-09: forced-ness must not propagate to what we launch
MEM=/home/mdrewt/projects/ai-apps/claude-harness/memory/projects
HARNESS=/home/mdrewt/projects/ai-apps/claude-harness
PROJ=$HARNESS/projects/monster-realm
# lp-skills: required-skill mapping computed from a slice's declared `touches:`, emitted into the
# rendered brief's role chain. ONE heredoc holds the mapping impl (specialist, below the END
# marker) and the fenced gating-test battery above it (tester-owned — do not edit to fit the
# implementation). `build_brief` (specialist, defined further below) wraps the moved-verbatim
# render heredoc and calls mr_skills() internally; live spawn and --selftest share one function.
mr_skills() {
  timeout 30 /usr/bin/python3 - "$@" <<'PYSKILLS'
"""mr_skills() heredoc body -- required-skill mapping for mr-spawn's rendered brief (lp-skills).

    mr_skills --selftest <selfdir>   -> runs the gating-test battery below; rc=0 pass, rc=1 fail
    mr_skills <raw touches>          -> prints the rendered <SKILLS_BLOCK> substitution value

TESTER-AUTHORED, TDD RED PHASE. SKILL_MAP/tokens_of/skills_for/render_block are referenced below
but left UNDEFINED -- the specialist adds them between the END marker and `def main`, without
touching the fence. A wrong expectation is corrected FROM THE SPEC, never to fit the impl.
"""
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import uuid

HARNESS = "/home/mdrewt/projects/ai-apps/claude-harness"
PROJ = HARNESS + "/projects/monster-realm"

# ===== GATING TESTS (lp-skills, tester-authored) — DO NOT EDIT TO FIT THE IMPLEMENTATION =====


def _run(args, timeout=30, env=None):
    """Single subprocess.run() wrapper shared by every real-process test below (t6, t8) -- may
    still raise subprocess.TimeoutExpired; callers catch it."""
    return subprocess.run(args, capture_output=True, text=True, timeout=timeout, env=env)


