# =================================================================================================
# Shared PYRL-block locator — BY CONTENT MARKER, modeled on mr-selfcheck's A4/A8 pattern: locate
# `<<'PYRL'` by content, find the line that is exactly `PYRL`. Returns (open_start, block_end, body)
# byte offsets into `src`, or (None, None, None) if either marker is missing — callers FAIL LOUDLY
# on that rather than silently skip (a silently-skipped extraction is a false green). Shared by T3
# (which EXECUTES the body) and T13 (which asserts nothing else in the file writes the arming output
# from OUTSIDE this exact byte range) so the two can never disagree about where the block is.
# =================================================================================================
def _locate_pyrl_block(tick_src):
    # The character class in place of a bare `'` keeps THIS line from matching mr-selfcheck's own
    # heredoc-opener scanner (`^…python3…<<-?'TAG'…$`), which would otherwise read this file as
    # opening an unterminated PYRL heredoc and RED py-heredoc-coverage. `[']PYRL[']` matches the
    # exact same literal text in mr-native-tick.sh (`<<'PYRL'`) — semantics unchanged.
    open_m = re.search(r"^[^\n]*python3[^\n]*<<[']PYRL['][^\n]*$", tick_src, re.M)
    if open_m is None:
        return None, None, None
    tail_start = open_m.end() + 1
    close_m = re.search(r"^PYRL\s*$", tick_src[tail_start:], re.M)
    if close_m is None:
        return None, None, None
    body = tick_src[tail_start:tail_start + close_m.start()]
    block_end = tail_start + close_m.end()
    return open_m.start(), block_end, body


# =================================================================================================
# T3 — behavioural arming pin (EARS-3, defect c).
