        _fail_missing("T4-vacuity-rows-zero", run, "F7+F8-only corpus")
    else:
        rows = _read_rows(run["out"]) if os.path.exists(run["out"]) else []
        check(len(rows) == 0, "T4-vacuity-rows-zero",
              "F7+F8-only corpus must yield 0 rows, got %d" % len(rows))
        check(not os.path.exists(run["out"]) or os.path.getsize(run["out"]) == 0,
