    main_out = os.path.join(tmp, "out_main.jsonl")

    # T8 proof-of-teeth: snapshot the lock-dir glob strictly around THIS invocation. Never a wider
    # glob for cleanup — only ever removes the one deterministic name this file's own calls can
    # create, so a real concurrent slice's costwatch lock is never touched.
    before_locks = set(glob.glob("/tmp/mr_costwatch_*.lock.d"))
    rc1, out1, err1, to1 = invoke([main_log, "live-standdown", "3", main_out])
    after_locks = set(glob.glob("/tmp/mr_costwatch_*.lock.d"))
    new_locks = after_locks - before_locks
    check(not new_locks, "T8-no-lock-dir",
          "mr-cost-watch telemetry created %s — the missing dispatch branch fell through into the "
          "watcher (proven hazard the spec calls out explicitly)" % sorted(new_locks))
    _record_rc("RUN_MAIN", rc1)
    # Captured BEFORE the rerun below — this is the only way T6 can actually catch a rerun that
    # doubles the row count. Reading the file only once, after both invocations, would make the
    # "before" and "after" comparison the same read and pass vacuously against a buggy re-appender.
    rowcount_after_first = len(_read_rows(main_out)) if not to1 else -1
    results["main"] = dict(log=main_log, out=main_out, rc=rc1, stdout=out1, timed_out=to1,
                            gate="live-standdown", nslices=3, source="slice:corpus",
