def _read_raw_lines(path):
    try:
        with open(path, errors="replace") as f:
            return f.read().splitlines()
    except OSError:
        return []


def _read_rows(path):
    """Parse OUTFILE as one-JSON-object-per-line. Silently skips unparseable lines (there should be
    none in a healthy file); callers assert row COUNT separately so a silently-shrunk file still bites."""
    rows = []
    for ln in _read_raw_lines(path):
        if not ln.strip():
            continue
        try:
            rows.append(json.loads(ln))
        except Exception:
            continue
    return rows


def _by_uuid(rows, uuid):
    for r in rows:
        if isinstance(r, dict) and r.get("uuid") == uuid:
            return r
    return None


