# =================================================================================================
# Subprocess guard — centralizes EVERY subprocess call in this file so "never invokes
# mr-native-tick.sh, spawns claude, or writes the kill-switch flag path" is a runtime property,
# not a convention. Any call whose argv[0] basename is mr-native-tick.sh, or whose argv contains
# "claude", or whose argv mentions the kill-switch flag basename, raises loudly instead of running.
# =================================================================================================
_FORBIDDEN_ARGV0 = {"mr-native-tick.sh"}


def _safe_run(argv, timeout=None):
    b0 = os.path.basename(str(argv[0]))
    if b0 in _FORBIDDEN_ARGV0:
        raise RuntimeError("REFUSED: this selftest must never execute %s" % b0)
    for a in argv:
        sa = str(a)
        if "claude" == os.path.basename(sa) or sa.strip() == "claude":
            raise RuntimeError("REFUSED: this selftest must never spawn claude (argv=%r)" % (argv,))
        if ".native-supervisor-disabled" in sa:
            raise RuntimeError("REFUSED: this selftest must never touch the kill-switch flag path")
    try:
        r = subprocess.run(argv, capture_output=True, text=True, timeout=timeout)
        return r.returncode, r.stdout or "", r.stderr or "", False
    except subprocess.TimeoutExpired as e:
        out = e.stdout if isinstance(e.stdout, str) else (e.stdout or b"").decode(errors="replace")
        err = e.stderr if isinstance(e.stderr, str) else (e.stderr or b"").decode(errors="replace")
        return None, out, err, True


def invoke(args, timeout=INVOKE_TIMEOUT):
    """Run the real `mr-cost-watch telemetry ...` under test. Returns (rc, stdout, stderr, timed_out)."""
    return _safe_run([COST_WATCH, "telemetry"] + list(args), timeout=timeout)


def _record_rc(label, rc):
    _ALL_RCS.append((label, rc))


