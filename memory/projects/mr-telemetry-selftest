# =================================================================================================
# T13 — single-assignment-site scan (EARS-3, the STRONGEST tooth here). A red-team PROVED that T3
# (executes the real PYRL body) and T9 (pins the two telemetry call sites) can BOTH stay green while
# a SECOND, unreviewed arming path writes `rate_limit_resets_at`/`rate_limit_armed_by` from OUTSIDE
# the PYRL block — e.g. `python3 -c "..."` appended after a real call site. Neither T3 nor T9 is
# positioned to see that: T3 only ever executes the block it already found; T9 only looks at
# `mr-cost-watch telemetry` call shape, not at who else writes to mr-state.json.
#
# This scans the WHOLE FILE, in two layers:
#   1. COMMENT LINES ARE SKIPPED OUTRIGHT (first non-whitespace char is `#`) — they cannot be code.
#      Same reasoning already load-bearing in mr-selfcheck's own heredoc scanner (`_openers` there
#      excludes `#`-prefixed lines for the identical reason: THIS FILE documents a heredoc opener
#      inside a comment, at T3's own `_locate_pyrl_block`, and counting prose as an opener produced
#      a pure false positive there). Prose that merely MENTIONS a field name in English ("gate 2
#      reads rate_limit_resets_at as data") is exactly the false-positive class comment-skipping
#      closes, and it is the one a first version of T13 actually hit.
#   2. Only an ASSIGNMENT SHAPE counts as a write — `d["rate_limit_resets_at"] = iso` /
#      `d["rate_limit_armed_by"] = "wrapper"` (key, closing quote, closing bracket, optional space,
#      `=` NOT followed by a second `=`). Gate 2's legitimate READ (`d.get("rate_limit_resets_at")`)
#      has a `)` where the write shape needs `]=`, so it is excluded BY SHAPE, not by an allowlist —
#      there is nothing to keep in sync if gate 2's exact spacing changes.
# `rate_limit_armed_by` is write-only everywhere in this file (nothing reads it back) and is scanned
# the same way. Both fields must resolve to EXACTLY ONE write, and that write must fall inside the
# PYRL block's byte range, reusing `_locate_pyrl_block`'s own offsets so T3 and T13 can never
# disagree about where the block is. Zero writes found is loud failure, never silent green — this
# corpus's standing doctrine (mr-selfcheck's own coverage/vacuity assertions) is that a scanner
# matching nothing must never be mistaken for "nothing to fix".
# =================================================================================================
WRITE_RESETS_AT_RE = re.compile(r"""rate_limit_resets_at['"]\]\s*=(?!=)""")
WRITE_ARMED_BY_RE = re.compile(r"""rate_limit_armed_by['"]\]\s*=(?!=)""")
# Sanity/drift guard only (not used to exclude anything from the write count above — exclusion is by
# shape, not by allowlist): confirms gate 2's known-legitimate read is still present in the file, so
# a T13 that never fires isn't quietly scanning a file where the read line itself has vanished.
READ_RESETS_AT_RE = re.compile(r"""\.get\(\s*['"]rate_limit_resets_at['"]""")


def assert_t13_single_arming_site():
    if not os.path.isfile(TICK):
        check(False, "T13-tick-not-found", "mr-native-tick.sh not found at %s" % TICK)
        return
    with open(TICK, errors="replace") as f:
        src = f.read()
    start, end, _body = _locate_pyrl_block(src)
    if not check(start is not None and end is not None, "T13-pyrl-block-located",
                 "could not locate the PYRL block by content — cannot bound the single arming site"):
        return

    src_lines = src.splitlines()

    def _line_no(idx):
        return src.count("\n", 0, idx) + 1

    def _line_text(idx):
        return src_lines[_line_no(idx) - 1].strip()[:160]

    def _is_comment_line(idx):
        return src_lines[_line_no(idx) - 1].lstrip().startswith("#")

    def _writes(pattern, field_label):
        hits = [m for m in pattern.finditer(src) if not _is_comment_line(m.start())]
        check(len(hits) == 1, "T13-%s-single-write" % field_label,
              "assignment of `%s` must occur from EXACTLY ONE place, found %d at line(s) %s"
              % (field_label, len(hits), [_line_no(m.start()) for m in hits]))
        for m in hits:
            check(start <= m.start() < end, "T13-%s-write-inside-pyrl" % field_label,
                  "`%s` write outside the PYRL block, line %d: %s"
                  % (field_label, _line_no(m.start()), _line_text(m.start())))
        return hits

    _writes(WRITE_ARMED_BY_RE, "rate_limit_armed_by")
    _writes(WRITE_RESETS_AT_RE, "rate_limit_resets_at")

    read_hits = [m for m in READ_RESETS_AT_RE.finditer(src) if not _is_comment_line(m.start())]
    check(len(read_hits) >= 1, "T13-resets-at-read-detected",
          "expected to find gate 2's `.get(\"rate_limit_resets_at\")` read; found 0 — either it was "
          "removed or its shape drifted, and this scan's exclusion-by-shape is unverified without it")


# =================================================================================================
# T9 — static call-site pins over mr-native-tick.sh, by CONTENT never by line number.
#
# A red-team PROVED two bypasses of the original (text-match-only) version of this check:
#  (i)  commenting out the live-standdown call and wrapping the tick-post-spawn call in
#       `if false; then … fi` kept T9 green with BOTH call sites dead in production;
#  (ii) appending `; python3 -c "…"` after a real call site kept T9 green with a second,
#       unreviewed statement riding on the same line.
# Tightenings (a)/(b)/(c) below close both. (a) rejects `;`/multi-`&&`/`||` chaining after the
# call — closes (ii). (b) rejects a call inside a disabled `if false`-ish or `: <<TAG` block, or on
# a `#`-comment line — closes (i). (c) pins the LOGFILE argument per gate (different sources ON
# PURPOSE: at the gate-1 standdown point $TLOG does not exist yet, so live-standdown must read a
# `/tmp/mr_pass_` path while tick-post-spawn must read `"$TLOG"`), which independently makes a
# swapped/wrong-argument call site fail even if (a)+(b) somehow didn't catch it.
# =================================================================================================
CALL_RE = re.compile(r'"\$MEM/mr-cost-watch"\s+telemetry\s+("[^"]*")\s+([A-Za-z0-9_-]+)')

_IF_OPEN_RE = re.compile(r"^\s*if\s+(.*)$")
_IF_FALSE_COND_RE = re.compile(r"^\s*(false\b|\[\s*0\s*-eq\s*1\s*\]|\[\[\s*0\s*-eq\s*1\s*\]\])")
_BARE_FI_RE = re.compile(r"^\s*fi\b")
_SELF_CLOSING_IF_RE = re.compile(r"\bfi\s*$")
_COLON_HEREDOC_OPEN_RE = re.compile(r"^\s*:\s*<<-?\s*['\"]?([A-Za-z0-9_]+)['\"]?\s*$")


def _call_site_disabled(src_lines, line_idx):
    """T9(b). Upward scan from the call site's line for an unclosed `if false`-ish opener or an
    unclosed `: <<TAG` block-comment opener, or a leading-`#` comment on the call's own line.
    HONEST LIMITATION (documented, not hidden): only the INNERMOST unclosed `if` is checked — a call
    nested two-plus levels inside a disabled OUTER `if` with a live inner `if` between it and the
    call would not be caught — and heredoc-comment detection assumes `: <<TAG` blocks are not
    nested. Both are accepted trade-offs for a real-shell-parser-free check; good enough to catch
    the PROVEN attack shape (a flat `if false; then … fi` or `: <<'X' … X` wrapped directly around a
    real call site). Self-contained one-liners (`if …; then …; fi` all on one line — this file's own
    dominant style, e.g. the gate-1 STANDDOWN line) are explicitly skipped as SIBLINGS, never
    ancestors, or every earlier one-liner in the file would be misread as still open."""
    if re.match(r"^\s*#", src_lines[line_idx]):
        return True, "the call-site line itself is a comment"
    fi_skip = 0
    for i in range(line_idx - 1, -1, -1):
        ln = src_lines[i]
        if _BARE_FI_RE.match(ln):
            fi_skip += 1
            continue
        m_if = _IF_OPEN_RE.match(ln)
        if m_if:
            if _SELF_CLOSING_IF_RE.search(ln):
                continue  # one-liner if/fi on one line — a sibling, not an ancestor
            if fi_skip > 0:
                fi_skip -= 1
                continue
            if _IF_FALSE_COND_RE.match(m_if.group(1)):
                return True, "inside a disabled `if %s` opened at line %d" % (m_if.group(1).strip()[:60], i + 1)
            return False, None  # innermost open if is LIVE
        m_colon = _COLON_HEREDOC_OPEN_RE.match(ln)
        if m_colon:
            tag = m_colon.group(1)
            closer = re.compile(r"^%s\s*$" % re.escape(tag))
            if not any(closer.match(src_lines[j]) for j in range(i + 1, line_idx)):
                return True, "inside a `: <<%s` block-comment opened at line %d" % (tag, i + 1)
            return False, None
    return False, None


def _call_site_not_whole_statement(tail_of_line):
    """T9(a). `tail_of_line` is everything on the source line AFTER the matched call. Rejects any
    `;` (a second statement chained on) and any `&&`/`||` chain that does not resolve to a bare
    `true` or an empty-string variable assignment (`VAR=`) — the two shapes this corpus uses
    elsewhere for "never let this call fail the tick". Returns a reason string, or None if OK."""
    if ";" in tail_of_line:
        return "line contains `;` after the call (a second statement is chained on)"
    ops = re.findall(r"&&|\|\|", tail_of_line)
    if len(ops) > 1:
        return "line contains more than one &&/|| chain after the call"
    if len(ops) == 1:
        idx = max(tail_of_line.rfind("&&"), tail_of_line.rfind("||"))
        trailing = tail_of_line[idx + 2:].split("#", 1)[0].strip()
        if trailing != "true" and not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*=", trailing):
            return "chain after the call resolves to %r, not a bare `true`/empty-string assignment" % trailing
    return None


def assert_t9_call_sites():
    if not os.path.isfile(TICK):
        check(False, "T9-tick-not-found", "mr-native-tick.sh not found at %s" % TICK)
        return
    with open(TICK, errors="replace") as f:
        src = f.read()
    src_lines = src.split("\n")

    matches = list(CALL_RE.finditer(src))
    check(len(matches) == 2, "T9-exactly-two-call-sites",
          "expected exactly 2 `mr-cost-watch telemetry` call-sites, found %d" % len(matches))

    bad_gates = [m.group(2) for m in matches if m.group(2) not in CLOSED_GATES]
    check(not bad_gates, "T9-closed-gate-vocabulary",
          "GATE literal(s) outside {live-standdown, tick-post-spawn}: %s" % bad_gates)

    # (a) + (b): every match must be a live, whole, uncommented statement.
    for m in matches:
        line_idx = src.count("\n", 0, m.start())
        line_start = src.rfind("\n", 0, m.start()) + 1
        line_end = src.find("\n", m.end())
        if line_end == -1:
            line_end = len(src)
        tail = src[m.end():line_end]
        reason_a = _call_site_not_whole_statement(tail)
        check(reason_a is None, "T9-call-whole-statement",
              "gate=%s at line %d is not a whole statement: %s — full line: %s"
              % (m.group(2), line_idx + 1, reason_a, src[line_start:line_end].strip()[:200]))
        disabled, reason_b = _call_site_disabled(src_lines, line_idx)
        check(not disabled, "T9-call-not-disabled",
              "gate=%s at line %d is unreachable: %s — full line: %s"
              % (m.group(2), line_idx + 1, reason_b, src_lines[line_idx].strip()[:200]))

    rc_idx = src.find('if [ "$RC" -eq 0 ]')
    pyrl_open_m = re.search(r"<<'PYRL'", src)
    pyrl_idx = pyrl_open_m.start() if pyrl_open_m else None
    standdown_idx = src.find("STANDDOWN live-chain")

    tick_post_spawn = [m for m in matches if m.group(2) == "tick-post-spawn"]
    if check(len(tick_post_spawn) >= 1, "T9-tick-post-spawn-present",
             "no `tick-post-spawn` telemetry call-site found"):
        m = tick_post_spawn[0]
        check(rc_idx != -1 and m.start() < rc_idx, "T9-tick-post-spawn-before-rc-check",
              "the tick-post-spawn call must appear before `if [ \"$RC\" -eq 0 ]`")
        check(pyrl_idx is not None and m.start() < pyrl_idx, "T9-tick-post-spawn-before-pyrl",
              "the tick-post-spawn call must appear before the `<<'PYRL'` opener")
        # (c): tick-post-spawn's LOGFILE must be "$TLOG" — $TLOG is what exists at that point.
        check(m.group(1) == '"$TLOG"', "T9-tick-post-spawn-logfile-arg",
              "tick-post-spawn's LOGFILE argument must be exactly \"$TLOG\", got %s" % m.group(1))

    live_standdown = [m for m in matches if m.group(2) == "live-standdown"]
    if check(len(live_standdown) >= 1, "T9-live-standdown-present",
             "no `live-standdown` telemetry call-site found"):
        m = live_standdown[0]
        check(standdown_idx != -1 and m.start() < standdown_idx, "T9-live-standdown-before-standdown-log",
              "the live-standdown call must appear before the `STANDDOWN live-chain` log line")
        # (c): live-standdown's LOGFILE must be a /tmp/mr_pass_ path — $TLOG does not exist yet here.
        check(m.group(1).startswith('"/tmp/mr_pass_'), "T9-live-standdown-logfile-arg",
              "live-standdown's LOGFILE argument must be a \"/tmp/mr_pass_...\" path, got %s" % m.group(1))


# =================================================================================================
# T10 — production non-pollution. Snapshot (exists, size, sha256) of mr-state.json and
# mr-rate-limit-telemetry.jsonl BEFORE the whole run and compare AFTER. Any change is a FAIL.
#
# BLIND SPOT FIX: the `MEM=` assignment near the top of mr-cost-watch hardcodes
# `/home/.../claude-harness/memory/projects` — the PRODUCTION absolute path — regardless of which
# copy of the SCRIPT is invoked (deliberately not cited by line number: it already rotted once as
# the file grew a header). A buggy
# implementation can therefore write to the production files while this suite's self-located
# `STATE_JSON`/`TELEMETRY_JSONL` (this worktree's copies) stay untouched, a false green on exactly
# the property T10 exists to catch. Both the self-located AND the hardcoded-production pair are
# snapshotted below. Read-only: never written by this file, even when the two happen to coincide
# (running this suite from a non-worktree checkout).
# =================================================================================================
def _snapshot(path):
    if not os.path.exists(path):
        return (False, None, None)
    try:
        with open(path, "rb") as f:
            data = f.read()
        return (True, len(data), hashlib.sha256(data).hexdigest())
    except OSError:
        return (True, None, None)


# =================================================================================================
# Main
# =================================================================================================
def selftest():
    before_state = _snapshot(STATE_JSON)
    before_telem = _snapshot(TELEMETRY_JSONL)
    before_prod_state = _snapshot(PROD_STATE_JSON)
    before_prod_telem = _snapshot(PROD_TELEMETRY_JSONL)

    assert_t3_arming_pin()
    assert_t13_single_arming_site()
    assert_t9_call_sites()

    with tempfile.TemporaryDirectory(prefix="mr-telemetry-selftest-") as tmp:
        results = run_invocation_battery(tmp)
        assert_t1_t2_t5_on_main(results)
        assert_t5_source_variants(results)
        assert_t4_vacuity(results)
        assert_t7_negative_control(results)
        assert_t6_idempotency(results)
        assert_t11_t12(results)

    # Best-effort, narrowly-scoped cleanup of the ONE deterministically-named lock dir this file's
    # own invocations can create (see the COLLATERAL NOTE). Never a wildcard delete.
    try:
        import shutil
        stray = "/tmp/mr_costwatch_telemetry.lock.d"
        if os.path.isdir(stray):
            shutil.rmtree(stray, ignore_errors=True)
    except Exception:
        pass

    after_state = _snapshot(STATE_JSON)
    after_telem = _snapshot(TELEMETRY_JSONL)
    after_prod_state = _snapshot(PROD_STATE_JSON)
    after_prod_telem = _snapshot(PROD_TELEMETRY_JSONL)
    check(before_state == after_state, "T10-no-mr-state-json-pollution",
          "mr-state.json (self-located) changed across the run: before=%s after=%s" % (before_state, after_state))
    check(before_telem == after_telem, "T10-no-telemetry-jsonl-pollution",
          "mr-rate-limit-telemetry.jsonl (self-located) changed across the run: before=%s after=%s"
          % (before_telem, after_telem))
    check(before_prod_state == after_prod_state, "T10-no-prod-mr-state-json-pollution",
          "mr-state.json (hardcoded PRODUCTION path %s) changed across the run: before=%s after=%s"
          % (PROD_STATE_JSON, before_prod_state, after_prod_state))
    check(before_prod_telem == after_prod_telem, "T10-no-prod-telemetry-jsonl-pollution",
          "mr-rate-limit-telemetry.jsonl (hardcoded PRODUCTION path %s) changed across the run: "
          "before=%s after=%s" % (PROD_TELEMETRY_JSONL, before_prod_telem, after_prod_telem))

    if _FAILURES:
        for id_, detail in _FAILURES:
            line = "TELEMETRY-SELFTEST-FAIL %s" % id_
            if detail:
                line += ": %s" % detail
            print(line)
        return 1
    print("TELEMETRY-SELFTEST-OK %d fixtures / %d assertions" % (len(FIXTURES), _ASSERTIONS))
    return 0


if __name__ == "__main__":
    # Bare invocation and `--selftest` are identical — there is nothing else this tool does.
    sys.exit(selftest())
