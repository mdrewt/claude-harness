def _derive_rate_limit_types():
    types = set()
    for _name, body, _why in FIXTURES:
        for line in body.split("\n"):
            line = line.strip()
            if not line:
                continue
            try:
                d = json.loads(line)
            except Exception:
                continue
            if not isinstance(d, dict) or d.get("type") != "rate_limit_event":
                continue
            ri = d.get("rate_limit_info")
            if isinstance(ri, dict) and "rateLimitType" in ri:
                types.add(ri["rateLimitType"])
    return types


