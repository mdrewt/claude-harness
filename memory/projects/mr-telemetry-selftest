def _fail_missing(id_, run, what):
    """One shared, clear failure shape for 'the run never produced usable output' — avoids a
    traceback from indexing into an empty/absent result and names the missing subcommand plainly."""
    if run.get("timed_out"):
        check(False, id_, "%s: mr-cost-watch telemetry timed out after %ss — the `telemetry` "
              "subcommand does not exist yet (dispatch fell through to the `watch` fallback)"
              % (what, INVOKE_TIMEOUT))
    else:
        check(False, id_, "%s: rc=%r stdout=%r" % (what, run.get("rc"), run.get("stdout")))


def assert_t1_t2_t5_on_main(results):
    """T1 (EARS-1, defect a): F1/F2 (allowed_warning) each produce exactly one row with the correct
    utilization. This REDs against a reader that filters on status=="rejected" (today's PYRL
    pre-filter behaviour, misapplied to this NEW reader) because F1/F2 would never be read at all.

    T2 (EARS-2, defect b): F3/F4/F5 each produce a row with utilization is None — never dropped.
    REDs against `if utilization is None: continue`.

    T5: every row carries EXACTLY the 12-key set, 0<=utilization<=1 when non-null, <1024 bytes,
    parses standalone, slices_running_at_sample/gate_reached/source match the call's arguments."""
    run = results["main"]
    rows = _read_rows(run["out"]) if not run["timed_out"] else []
    EXPECTED_ROWS = 6  # F1,F2,F3,F4,F5,F6 — F7/garbage/blank must not appear
    if not check(len(rows) == EXPECTED_ROWS, "T5-row-count",
                 "expected exactly %d rows from the corpus (F1..F6), got %d (out=%s, timed_out=%s)"
                 % (EXPECTED_ROWS, len(rows), run["out"], run["timed_out"])):
        _fail_missing("T1-allowed-warning-rows", run, "F1/F2 rows")
        _fail_missing("T2-utilization-null-rows", run, "F3/F4/F5 rows")
        return

    # T1
    r1 = _by_uuid(rows, "f1-0000-0000-0000-000000000001")
    r2 = _by_uuid(rows, "f1-0000-0000-0000-000000000002")
    check(r1 is not None and r1.get("utilization") == 0.87, "T1-F1-allowed-warning",
          "F1 (status=allowed_warning) row missing or utilization != 0.87: %r" % r1)
    check(r2 is not None and r2.get("utilization") == 0.32, "T1-F2-allowed-warning",
          "F2 (status=allowed_warning) row missing or utilization != 0.32: %r" % r2)

    # T2
    for uuid, label in (
        ("f1-0000-0000-0000-000000000003", "F3-rejected-no-utilization"),
        ("f1-0000-0000-0000-000000000004", "F4-allowed-no-utilization"),
        ("f1-0000-0000-0000-000000000005", "F5-no-ratelimittype-at-all"),
    ):
        row = _by_uuid(rows, uuid)
        check(row is not None, "T2-%s-present" % label, "row for uuid=%s missing (dropped, not just null)" % uuid)
        if row is not None:
            check(row.get("utilization") is None, "T2-%s-null" % label,
                  "expected utilization: null, got %r" % (row.get("utilization"),))

    # T5 — key set, ranges, byte size, standalone parse
    for i, ln in enumerate(_read_raw_lines(run["out"])):
        if not ln.strip():
            continue
        check(len(ln.encode("utf-8")) < 1024, "T5-row-size-%d" % i, "row %d is >=1024 bytes" % i)
        try:
            row = json.loads(ln)
        except Exception as e:
            check(False, "T5-row-standalone-json-%d" % i, "row %d does not parse standalone: %s" % (i, e))
            continue
        check(set(row.keys()) == EXPECTED_KEYS, "T5-row-keys-%d" % i,
              "row %d key set != the 12-key contract: got %s" % (i, sorted(row.keys())))
        u = row.get("utilization")
        if u is not None:
            check(0 <= u <= 1, "T5-row-utilization-range-%d" % i, "utilization out of [0,1]: %r" % u)
        check(row.get("slices_running_at_sample") == 3 and isinstance(row.get("slices_running_at_sample"), int),
              "T5-row-nslices-%d" % i,
              "slices_running_at_sample != int(3): %r" % (row.get("slices_running_at_sample"),))
        check(row.get("gate_reached") == "live-standdown", "T5-row-gate-%d" % i,
              "gate_reached != 'live-standdown': %r" % (row.get("gate_reached"),))
        check(row.get("source") == "slice:corpus", "T5-row-source-slice-%d" % i,
              "source != 'slice:corpus' for mr_pass_corpus.log: %r" % (row.get("source"),))


