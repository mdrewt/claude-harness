def assert_t6_idempotency(results):
    """T6: rerunning the emitter over the SAME log+outfile must not double the row count, and the
    second run's stdout must report dup= > 0."""
    main = results["main"]
    rerun = results["main_rerun"]
    if main["timed_out"] or rerun["timed_out"]:
        _fail_missing("T6-idempotent-rowcount", rerun, "idempotent rerun")
        _fail_missing("T6-idempotent-dup-reported", rerun, "idempotent rerun stdout")
        return
    rows_after_first = main["rowcount_after_first"]
    rows_after_second = len(_read_rows(main["out"]))  # read AFTER the rerun completed
    check(rows_after_first == rows_after_second, "T6-idempotent-rowcount",
          "row count changed across a rerun over the same log+outfile: %d -> %d"
          % (rows_after_first, rows_after_second))
    m = re.match(r"OK rows=(\d+) util=(\d+) dup=(\d+) skip=(\d+)", rerun["stdout"].strip())
    check(m is not None and int(m.group(3)) > 0, "T6-idempotent-dup-reported",
          "rerun stdout must report dup=<n> with n>0, got %r" % rerun["stdout"])


def assert_t11_t12(results):
    """T11: stdout contract. Success -> exactly one `OK rows=<int> util=<int> dup=<int> skip=<int>`
    line. Missing/unreadable LOGFILE -> exactly one `ERR ...` line, rc still 0 (a telemetry reader
    must never fail its caller). T12: rc of every emitter invocation is 0."""
    main = results["main"]
    if main["timed_out"]:
        _fail_missing("T11-success-stdout-shape", main, "successful run stdout")
    else:
        lines = [ln for ln in main["stdout"].splitlines() if ln.strip()]
        check(len(lines) == 1, "T11-success-stdout-single-line",
              "successful run stdout must be exactly one line, got %d: %r" % (len(lines), main["stdout"]))
        if lines:
            check(re.fullmatch(r"OK rows=\d+ util=\d+ dup=\d+ skip=\d+", lines[0]) is not None,
                  "T11-success-stdout-shape", "stdout does not match the OK contract: %r" % lines[0])

    missing = results["missing"]
    if missing["timed_out"]:
        _fail_missing("T11-failure-stdout-shape", missing, "missing-logfile run stdout")
    else:
        lines = [ln for ln in missing["stdout"].splitlines() if ln.strip()]
        check(len(lines) == 1 and lines[0].startswith("ERR "), "T11-failure-stdout-shape",
              "missing-LOGFILE run stdout must be exactly one `ERR ...` line, got %r" % missing["stdout"])
        check(missing["rc"] == 0, "T11-failure-rc-still-zero",
              "a telemetry reader must never fail its caller even on a missing LOGFILE: rc=%r" % missing["rc"])

    for label, rc in _ALL_RCS:
        check(rc == 0, "T12-rc-zero-%s" % label,
              "invocation %s did not return rc=0 (rc=%r) — an emitter must always exit 0" % (label, rc))


# =================================================================================================
# T3 — behavioural arming pin (EARS-3, defect c). Extracted BY CONTENT MARKER, modeled on
# mr-selfcheck's A4/A8 pattern: locate `<<'PYRL'` by content, find the line that is exactly `PYRL`,
# and FAIL LOUDLY if either marker is missing (a silently-skipped extraction is a false green).
# =================================================================================================
def assert_t3_arming_pin():
    if not os.path.isfile(TICK):
        check(False, "T3-arming-tick-not-found", "mr-native-tick.sh not found at %s" % TICK)
        return
    with open(TICK, errors="replace") as f:
        tick_src = f.read()

    # The character class in place of a bare `'` keeps THIS line from matching mr-selfcheck's own
    # heredoc-opener scanner (`^…python3…<<-?'TAG'…$`), which would otherwise read this file as
    # opening an unterminated PYRL heredoc and RED py-heredoc-coverage. `[']PYRL[']` matches the
    # exact same literal text in mr-native-tick.sh (`<<'PYRL'`) — semantics unchanged, T3 unweakened.
    open_m = re.search(r"^[^\n]*python3[^\n]*<<[']PYRL['][^\n]*$", tick_src, re.M)
    if not check(open_m is not None, "T3-arming-extraction-open",
                 "could not locate the `<<'PYRL'` opener by content — extraction has rotted"):
        return
    tail = tick_src[open_m.end() + 1:]
    close_m = re.search(r"^PYRL\s*$", tail, re.M)
    if not check(close_m is not None, "T3-arming-extraction-close",
                 "could not locate the closing `PYRL` marker line by content — extraction has rotted"):
        return
    body = tail[:close_m.start()]
    check(len(body.strip()) > 0, "T3-arming-extraction-nonempty", "extracted PYRL body is empty")

    with tempfile.TemporaryDirectory() as gx:
        script = os.path.join(gx, "extracted_pyrl.py")
        with open(script, "w") as f:
            f.write(body)

        def _mkstate(name):
            p = os.path.join(gx, name)
            with open(p, "w") as f:
                json.dump({"foo": "bar"}, f)
            return p

        # (i) F1+F2 only (allowed_warning; no "rejected" substring anywhere) -> NONE, state untouched.
        tlog_i = os.path.join(gx, "tlog_none.log")
        with open(tlog_i, "w") as f:
            f.write(_corpus_body([F1, F2]))
        state_i = _mkstate("state_none.json")
        with open(state_i, "rb") as f:
            state_i_before = f.read()
        rc, out, err, to = _safe_run([sys.executable or "/usr/bin/python3", script, tlog_i, state_i],
                                      timeout=10)
        check(not to, "T3-arming-none-not-timed-out", "extracted PYRL script timed out")
        check(rc == 0, "T3-arming-none-rc", "extracted PYRL script rc=%r stderr=%r" % (rc, err))
        check(out.strip() == "NONE", "T3-arming-none-stdout",
              "a log with only allowed_warning rows must arm nothing — a WIDENED arming predicate "
              "REDs here: got %r" % out.strip())
        with open(state_i, "rb") as f:
            state_i_after = f.read()
        check(state_i_before == state_i_after, "T3-arming-none-state-untouched",
              "state file must be byte-identical when nothing arms")

        # (ii) a rejected row with resetsAt = now+3600 -> ARMED
        future = int(time.time()) + 3600
        tlog_ii = os.path.join(gx, "tlog_armed.log")
        with open(tlog_ii, "w") as f:
            f.write('{"type":"rate_limit_event","rate_limit_info":{"status":"rejected",'
                    '"resetsAt":%d,"rateLimitType":"five_hour"},"uuid":"t3-ii","session_id":"s1"}\n'
                    % future)
        state_ii = _mkstate("state_armed.json")
        rc2, out2, err2, to2 = _safe_run(
            [sys.executable or "/usr/bin/python3", script, tlog_ii, state_ii], timeout=10)
        check(not to2, "T3-arming-armed-not-timed-out", "extracted PYRL script timed out")
        check(out2.strip().startswith("ARMED"), "T3-arming-armed-stdout",
              "a future-resetsAt rejected row must arm — a NARROWED arming predicate REDs here: "
              "got %r" % out2.strip())

        # (iii) a rejected row with resetsAt in the past -> SKIPPED past(
        past = int(time.time()) - 3600
        tlog_iii = os.path.join(gx, "tlog_past.log")
        with open(tlog_iii, "w") as f:
            f.write('{"type":"rate_limit_event","rate_limit_info":{"status":"rejected",'
                    '"resetsAt":%d,"rateLimitType":"five_hour"},"uuid":"t3-iii","session_id":"s1"}\n'
                    % past)
        state_iii = _mkstate("state_past.json")
        rc3, out3, err3, to3 = _safe_run(
            [sys.executable or "/usr/bin/python3", script, tlog_iii, state_iii], timeout=10)
        check(not to3, "T3-arming-past-not-timed-out", "extracted PYRL script timed out")
        check(out3.strip().startswith("SKIPPED past("), "T3-arming-past-stdout",
              "a past-resetsAt rejected row must be skipped as past, got %r" % out3.strip())


# =================================================================================================
# T9 — static call-site pins over mr-native-tick.sh, by CONTENT never by line number.
# =================================================================================================
CALL_RE = re.compile(r'"\$MEM/mr-cost-watch"\s+telemetry\s+"[^"]*"\s+([A-Za-z0-9_-]+)')


def assert_t9_call_sites():
    if not os.path.isfile(TICK):
        check(False, "T9-tick-not-found", "mr-native-tick.sh not found at %s" % TICK)
        return
    with open(TICK, errors="replace") as f:
        src = f.read()

    matches = list(CALL_RE.finditer(src))
    check(len(matches) == 2, "T9-exactly-two-call-sites",
          "expected exactly 2 `mr-cost-watch telemetry` call-sites, found %d" % len(matches))

    bad_gates = [m.group(1) for m in matches if m.group(1) not in CLOSED_GATES]
    check(not bad_gates, "T9-closed-gate-vocabulary",
          "GATE literal(s) outside {live-standdown, tick-post-spawn}: %s" % bad_gates)

    rc_idx = src.find('if [ "$RC" -eq 0 ]')
    pyrl_open_m = re.search(r"<<'PYRL'", src)
    pyrl_idx = pyrl_open_m.start() if pyrl_open_m else None
    standdown_idx = src.find("STANDDOWN live-chain")

    tick_post_spawn = [m for m in matches if m.group(1) == "tick-post-spawn"]
    if check(len(tick_post_spawn) >= 1, "T9-tick-post-spawn-present",
             "no `tick-post-spawn` telemetry call-site found"):
        m = tick_post_spawn[0]
        check(rc_idx != -1 and m.start() < rc_idx, "T9-tick-post-spawn-before-rc-check",
              "the tick-post-spawn call must appear before `if [ \"$RC\" -eq 0 ]`")
        check(pyrl_idx is not None and m.start() < pyrl_idx, "T9-tick-post-spawn-before-pyrl",
              "the tick-post-spawn call must appear before the `<<'PYRL'` opener")

    live_standdown = [m for m in matches if m.group(1) == "live-standdown"]
    if check(len(live_standdown) >= 1, "T9-live-standdown-present",
             "no `live-standdown` telemetry call-site found"):
        m = live_standdown[0]
        check(standdown_idx != -1 and m.start() < standdown_idx, "T9-live-standdown-before-standdown-log",
              "the live-standdown call must appear before the `STANDDOWN live-chain` log line")


# =================================================================================================
# T10 — production non-pollution. Snapshot (exists, size, sha256) of mr-state.json and
# mr-rate-limit-telemetry.jsonl BEFORE the whole run and compare AFTER. Any change is a FAIL.
# =================================================================================================
def _snapshot(path):
    if not os.path.exists(path):
        return (False, None, None)
    try:
        with open(path, "rb") as f:
            data = f.read()
        return (True, len(data), hashlib.sha256(data).hexdigest())
    except OSError:
        return (True, None, None)


# =================================================================================================
# Main
# =================================================================================================
def selftest():
    before_state = _snapshot(STATE_JSON)
    before_telem = _snapshot(TELEMETRY_JSONL)

    assert_t3_arming_pin()
    assert_t9_call_sites()

    with tempfile.TemporaryDirectory(prefix="mr-telemetry-selftest-") as tmp:
        results = run_invocation_battery(tmp)
        assert_t1_t2_t5_on_main(results)
        assert_t5_source_variants(results)
        assert_t4_vacuity(results)
        assert_t7_negative_control(results)
        assert_t6_idempotency(results)
        assert_t11_t12(results)

    # Best-effort, narrowly-scoped cleanup of the ONE deterministically-named lock dir this file's
    # own invocations can create (see the COLLATERAL NOTE). Never a wildcard delete.
    try:
        import shutil
        stray = "/tmp/mr_costwatch_telemetry.lock.d"
        if os.path.isdir(stray):
            shutil.rmtree(stray, ignore_errors=True)
    except Exception:
        pass

    after_state = _snapshot(STATE_JSON)
    after_telem = _snapshot(TELEMETRY_JSONL)
    check(before_state == after_state, "T10-no-mr-state-json-pollution",
          "mr-state.json changed across the run: before=%s after=%s" % (before_state, after_state))
    check(before_telem == after_telem, "T10-no-telemetry-jsonl-pollution",
          "mr-rate-limit-telemetry.jsonl changed across the run: before=%s after=%s"
          % (before_telem, after_telem))

    if _FAILURES:
        for id_, detail in _FAILURES:
            line = "TELEMETRY-SELFTEST-FAIL %s" % id_
            if detail:
                line += ": %s" % detail
            print(line)
        return 1
    print("TELEMETRY-SELFTEST-OK %d fixtures / %d assertions" % (len(FIXTURES), _ASSERTIONS))
    return 0


if __name__ == "__main__":
    # Bare invocation and `--selftest` are identical — there is nothing else this tool does.
    sys.exit(selftest())
