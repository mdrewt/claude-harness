        and got.get(("S-med", "syn.toy::t_atk")) == "no-compile" and q["O-med"]["no_compile_files"] == 0
        and all(w and w.startswith("unresolved import: Cannot find module") and "setup step toy: `false` exit 1" in w for w in why), (got, why))
    # The shape vitest writes, read by the shipped test patterns.
    shipped = Ctx(HERE).cfg
