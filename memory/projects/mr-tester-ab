def _st_offline(chk, tmp):
    """Without `mark`: g1 is derived from the first lens call after the primary, and later
    tester calls are recorded as follow-ups."""
    box = _Box(os.path.join(tmp, "offline"), prices=_PRICES, lens_roles=["reviewer", "verifier"])
    made = {}

    def hook(name, sha):
        if name == "g1":
            made["green"] = sha
            time.sleep(1.1)
            made["followup"] = box.transcript("Fix the wrong test", "sonnet", "medium", at=time.time())
            made["lens"] = box.transcript("Review np-a", "opus", "medium", role="reviewer", at=time.time())
            box.transcript("Review np-a again", "opus", "medium", role="reviewer", at=time.time() + 30)
            time.sleep(1.1)
        elif name == "m":
            record_snap(box.ctx(), "np-a", "m", sha)

    box.transcript("Review the np-a plan", "opus", "medium", role="reviewer", at=time.time() - 300)
    _scenario(box, hook=hook)
    box.run("score", "np-a")
    g1 = [r for r in box.rows("snap", "np-a") if r["name"] == "g1"]
    chk("offline/g1-derived-from-first-lens-call", len(g1) == 1 and g1[0]["sha"] == made["green"]
        and g1[0]["source"] == "derived", g1)
    follow = [r for r in box.rows("run", "np-a") if r["role"] == "followup"]
    chk("offline/followup-testers-recorded-not-scored", [r["agent_id"] for r in follow] == [made["followup"]]
        and follow[0]["cost_usd"] == 2.0 and spent(box.rows()) == 14.0, follow)
    n = len(box.rows())
    box.run("score", "np-a")
    chk("offline/recorded-once", len(box.rows()) == n)
    # No g2 was recorded either: a test that fails at the first green and passes at m is
    # lens-caught, whichever fix turned it.
    chk("offline/classes-with-a-derived-g1-and-no-g2", sorted(c["type"] for c in latest(
        box.rows("candidate", "np-a"), lambda r: (r["label"], r.get("test_id") or r.get("claim_id")))) == sorted(
        ["lens-caught"] * 5 + ["base", "open-fail", "spec"]))


