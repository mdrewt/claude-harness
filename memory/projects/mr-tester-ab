    retro = _retro_stub(box)
    hook, outs = _by_command(box)
    _scenario(box, hook=hook)
    status = box.run("status")
    chk("close/status-says-which-condition-is-pending", not box.rows("close")
        and "closes on required-slices pending: off: no slice is listed" in status
        and "closes on max-slices      pending: 1 of 2 scored slice(s)" in status
        and "closes on cap             pending: $14.00 of $500 committed" in status
        and "closes on backstop-days   pending: 1 of 45 loop-active day(s) since the first finalized slice" in status, status)
    wt = box.worktree("np-b")
