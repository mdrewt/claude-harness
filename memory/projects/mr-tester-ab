    g1 = [r for r in box.rows("snap", "np-a") if r["name"] == "g1"]
    chk("offline/g1-derived-from-first-lens-call", len(g1) == 1 and g1[0]["sha"] == made["green"]
        and g1[0]["source"] == "derived", g1)
