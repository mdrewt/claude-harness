    made = {}

    def hook(name, sha):
        if name == "g1":
            made["green"] = sha
            time.sleep(1.1)
            made["followup"] = box.transcript("Fix the wrong test", "sonnet", "medium", at=time.time())
            made["lens"] = box.transcript("Review np-a", "opus", "medium", role="reviewer", at=time.time())
            box.transcript("Review np-a again", "opus", "medium", role="reviewer", at=time.time() + 30)
            time.sleep(1.1)
        elif name == "m":
            record_snap(box.ctx(), "np-a", "m", sha)

