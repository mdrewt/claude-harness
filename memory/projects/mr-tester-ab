def _ledger(n, found=(), costs=None, tiers=None, areas=None, quality=None, replicate=(), failed=(), extra=()):
    """A fixture ledger of n scored slices s01..: `found` lists (class, arms that found it,
    status) once per slice unless a fourth element names the slices."""
    costs = costs or {"S-med": 2.7, "S-high": 3.5, "O-med": 6.5, "O-high": 9.0, "S-med-r": 2.7}
    rows = []
    for i in range(n):
        s = "s%02d" % (i + 1)
        tier = (tiers or ["routine"] * n)[i]
        rows.append({"kind": "assignment", "slice": s, "tier": tier, "tester_md_sha": "ab" * 32, "skipped": None})
        rows.append({"kind": "slice", "slice": s, "status": "scored", "area": (areas or ["rust"] * n)[i]})
        for j, arm in enumerate(_ARMS):
            name = arm["arm"]
            rows.append({"kind": "run", "slice": s, "label": "a%d" % (j + 1), "arm": name, "role": arm["role"],
                         "status": "failed" if (s, name) in failed else "ok", "cost_usd": costs[name],
                         "twin": name == "S-med", "cli_version": "9.9.9", "leak": False, "tests_ref": "0" * 40})
            q = {"no_compile_files": 0, "flaky": 0, "brittle": 0, "not_run": 0, "tests": 10, "test_loc": 100,
                 "loc_per_criterion": 10.0, "bloat_usd": 0.05}
            q.update((quality or {}).get(name, {}))
            rows.append(dict(q, kind="quality", slice=s, label="a%d" % (j + 1)))
        for k, spec in enumerate(found):
            klass, arms, status = spec[:3]
            if len(spec) > 3 and s not in spec[3]:
                continue
            rows.append({"kind": "finding", "slice": s, "finding_id": "f%s-%d" % (s, k), "class": klass,
                         "status": status, "verdict": "bug", "criterion": "C%d" % k, "wrong_behaviour": "wrong %d" % k,
                         "severity": "minor", "found_by": sorted(arms), "members": ["k%d" % k],
                         "missed_by": sorted(a for a in ("S-med", "S-high", "O-med", "O-high") if a not in arms),
                         "replicate_found": k in replicate, "fix_cost_usd": None})
    return rows + list(extra)


