SLICE_RE = re.compile(r"[A-Za-z0-9][A-Za-z0-9._-]{0,63}")
CRITERION_RE = re.compile(r"criterion:\s*([A-Za-z0-9][\w.\-]*)")
SHADOW_ROLES = ("shadow", "replicate")
PROMPT_FILE = "TESTER-PROMPT.md"
REPORT_FILE = "REPORT.md"
_GIT_SCRUB = ("GIT_DIR", "GIT_WORK_TREE", "GIT_INDEX_FILE", "GIT_OBJECT_DIRECTORY",
              "GIT_COMMON_DIR", "GIT_NAMESPACE", "GIT_ALTERNATE_OBJECT_DIRECTORIES")
