def _st_replan(chk, tmp):
    """`plan` again, mid-batch: the shadows that started are kept, only the others are printed;
    a shadow that ran twice in one export is priced in full and not scored."""
    box = _Box(os.path.join(tmp, "replan"), prices=_PRICES)
    wt = box.worktree("np-a")
    prompt = box.prompt("np-a", wt)
    first = box.run("plan", "np-a", "--prompt", prompt)
    lab = box.labels("np-a")
    box.shadow("np-a", "S-med", {"tests/s_med.toy": _toy(_T_ATK)})
    box.shadow("np-a", "O-med", {"tests/o_med.toy": _toy(_T_ATK)})
    again = box.run("plan", "np-a", "--prompt", prompt)
    calls = [l for l in again.splitlines() if "Agent(" in l]
    chk("replan/prints-only-the-shadows-that-have-not-started", again.startswith(
        "AB-PLAN np-a: 2 shadow(s) have already started or finished and are kept as they are. Issue only these 3 Agent call(s)")
        and len(calls) == 3 and not any(lab[a][1] in again for a in ("S-med", "O-med"))
        and all(lab[a][1] in again for a in ("S-high", "O-high", "S-med-r"))
        and all(c.split(". ", 1)[1] in first for c in calls) and set(re.findall(r'subagent_type="([^"]*)"', again)) == {"tester"}
        and again.rstrip().endswith("mr-tester-ab collect np-a"), again)
    # Started and killed before its transcript was written: its export is no longer the base tree.
    os.makedirs(os.path.join(lab["S-high"][1], "tests"), exist_ok=True)
    with open(os.path.join(lab["S-high"][1], "tests", "half.toy"), "w") as fh:
        fh.write("test t_half atk=5\n")
    chk("replan/an-export-that-changed-has-started", box.run("plan", "np-a", "--prompt", prompt).count("Agent(") == 2)
    box.shadow("np-a", "S-high", {"tests/s_high.toy": _toy(_T_ATK)})
    box.shadow("np-a", "O-high", {"tests/o_high.toy": _toy(_T_ATK)})
    box.shadow("np-a", "S-med-r", {"tests/s_med_r.toy": _toy(_T_ATK)})
    full = box.run("plan", "np-a", "--prompt", prompt)
    chk("replan/nothing-left-to-issue", full.startswith("AB-PLAN np-a: every shadow has already started or finished; issue no shadow call")
        and "Agent(" not in full, full)
    # The call was issued again all the same: two sessions worked in S-med's export.
    box.shadow("np-a", "S-med", {"tests/s_med2.toy": _toy(_T_DEF)})
    out = box.run("collect", "np-a")
    runs = {r["arm"]: r for r in box.rows("run", "np-a")}
    chk("replan/a-second-run-in-one-export-is-priced-in-full-and-not-scored", runs["S-med"]["status"] == "rerun"
        and runs["S-med"]["cost_usd"] == 4.0 and runs["S-med"]["sessions_in_export"] == 2
        and runs["O-med"]["status"] == "ok" and runs["O-med"]["cost_usd"] == 4.0 and spent(box.rows()) == 16.0
        and "AB-WARN np-a: 1 shadow(s) ran more than once in one export" in out
        and all(r["label"] != runs["S-med"]["label"] for r in ok_runs(box.rows(), "np-a")), (runs["S-med"], out))
    chk("replan/status-names-the-rerun", "S-med: ran 2 times in one export; priced, not scored" in box.run("status"), box.run("status"))


def _st_end_merge(chk, tmp):
    """At the default-branch head an arm's edit to a file that existed before it is merged into
    that file as the head has it: the file's old content, which the arm did not write, cannot
    break the arm's tests, and a real break of one of them still shows."""
    pad = "# pad 1\n# pad 2\n# pad 3\n# pad 4\n# pad 5\n# pad 6\n"
    old = "requires mp\n# criterion: C1\ntest t_old hp=10\n" + pad
    box = _Box(os.path.join(tmp, "end-merge"), prices=_PRICES, mutants={"enabled": False})
    box.commit(box.game, "an existing suite", {"tests/shared.toy": old})
    wt = box.worktree("np-a")
    box.run("plan", "np-a", "--prompt", box.prompt("np-a", wt))
    lab = {arm: label for arm, (label, _) in box.labels("np-a").items()}
    box.shadow("np-a", "S-med", {"tests/shared.toy": old + _toy(("t_a", "atk=5", "C2"))})
    box.shadow("np-a", "S-high", {"tests/shared.toy": old + _toy(("t_b", "hp=10", "C3"))})
    # O-med also rewrites the line the default branch changes afterwards.
    box.shadow("np-a", "O-med", {"tests/shared.toy": old.replace("requires mp\n", "requires mp  # the fixture\n")
                                 + _toy(("t_c", "atk=5", "C4"))})
    box.shadow("np-a", "O-high", {"tests/new.toy": "requires mp\n" + _toy(("t_d", "atk=5", "C5"))})
    # The replicate rewords a comment the default branch rewords too: the merge is forced, and builds.
    box.shadow("np-a", "S-med-r", {"tests/shared.toy": old.replace("# pad 2\n", "# pad 2, kept\n")
                                   + _toy(("t_e", "hp=10", "C6"), ("t_f", "atk=5", "C7"))})
    box.run("collect", "np-a")
    record_snap(box.ctx(), "np-a", "m", box.commit(wt, "green", {"game/rules.txt": "hp=10\nold=bug\nmp=4\natk=5\n"}))
    git(box.game, "merge", "-q", "--ff-only", "slice/np-a")
    # Later work renames the fixture key the old suite requires, and raises hp.
    box.commit(box.game, "later work", {"game/rules.txt": "hp=11\nold=bug\nmana=4\natk=5\n",
                                        "tests/shared.toy": "requires mana\n# criterion: C1\ntest t_old hp=11\n"
                                        + pad.replace("# pad 2\n", "# pad two\n")})
    box.run("score", "np-a", "--end")
    end = {(r["label"], r["test_id"].rsplit("::", 1)[1]): (r["result"], r.get("reason")) for r in box.rows("exec", "np-a")
           if r["snap"] == "end"}
    at_m = {r["result"] for r in box.rows("exec", "np-a") if r["snap"] == "m"}
    q = {r["label"]: r for r in latest(box.rows("quality", "np-a"), lambda r: r["label"])}
    chk("end/an-edit-to-an-existing-file-is-merged-into-the-head's", at_m == {"pass"}
        and end.get((lab["S-med"], "t_a")) == ("pass", None) and q[lab["S-med"]]["brittle"] == 0
        and q[lab["S-med"]]["stale_files"] == 0, (end.get((lab["S-med"], "t_a")), q[lab["S-med"]]))
    chk("end/a-real-break-in-an-existing-file-still-shows", end.get((lab["S-high"], "t_b"), ("",))[0] == "fail"
        and q[lab["S-high"]]["brittle"] == 1 and q[lab["S-high"]]["brittle_files"] == 0, (end.get((lab["S-high"], "t_b")), q[lab["S-high"]]))
    chk("end/a-forced-merge-that-does-not-build-is-stale-not-brittle", end.get((lab["O-med"], "t_c")) == ("not-run", STALE)
        and q[lab["O-med"]]["brittle"] == 0 and q[lab["O-med"]]["stale_files"] == 1, (end.get((lab["O-med"], "t_c")), q[lab["O-med"]]))
    chk("end/a-file-the-arm-created-is-its-own", end.get((lab["O-high"], "t_d"), ("",))[0] == "no-compile"
        and q[lab["O-high"]]["brittle"] == 1 and q[lab["O-high"]]["brittle_files"] == 1, (end.get((lab["O-high"], "t_d")), q[lab["O-high"]]))
    chk("end/in-a-forced-merge-a-pass-counts-and-a-failure-is-stale", end.get((lab["S-med-r"], "t_e")) == ("not-run", STALE)
        and end.get((lab["S-med-r"], "t_f")) == ("pass", None) and q[lab["S-med-r"]]["brittle"] == 0
        and q[lab["S-med-r"]]["stale_files"] == 1, (end.get((lab["S-med-r"], "t_e")), end.get((lab["S-med-r"], "t_f")), q[lab["S-med-r"]]))
    text = render_report(box.rows(), box.cfg)
    scratch = box.ctx().scratch
    chk("end/the-report-counts-stale-files-apart", "1 such file(s) could only be merged by force" in text
        and open(os.path.join(scratch, "tests", "shared.toy")).read().startswith("requires mana\n")
        and "t_a" not in open(os.path.join(scratch, "tests", "shared.toy")).read(), text[:200])


