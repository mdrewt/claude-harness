    box.run("collect", "np-b")
    with _gh(box, works=False):
        done = box.run("finalize", "np-b", "--no-score")
    chk("close/no-required-list-closes-on-a-backstop", done == "AB-CLOSED max-slices\nAB-FINALIZED np-b\n"
        and [c["reason"] for c in box.rows("close")] == ["max-slices"] and retro() == ["tester-ab close"]
        and "  closed: max-slices" in box.run("status"), done)
    box = _Box(os.path.join(tmp, "close-required-status"), required_slices=["np-a", "np-b"], pr_repo="o/r", **extra)
    hook, outs = _by_command(box)
    _scenario(box, hook=hook)
    chk("close/status-counts-the-required-slices", "closes on required-slices pending: 1 of 2 required slice(s) finalized"
        in box.run("status"), box.run("status"))
    # Loop-active days: distinct days with a commit on the default branch since the first m.
    box = _Box(os.path.join(tmp, "close-days"), **dict(extra, backstops={"max_scored_slices": 16, "loop_active_days": 3}))
