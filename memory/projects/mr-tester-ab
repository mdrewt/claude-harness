def _scenario(box, slice_="np-a", rust=True, hook=None):
    """Plan, play five shadows, collect, and build the snapshots g1, g2, m and end of a slice.
    `hook(name, sha)` is called after the commit of g1, g2 and m; by default it records the
    commit as that snapshot.

    rules at base: hp=10 old=bug mp=4.   g1: +atk=5 def=2 spd=6.   g2: def=3 (a lens fix).
    m: spd=7 old=fixed.   end: hp=11 mp=5, and the spec corpus changes criterion C8."""
    wt = box.worktree(slice_)
    box.run("plan", slice_, "--prompt", box.prompt(slice_, wt))
    t_old, t_wrong = ("t_old", "old=fixed", "C4"), ("t_wrong", "zz=1", "C7")
    t_brit, t_mp = ("t_brit", "hp=10", "C9"), ("t_mp", "mp=4", "C8")
    box.shadow(slice_, "S-med", {"tests/s_med.toy": _toy(_T_ATK, _T_DEF, t_wrong)})
    box.shadow(slice_, "S-high", {"tests/s_high.toy": _toy(_T_ATK, _T_DEF, _T_SPD, t_brit)})
    box.shadow(slice_, "O-med", {"tests/o_med.toy": _toy(_T_ATK, t_old),
                                 "tests/o_med_fl.toy": _toy("flaky t_fl")},
               report="FINDINGS\n- kind: base | test: t_old | where: game/rules.txt:2 | old holds the wrong value\n"
                      "- kind: spec | test: none | where: specs/m.spec.md:1 | C1 and C2 cannot both hold\n")
    box.shadow(slice_, "O-high", {"tests/o_high_a.toy": _toy(_T_DEF, "BROKEN"),
                                  "tests/o_high_b.toy": _toy(_T_SPD, t_mp)})
    box.shadow(slice_, "S-med-r", {"tests/s_med_r.toy": _toy(_T_ATK, _T_DEF),
                                   "tests/s_med_r_gh.toy": _toy("ghost t_gh")})
    box.transcript("Write the red tests for %s in %s." % (slice_, wt), "sonnet", "medium")
    box.run("collect", slice_)
    ctx = box.ctx()
    target = "game/rules.txt" if rust else "client/ui.txt"
    rules = lambda **kv: "".join("%s=%s\n" % p for p in kv.items())
    hook = hook or (lambda name, sha: record_snap(ctx, slice_, name, sha))
    box.commit(wt, "red", {"tests/primary.toy": _toy(_T_ATK)})
    hook("g1", box.commit(wt, "green", {target: rules(hp=10, old="bug", mp=4, atk=5, **{"def": 2}, spd=6),
                                        "game/main.rs" if rust else "docs/main.md": "use helper;\nfn main() {}\n"}))
    hook("g2", box.commit(wt, "lens fix", {target: rules(hp=10, old="bug", mp=4, atk=5, **{"def": 3}, spd=6)}))
    hook("m", box.commit(wt, "last fix", {target: rules(hp=10, old="fixed", mp=4, atk=5, **{"def": 3}, spd=7)}))
    git(box.game, "merge", "-q", "--ff-only", "slice/" + slice_)
    box.commit(box.game, "later work", {target: rules(hp=11, old="fixed", mp=5, atk=5, **{"def": 3}, spd=7)})
    time.sleep(1.1)          # the spec change is after m to the second
    spec = [c["claim_id"] for c in box.rows("claim", slice_) if c["type"] == "spec"]
    box.commit(box.harness, "spec: C8 reworded\n\nAB-Claim: %s" % spec[0], {"specs/m.spec.md": "C1 C2 C3 C8 mp\n"})
    return wt


