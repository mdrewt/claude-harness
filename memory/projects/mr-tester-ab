            "score": cmd_score, "status": cmd_status, "judge-pack": cmd_judge_pack,
            "judge-apply": cmd_judge_apply, "fix-cost": cmd_fix_cost, "report": cmd_report,
            "mark": cmd_mark, "escapes": cmd_escapes, "finalize": cmd_finalize, "close-check": cmd_close_check}


def main(argv, mem=HERE):
    """Every path returns 0: the experiment never fails the slice it rides on."""
    try:
        ctx = Ctx(mem)
    except Exception as exc:
        print("AB-SKIP config: %s" % str(exc)[:200])
        return 0
    if ctx.cfg.get("enabled") is not True:
        print("AB-SKIP disabled")
        return 0
    command = COMMANDS.get(argv[0] if argv else "")
    if not command:
        print("AB-SKIP usage: mr-tester-ab %s ..." % " | ".join(sorted(COMMANDS)))
        return 0
    try:
        command(ctx, argv[1:])
    except Skip as skip:
        print("AB-SKIP %s" % skip)
    except Exception as exc:
        print("AB-SKIP error in %s: %s: %s" % (argv[0], type(exc).__name__, str(exc)[:300]))
    return 0


