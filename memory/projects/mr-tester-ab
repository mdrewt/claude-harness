class Ctx:
    def __init__(self, mem):
        self.mem = mem
        with open(os.path.join(mem, "mr-tester-ab.config.json")) as fh:
            self.cfg = json.load(fh)
        if not isinstance(self.cfg, dict):
            raise ValueError("config is not an object")
        self.ledger = os.path.join(mem, "mr-tester-ab.jsonl")
        self.side = os.path.join(mem, "tester-ab")
        self.game = self.cfg.get("game_repo", "")
        self.cache = os.path.expanduser(self.cfg.get("cache_root", "~/.cache/mr-tester-ab"))
        self.transcripts = os.path.expanduser(self.cfg.get("transcripts_root", "~/.claude/projects"))
        self.scratch = os.path.join(self.cache, "scratch")

    def side_of(self, slice_):
        return os.path.join(self.side, slice_)

    def manifest_path(self, slice_):
        return os.path.join(self.side_of(slice_), "manifest.json")

    def manifest(self, slice_):
        try:
            with open(self.manifest_path(slice_)) as fh:
                return json.load(fh)
        except (OSError, ValueError):
            return None

    def arm(self, name):
        return next((a for a in self.cfg.get("arms", []) if a.get("arm") == name), None)


# --------------------------------------------------------------------------- small helpers
def now():
    return datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def epoch(stamp):
    try:
        return datetime.datetime.fromisoformat(str(stamp).replace("Z", "+00:00")).timestamp()
    except ValueError:
        return None


def sha256(text):
    return hashlib.sha256(text.encode("utf-8", "replace")).hexdigest()


def check_slice(slice_):
    if not slice_ or not SLICE_RE.fullmatch(slice_):
        raise Skip("bad-slice-id")
    return slice_


def options(args, valued=(), flags=()):
    """(positionals, {option: value}). An unknown option is a usage error."""
    pos, opt = [], {}
    i = 0
    while i < len(args):
        a = args[i]
        if a in valued and i + 1 < len(args):
            opt[a[2:]] = args[i + 1]
            i += 2
        elif a in flags:
            opt[a[2:]] = True
            i += 1
        elif a.startswith("--"):
            raise Skip("usage: unknown or incomplete option %s" % a)
        else:
            pos.append(a)
            i += 1
    return pos, opt


def write_json(path, obj):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = "%s.tmp.%d" % (path, os.getpid())
    with open(tmp, "w") as fh:
        json.dump(obj, fh, indent=1, sort_keys=True)
        fh.write("\n")
    os.replace(tmp, path)


def append(ctx, rows):
    """Append rows to the ledger: one write per call, under an exclusive flock, so two writers
    never interleave inside a line."""
    stamp = now()
    text = "".join(json.dumps(dict({"v": 1, "ts": stamp}, **row), sort_keys=True) + "\n"
                   for row in rows)
    if not text:
        return
    fd = os.open(ctx.ledger, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o644)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        os.write(fd, text.encode())
    finally:
        os.close(fd)


def read(ctx):
    rows = []
    try:
        with open(ctx.ledger, errors="replace") as fh:
            for line in fh:
                try:
                    row = json.loads(line)
                except ValueError:
                    continue
                if isinstance(row, dict) and row.get("kind"):
                    rows.append(row)
    except OSError:
        pass
    return rows


def of(rows, kind, slice_=None):
    return [r for r in rows if r.get("kind") == kind and (slice_ is None or r.get("slice") == slice_)]


def latest(rows, key):
    """The last row per key(row), in first-seen order."""
    out = {}
    for row in rows:
        out[key(row)] = row
    return list(out.values())


def git(repo, *args, env=None, cwd=None, data=None, check=True):
    """Run git and return its stdout. Repo-redirecting variables of the caller never apply."""
    clean = {k: v for k, v in os.environ.items() if k not in _GIT_SCRUB}
    clean.update(env or {})
    argv = ["git"] + (["-C", repo] if repo else []) + list(args)
    done = subprocess.run(argv, env=clean, cwd=cwd, input=data, capture_output=True, timeout=600)
    if check and done.returncode != 0:
        raise RuntimeError("git %s: %s" % (" ".join(args[:2]), done.stderr.decode(errors="replace").strip()[:200]))
    return done.stdout.decode(errors="replace")


def common_dir(repo):
    path = git(repo, "rev-parse", "--git-common-dir").strip()
    return os.path.normpath(os.path.join(repo, path))


def snapshot(repo, tree, parent, message, exclude=()):
    """A commit holding everything under `tree` that git would track (ignore rules apply), with
    `parent` as its parent; `parent` itself when the two trees are equal."""
    gitdir = common_dir(repo)
    fd, index = tempfile.mkstemp(prefix="mr-tester-ab-index-")
    os.close(fd)
    os.unlink(index)
    env = {"GIT_INDEX_FILE": index}
    base = ["--git-dir", gitdir, "--work-tree", tree]
    try:
        git(None, *base, "read-tree", parent, env=env, cwd=tree)
        git(None, *base, "add", "-A", ".", env=env, cwd=tree)
        if exclude:
            git(None, *base, "rm", "--cached", "-q", "--ignore-unmatch", "--", *exclude, env=env, cwd=tree)
        new_tree = git(None, *base, "write-tree", env=env, cwd=tree).strip()
        if new_tree == git(repo, "rev-parse", parent + "^{tree}").strip():
            return git(repo, "rev-parse", parent).strip()
        return git(repo, *_GIT_ID, "commit-tree", new_tree, "-p", parent, "-m", message).strip()
    finally:
        with contextlib.suppress(OSError):
            os.unlink(index)


def set_ref(repo, slice_, name, sha):
