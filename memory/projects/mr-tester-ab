def _st_unloadable(chk, tmp):
    """A test file the runner could not collect is `no-compile`, a false positive of its arm, as
    a Rust file that does not build; it is `not-run` only where the setup step that builds what
    it imports failed."""
    def play(name, steps):
        box = _Box(os.path.join(tmp, "uncollected-" + name), prices=_PRICES, mutants={"enabled": False})
        box.cfg["runners"][0].update(setup=steps, unresolved="Failed to resolve import|Cannot find (module|package)")
        box.write_cfg()
        wt = box.worktree("np-a")
        box.run("plan", "np-a", "--prompt", box.prompt("np-a", wt))
        box.shadow("np-a", "S-med", {"tests/syn.toy": _toy(_T_ATK) + "UNCOLLECTED Transform failed: Unexpected end of file\n"})
        box.shadow("np-a", "O-med", {"tests/imp.toy": _toy(_T_ATK) + "UNCOLLECTED Cannot find module './invented'\n",
                                     "tests/fine.toy": _toy(_T_DEF)})
        box.run("collect", "np-a")
        record_snap(box.ctx(), "np-a", "g1", box.commit(wt, "green", {"game/rules.txt": "hp=10\natk=5\ndef=3\n"}))
        record_snap(box.ctx(), "np-a", "m", box.commit(wt, "docs", {"docs/note.md": "later\n"}))
        box.run("score", "np-a")
        lab = {label: arm for arm, (label, _) in box.labels("np-a").items()}
        got = {(lab[r["label"]], r["test_id"].rsplit("/", 1)[1]): r["result"] for r in box.rows("exec", "np-a") if r["snap"] == "m"}
        return box, got, {lab[q["label"]]: q for q in box.rows("quality", "np-a")}

    box, got, q = play("plain", [])
    st = Stats(box.rows(), box.cfg)
    chk("uncollected/a-file-that-was-not-collected-is-no-compile", got == {
        ("S-med", "syn.toy::t_atk"): "no-compile", ("O-med", "imp.toy::t_atk"): "no-compile", ("O-med", "fine.toy::t_def"): "pass"}
        and q["S-med"]["no_compile_files"] == 1 and q["O-med"]["no_compile_files"] == 1 and q["O-med"]["not_run"] == 0, got)
