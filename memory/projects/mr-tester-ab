def run_cmd(argv, cwd, env, timeout):
    """(exit code, timed out, wall seconds, output tail). The command gets its own process group
    and the whole group is killed on a timeout, so a build tool's children do not outlive it."""
    start = time.time()
    try:
        proc = subprocess.Popen(argv, cwd=cwd, env=env, stdout=subprocess.PIPE,
                                stderr=subprocess.STDOUT, start_new_session=True)
    except OSError as exc:
        return 127, False, 0.0, str(exc)
    try:
        out, _ = proc.communicate(timeout=max(1, timeout))
        return proc.returncode, False, time.time() - start, out.decode(errors="replace")[-4000:]
    except subprocess.TimeoutExpired:
        with contextlib.suppress(OSError):
            os.killpg(proc.pid, signal.SIGKILL)
        proc.wait()
        return -9, True, time.time() - start, ""
    except BaseException:       # this process is being stopped: the group goes with it
        with contextlib.suppress(OSError):
            os.killpg(proc.pid, signal.SIGKILL)
        proc.wait()
        raise


def is_test(ctx, path):
    return any(re.search(p, path) for p in ctx.cfg.get("test_paths", []))


def is_game_code(ctx, path):
    return bool(re.search(ctx.cfg.get("game_code", "$^"), path)) and not is_test(ctx, path)


def _close(text, at, open_, rust):
    """The offset just past the bracket that closes the one opened at or after `at`, or None.
    String literals and comments are skipped; in Rust a `'` opens no string (it marks a
    lifetime)."""
    close = {"{": "}", "(": ")"}[open_]
    quotes = '"' if rust else "\"'`"
    depth, i, n = 0, at, len(text)
    while i < n:
        c = text[i]
        if c in quotes:
            j = i + 1
            while j < n and text[j] != c:
                j += 2 if text[j] == "\\" else 1
            i = j + 1
        elif text.startswith("//", i):
            j = text.find("\n", i)
            i = n if j < 0 else j
        elif text.startswith("/*", i):
            j = text.find("*/", i)
            i = n if j < 0 else j + 2
        else:
            if c == open_:
                depth += 1
            elif c == close and depth:
                depth -= 1
                if depth == 0:
                    return i + 1
            i += 1
    return None


def test_spans(ctx, path, text):
    """[(name, criterion tag, first line, line after the last)] of the tests a file declares.

    A test begins at the non-blank lines directly above its declaration (at most three: its tag
    and attributes) and ends where its body's bracket closes when the pattern names one
    (`body`: `{` is looked for after the match, `(` from its start), else at the next test.
    The tag is the nearest `criterion: <ID>` from the line that names the test back to three
    lines above the declaration, never reaching into the test before: a tag above `#[test]`
    and one between `#[test]` and `fn` are both found."""
    for pat in ctx.cfg.get("test_patterns", []):
        if not re.search(pat["match"], path):
            continue
        lines = text.split("\n")
        found = []
        for m in re.finditer(pat["test"], text, re.M):
            name = next((g for g in reversed(m.groups()) if g), None)
            if name:
                found.append((name, m, text.count("\n", 0, m.start()), text.count("\n", 0, m.end())))
        closes = []          # the line after each body's closing bracket, where the pattern names one
        for name, m, first, last in found:
            at = _close(text, m.start() if pat.get("body") == "(" else m.end(), pat["body"],
                        path.endswith(".rs")) if pat.get("body") else None
            closes.append(None if at is None else text.count("\n", 0, at) + 1)
        # The lines above a test belong to it only down to where the test before it ends.
        floors = [-1] + [max(found[i][3], (closes[i] or 0) - 1) for i in range(len(found) - 1)]
        tops = []
        for (_, _, first, _), floor in zip(found, floors):
            top = first
            while top - 1 > floor and first - top < 3 and lines[top - 1].strip():
                top -= 1
            tops.append(top)
        out = []
        for i, (name, m, first, last) in enumerate(found):
            tag = ""
            for line in reversed(lines[max(floors[i] + 1, first - 3):last + 1]):
                hit = CRITERION_RE.search(line)
                if hit:
                    tag = hit.group(1)
                    break
            end = tops[i + 1] if i + 1 < len(found) else len(lines)
            if closes[i] is not None:
                end = min(end, closes[i])
            out.append((name, tag, tops[i], max(end, last + 1)))
        return out
    return []


def tests_in(ctx, path, text):
    """[(name, criterion tag)] of the tests a file declares."""
    return [(name, tag) for name, tag, _, _ in test_spans(ctx, path, text)]


def _body(lines):
    """A test's lines without comments and whitespace: a tag added to an existing test, or a
    formatter's rewrap, is not a change to it."""
    return "".join("".join(l.split()) for l in lines if not re.match(r"\s*(//|/\*|\*|#(?![\[!]))", l))


def own_tests(ctx, ref, path, base=None):
    """[(name, criterion tag)] of the tests of `path` at `ref` that the arm wrote: those the
    base version of the file (the parent of the arm's commit) does not hold, or holds with
    another body. A test that was already in a file the arm edited is not the arm's: it is not
    run, counted, priced, charged as a false positive or a brittle break, or credited with a
    seeded defect."""
    base = base or ref + "^"
    cache = ctx.__dict__.setdefault("_own", {})
    key = (base, ref, path)
    if key not in cache:
        new = git(ctx.game, "show", "%s:%s" % (ref, path), check=False)
        old = git(ctx.game, "show", "%s:%s" % (base, path), check=False)
        before = {}
        for name, _, a, b in test_spans(ctx, path, old):
            before.setdefault(name, set()).add(_body(old.split("\n")[a:b]))
        cache[key] = [(name, tag) for name, tag, a, b in test_spans(ctx, path, new)
                      if _body(new.split("\n")[a:b]) not in before.get(name, ())]
    return cache[key]


# --------------------------------------------------------------------------- eligibility
def closed(rows):
    return bool(of(rows, "close"))


def ineligible(ctx, slice_):
    """None when the slice is in the experiment, else the reason."""
    cfg = ctx.cfg
    if slice_ in cfg.get("exclude_slices", []):
        return "excluded"
    if slice_ in cfg.get("required_slices", []) or any(slice_.startswith(p) for p in cfg.get("prefixes", [])):
        return None
    return "ineligible"


def spent(rows):
    """What the cap counts: the arm, judge and port runs."""
    return sum(r.get("cost_usd") or 0.0 for r in of(rows, "run")
               if r.get("role") in SHADOW_ROLES + ("judge", "port"))


def committed(ctx, rows):
    """What the cap is held against: the spend, plus a reserve by model for every planned arm
    whose run has no price. A slice planned and not collected, a shadow that failed and a run
    whose transcript could not be priced all hold their reserve, so neither fan-out nor a
    pricing fault spends past the cap unseen."""
    reserve = ctx.cfg.get("reserve_usd", {})
    total = spent(rows)
    for row in of(rows, "assignment"):
        if row.get("skipped"):
            continue
        priced = {r.get("arm") for r in of(rows, "run", row["slice"]) if r.get("cost_usd") is not None}
        total += sum(reserve.get((ctx.arm(arm) or {}).get("model"), 0)
                     for arm in row.get("arms_planned", []) if arm not in priced)
    return total


def cmd_eligible(ctx, args):
    pos, _ = options(args)
    slice_ = check_slice(pos[0] if pos else "")
    why = ineligible(ctx, slice_)
    if why is None and len(pos) > 1 and pos[1] != "project":
        why = "not-a-game-slice"
    if why is None and closed(read(ctx)):
        why = "closed"
    print("no %s" % why if why else "yes %d" % int(ctx.cfg.get("cap_bump_usd", 0)))


# --------------------------------------------------------------------------- plan
def assign(slice_, arms):
    """{label: arm}: a fixed permutation per slice, so labels say nothing about the arm and a
    second plan of the slice cannot differ."""
    order = sorted(arms, key=lambda a: sha256("tester-ab-v1:%s:%s" % (slice_, a["arm"])))
    return {"a%d" % (i + 1): arm for i, arm in enumerate(order)}


def export_tree(repo, sha, dest, paths=()):
    """Unpack the commit's tree, or only `paths` of it, as plain files under `dest`."""
    os.makedirs(dest)
    archive = subprocess.Popen(["git", "-C", repo, "archive", "--format=tar", sha, "--", *paths],
                               stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                               env={k: v for k, v in os.environ.items() if k not in _GIT_SCRUB})
    untar = subprocess.run(["tar", "-x", "-C", dest], stdin=archive.stdout, capture_output=True)
    archive.stdout.close()
    if archive.wait() != 0 or untar.returncode != 0:
        raise RuntimeError("export of %s failed" % sha[:12])


def shadow_call(slice_, label, entry):
    """The Agent call of one shadow. Its type is `tester` and no other: the tester guards act on
    that type, and that agent has no shell."""
    return ('Agent(subagent_type="tester", model="%s", effort="%s", description="tester %s %s", '
            'prompt="Your task is in %s/%s. Read it fully and follow it exactly.")'
            % (entry["model"], entry["effort"], label, slice_, entry["export"], PROMPT_FILE))


def export_touched(ctx, manifest, entry):
    """Whether a shadow has worked in its export: the directory is gone, holds the shadow's
    output file, or differs from the base tree."""
    root = entry["export"]
    if not os.path.isdir(root) or os.path.exists(os.path.join(root, REPORT_FILE)):
        return True
    return snapshot(ctx.game, root, manifest["base"], "tester-ab probe", exclude=(REPORT_FILE, PROMPT_FILE)) != manifest["base"]


# One entry of an acceptance ledger, capturing its id: `- [ ] ID: ...` or `- [x] **ID:** ...`.
GATE_ENTRY = r"^- \[.\] \*{0,2}([A-Za-z0-9][\w.\-]*):\*{0,2}"


def kept_gates(ctx, slice_):
    """The slice's acceptance ledger: the copy `plan` kept, else the live file, else the
    archived one (mr-record moves a gates file to gates/archive 30 days after the merge, and
    the judge is packed later than that)."""
    for path in (os.path.join(ctx.side_of(slice_), "gates.md"),
                 os.path.join(ctx.mem, "gates", "%s.gates.md" % slice_),
                 os.path.join(ctx.mem, "gates", "archive", "%s.gates.md" % slice_)):
        with contextlib.suppress(OSError):
            with open(path, errors="replace") as fh:
                return fh.read()
    return ""


def cmd_plan(ctx, args):
    pos, opt = options(args, valued=("--prompt", "--worktree", "--tier", "--milestone"))
    slice_ = check_slice(pos[0] if pos else "")
    rows = read(ctx)
    if closed(rows):
        raise Skip("closed")
    why = ineligible(ctx, slice_)
    if why:
        raise Skip(why)
    if os.environ.get("CLAUDE_CODE_SUBAGENT_MODEL"):
        raise Skip("CLAUDE_CODE_SUBAGENT_MODEL is set: every subagent would run on one model")
    side = ctx.side_of(slice_)
    skipped = [r for r in of(rows, "assignment", slice_) if r.get("skipped")]
    if skipped:
        raise Skip(skipped[-1]["skipped"])
    worktree = os.path.abspath(opt.get("worktree") or os.path.join(
        ctx.game, ctx.cfg.get("worktree_root", ".claude/worktrees"), slice_))
    manifest = ctx.manifest(slice_)
    if manifest:
        # Shadows never rerun. Calls are printed again only while nothing can have changed (not
        # collected, the worktree still at the commit the base was taken from), and only for the
        # shadows that have not started: a second run in an export that holds a first run's
        # tests would mix two runs into one arm's suite.
        head = git(worktree, "rev-parse", "HEAD", check=False).strip()
        if manifest.get("collected") or head != manifest.get("head_at_plan"):
            raise Skip("already-planned: run `collect %s` if you have not; issue no shadow call" % slice_)
        ran = find_runs(ctx, manifest)[0]
        started = sorted(l for l, e in manifest["labels"].items() if l in ran or export_touched(ctx, manifest, e))
        if not started:
            with open(os.path.join(side, "plan.out")) as fh:
                sys.stdout.write(fh.read())
            return
        calls = [shadow_call(slice_, l, e) for l, e in sorted(manifest["labels"].items()) if l not in started]
        collect = "%s/mr-tester-ab collect %s" % (ctx.mem, slice_)
        if not calls:
            print("AB-PLAN %s: every shadow has already started or finished; issue no shadow call. When all have "
                  "returned run: %s" % (slice_, collect))
            return
        print("AB-PLAN %s: %d shadow(s) have already started or finished and are kept as they are. Issue only these "
              "%d Agent call(s) in ONE foreground message, with your own tester call if it has not returned:"
              % (slice_, len(started), len(calls)))
        for i, call in enumerate(calls):
            print("%d. %s" % (i + 1, call))
        print("When all have returned run: %s" % collect)
        return
    total = committed(ctx, rows)
    if total >= ctx.cfg.get("cap_arm_usd", 0):
        raise Skip("cap")
    if not opt.get("prompt"):
        raise Skip("usage: plan <slice> --prompt <file>")
    with open(opt["prompt"]) as fh:
        prompt = fh.read()
    need = []
    if not re.search(r"^## Contracts\b", prompt, re.M):
        need.append("a `## Contracts` section with the signatures the tests will call and each test "
                    "file's path (for Rust, its module name)")
    if worktree not in prompt:
        need.append("the worktree path %s" % worktree)
    if need:
        asked = os.path.join(side, "asked")
        if os.path.exists(asked):
            append(ctx, [{"kind": "assignment", "slice": slice_, "skipped": "prompt-incomplete"}])
            raise Skip("prompt-incomplete")
        os.makedirs(side, exist_ok=True)
        open(asked, "w").close()
        print("AB-NEED %s: the tester prompt lacks %s. Add it and run plan again; a second "
              "incomplete prompt skips the experiment for this slice." % (slice_, " and ".join(need)))
        return
    arms = [a for a in ctx.cfg["arms"]]
    if total >= ctx.cfg.get("step_down_usd", float("inf")):
        arms = [a for a in arms if a["arm"] in ctx.cfg.get("step_down_arms", [])]
    if not arms:
        raise Skip("no-arms")
    head = git(worktree, "rev-parse", "HEAD").strip()
    base = snapshot(worktree, worktree, head, "tester-ab %s base" % slice_)
    set_ref(worktree, slice_, "base", base)
    labels = {}
    calls = []
    for label, arm in assign(slice_, arms).items():
        root = os.path.join(ctx.cache, slice_, os.urandom(8).hex())
        export_tree(worktree, base, root)
        with open(os.path.join(root, PROMPT_FILE), "w") as fh:
            fh.write(prompt.replace(worktree, root) + FOOTER.format(root=root, report=REPORT_FILE))
        labels[label] = {"arm": arm["arm"], "model": arm["model"], "effort": arm["effort"],
                         "role": arm.get("role", "shadow"), "export": root}
        calls.append(shadow_call(slice_, label, labels[label]))
    try:
        with open(os.path.join(ctx.game, ".claude", "agents", "tester.md"), "rb") as fh:
            tester_md = hashlib.sha256(fh.read()).hexdigest()
    except OSError:
        tester_md = None
    out = ["AB-PLAN %s: issue these %d Agent calls in ONE foreground message, in this order, before "
           "any test file exists." % (slice_, len(calls) + 1),
           "1. your own tester call, exactly as without the experiment: your prompt file unmodified, "
           "the model the QUALITY TIER line names, no effort parameter. It writes the gating tests."]
    out += ["%d. %s" % (i + 2, call) for i, call in enumerate(calls)]
    out += ["Calls 2-%d are shadows: their tests never enter the repo. Each ends with the single "
            "word `done`; do not read their exports or reports." % (len(calls) + 1),
            "When all have returned run: %s/mr-tester-ab collect %s" % (ctx.mem, slice_)]
    text = "\n".join(out) + "\n"
    os.makedirs(side, exist_ok=True)
    with open(os.path.join(side, "plan.out"), "w") as fh:
        fh.write(text)
    with open(os.path.join(side, PROMPT_FILE), "w") as fh:      # the judge is shown its criteria
        fh.write(prompt)
    gates = kept_gates(ctx, slice_)     # kept beside the prompt: the live file is archived later
    if gates:
        with open(os.path.join(side, "gates.md"), "w") as fh:
            fh.write(gates)
    write_json(ctx.manifest_path(slice_), {
        "slice": slice_, "milestone": opt.get("milestone"), "tier": opt.get("tier"),
        "worktree": worktree, "head_at_plan": head, "base": base, "labels": labels,
        "prompt_sha256": sha256(prompt), "tester_md_sha": tester_md, "planned": now(),
        "collected": False})
    append(ctx, [{"kind": "assignment", "slice": slice_, "milestone": opt.get("milestone"),
                  "tier": opt.get("tier"), "labels": {l: e["arm"] for l, e in labels.items()},
                  "prompt_sha256": sha256(prompt), "base_ref": base, "tester_md_sha": tester_md,
                  "arms_planned": [a["arm"] for a in arms], "skipped": None},
                 {"kind": "snap", "slice": slice_, "name": "base", "sha": base, "source": "tool"}])
    sys.stdout.write(text)


# --------------------------------------------------------------------------- collect
def scan_transcript(path):
    """What a run did, from its transcript: every string in its tool inputs, its last text, the
    number of Bash calls that errored."""
    strings, bash, last_text, blocked = [], set(), "", 0

    def walk(value):
        if isinstance(value, str):
            strings.append(value)
        elif isinstance(value, dict):
            for v in value.values():
                walk(v)
        elif isinstance(value, list):
            for v in value:
                walk(v)

    with open(path, errors="replace") as fh:
        for line in fh:
            try:
                event = json.loads(line)
            except ValueError:
                continue
            msg = event.get("message") if isinstance(event, dict) else None
            content = msg.get("content") if isinstance(msg, dict) else None
            if not isinstance(content, list):
                continue
            for block in content:
                if not isinstance(block, dict):
                    continue
                if event.get("type") == "assistant" and block.get("type") == "text":
                    last_text = block.get("text") or last_text
                elif event.get("type") == "assistant" and block.get("type") == "tool_use":
                    walk(block.get("input"))
                    if block.get("name") == "Bash":
                        bash.add(block.get("id"))
                elif block.get("type") == "tool_result" and block.get("is_error") \
                        and block.get("tool_use_id") in bash:
                    blocked += 1
    return strings, last_text, blocked


def find_runs(ctx, manifest):
    """({label: [transcript path, oldest first]}, {session id}) of the shadows: a shadow's
    transcripts are those whose first message names its export. There is one, unless a shadow
    call was issued again."""
    since = (epoch(manifest["planned"]) or 0) - 120
    found, sessions = {}, set()
    for path in glob.glob(os.path.join(glob.escape(ctx.transcripts), "*", "*", "subagents", "agent-*.jsonl")):
        try:
            if os.path.getmtime(path) < since:
                continue
            with open(path, errors="replace") as fh:
                head = fh.readline(400000)
        except OSError:
            continue
        for label, entry in manifest["labels"].items():
            if entry["export"] in head:
                found.setdefault(label, []).append(path)
                sessions.add(os.path.basename(os.path.dirname(os.path.dirname(path))))
    for paths in found.values():
        paths.sort(key=lambda p: (os.path.getmtime(p), p))
    return found, sessions


def by_role(ctx, session):
    """{agent id: mr-cost-sum's row} for a session's subagents."""
    env = dict(os.environ, MR_COST_TRANSCRIPTS=ctx.transcripts)
    done = subprocess.run([os.path.join(ctx.mem, "mr-cost-sum"), "--by-role", session],
                          capture_output=True, text=True, timeout=120, env=env)
    return {r["agent_id"]: r for r in json.loads(done.stdout).get("subagents", [])}


def agent_id(path):
    return os.path.basename(path)[len("agent-"):-len(".jsonl")]


def parse_findings(report):
    """[(type, test, where, sentence)] from the last FINDINGS block of a report, at most three."""
    at = [i for i, line in enumerate(report.split("\n")) if line.strip() == "FINDINGS"]
    if not at:
        return []
    out = []
    for line in report.split("\n")[at[-1] + 1:]:
        m = re.match(r"\s*-\s*kind:\s*(base|spec)\s*\|\s*test:\s*(.*?)\s*\|\s*where:\s*(.*?)\s*\|\s*(.+)", line)
        if m:
            test = m.group(2).strip("`")
            out.append((m.group(1), "" if test.lower() == "none" else test, m.group(3).strip("`"),
                        " ".join(m.group(4).split())))
    return out[:3]


def local_path(ctx, root, value):
    """`value` with the export's path, and the harness repo's, taken off the front of any path
    in it."""
    for prefix in (root, ctx.cfg.get("harness_repo") or ""):
        if prefix:
            value = value.replace(prefix.rstrip("/") + "/", "").replace(prefix.rstrip("/"), "")
    return value


def changed_files(repo, old, new):
    """[(status letter, path)] between two commits."""
    out = []
    for line in git(repo, "diff", "--name-status", "--no-renames", old, new).splitlines():
        status, _, path = line.partition("\t")
        if path:
            out.append((status[:1], path))
    return out


def cmd_collect(ctx, args):
    pos, _ = options(args)
    slice_ = check_slice(pos[0] if pos else "")
    manifest = ctx.manifest(slice_)
    if not manifest:
        raise Skip("no-manifest")
    if manifest.get("collected"):
        raise Skip("already-collected")
    side = ctx.side_of(slice_)
    transcripts, sessions = find_runs(ctx, manifest)
    priced = {}
    for session in sorted(sessions):
        with contextlib.suppress(Exception):
            priced.update(by_role(ctx, session))
    runs, claims, strays = [], [], set()
    for label in sorted(manifest["labels"]):
        entry = manifest["labels"][label]
        root, paths = entry["export"], transcripts.get(label, [])
        path = paths[0] if paths else None
        row = {"kind": "run", "slice": slice_, "label": label, "arm": entry["arm"],
               "role": entry["role"], "twin": False, "status": "ok", "leak": False}
        costs = [priced[agent_id(p)] for p in paths if agent_id(p) in priced]
        cost = costs[0] if len(costs) == len(paths) and costs else None
        report = ""
        with contextlib.suppress(OSError):
            with open(os.path.join(root, REPORT_FILE), errors="replace") as fh:
                report = fh.read()
        ref = None
        if os.path.isdir(root):
            ref = snapshot(ctx.game, root, manifest["base"], "tester-ab %s %s" % (slice_, label),
                           exclude=(REPORT_FILE, PROMPT_FILE))
        files = [p for s, p in changed_files(ctx.game, manifest["base"], ref) if s != "D"] if ref else []
        tests = [p for p in files if is_test(ctx, p)]
        if not path or not cost or not (files or report):
            row["status"] = "failed"
        else:
            strings, blocked, leak = [], 0, False
            for one in paths:
                said, last_text, errors = scan_transcript(one)
                strings += said
                blocked += errors
                leak = leak or last_text.strip().lower().rstrip(".") != "done"
            # Every session that worked in the export is paid for, whichever wrote the tests.
            row.update(session=os.path.basename(os.path.dirname(os.path.dirname(path))),
                       agent_id=cost["agent_id"], tool_use_id=cost["tool_use_id"],
                       model_observed=cost["model"], effort_observed=cost["effort"],
                       cli_version=cost["version"], started=cost["started"],
                       duration_s=cost["duration_s"], calls=cost["calls"], tokens=cost["tokens"],
                       cost_usd=round(sum(c["cost_usd"] or 0.0 for c in costs), 6), bash_blocked=blocked, leak=leak)
            if len(paths) > 1:
                row.update(status="rerun", sessions_in_export=len(paths))
            others = [s.replace(root, "") for s in strings]
            if any(ctx.cache in s or manifest["worktree"] in s for s in others):
                row["status"] = "contaminated"
                for s in others:
                    strays.update(re.findall(re.escape(manifest["worktree"]) + r"[^\s\"'`;|&<>()]*", s))
            elif row["status"] == "ok" and (entry["model"] not in (cost["model"] or "") or cost["effort"] != entry["effort"]):
                row["status"] = "arm-mismatch"
        if ref and tests:
            set_ref(ctx.game, slice_, label, ref)
            row["tests_ref"] = ref
            numstat = git(ctx.game, "diff", "--numstat", manifest["base"], ref, "--", *tests)
            row["test_loc"] = sum(int(l.split("\t")[0]) for l in numstat.splitlines() if l.split("\t")[0].isdigit())
            own = sum(len(own_tests(ctx, ref, p, manifest["base"])) for p in tests)
            row["tests"] = own
            row["tests_existing"] = sum(len(tests_in(ctx, p, git(ctx.game, "show", "%s:%s" % (ref, p))))
                                        for p in tests) - own
            # Test lines were written and the patterns find no test in them: nothing of this
            # run will be replayed, so it is said and recorded, not left to read as "found nothing".
            row["undetected"] = own == 0
        row["files"] = tests
        row["non_test_files"] = [p for p in files if not is_test(ctx, p)]
        if row["status"] == "ok" and not tests:
            # Nothing under the test paths: tests written inside a source file, or a report
            # alone. Nothing of this run can be replayed, and that is recorded, not left silent.
            row["gap"] = "no-test-file"
        if report:
            os.makedirs(side, exist_ok=True)
            with open(os.path.join(side, "%s.report.md" % label), "w") as fh:
                fh.write(report)
        if row["status"] == "ok":
            for kind, test, where, text in parse_findings(report):
                # Paths are kept relative to the tree: the export's own path would name the run.
                where, text = (local_path(ctx, root, v) for v in (where, text))
                claims.append({"kind": "claim", "slice": slice_, "label": label, "type": kind,
                               "claim_id": "c" + sha256("%s|%s|%s" % (slice_, label, text))[:8],
                               "test": test, "where": where, "text": text, "text_sha": sha256(text)})
        runs.append(row)
    # The primary is the first tester of the same sessions that is not a shadow. A scored arm on
    # the primary's model and effort is its twin: the implementation is built to pass a suite
    # like its own.
    paths = {agent_id(p): p for session in sessions for p in glob.glob(os.path.join(
        glob.escape(ctx.transcripts), "*", session, "subagents", "agent-*.jsonl"))}

    def is_shadow(agent):       # of this slice or any other: its first message names an export
        with open(paths[agent], errors="replace") as fh:
            return ctx.cache in fh.readline(400000)

    primary = next((r for r in sorted(priced.values(), key=lambda r: r["started"] or "")
                    if r["role"] == "tester" and r["agent_id"] in paths and not is_shadow(r["agent_id"])
                    and (epoch(r["started"]) or 0) >= (epoch(manifest["planned"]) or 0) - 120), None)
    if primary:
        # The primary is not scored; a primary that read a shadow's export is still recorded,
        # because the implementation is then built against tests it should never have seen.
        seen = scan_transcript(paths[primary["agent_id"]])[0]
        runs.append({"kind": "run", "slice": slice_, "label": "primary", "arm": "primary",
                     "role": "primary", "twin": False, "leak": False,
                     "status": "contaminated" if any(ctx.cache in s for s in seen) else "ok",
                     "agent_id": primary["agent_id"], "tool_use_id": primary["tool_use_id"],
                     "model_observed": primary["model"], "effort_observed": primary["effort"],
                     "cli_version": primary["version"], "started": primary["started"],
                     "duration_s": primary["duration_s"], "calls": primary["calls"],
                     "tokens": primary["tokens"], "cost_usd": primary["cost_usd"]})
        for row in runs:
            entry = manifest["labels"].get(row["label"])
            row["twin"] = bool(entry and entry["role"] == "shadow" and entry["model"] in (primary["model"] or "")
                               and entry["effort"] == primary["effort"])
    append(ctx, runs + claims)
    removed = 0
    for entry in manifest["labels"].values():
        root = entry["export"]
        # Only what the manifest registered, and only under this slice's cache directory.
        if os.path.dirname(root) == os.path.join(ctx.cache, slice_) and os.path.isdir(root):
            shutil.rmtree(root)
            removed += 1
    manifest["collected"] = True
    write_json(ctx.manifest_path(slice_), manifest)
    tally = {}
    for row in runs:
        if row["role"] in SHADOW_ROLES:
            tally[row["status"]] = tally.get(row["status"], 0) + 1
    print("AB-COLLECTED %s: %s; %d export(s) removed" % (
        slice_, ", ".join("%d %s" % (n, s) for s, n in sorted(tally.items())) or "no runs", removed))
    blind = sum(1 for r in runs if r.get("undetected"))
    if blind:
        print("AB-WARN %s: %d shadow run(s) wrote test lines in which no test of their own was detected. "
              "Nothing of such a run can be replayed; the run row records it (`undetected`)." % (slice_, blind))
    bare = sum(1 for r in runs if r.get("gap") == "no-test-file")
    if bare:
        print("AB-WARN %s: %d shadow run(s) wrote no file under the test paths (tests inside a source file, or a "
              "report alone). Nothing of such a run can be replayed; the run row records it (`gap`)." % (slice_, bare))
    again = sum(1 for r in runs if r.get("status") == "rerun")
    if again:
        print("AB-WARN %s: %d shadow(s) ran more than once in one export. Such a suite is a mix of two runs: "
              "it is priced in full and not scored (`rerun`)." % (slice_, again))
    if strays:
        # The run is not scored, but whatever it wrote there is still in the builder's tree.
        print("AB-CONTAMINATED %s: a shadow run named these paths in your worktree. Before you commit, "
              "delete any of them your own tester did not write:" % slice_)
        for path in sorted(strays)[:20]:
            print("  " + path)
    limit = int(ctx.cfg.get("claims_digest_limit", 8))
    ordered = sorted(claims, key=lambda c: c["claim_id"])
    for claim in ordered[:limit]:
        print("  claim %s [%s] %s — %s" % (claim["claim_id"], claim["type"], claim["where"], claim["text"]))
    if ordered:
        print("A claim is advisory. Act on one only through the normal route, with the trailer "
              "`AB-Claim: <id>` on the commit; a claim alone never justifies a park.")


# --------------------------------------------------------------------------- replay
def git_scratch(ctx, *args):
    return git(None, "--git-dir", common_dir(ctx.game), "--work-tree", ctx.scratch, *args,
               env={"GIT_INDEX_FILE": os.path.join(ctx.cache, "scratch.index")}, cwd=ctx.scratch)


def checkout(ctx, sha):
    """Make the scratch directory the tree of `sha`: tracked files as the commit has them, and
    nothing untracked that git does not ignore, so a test file a stopped replay left behind is
    never compiled into the next one. Ignored files (installed packages, build output) stay, so
    one directory serves every replay."""
    os.makedirs(ctx.scratch, exist_ok=True)
    git_scratch(ctx, "read-tree", "--reset", "-u", sha)
    git_scratch(ctx, "clean", "-fdq")


def overlay(ctx, ref, files, onto=None):
    """Write the arm's version of each file into the scratch directory. Returns the paths that
    were merged by force.

    With `onto` (a snapshot later than the slice's merge), a file the arm edited rather than
    created is not replaced whole: the file's other content has moved on since the arm saw it,
    and the arm's copy of that content would stop building for reasons the arm did not cause.
    The arm's change against its base is merged into the file as `onto` holds it. Where the two
    changed the same lines both sides' lines are kept (a forced merge): its path is returned,
    and a failure in such a file is no evidence about the arm's tests. That is the common case
    where the gating tester edited the same fixture as the arm: such a file shows that a test
    still passes, and cannot show that it broke."""
    show = lambda rev, path: subprocess.run(["git", "-C", ctx.game, "show", "%s:%s" % (rev, path)], capture_output=True)
    forced = set()
    for path in files:
        dest = os.path.join(ctx.scratch, path)
        os.makedirs(os.path.dirname(dest), exist_ok=True)
        blob = subprocess.run(["git", "-C", ctx.game, "show", "%s:%s" % (ref, path)],
                              capture_output=True, check=True).stdout
        base, theirs = (show(ref + "^", path), show(onto, path)) if onto else (None, None)
        if onto and base.returncode == 0 and theirs.returncode == 0 and theirs.stdout != base.stdout:
            with tempfile.TemporaryDirectory(prefix="mr-tester-ab-merge-") as tmp:
                names = []
                for name, data in (("theirs", theirs.stdout), ("base", base.stdout), ("arm", blob)):
                    names.append(os.path.join(tmp, name))
                    with open(names[-1], "wb") as fh:
                        fh.write(data)
                done = subprocess.run(["git", "merge-file", "-p", "-q"] + names, capture_output=True)
                if done.returncode > 0 and done.returncode < 128:      # that many conflicts
                    done = subprocess.run(["git", "merge-file", "-p", "-q", "--union"] + names, capture_output=True)
                    forced.add(path)
                if done.returncode == 0:
                    blob = done.stdout
                else:
                    forced.discard(path)        # not text: the arm's file as it is
        with open(dest, "wb") as fh:
            fh.write(blob)
    return forced


def clear_overlay(ctx, snap_sha, files):
    """Put every overlaid path back to what the snapshot holds there, or remove it."""
    for path in files:
        dest = os.path.join(ctx.scratch, path)
        blob = subprocess.run(["git", "-C", ctx.game, "show", "%s:%s" % (snap_sha, path)], capture_output=True)
        if blob.returncode == 0:
            with open(dest, "wb") as fh:
                fh.write(blob.stdout)
        else:
            with contextlib.suppress(OSError):
                os.unlink(dest)


def crate_of(ctx, path):
    """The cargo package a file belongs to: the `name` of the nearest Cargo.toml above it."""
    here = os.path.dirname(path)
    while True:
        try:
            with open(os.path.join(ctx.scratch, here, "Cargo.toml")) as fh:
                m = re.search(r'^\[package\][^\[]*?^name\s*=\s*"([^"]+)"', fh.read(), re.M | re.S)
            if m:
                return m.group(1)
        except OSError:
            pass
        if not here:
            return None
        here = os.path.dirname(here)


def read_junit(path):
    """[(classname, name, result, milliseconds, failure text)] of a junit file; [] when absent."""
    try:
        root = ET.parse(path).getroot()
    except (OSError, ET.ParseError):
        return []
    out = []
    for case in root.iter("testcase"):
        bad = next((c for c in case if c.tag in ("failure", "error")), None)
        skipped = any(c.tag == "skipped" for c in case)
        try:
            ms = int(float(case.get("time") or 0) * 1000)
        except ValueError:
            ms = 0
        text = ""
        if bad is not None:
            text = ((bad.get("message") or "") + "\n" + (bad.text or "")).strip()
            if not text:
                # A test the runner killed (a signal, its timeout) has no message: what the
                # report does hold is the failure's type and the test's captured output.
                said = "\n".join((c.text or "").strip() for c in case if c.tag in ("system-err", "system-out"))
                text = ("%s\n%s" % (bad.get("type") or "", said[-3000:])).strip() or \
                    "(the runner reported a failure and no output: the test was killed or timed out)"
            text = text[:4000]
        out.append((case.get("classname") or "", case.get("name") or "",
                    "fail" if bad is not None else "not-run" if skipped else "pass", ms, text))
    return out


class RunnerError(Exception):
    """A runner could not start, or its setup failed: nothing is known about the tests."""


def stem_of(path):
    """The name a runner reports a test file under: its base name without the extension, or its
    directory's name for a `mod` or `main` file."""
    stem = os.path.splitext(os.path.basename(path))[0]
    return os.path.basename(os.path.dirname(path)) if stem in ("mod", "main") else stem


def runner_named(ctx, name):
    return next((r for r in ctx.cfg.get("runners", []) if r.get("name") == name), {})


def fill(ctx, tokens, runner, files, names, values, code=None):
    """A command line from its config tokens. `{files}` and `{packages}` expand to several
    arguments (the packages of `code`, else of the test files); `{names}` to the test names as
    a regex alternation; `{scope}` to the runner's own expression for the tests of these files
    (its `scopes`: the first entry whose match fits a file, joined by ` | `), so a test of the
    same name elsewhere in the package is not run."""
    crates = sorted({c for c in (crate_of(ctx, f) for f in (code or files)) if c})
    scope = []
    for path in files:
        rule = next((r for r in runner.get("scopes", []) if re.search(r["match"], path)), None)
        if rule:
            scope.append(rule["expr"].replace("{stem}", stem_of(path)))
    values = dict(values, tool=ctx.mem, scope=" | ".join(sorted(set(scope))),
                  names="|".join(re.escape(n) for n in sorted(set(names))))
    argv = []
    for token in tokens:
        if token == "{files}":
            argv += values["files"]
        elif token == "{packages}":
            argv += [x for c in crates for x in ("-p", c)]
        else:
            for key, value in values.items():
                if isinstance(value, str):
                    token = token.replace("{%s}" % key, value)
            argv.append(token)
    return argv


def runner_env(ctx):
    """The environment of every replay and seeded-defect command: the shared cargo target
    directory, the config's `runner_env` (which bounds the cores a build and a test run take,
    because other slices are building on this machine), and the config's `runner_path`
    directories ahead of PATH, because the caller's PATH may hold another toolchain."""
    env = dict(os.environ, CARGO_TARGET_DIR=os.path.join(ctx.cache, "target"))
    env.update({k: str(v) for k, v in ctx.cfg.get("runner_env", {}).items()})
    dirs = [os.path.expanduser(d) for d in ctx.cfg.get("runner_path", [])]
    env["PATH"] = os.pathsep.join([d for d in dirs if os.path.isdir(d)] + [env.get("PATH", "")])
    return env


def setup_stamps(ctx):
    """{step: the stamp it last ran against}, from the cache."""
    try:
        with open(os.path.join(ctx.cache, "setup-stamps.json")) as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return {}


def setup_steps(ctx, runner, cwd, snap_sha):
    """[(step, key, stamp)] of the runner's setup steps that are due at this snapshot.

    A step is due when its `if_missing` path (relative to the runner's directory) is absent, or
    when the snapshot's `stamp` paths (relative to the tree: a lockfile, the sources of a built
    package) are not the ones the step last ran against. What a step leaves behind is ignored
    by git, so it survives from one snapshot to the next and would otherwise serve a tree it
    was not built from."""
    saved = setup_stamps(ctx)
    due = []
    for i, step in enumerate(runner.get("setup", [])):
        key = "%s/%d" % (runner.get("name"), i)
        stamp = None
        if step.get("stamp") and snap_sha:
            stamp = " ".join(git(ctx.game, "rev-parse", "--verify", "--quiet", "%s:%s" % (snap_sha, path),
                                 check=False).strip() or "-" for path in step["stamp"])
        missing = step.get("if_missing") and not os.path.exists(os.path.join(cwd, step["if_missing"]))
        if missing or (stamp is not None and saved.get(key) != stamp) or not (step.get("if_missing") or step.get("stamp")):
            due.append((step, key, stamp))
    return due


def run_runner(ctx, runner, files, names, budget, snap_sha=None):
    """Run one runner over `files` in the scratch directory.
    (junit cases, whether it built, whether it timed out, wall seconds).

    `budget` covers the probe, the setup and the test command together. A probe or setup step
    that fails, or a command that cannot be started (exit 127), raises RunnerError; a setup
    step marked `optional` that fails is noted in `ctx.setup_note` and the run goes on."""
    cwd = os.path.join(ctx.scratch, runner.get("cwd", ""))
    junit = os.path.join(ctx.cache, "junit.xml")
    # A runner that writes its report to a path of its own names it in `junit`, relative to the
    # scratch directory.
    out_junit = os.path.join(ctx.scratch, runner.get("junit", junit))
    with contextlib.suppress(OSError):
        os.unlink(out_junit)
    rel = [os.path.relpath(os.path.join(ctx.scratch, f), cwd) for f in files]
    argv = fill(ctx, runner["cmd"], runner, files, names, {"files": rel, "junit": junit})
    env = runner_env(ctx)
    start = time.time()
    notes = ctx.__dict__.setdefault("setup_note", {})
    notes.pop(runner.get("name"), None)

    def fail(step, rc, tail):
        return "%s: `%s` exit %s: %s" % (runner.get("name"), " ".join(step), rc, " ".join(tail.split())[-200:])

    if runner.get("probe"):
        rc, _, _, tail = run_cmd(runner["probe"], cwd, env, budget - (time.time() - start))
        if rc != 0:
            raise RunnerError(fail(runner["probe"], rc, tail))
    for step, key, stamp in setup_steps(ctx, runner, cwd, snap_sha):
        rc, _, _, tail = run_cmd(step["cmd"], cwd, env, budget - (time.time() - start))
        if rc != 0 and not step.get("optional"):
            raise RunnerError(fail(step["cmd"], rc, tail))
        if rc != 0:
            notes[runner.get("name")] = "setup step " + fail(step["cmd"], rc, tail)
        elif stamp is not None:
            write_json(os.path.join(ctx.cache, "setup-stamps.json"), dict(setup_stamps(ctx), **{key: stamp}))
    rc, timed_out, wall, tail = run_cmd(argv, cwd, env, min(budget - (time.time() - start), runner.get("timeout_s", 1200)))
    if rc == 127:
        raise RunnerError("%s: `%s` cannot start: %s" % (runner.get("name"), argv[0], " ".join(tail.split())[-200:]))
    cases = [] if timed_out else read_junit(out_junit)
    # `no_tests_rc` is the runner's exit code for a build that held none of the tests asked for.
    return cases, bool(cases) or rc in (0, runner.get("no_tests_rc")), timed_out, wall


def run_suite(ctx, snap_sha, ref, files, only=None, budget=3600, merge=False):
    """Replay the tests one arm wrote (`own_tests`) against the tree checked out in the scratch
    directory. {test id: (result, criterion tag, milliseconds, failure text or the reason a
    test did not run)}.

    A runner that exits non-zero without a report did not build: its files are then run one at
    a time, so one file that does not compile is charged alone. A test the report does not hold
    under its own file is `not-run`: the build never compiled it in (a Rust module no `mod` line
    names), whatever a test of the same name elsewhere did. A failure whose text matches the
    runner's `unresolved` pattern is `not-run` too: an import that does not resolve (a package
    the setup did not build) says nothing about the code under test: the setup step that
    should have built the package failed (`setup_note`). With every setup step done, an import
    that does not resolve is the test's own. A file the runner reports as failed while it
    reports none of the file's tests could not be collected (a syntax error, a static import of
    a module that does not exist): its tests are `no-compile`, as a Rust file that does not
    build. With `merge` the arm's files are merged into the snapshot's (`overlay`); in a file
    merged by force a test that passes has passed, and one that fails, or a file that does not
    build, is `not-run` for that reason: the forced lines may be what broke it."""
    results = {}
    forced = set()
    declared = {}
    for path in files:
        declared[path] = [(n, tag) for n, tag in own_tests(ctx, ref, path)
                          if only is None or "%s::%s" % (path, n) in only]
    start = time.time()

    def record(path, cases, compiled, timed_out, runner=None):
        mine = re.compile(r"(?<![\w-])%s(?![\w-])" % re.escape(stem_of(path)))
        unresolved = (runner or {}).get("unresolved")
        note = ctx.__dict__.get("setup_note", {}).get((runner or {}).get("name"))
        here = [c for c in cases if mine.search(c[0] + " " + c[1])]
        named = lambda c, name: c[1] == name or c[1].endswith("::" + name) or c[1].endswith(" > " + name)
        hits = {name: next((c for c in here if named(c, name)), None) for name, _ in declared[path]}
        # The report holds a failure under this file that is none of the file's tests (vitest
        # names it after the file) and holds none of the arm's tests: the file was not collected.
        uncollected = None
        if not any(hits.values()) and any(c[2] == "fail" for c in here):
            every = [n for n, _ in tests_in(ctx, path, git(ctx.game, "show", "%s:%s" % (ref, path), check=False))]
            uncollected = next((c for c in here if c[2] == "fail" and not any(named(c, n) for n in every)), None)
        if uncollected and unresolved and note and re.search(unresolved, uncollected[4]):
            for name, tag in declared[path]:
                results["%s::%s" % (path, name)] = (
                    "not-run", tag, 0, "unresolved import: " + " ".join(uncollected[4].split())[:160] + "; " + note)
            return
        if uncollected:
            compiled = False
        for name, tag in declared[path]:
            hit = hits[name]
            if hit and hit[2] == "fail" and unresolved and note and re.search(unresolved, hit[4]):
                why = "unresolved import: " + " ".join(hit[4].split())[:160] + "; " + note
                results["%s::%s" % (path, name)] = ("not-run", tag, hit[3], why)
            elif hit and hit[2] == "fail" and path in forced:
                results["%s::%s" % (path, name)] = ("not-run", tag, hit[3], STALE)
            elif hit:
                results["%s::%s" % (path, name)] = (hit[2], tag, hit[3], hit[4])
            elif timed_out:
                results["%s::%s" % (path, name)] = ("not-run", tag, 0, OUT_OF_TIME)
            elif compiled:
                results["%s::%s" % (path, name)] = (
                    "not-run", tag, 0, "the runner's report holds no such test under this file" if runner
                    else "no runner fits this file")
            elif path in forced:
                results["%s::%s" % (path, name)] = ("not-run", tag, 0, STALE)
            else:
                results["%s::%s" % (path, name)] = ("no-compile", tag, 0, "")

    todo = [p for p in files if declared[p]]
    for runner in ctx.cfg.get("runners", []):
        mine = [p for p in todo if re.search(runner["match"], p)
                and not (runner.get("exclude") and re.search(runner["exclude"], p))]
        todo = [p for p in todo if p not in mine]
        if not mine:
            continue
        groups = [mine]
        while groups:
            group = groups.pop(0)
            left = budget - (time.time() - start)
            if left <= 0:
                for path in group:
                    record(path, [], True, True, runner)
                continue
            forced.update(overlay(ctx, ref, group, snap_sha if merge else None))
            try:
                names = [n for p in group for n, _ in declared[p]]
                cases, compiled, timed_out, _ = run_runner(ctx, runner, group, names, left, snap_sha)
            finally:
                clear_overlay(ctx, snap_sha, group)
            if not compiled and not timed_out and len(group) > 1:
                groups += [[p] for p in group]
                continue
            for path in group:
                record(path, cases, compiled, timed_out, runner)
    for path in todo:        # no runner executes this kind of file
        record(path, [], True, False)
    return results


def snaps_of(rows, slice_):
    return {r["name"]: r["sha"] for r in of(rows, "snap", slice_)}


def ok_runs(rows, slice_):
    """The shadow runs whose tests are replayed."""
    return [r for r in of(rows, "run", slice_)
            if r.get("role") in SHADOW_ROLES and r.get("status") == "ok" and r.get("tests_ref")]


def gaps_of(rows, slice_=None):
    """{(slice, label): gap} of the shadow runs with status ok that measured nothing of their
    arm: `no-test-file` (nothing under the test paths), `no-test-detected` (test lines, no test
    found in them), `none-ran` (tests found, not one of them ran at the merged code). What the
    slice's scoring found (the quality row) stands over what `collect` saw. Such a run is
    listed in `status` and the report, and is in no table and no decision: it found nothing
    because nothing of it ran, which says nothing about its arm."""
    out = {}
    for r in of(rows, "run", slice_):
        if r.get("role") in SHADOW_ROLES and r.get("status") == "ok":
            gap = r.get("gap") or ("no-test-detected" if r.get("undetected") else None)
            if gap:
                out[(r["slice"], r["label"])] = gap
    for q in of(rows, "quality", slice_):
        out.pop((q["slice"], q["label"]), None)
        if q.get("gap"):
            out[(q["slice"], q["label"])] = q["gap"]
    return out


def execs(rows, slice_):
    """The results that count: those taken at the commit each snapshot now names."""
    snaps = snaps_of(rows, slice_)
    return [r for r in of(rows, "exec", slice_) if r.get("sha", snaps.get(r["snap"])) == snaps.get(r["snap"])]


def result_table(rows, slice_):
    """{(label, test id): {snap: [result of run 1, run 2, ...]}}"""
    table = {}
    for row in sorted(execs(rows, slice_), key=lambda r: r.get("run_n", 1)):
        table.setdefault((row["label"], row["test_id"]), {}).setdefault(row["snap"], []).append(row["result"])
    return table


def settled(results):
    """One result for a snapshot: the shared result of its runs, `flaky` when they disagree."""
    if not results:
        return None
    return results[0] if len(set(results)) == 1 else "flaky"


def game_diff(ctx, old, new):
    return any(is_game_code(ctx, p) for _, p in changed_files(ctx.game, old, new))


def replay(ctx, slice_, rows, only_snaps=None, budget=None):
    """Run every (arm, snapshot, run) the ledger has no result for. Returns False when the
    budget ran out first.

    Under a budget (the in-session `escapes`), a run the clock stopped writes no row at all, and
    neither does one the budget never reached: a result of `not-run` there would stand for good,
    and the arm would be charged a miss for a defect its test catches. `score` runs it at merge.
    At `end` an arm's edit to a file that already existed is merged into the file as the default
    branch has it (`overlay`)."""
    snaps = snaps_of(rows, slice_)
    done = {(r["label"], r["snap"], r.get("run_n", 1)) for r in execs(rows, slice_)}
    claimed = {}
    for claim in of(rows, "claim", slice_):
        if claim.get("type") == "base" and claim.get("test"):
            claimed.setdefault(claim["label"], set()).add(claim["test"])
    start = time.time()
    complete = True
    for snap in ("base", "g1", "g2", "m", "end"):
        if snap not in snaps or (only_snaps and snap not in only_snaps):
            continue
        fresh = True
        for run in ok_runs(rows, slice_):
            label, ref, files = run["label"], run["tests_ref"], run.get("files", [])
            only = None
            if snap == "base":       # every red-phase test fails here; only a claimed one is evidence
                names = claimed.get(label)
                if not names:
                    continue
                only = {"%s::%s" % (p, n) for p in files
                        for n, _ in tests_in(ctx, p, git(ctx.game, "show", "%s:%s" % (ref, p))) if n in names}
            for run_n in ((1, 2) if snap == "m" else (1,)):
                if (label, snap, run_n) in done:
                    continue
                left = None if budget is None else budget - (time.time() - start)
                if left is not None and left <= 0:
                    complete = False
                    continue
                if fresh:
                    checkout(ctx, snaps[snap])
                    fresh = False
                results = run_suite(ctx, snaps[snap], ref, files, only, left if left is not None else 3600,
                                    merge=snap == "end")
                if left is not None and any(r[0] == "not-run" and r[3] == OUT_OF_TIME for r in results.values()):
                    complete = False
                    continue
                append(ctx, [dict({"kind": "exec", "slice": slice_, "label": label, "snap": snap,
                                   "sha": snaps[snap], "test_id": test, "criterion_tag": tag, "result": result,
                                   "runtime_ms": ms, "run_n": run_n, "ported": False},
                                  **({"reason": why[:300]} if result == "not-run" else {}))
                             for test, (result, tag, ms, why) in sorted(results.items())])
                fails = {t: r[3] for t, r in results.items() if r[0] == "fail"}
                if fails:
                    write_json(os.path.join(ctx.side_of(slice_), "fail", "%s.%s.%d.json" % (label, snap, run_n)), fails)
    return complete


def imports(text, stem):
    """Whether a source text names `stem` in an import, use or mod line."""
    return any(re.search(r"\b%s\b" % re.escape(stem), line)
               for line in text.split("\n")
               if re.match(r"\s*(pub(\([a-z]+\))?\s+)?(use|mod|import|export)\b|.*\brequire\(", line))


def claim_scope(ctx, slice_, snaps, where):
    """`in` when the file a base claim names is one the slice's diff touches or one a touched
    file imports; else `out`."""
    path = where.rsplit(":", 1)[0] if re.search(r":\d+$", where) else where
    if "m" not in snaps:
        return "out"
    touched = [p for _, p in changed_files(ctx.game, snaps["base"], snaps["m"])]
    if path in touched:
        return "in"
    stem = os.path.splitext(os.path.basename(path))[0]
    if stem in ("mod", "lib", "index", "main"):
        stem = os.path.basename(os.path.dirname(path))
    for other in touched:
        text = git(ctx.game, "show", "%s:%s" % (snaps["m"], other), check=False)
        if stem and imports(text, stem):
            return "in"
    return "out"


def claim_commits(ctx, rows, slice_, snaps):
    """{claim id: sha} of commits whose `AB-Claim:` trailer names a claim and which change a file
    that counts: non-test game code in the game repo; the spec corpus, a gates file or
    DECISIONS.md in the harness repo."""
    out = {}
    assigned = of(rows, "assignment", slice_)
    since = assigned[0]["ts"] if assigned else "1970-01-01T00:00:00Z"
    last = snaps.get("end") or snaps.get("m")
    sources = []
    if last:
        sources.append((ctx.game, ["%s..%s" % (snaps["base"], last)], lambda p: is_game_code(ctx, p)))
    harness = ctx.cfg.get("harness_repo")
    if harness and os.path.isdir(harness):
        counts = ctx.cfg.get("spec_paths", r"^(specs/|memory/projects/gates/|docs/DECISIONS\.md$)")
        sources.append((harness, ["--since=" + since, "HEAD"], lambda p: bool(re.search(counts, p))))
    for repo, span, counted in sources:
        log = git(repo, "log", "--format=%H%x00%B%x01", *span, check=False)
        for entry in log.split("\x01"):
            sha, _, body = entry.strip().partition("\x00")
            for claim in re.findall(r"^AB-Claim:\s*(\S+)", body, re.M):
                files = git(repo, "show", "--name-only", "--format=", sha, check=False).split()
                if any(counted(p) for p in files):
                    out.setdefault(claim, sha)
    return out


def derive(ctx, slice_, rows):
    """The candidates the recorded results support, as ledger rows (without those unchanged).

      lens-caught  fails at g1, passes at g2 (at m when no g2 was recorded), game code changed
      escape       fails at g2, passes at m or at end, game code changed between
      base         a claimed test that fails at base and passes at m or at end, where game-code
                   lines that existed at base changed
      spec         a spec claim that a counted commit names in an `AB-Claim:` trailer
      open-fail    still failing at m (both runs)
    """
    snaps = snaps_of(rows, slice_)
    table = result_table(rows, slice_)
    claims = of(rows, "claim", slice_)
    handed = {(r["label"], r["test_id"]) for r in of(rows, "handoff", slice_)}
    found = []

    def add(kind, label, key, snap_fail, snap_pass, scope="in"):
        diff = bool(snap_fail and snap_pass and game_diff(ctx, snaps[snap_fail], snaps[snap_pass]))
        found.append({"kind": "candidate", "slice": slice_, "type": kind, "label": label,
                      "candidate_id": candidate_id(slice_, label, key),
                      ("claim_id" if kind == "spec" else "test_id"): key,
                      "snap_fail": snap_fail, "snap_pass": snap_pass, "game_diff": diff,
                      "scope": scope, "handed_in_session": (label, key) in handed})

    claimed = {}
    for claim in claims:
        if claim["type"] == "base" and claim.get("test"):
            claimed[(claim["label"], claim["test"])] = claim
    for (label, test), by_snap in sorted(table.items()):
        at = {snap: settled(by_snap.get(snap)) for snap in ("base", "g1", "g2", "m", "end")}
        if at["m"] == "flaky":       # its flips say nothing about the code
            continue
        fixed = "m" if at["m"] == "pass" else "end" if at["end"] == "pass" else None
        claim = claimed.get((label, test.rsplit("::", 1)[-1]))
        if claim and at["base"] == "fail" and fixed:
            numstat = git(ctx.game, "diff", "--numstat", "--no-renames", snaps["base"], snaps[fixed])
            existing = any(l.split("\t")[1] not in ("0", "-") and is_game_code(ctx, l.split("\t")[2])
                           for l in numstat.splitlines() if l.count("\t") == 2)
            if existing:
                add("base", label, test, "base", fixed, claim_scope(ctx, slice_, snaps, claim.get("where", "")))
                continue
        if at["g1"] == "fail" and at["g2"] == "pass":
            add("lens-caught", label, test, "g1", "g2")
        elif at["g1"] == "fail" and at["g2"] is None and at["m"] == "pass":
            add("lens-caught", label, test, "g1", "m")
        elif at["g2"] == "fail" and fixed:
            add("escape", label, test, "g2", fixed)
        elif at["m"] == "fail" and at["end"] == "pass":
            add("escape", label, test, "m", "end")
        elif at["m"] == "fail":
            add("open-fail", label, test, "m", None)
    # A flip with no game-code change between the two snapshots is not evidence of a defect.
    found = [c for c in found if c["type"] == "open-fail" or c["game_diff"]]
    commits = claim_commits(ctx, rows, slice_, snaps) if any(c["type"] == "spec" for c in claims) else {}
    for claim in claims:
        if claim["type"] == "spec" and claim["claim_id"] in commits:
            add("spec", claim["label"], claim["claim_id"], None, None)
            found[-1]["fix"] = commits[claim["claim_id"]]
    known = {(r["label"], r.get("test_id") or r.get("claim_id")): r for r in of(rows, "candidate", slice_)}
    fresh = []
    for cand in found:
        old = known.pop((cand["label"], cand.get("test_id") or cand.get("claim_id")), None)
        if not old or any(old.get(k) != v for k, v in cand.items()):
            fresh.append(cand)
    # What is left was derived from results that no longer count (m was recorded again).
    fresh += [dict({k: v for k, v in old.items() if k not in ("v", "ts")}, type="withdrawn")
              for old in known.values() if old["type"] != "withdrawn"]
    return fresh


def quality(ctx, slice_, rows):
    """One mechanical quality row per arm once its tests were replayed at m. An arm in whose
    test lines no test was detected gets its row too, with `gap` saying so: it found nothing
    because nothing of it could run, which must not read as a clean arm.

    brittle  one cause in one file is one break, because one repair mends it: the tests of a
             file that pass at m and fail at end count once per distinct failure (its first
             line, numbers aside), and a file that passes at m and no longer compiles at end
             counts once. A test whose criterion the spec added or changed since m is excused.
             `brittle_tests` is how many tests those breaks took down. At end an arm's edit to
             a file that existed before it is merged into the file as the default branch has
             it; where that merge had to be forced and a test then fails or the file does not
             build, the file is counted in `stale_files` and is no break.
    gap      `no-test-detected`: test lines written, no test found in them;
             `none-ran`: tests found, and not one of them ran at m. Else null."""
    snaps = snaps_of(rows, slice_)
    table = result_table(rows, slice_)
    bloat = ctx.cfg.get("bloat", {})
    per_line = bloat.get("tokens_per_line", 0) * (
        bloat.get("fresh_reads", 0) * bloat.get("fresh_usd_per_mtok", 0)
        + bloat.get("cached_turns", 0) * bloat.get("cached_usd_per_mtok", 0)) / 1e6
    spec_diff = None
    out = []
    if "m" not in snaps:
        return out
    for run in ok_runs(rows, slice_):
        label = run["label"]
        mine = {t: s for (l, t), s in table.items() if l == label}
        own = [n for p in run.get("files", []) for n, _ in own_tests(ctx, run["tests_ref"], p)]
        if own and not any("m" in s for s in mine.values()):
            continue        # not replayed yet
        first = "g1" if "g1" in snaps else "m"
        broken = {t.rsplit("::", 1)[0] for t, s in mine.items() if "no-compile" in s.get(first, [])}
        tag_of = {r["test_id"]: r["criterion_tag"] for r in execs(rows, slice_) if r["label"] == label}
        said_at_end = {}
        with contextlib.suppress(OSError, ValueError):
            with open(os.path.join(ctx.side_of(slice_), "fail", "%s.end.1.json" % label)) as fh:
                said_at_end = json.load(fh)
        why_end = {r["test_id"]: r.get("reason") or "" for r in execs(rows, slice_)
                   if r["label"] == label and r["snap"] == "end"}
        # A file merged by force at end whose tests fail or do not build there: reported, never charged.
        unmerged = {t.rsplit("::", 1)[0] for t, s in mine.items()
                    if settled(s.get("m")) == "pass" and why_end.get(t) == STALE}
        causes, stale, broke = set(), set(), 0
        for test, by_snap in sorted(mine.items()):
            end = settled(by_snap.get("end"))
            if settled(by_snap.get("m")) == "pass" and end in ("fail", "no-compile"):
                tag = tag_of.get(test, "")
                if spec_diff is None:
                    spec_diff = spec_changes(ctx, rows, slice_)
                if tag and re.search(r"(?<![\w.-])%s(?![\w-])" % re.escape(tag), spec_diff):
                    continue
                broke += 1
                if end == "fail":
                    first_line = next((l for l in said_at_end.get(test, "").split("\n") if l.strip()), "")
                    causes.add((test.rsplit("::", 1)[0], re.sub(r"\d+", "#", " ".join(first_line.split()))[:120] or test))
                else:
                    stale.add(test.rsplit("::", 1)[0])
        asserts = {}
        for path in run.get("files", []):
            for line in git(ctx.game, "show", "%s:%s" % (run["tests_ref"], path), check=False).split("\n"):
                norm = " ".join(line.split())
                if re.search(r"\bassert|\bexpect\(", norm):
                    asserts[norm] = asserts.get(norm, 0) + 1
        criteria = criteria_count(ctx, slice_, rows)
        loc = run.get("test_loc", 0)
        ran = sum(1 for s in mine.values() if settled(s.get("m")) in ("pass", "fail", "flaky"))
        out.append({"kind": "quality", "slice": slice_, "label": label,
                    "no_compile_files": len(broken),
                    "flaky": sum(1 for s in mine.values() if settled(s.get("m")) == "flaky"),
                    "not_run": sum(1 for s in mine.values() if settled(s.get("m")) == "not-run"),
                    "brittle": len(causes) + len(stale), "brittle_files": len(stale), "brittle_tests": broke,
                    "stale_files": len(unmerged),
                    "test_loc": loc, "tests": len(own), "ran": ran,
                    "gap": "no-test-detected" if not own else "none-ran" if not ran else None,
                    "criteria": criteria, "loc_per_criterion": round(loc / max(1, criteria), 2),
                    "dup_assert_lines": sum(n - 1 for n in asserts.values()),
                    "runtime_ms": sum(r["runtime_ms"] for r in execs(rows, slice_)
                                      if r["label"] == label and r["snap"] == "m" and r.get("run_n", 1) == 1),
                    "bloat_usd": round(loc * per_line, 4)})
    known = {r["label"]: r for r in of(rows, "quality", slice_)}
    return [q for q in out if any(known.get(q["label"], {}).get(k) != v for k, v in q.items())]


def criteria_count(ctx, slice_, rows):
    """How many criteria the slice has: the entries of its acceptance ledger, else the distinct
    criterion tags its arms used between them. One number for the slice, so lines per criterion
    compares what the arms wrote and not how many tags each of them spread it over."""
    listed = set(re.findall(GATE_ENTRY, kept_gates(ctx, slice_), re.M))
    return len(listed) or len({r["criterion_tag"] for r in execs(rows, slice_) if r.get("criterion_tag")})


def spec_changes(ctx, rows, slice_):
    """The spec-corpus lines the harness repo's commits since the slice's m added or changed.

    Only such a line excuses a test that broke: a criterion that was reworded moved the target.
    A line a commit removes excuses nothing, and neither does a line it moves (removed and
    added with the same text in one commit, or a renamed file): closing a milestone deletes
    its whole spec, every criterion id in it, and no criterion changed."""
    stamp = next((r["ts"] for r in of(rows, "snap", slice_) if r["name"] == "m"), None)
    harness = ctx.cfg.get("harness_repo")
    if not stamp or not harness or not os.path.isdir(harness):
        return ""
    log = git(harness, "log", "--since=" + stamp, "-p", "-M", "--format=%x01%ct%x02", "--", "specs", check=False)
    kept = []
    for commit in log.split("\x01"):
        when, _, diff = commit.partition("\x02")
        if not when.strip().isdigit() or int(when) <= (epoch(stamp) or 0):
            continue        # `--since` keeps a commit of the very second m was recorded in
        lines = diff.split("\n")
        removed = {" ".join(l[1:].split()) for l in lines if l.startswith("-") and not l.startswith("---")}
        kept += [l[1:] for l in lines if l.startswith("+") and not l.startswith("+++")
                 and " ".join(l[1:].split()) not in removed]
    return "\n".join(kept)


def mutants(ctx, slice_, rows):
    """The seeded-defect measure: mutate the lines the slice changed in matching files, once per
    arm, with only the tests that arm wrote and that pass at m deciding what is caught (`runner`
    names the runner whose `scopes` keep the run to the arm's own files; the names keep it to
    the arm's own tests in them). One wall budget covers the slice; an arm it does not reach is
    recorded as `budget`. The command's exit code must be one of `ok_rc`, else the row is
    `error`."""
    cfg = ctx.cfg.get("mutants", {})
    snaps = snaps_of(rows, slice_)
    if not cfg.get("enabled") or "m" not in snaps or "base" not in snaps:
        return
    paths = [p for s, p in changed_files(ctx.game, snaps["base"], snaps["m"])
             if s != "D" and re.search(cfg["match"], p) and not is_test(ctx, p)]
    if not paths:
        return
    done = {r["label"] for r in of(rows, "mutants", slice_) if r.get("sha", snaps["m"]) == snaps["m"]}
    table = result_table(rows, slice_)
    runner = runner_named(ctx, cfg.get("runner"))
    diff_file = os.path.join(ctx.cache, "mutants.diff")
    out_dir = os.path.join(ctx.cache, "mutants-out")
    start = time.time()
    fresh = True
    for run in ok_runs(rows, slice_):
        label = run["label"]
        if label in done or not any(l == label and "m" in s for (l, _), s in table.items()):
            continue
        row = {"kind": "mutants", "slice": slice_, "label": label, "sha": snaps["m"], "generated": 0, "caught": 0,
               "missed": 0, "unviable": 0, "timeouts": 0, "wall_s": 0, "status": "ok"}
        files, names = [], []
        for path in run.get("files", []):
            passing = [t.rsplit("::", 1)[1] for (l, t), s in sorted(table.items())
                       if l == label and t.rsplit("::", 1)[0] == path and settled(s.get("m")) == "pass"]
            if passing:
                files.append(path)
                names += passing
        left = cfg.get("wall_budget_s", 1800) - (time.time() - start)
        if not files:
            row["status"] = "no-tests"
        elif left <= 0:
            row["status"] = "budget"
        else:
            if fresh:
                checkout(ctx, snaps["m"])
                with open(diff_file, "w") as fh:
                    fh.write(git(ctx.game, "diff", snaps["base"], snaps["m"], "--", *paths))
                fresh = False
            shutil.rmtree(out_dir, ignore_errors=True)
            overlay(ctx, run["tests_ref"], files)
            try:
                # The packages are those of the changed code; the scope is the arm's own files.
                argv = fill(ctx, cfg["cmd"], runner, files, names, {"diff": diff_file, "out": out_dir}, code=paths)
                rc, timed_out, wall, tail = run_cmd(argv, ctx.scratch, runner_env(ctx), left)
                if rc == 127:
                    raise RunnerError("mutants: `%s` cannot start: %s" % (argv[0], " ".join(tail.split())[-200:]))
            finally:
                clear_overlay(ctx, snaps["m"], files)
            counts = {}
            for key, name in (("caught", "caught.txt"), ("missed", "missed.txt"),
                              ("unviable", "unviable.txt"), ("timeouts", "timeout.txt")):
                try:
                    with open(os.path.join(out_dir, "mutants.out", name)) as fh:
                        counts[key] = sum(1 for line in fh if line.strip())
                except OSError:
                    pass
            row["wall_s"] = round(wall)
            if timed_out:
                row["status"] = "budget"
            elif len(counts) < 4 or rc not in cfg.get("ok_rc", [0]):
                # Its exit code says whether the lists mean anything: a baseline that fails
                # (the arm's tests do not pass in the unmutated tree) leaves four empty lists.
                row.update(status="error", rc=rc)
            else:
                row.update(counts, generated=sum(counts.values()))
        append(ctx, [row])


def slice_row(ctx, slice_, rows):
    """The slice's standing once it has an m snapshot: `scored` with all four scored arms valid,
    `degraded` with two or three, `void` with fewer; the area its merged diff falls in; what the
    experiment added to its cost. A run with a measurement gap (`gaps_of`) is not valid."""
    snaps = snaps_of(rows, slice_)
    if "m" not in snaps:
        return []
    gaps = gaps_of(rows, slice_)
    valid = [r["arm"] for r in ok_runs(rows, slice_) if r["role"] == "shadow" and (slice_, r["label"]) not in gaps]
    files = [p for _, p in changed_files(ctx.game, snaps["base"], snaps["m"])]
    hit = [name for name, pattern in sorted(ctx.cfg.get("areas", {}).items())
           if any(re.search(pattern, p) for p in files)]
    row = {"kind": "slice", "slice": slice_, "arms_ok": valid,
           "status": "void" if len(valid) < 2 else "degraded" if len(valid) < 4 else "scored",
           "area": hit[0] if len(hit) == 1 else "mixed" if hit else "other",
           "added_cost_usd": round(sum(r.get("cost_usd") or 0.0 for r in of(rows, "run", slice_)
                                       if r.get("role") in SHADOW_ROLES), 4),
           "cumulative_added_usd": round(spent(rows), 4)}
    old = (of(rows, "slice", slice_) or [{}])[-1]
    return [] if all(old.get(k) == v for k, v in row.items()) else [row]


@contextlib.contextmanager
def score_lock(ctx):
    os.makedirs(ctx.cache, exist_ok=True)
    fd = os.open(os.path.join(ctx.cache, "score.lock"), os.O_WRONLY | os.O_CREAT, 0o644)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        os.close(fd)


def cmd_score(ctx, args):
    pos, opt = options(args, flags=("--end", "--background"))
    slice_ = check_slice(pos[0] if pos else "")
    manifest = ctx.manifest(slice_)
    if not manifest:
        raise Skip("no-manifest")
    if opt.get("background"):
        # Other slices are building and running time-bounded gates on this machine.
        with contextlib.suppress(OSError):
            os.nice(19)
        with contextlib.suppress(Exception):
            subprocess.run(["ionice", "-c3", "-p", str(os.getpid())], capture_output=True, timeout=5)
    stopped = os.path.join(ctx.side_of(slice_), "score.err")
    with contextlib.suppress(OSError):
        os.unlink(stopped)
    if not manifest.get("collected"):
        # The build session ended without `collect`: the shadows' work is still in the exports.
        with contextlib.redirect_stdout(io.StringIO()):
            cmd_collect(ctx, [slice_])
    with score_lock(ctx):
        if opt.get("end"):
            branch = ctx.cfg.get("default_branch", "master")
            head = git(ctx.game, "rev-parse", "--verify", "--quiet", "refs/remotes/origin/" + branch, check=False).strip() \
                or git(ctx.game, "rev-parse", branch).strip()
            record_snap(ctx, slice_, "end", head)
        agents = session_rows(ctx, read(ctx), slice_)
        append(ctx, followups(ctx, slice_, read(ctx), agents))
        derive_g1(ctx, slice_, read(ctx), agents)
        try:
            replay(ctx, slice_, read(ctx))
            append(ctx, derive(ctx, slice_, read(ctx)))
            append(ctx, quality(ctx, slice_, read(ctx)))
            append(ctx, slice_row(ctx, slice_, read(ctx)))
            append(ctx, findings(read(ctx), slice_))
            mutants(ctx, slice_, read(ctx))
        except RunnerError as exc:
            # No result is written for a run that told nothing about the tests.
            with open(stopped, "w") as fh:
                fh.write("%s %s\n" % (now(), exc))
            raise Skip("runner: %s. Nothing is recorded for that run; the next `score %s` retries" % (exc, slice_))
    rows = read(ctx)
    print("AB-SCORED %s: %d result(s), %d candidate(s)" % (
        slice_, len(execs(rows, slice_)), len(current_candidates(rows, slice_))))
    gaps = [q for q in latest(of(rows, "quality", slice_), lambda r: r["label"]) if q.get("gap")]
    if gaps:
        print("AB-WARN %s: %d arm(s) had no test of their own run at the merged code (%s). They are recorded "
              "(`gap`) and listed in the report; such an arm found nothing because nothing of it ran."
              % (slice_, len(gaps), ", ".join(sorted({q["gap"] for q in gaps}))))


# --------------------------------------------------------------------------- mark, escapes, finalize
def planned(ctx, slice_):
    manifest = ctx.manifest(slice_)
    if not manifest:
        raise Skip("no-manifest")
    return manifest


def snap_worktree(ctx, slice_, name):
    """Record the slice worktree as it stands (uncommitted work included) as snapshot `name`,
    once."""
    manifest = planned(ctx, slice_)
    if name in snaps_of(read(ctx), slice_):
        raise Skip("%s is already recorded for %s" % (name, slice_))
    worktree = manifest["worktree"]
    sha = snapshot(worktree, worktree, git(worktree, "rev-parse", "HEAD").strip(),
                   "tester-ab %s %s" % (slice_, name))
    record_snap(ctx, slice_, name, sha)
    return sha


def cmd_mark(ctx, args):
    pos, _ = options(args)
    slice_ = check_slice(pos[0] if pos else "")
    print("AB-MARK %s: first green recorded (%s)" % (slice_, snap_worktree(ctx, slice_, "g1")[:12]))


# What the builder does with a shadow test that exposes a real defect before merge. The shadow
# test itself never enters the repo: what the experiment adds to the suite is at most one test a
# defect, and `finalize` records each one so that growth is visible in the report.
ADOPTION_RULE = ("For each one that is a real defect: fix the defect. Add at most ONE test for it, the smallest that "
                 "catches it, and prefer extending an existing test to writing a new one; add none if the gating "
                 "tests already catch it after the fix. Put the trailer `AB-Adopt: <its id>` (the `k...` "
                 "heading in the file) on the fix commit.")


def candidate_id(slice_, label, key):
    return "k" + sha256("%s|%s|%s" % (slice_, label, key))[:10]


def adoptions(ctx, slice_, rows):
    """Ledger rows for the commits between base and m whose `AB-Adopt:` trailer names a handed
    test: the tests the commit added or changed (`none` when it changed none) and the test
    lines it added. A commit is recorded once."""
    snaps = snaps_of(rows, slice_)
    if "m" not in snaps or "base" not in snaps:
        return []
    known = {(r["candidate_id"], r["commit"]) for r in of(rows, "adoption", slice_)}
    handed = {r["handoff_id"] for r in of(rows, "handoff", slice_)}
    out = []
    log = git(ctx.game, "log", "--reverse", "--format=%H%x00%B%x01", "%s..%s" % (snaps["base"], snaps["m"]), check=False)
    for entry in log.split("\x01"):
        sha, _, body = entry.strip().partition("\x00")
        for cand in sorted(set(ADOPT_RE.findall(body))):
            if not sha or (cand, sha) in known:
                continue
            tests, lines = [], 0
            for stat in git(ctx.game, "show", "--numstat", "--no-renames", "--format=", sha, check=False).splitlines():
                added, _, path = (stat.split("\t") + ["", ""])[:3]
                if not path or not is_test(ctx, path):
                    continue
                lines += int(added) if added.isdigit() else 0
                tests += ["%s::%s" % (path, n) for n, _ in own_tests(ctx, sha, path)]
            out.append({"kind": "adoption", "slice": slice_, "candidate_id": cand, "commit": sha,
                        "handed": cand in handed, "tests": tests, "test_added": ", ".join(tests) or "none",
                        "lines_added": lines, "over_limit": len(tests) > 1})
    return out


def cmd_escapes(ctx, args):
    pos, _ = options(args)
    slice_ = check_slice(pos[0] if pos else "")
    sha = snap_worktree(ctx, slice_, "g2")
    print("AB-ESCAPES %s: green after the lens fixes recorded (%s)" % (slice_, sha[:12]))
    if not ctx.cfg.get("escapes_in_session"):
        return
    # The handoff is advisory: a scorer that is busy, or a budget that runs out, leaves the
    # slice to be scored at merge.
    os.makedirs(ctx.cache, exist_ok=True)
    fd = os.open(os.path.join(ctx.cache, "score.lock"), os.O_WRONLY | os.O_CREAT, 0o644)
    try:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            raise Skip("scorer-busy: no in-session handoff; proceed")
        complete = replay(ctx, slice_, read(ctx), only_snaps=("g2",), budget=ctx.cfg.get("escapes_budget_s", 100))
    except RunnerError as exc:
        raise Skip("runner: %s; no in-session handoff; proceed" % exc)
    finally:
        os.close(fd)
    rows = read(ctx)
    failing = sorted(((label, test) for (label, test), by in result_table(rows, slice_).items()
                      if settled(by.get("g2")) == "fail"), key=lambda lt: sha256("handoff:%s:%s:%s" % ((slice_,) + lt)))
    failing = failing[:int(ctx.cfg.get("handoff_limit", 5))]
    if not complete:
        print("AB-SKIP budget: the replay did not finish in the wall budget; the rest is scored at merge")
    if not failing:
        print("AB-ESCAPES %s: no shadow test fails here" % slice_)
        return
    refs = {r["label"]: r["tests_ref"] for r in ok_runs(rows, slice_)}
    parts = ["# Shadow tests failing after the lens fixes: %s\n\nEach is a test written blind from this slice's "
             "criteria that fails against the current tree. Rule on each: a real defect in the implementation is "
             "fixed through the normal lens-fix path; a wrong test needs no action.\n\n%s\n" % (slice_, ADOPTION_RULE)]
    handed = []
    for i, (label, test) in enumerate(failing):
        cand = candidate_id(slice_, label, test)
        path, name = test.rsplit("::", 1)
        fails = {}
        with contextlib.suppress(OSError, ValueError):
            with open(os.path.join(ctx.side_of(slice_), "fail", "%s.g2.1.json" % label)) as fh:
                fails = json.load(fh)
        parts.append("\n## %s\n\n```\n%s\n```\n\nFailure output:\n\n```\n%s\n```\n" % (
            cand, redact(ctx, test_excerpt(ctx, refs[label], path, name)), redact(ctx, fails.get(test, "(not kept)"))))
        handed.append({"kind": "handoff", "slice": slice_, "label": label, "test_id": test, "handoff_id": cand})
    out = os.path.join(ctx.side_of(slice_), "escapes.md")
    with open(out, "w") as fh:
        fh.write("".join(parts))
    append(ctx, handed)
    print("AB-ESCAPES %s: %d shadow test(s) fail here. Pass %s to the red-team; fix what it confirms before "
          "opening the PR.\n%s" % (slice_, len(handed), out, ADOPTION_RULE))


def merged(ctx, slice_, deadline):
    """Whether the slice's PR is merged, by `gh`: True, False, or None when gh cannot say."""
    left = deadline - time.time()
    if left <= 0 or not ctx.cfg.get("pr_repo"):
        return None
    try:
        done = subprocess.run(["gh", "pr", "list", "--repo", ctx.cfg["pr_repo"], "--state", "merged", "--head",
                               ctx.cfg.get("branch_prefix", "slice/") + slice_, "--json", "number"],
                              capture_output=True, text=True, timeout=min(4, left), stdin=subprocess.DEVNULL)
        return bool(json.loads(done.stdout)) if done.returncode == 0 else None
    except Exception:
        return None


def close_conditions(ctx, rows, current=None, ask=True):
    """[(condition, whether it holds, where it stands)], in the order `finalize` tries them.

      required-slices  every required slice has an m snapshot and is merged (the one being
                       finalized counts as merging), and no planned slice lacks its m snapshot.
                       With no slice listed this condition is off and the other three close
                       the experiment.
      max-slices       the backstop number of slices have at least two valid scored arms and an m
      cap              the arm, judge and port spend, with the reserve of every unpriced
                       planned arm, has reached the cap
      backstop-days    the default branch has commits on that many distinct days since the
                       first m snapshot

    `ask` false leaves out the one question that needs the network (whether the required
    slices' PRs are merged): `status` reports without it."""
    cfg = ctx.cfg
    stops = cfg.get("backstops", {})
    with_m = {r["slice"]: r["ts"] for r in reversed(of(rows, "snap")) if r["name"] == "m"}
    assigned = [r["slice"] for r in of(rows, "assignment") if not r.get("skipped")]
    required = cfg.get("required_slices", [])
    out = []
    if not required:
        out.append(("required-slices", False, "off: no slice is listed"))
    else:
        have = [s for s in required if s in with_m]
        open_ = [s for s in assigned if s not in with_m]
        holds = len(have) == len(required) and not open_
        if holds and ask:
            deadline = time.time() + 8
            holds = all(s == current or merged(ctx, s, deadline) for s in required)
        out.append(("required-slices", holds, "%d of %d required slice(s) finalized%s" % (
            len(have), len(required), "; %d planned slice(s) not finalized" % len(open_) if open_ else "")))
    gaps = gaps_of(rows)
    scored = [s for s in with_m if len([r for r in ok_runs(rows, s) if r["role"] == "shadow"
                                        and (s, r["label"]) not in gaps]) >= 2]
    most = stops.get("max_scored_slices", 16)
    out.append(("max-slices", len(scored) >= most, "%d of %d scored slice(s)" % (len(scored), most)))
    cap = cfg.get("cap_arm_usd", float("inf"))
    out.append(("cap", committed(ctx, rows) >= cap, "$%.2f of $%s committed" % (committed(ctx, rows), cap)))
    days, limit = set(), stops.get("loop_active_days", 45)
    if with_m:
        branch = cfg.get("default_branch", "master")
        ref = "refs/remotes/origin/" + branch
        if not git(ctx.game, "rev-parse", "--verify", "--quiet", ref, check=False).strip():
            ref = branch
        days = set(git(ctx.game, "log", "--since=" + min(with_m.values()), "--format=%cs", ref, check=False).split())
    out.append(("backstop-days", len(days) >= limit, "%d of %d loop-active day(s) since the first finalized slice" % (
        len(days), limit)))
    return out


def close_reason(ctx, rows, current):
    """The first close condition that holds, or None."""
    return next((name for name, holds, _ in close_conditions(ctx, rows, current) if holds), None)


def cmd_finalize(ctx, args):
    pos, opt = options(args, valued=("--repo", "--head"), flags=("--no-score",))
    slice_ = check_slice(pos[0] if pos else "")
    manifest = planned(ctx, slice_)
    recorded = snaps_of(read(ctx), slice_).get("m")
    # A slice is audited again after its fixes: the head the latest audit names is m, and the
    # results taken at an earlier one stop counting.
    if not recorded or opt.get("head"):
        repo = opt.get("repo") or manifest["worktree"]
        sha = git(repo, "rev-parse", "--verify", (opt.get("head") or "HEAD") + "^{commit}").strip()
        if sha != recorded:
            record_snap(ctx, slice_, "m", sha)
            if not opt.get("no-score"):
                # Detached: the replay takes minutes and its caller waits seconds.
                subprocess.Popen([os.path.join(ctx.mem, "mr-tester-ab"), "score", slice_, "--background"],
                                 start_new_session=True, stdin=subprocess.DEVNULL,
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    with contextlib.suppress(Exception):         # a record for the report, never a reason to stop
        append(ctx, adoptions(ctx, slice_, read(ctx)))
    close_if_due(ctx, slice_)
    print("AB-FINALIZED %s" % slice_)


def close_if_due(ctx, current=None, reason=None):
    """Close the experiment when it is open and a close condition holds (or `reason` is given):
    the `close` row, once, and one retro request. Returns the reason, or None."""
    rows = read(ctx)
    if closed(rows):
        return None
    reason = reason or close_reason(ctx, rows, current)
    if reason:
        append(ctx, [{"kind": "close", "slice": "-", "reason": reason,
                      "scored_slices": len({r["slice"] for r in of(rows, "snap") if r["name"] == "m"})}])
        queue_retro(ctx)
        print("AB-CLOSED %s" % reason)
    return reason


def cmd_close_check(ctx, args):
    """The close conditions, tried outside any slice of the experiment: the backstop of
    loop-active days is met by days passing, after the last eligible slice has merged and no
    `finalize` is left to come. mr-audit calls this on every audit of a slice the experiment
    did not plan, while the ledger holds no `close` row. `--sample-done` closes an open
    experiment whatever the conditions say: the supervisor passes it once the last sample
    milestone has closed, so that the items blocked on the close are not held by slices that
    will never come."""
    _, opt = options(args, flags=("--sample-done",))
    if closed(read(ctx)):
        raise Skip("closed")
    if not close_if_due(ctx, reason="sample-done" if opt.get("sample-done") else None):
        print("AB-OPEN no close condition holds")


def queue_retro(ctx):
    """Ask the loop for the close analysis. mr-retro-request writes to the directory its own
    source names, so it is run only when that is this tool's directory: a copy of the tooling in
    a sandbox never queues an event in the live one."""
    script = os.path.join(ctx.mem, "mr-retro-request")
    with contextlib.suppress(Exception):
        with open(script) as fh:
            if ("\nMEM=%s\n" % ctx.mem) not in fh.read():
                return
        subprocess.run(["bash", script, "tester-ab close"], timeout=10, stdin=subprocess.DEVNULL,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def session_rows(ctx, rows, slice_):
    """mr-cost-sum's rows for the subagents of the sessions the slice's runs came from, shadow
    testers left out (a shadow's first message names an export)."""
    out = {}
    for session in sorted({r["session"] for r in of(rows, "run", slice_) if r.get("session")}):
        with contextlib.suppress(Exception):
            for agent, row in by_role(ctx, session).items():
                paths = glob.glob(os.path.join(glob.escape(ctx.transcripts), "*", session, "subagents",
                                               "agent-%s.jsonl" % agent))
                with open(paths[0], errors="replace") as fh:
                    if ctx.cache not in fh.readline(400000):
                        out[agent] = row
    return out


def followups(ctx, slice_, rows, agents):
    """Run rows for the tester calls after the primary (corrections, lens pins, scope splits):
    they run under tier policy and are recorded, not scored."""
    known = {r.get("agent_id") for r in of(rows, "run", slice_)}
    primary = next((r for r in of(rows, "run", slice_) if r.get("role") == "primary"), None)
    if not primary:
        return []
    return [{"kind": "run", "slice": slice_, "label": "followup", "arm": "primary", "role": "followup",
             "twin": False, "status": "ok", "leak": False, "agent_id": a["agent_id"],
             "tool_use_id": a["tool_use_id"], "model_observed": a["model"], "effort_observed": a["effort"],
             "cli_version": a["version"], "started": a["started"], "duration_s": a["duration_s"],
             "calls": a["calls"], "tokens": a["tokens"], "cost_usd": a["cost_usd"]}
            for a in sorted(agents.values(), key=lambda a: a["started"] or "")
            if a["role"] == "tester" and a["agent_id"] not in known and (a["started"] or "") > (primary.get("started") or "")]


def derive_g1(ctx, slice_, rows, agents):
    """When `mark` did not run: the last commit of the slice before its first lens call after
    the primary tester, recorded as g1 with source `derived`."""
    snaps = snaps_of(rows, slice_)
    primary = next((r for r in of(rows, "run", slice_) if r.get("role") == "primary"), None)
    if "g1" in snaps or "m" not in snaps or not primary:
        return
    after = (epoch(primary.get("started")) or 0) + (primary.get("duration_s") or 0)
    lenses = ctx.cfg.get("lens_roles", [])
    first = min((epoch(a["started"]) for a in agents.values()
                 if a["role"] in lenses and (epoch(a["started"]) or 0) > after), default=None)
    if first is None:
        return
    last = None
    for line in git(ctx.game, "log", "--reverse", "--format=%H %ct", "%s..%s" % (snaps["base"], snaps["m"])).splitlines():
        sha, _, stamp = line.partition(" ")
        if int(stamp) <= first:
            last = sha
    if last:
        record_snap(ctx, slice_, "g1", last, source="derived")


