    chk("plan/prints-primary-and-five-shadows", out.startswith("AB-PLAN np-a: issue these 6 Agent calls")
        and len(calls) == 5 and all('subagent_type="tester"' in c for c in calls)
        and out.splitlines()[1].startswith("1. your own tester call"), out)
    chk("plan/models-and-efforts", sorted(re.findall(r'model="(\w+)", effort="(\w+)"', out)) == sorted(
        (a["model"], a["effort"]) for a in _ARMS), calls)
    chk("plan/output-hides-arms", not any(a["arm"] in out for a in _ARMS)
        and sorted(manifest["labels"]) == ["a1", "a2", "a3", "a4", "a5"]
        and sorted(e["arm"] for e in manifest["labels"].values()) == sorted(a["arm"] for a in _ARMS), out)
    chk("plan/label-order-is-fixed-per-slice",
        {l: a["arm"] for l, a in assign("np-a", _ARMS).items()} == {l: e["arm"] for l, e in manifest["labels"].items()}
        and assign("np-a", _ARMS) != assign("np-c", _ARMS) and assign("np-a", _ARMS) == assign("np-a", _ARMS[::-1]))
    exports = [e["export"] for e in manifest["labels"].values()]
