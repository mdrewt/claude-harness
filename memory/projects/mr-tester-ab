            git(repo, "init", "-q", "-b", "master")
        self.commit(self.game, "initial", {
            "game/rules.txt": "hp=10\nold=bug\nmp=4\n", "game/helper.rs": "pub fn help() {}\n",
            "game/other.rs": "pub fn other() {}\n", "client/ui.txt": "title=Realm\n",
            "docs/note.md": "note\n", ".gitignore": "ignored/\n",
            ".claude/agents/tester.md": "tester\n"})
        self.commit(self.harness, "initial", {"specs/m.spec.md": "C1 C2 C3\n"})

    def write_cfg(self):
        with open(os.path.join(self.mem, "mr-tester-ab.config.json"), "w") as fh:
            json.dump(self.cfg, fh)

    def ctx(self):
        return Ctx(self.mem)

    def run(self, *argv):
        buf = io.StringIO()
        with contextlib.redirect_stdout(buf):
            rc = main(list(argv), mem=self.mem)
        return buf.getvalue() if rc == 0 else "RC=%s %s" % (rc, buf.getvalue())

    def rows(self, kind=None, slice_=None):
        rows = read(self.ctx())
        return rows if kind is None else of(rows, kind, slice_)

    def commit(self, repo, message, files):
        """Write files (None deletes) and commit. Returns the sha."""
        for path, body in files.items():
            dest = os.path.join(repo, path)
            if body is None:
                os.unlink(dest)
                continue
            os.makedirs(os.path.dirname(dest), exist_ok=True)
            with open(dest, "w") as fh:
                fh.write(body)
        git(repo, "add", "-A")
        git(repo, *_GIT_ID, "commit", "-q", "--allow-empty", "-m", message)
        return git(repo, "rev-parse", "HEAD").strip()

    def worktree(self, slice_):
        path = os.path.join(self.game, ".claude", "worktrees", slice_)
        git(self.game, "worktree", "add", "-q", "-b", "slice/" + slice_, path, "master")
        return path

    def prompt(self, slice_, worktree, contracts=True):
        path = os.path.join(self.tmp, "prompt-%s.md" % slice_)
        with open(path, "w") as fh:
            fh.write("Write the red tests for %s in %s.\n" % (slice_, worktree))
            if contracts:
                fh.write("\n## Contracts\n\nrules: key=value lines in game/rules.txt\n")
        return path

    def labels(self, slice_):
        """{arm: (label, export)} of a planned slice."""
        manifest = self.ctx().manifest(slice_)
        return {e["arm"]: (label, e["export"]) for label, e in manifest["labels"].items()}

    def transcript(self, first, model, effort, inputs=(), final="done", role="tester", tokens=1000000):
        """Write one subagent transcript. `tokens` input tokens: $2.00 on sonnet, $4.00 on opus."""
        self.agents += 1
        agent = "f%03d" % self.agents
        sub = os.path.join(self.tr, "proj", self.session, "subagents")
        os.makedirs(sub, exist_ok=True)
        stamp = lambda s: (datetime.datetime.now(datetime.timezone.utc) + datetime.timedelta(seconds=s + self.agents)
                           ).strftime("%Y-%m-%dT%H:%M:%S.000Z")
        content = [{"type": "tool_use", "id": "t%d" % i, "name": name, "input": inp}
                   for i, (name, inp) in enumerate(inputs)]
        events = [
            {"type": "user", "timestamp": stamp(0), "message": {"role": "user", "content": first}},
            {"type": "assistant", "timestamp": stamp(1), "effort": effort, "version": "9.9.9",
             "message": {"id": "m1", "model": _MODEL_ID.get(model, model), "content": content,
                         "usage": {"input_tokens": tokens}}},
            {"type": "user", "timestamp": stamp(2), "message": {"role": "user", "content": [
                {"type": "tool_result", "tool_use_id": "t%d" % i, "is_error": name == "Bash"}
                for i, (name, _) in enumerate(inputs)]}},
            {"type": "assistant", "timestamp": stamp(3), "effort": effort, "version": "9.9.9",
             "message": {"id": "m2", "model": _MODEL_ID.get(model, model),
                         "content": [{"type": "text", "text": final}], "usage": {}}}]
        with open(os.path.join(sub, "agent-%s.jsonl" % agent), "w") as fh:
            fh.write("".join(json.dumps(e) + "\n" for e in events))
        with open(os.path.join(sub, "agent-%s.meta.json" % agent), "w") as fh:
            json.dump({"agentType": role, "description": "x", "toolUseId": "toolu_" + agent}, fh)
        return agent

    def shadow(self, slice_, arm, files, report="FINDINGS\nNONE\n", **how):
        """Play one shadow tester: write its files and report into its export, and a transcript."""
        label, root = self.labels(slice_)[arm]
        for path, body in files.items():
            dest = os.path.join(root, path)
            os.makedirs(os.path.dirname(dest), exist_ok=True)
            with open(dest, "w") as fh:
                fh.write(body)
        if report is not None:
            with open(os.path.join(root, REPORT_FILE), "w") as fh:
                fh.write(report)
        entry = self.ctx().arm(arm)
        inputs = [("Read", {"file_path": os.path.join(root, PROMPT_FILE)}),
                  ("Bash", {"command": "cargo test"})] + list(how.pop("inputs", ()))
        how.setdefault("model", entry["model"])
        how.setdefault("effort", entry["effort"])
        return self.transcript("Your task is in %s/%s. Read it fully and follow it exactly." % (root, PROMPT_FILE),
                               inputs=inputs, **how)


def _toy(*tests):
    """A toy test file: (name, key=value, criterion) triples; `flaky` and `BROKEN` verbatim."""
    out = []
    for test in tests:
        if isinstance(test, str):
            out.append(test)
        else:
            out += ["# criterion: %s" % test[2], "test %s %s" % (test[0], test[1])]
    return "\n".join(out) + "\n"


_T_ATK, _T_DEF, _T_SPD = ("t_atk", "atk=5", "C1"), ("t_def", "def=3", "C2"), ("t_spd", "spd=7", "C3")


def _st_disabled(chk, tmp):
    """With `enabled` anything but true, every entry point prints AB-SKIP and writes nothing."""
    for value in (False, "true", 1, None):
        box = _Box(os.path.join(tmp, "disabled-%r" % (value,)), enabled=value)
        worktree = box.worktree("np-a")
        before = sorted(os.listdir(box.mem))
        refs = git(box.game, "for-each-ref")
        outs = [box.run(*argv) for argv in (
            ["eligible", "np-a"], ["plan", "np-a", "--prompt", box.prompt("np-a", worktree)],
            ["collect", "np-a"], ["score", "np-a"], ["score", "np-a", "--end"], ["status"],
            ["mark", "np-a"], ["escapes", "np-a"], ["finalize", "np-a"], ["judge-pack"],
            ["judge-apply", "x.json"], ["report"], ["fix-cost", "f1", "3"], [], ["nonsense"])]
        chk("disabled/%r/all-skip" % (value,), all(o == "AB-SKIP disabled\n" for o in outs), outs)
        chk("disabled/%r/writes-nothing" % (value,), sorted(os.listdir(box.mem)) == before
            and not os.path.exists(box.cache) and git(box.game, "for-each-ref") == refs,
            sorted(os.listdir(box.mem)))
    box = _Box(os.path.join(tmp, "no-config"))
    os.unlink(os.path.join(box.mem, "mr-tester-ab.config.json"))
    chk("disabled/missing-config-skips", box.run("status").startswith("AB-SKIP config:"), box.run("status"))


