def _st_gates(chk, tmp):
    """The slice's acceptance ledger is kept at `plan`: the judge is shown a criterion's text
    after the live file has been archived, and lines per criterion divides by the slice's
    criteria, the same number for every arm."""
    box = _Box(os.path.join(tmp, "gates"), prices=_PRICES, mutants={"enabled": False},
               judge={"model": "fable", "effort": "high", "max_items": 150})
    gates = ("# Gates: np-a\n\n- [ ] C1: WHEN a monster attacks THE damage SHALL use its attack.\n  CHECK: just ci\n"
             "- [ ] C2: THE defence of a new monster SHALL be three.\n- [x] C3: THE speed SHALL be seven.\n"
             "- [ ] C4: THE old rule SHALL be fixed.\n")
    live = os.path.join(box.mem, "gates", "np-a.gates.md")
    os.makedirs(os.path.dirname(live))
    with open(live, "w") as fh:
        fh.write(gates)
    wt = box.worktree("np-a")
    box.run("plan", "np-a", "--prompt", box.prompt("np-a", wt))
    kept = os.path.join(box.mem, "tester-ab", "np-a", "gates.md")
    chk("gates/kept-at-plan", os.path.isfile(kept) and open(kept).read() == gates)
    box.shadow("np-a", "S-med", {"tests/a.toy": _toy(("t_def", "def=3", "C2"), ("t_def2", "def=3", "C2"))})
    box.shadow("np-a", "O-med", {"tests/b.toy": _toy(_T_ATK, _T_DEF)})
    box.run("collect", "np-a")
    record_snap(box.ctx(), "np-a", "g1", box.commit(wt, "green", {"game/rules.txt": "hp=10\natk=5\ndef=2\n"}))
    record_snap(box.ctx(), "np-a", "m", box.commit(wt, "fix", {"game/rules.txt": "hp=10\natk=5\ndef=3\n"}))
    box.run("score", "np-a")
    os.unlink(live)             # thirty days on, mr-record has moved it away
    out = box.run("judge-pack")
    bundle = open(bundle_place(box.ctx(), 1)[0]).read() if "AB-JUDGE-PACK" in out else ""
    chk("gates/the-judge-is-shown-the-criterion-after-the-live-file-is-gone",
        bundle.count("criterion: C2 C2: THE defence of a new monster SHALL be three.\n") == 3, bundle[:1500])
    lab = {label: arm for arm, (label, _) in box.labels("np-a").items()}
    q = {lab[r["label"]]: r for r in box.rows("quality", "np-a")}
    # Both wrote four test lines; S-med used one tag and O-med two. The slice has four criteria.
    chk("gates/lines-per-criterion-divides-by-the-slice's-criteria", q["S-med"]["criteria"] == 4 and q["O-med"]["criteria"] == 4
        and q["S-med"]["test_loc"] == q["O-med"]["test_loc"] == 4
        and q["S-med"]["loc_per_criterion"] == q["O-med"]["loc_per_criterion"] == 1.0, (q["S-med"], q["O-med"]))
    os.unlink(kept)
    os.makedirs(os.path.join(box.mem, "gates", "archive"))
    with open(os.path.join(box.mem, "gates", "archive", "np-a.gates.md"), "w") as fh:
        fh.write(gates)
    chk("gates/the-archive-is-read-when-nothing-was-kept", "SHALL be seven" in criterion_text(box.ctx(), "np-a", "C3")
        and criterion_text(box.ctx(), "np-b", "C3") == "")
    # A test contract's own tag is shown the sentence of the criterion it belongs to: the one
    # whose CHECK names it, else the one whose id it starts with; never the CHECK command.
    with open(os.path.join(box.mem, "gates", "archive", "np-a.gates.md"), "w") as fh:
        fh.write(gates.replace("CHECK: just ci", "CHECK: just test C3-SPEED-IS-SEVEN"))
    chk("gates/a-sub-tag-is-shown-its-criterion's-sentence",
        criterion_text(box.ctx(), "np-a", "C3-SPEED-IS-SEVEN") == "C1: WHEN a monster attacks THE damage SHALL use its attack."
        and criterion_text(box.ctx(), "np-a", "C2-DEFENCE") == "C2: THE defence of a new monster SHALL be three."
        and criterion_text(box.ctx(), "np-a", "X9") == "", criterion_text(box.ctx(), "np-a", "C3-SPEED-IS-SEVEN"))


