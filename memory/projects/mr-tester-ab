            "test_paths": ["^tests/"], "game_code": "^(game|client)/",
            "spec_paths": "^specs/", "areas": {"rust": "^game/", "client": "^client/"},
            "test_patterns": [{"match": r"\.toy$", "test": r"^(?:test|flaky)\s+(\S+)"}],
            "runners": [{"name": "toy", "match": r"\.toy$", "cwd": "", "timeout_s": 60,
                         "cmd": ["/usr/bin/python3", os.path.join(toy, "run.py"), "{junit}", "{files}"]}],
            "mutants": {"enabled": True, "match": "^game/", "wall_budget_s": 60,
