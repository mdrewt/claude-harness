    chk("offline/followup-testers-recorded-not-scored", [r["agent_id"] for r in follow] == [made["followup"]]
        and follow[0]["cost_usd"] == 2.0 and spent(box.rows()) == 14.0, follow)
    n = len(box.rows())
    box.run("score", "np-a")
    chk("offline/recorded-once", len(box.rows()) == n)
