def _st_runner(chk, tmp):
    """What a runner's exit and report say about each test; the scratch directory; a runner that
    cannot start; budgets; being stopped."""
    # The report is at a path of the runner's own, and the runner exits non-zero on a failure.
    box = _Box(os.path.join(tmp, "runner"))
    toy = box.cfg["runners"][0]
    toy.update(junit="ignored/report/junit.xml", cmd=toy["cmd"][:2] + ["ignored/report/junit.xml", "{files}"])
    box.write_cfg()
    wt = box.worktree("np-a")
    box.run("plan", "np-a", "--prompt", box.prompt("np-a", wt))
    lab = {arm: label for arm, (label, _) in box.labels("np-a").items()}
    box.shadow("np-a", "S-med", {"tests/a.toy": _toy(_T_ATK, _T_DEF)})
    box.shadow("np-a", "O-med", {"tests/gh.toy": _toy("ghost t_gh")})
    box.shadow("np-a", "S-high", {"tests/def.toy": _toy("ghost t_atk"), "tests/x_def.toy": _toy(_T_ATK)})
    box.shadow("np-a", "O-high", {"tests/b.toy": _toy(_T_DEF, "BROKEN")})
    box.run("collect", "np-a")
    sha = box.commit(wt, "green", {"game/rules.txt": "hp=10\nold=bug\nmp=4\natk=5\n"})
    ctx = box.ctx()
    record_snap(ctx, "np-a", "m", sha)
    good = json.loads(json.dumps(box.cfg))
    # A runner that cannot start, a probe that fails and a setup step that fails say nothing
    # about the tests: no result is written and the next score runs them.
    for name, change in (("cannot-start", lambda c: c["runners"][0]["cmd"].__setitem__(0, "/no/such/python3")),
                         ("probe-fails", lambda c: c["runners"][0].update(probe=["false"])),
                         ("setup-fails", lambda c: c["runners"][0].update(setup=[{"cmd": ["false"], "if_missing": "absent"}]))):
        box.cfg = json.loads(json.dumps(good))
        change(box.cfg)
        box.write_cfg()
        out = box.run("score", "np-a")
        chk("runner/%s-records-nothing" % name, out.startswith("AB-SKIP runner: toy: ") and "the next `score np-a` retries" in out
            and box.rows("exec") == [] and box.rows("quality") == [] and box.rows("mutants") == []
            and "last score stopped: " in box.run("status"), out)
    box.cfg = json.loads(json.dumps(good))
    box.cfg["mutants"]["cmd"][0] = "/no/such/python3"
    box.write_cfg()
    out = box.run("score", "np-a")
    chk("runner/mutants-cannot-start-records-no-row", out.startswith("AB-SKIP runner: mutants: ")
        and {m["status"] for m in box.rows("mutants")} <= {"no-tests"} and len(box.rows("mutants")) < 4
        and len(box.rows("exec")) > 0, box.rows("mutants"))
    box.cfg = json.loads(json.dumps(good))
    box.write_cfg()
    out = box.run("score", "np-a")
    table = {(l, t.rsplit("/", 1)[1]): settled(by.get("m")) for (l, t), by in result_table(box.rows(), "np-a").items()}
    chk("runner/retried-and-scored", out.startswith("AB-SCORED np-a:") and "last score stopped" not in box.run("status")
        and len(box.rows("mutants")) == 4, out)
    chk("runner/own-report-path-with-a-failing-exit", table.get((lab["S-med"], "a.toy::t_atk")) == "pass"
        and table.get((lab["S-med"], "a.toy::t_def")) == "fail", table)
    quality_rows = {q["label"]: q for q in box.rows("quality", "np-a")}
    chk("runner/no-tests-exit-is-not-run-not-no-compile", table.get((lab["O-med"], "gh.toy::t_gh")) == "not-run"
        and quality_rows[lab["O-med"]]["not_run"] == 1 and quality_rows[lab["O-med"]]["no_compile_files"] == 0
        and table.get((lab["O-high"], "b.toy::t_def")) == "no-compile" and quality_rows[lab["O-high"]]["no_compile_files"] == 1,
        table)
    chk("runner/a-test-counts-under-its-own-file-only", table.get((lab["S-high"], "def.toy::t_atk")) == "not-run"
        and table.get((lab["S-high"], "x_def.toy::t_atk")) == "pass", table)
    # The scratch directory after a replay that was killed: a stray test file and an overlaid
    # tracked file are both gone at the next checkout; what git ignores stays.
    scratch = ctx.scratch
    os.makedirs(os.path.join(scratch, "tests"), exist_ok=True)
    for path, body in (("tests/left.toy", "BROKEN\n"), ("game/rules.txt", "atk=0\n"), ("ignored/built", "x\n")):
        with open(os.path.join(scratch, path), "w") as fh:
            fh.write(body)
    checkout(ctx, sha)
    chk("scratch/checkout-removes-what-a-killed-replay-left", not os.path.exists(os.path.join(scratch, "tests", "left.toy"))
        and "atk=5" in open(os.path.join(scratch, "game", "rules.txt")).read()
        and os.path.isfile(os.path.join(scratch, "ignored", "built")), os.listdir(scratch))
    # The budget covers setup and the test command together.
    slow = {"name": "slow", "cwd": "", "timeout_s": 60, "setup": [{"cmd": ["sleep", "1.5"], "if_missing": "absent"}],
            "cmd": ["sleep", "5"]}
    began = time.time()
    _, _, timed_out, _ = run_runner(ctx, slow, [], [], 2.5)
    chk("runner/budget-covers-setup-and-command", timed_out and time.time() - began < 3.4, time.time() - began)
    # SIGTERM while a replay runs: the runner's process group dies with the tool and the
    # overlaid test files are taken out of the scratch directory.
    record_snap(ctx, "np-a", "end", sha)
    probe = os.path.join(box.tmp, "probe")
    proc = subprocess.Popen([os.path.join(box.mem, "mr-tester-ab"), "score", "np-a"], stdout=subprocess.DEVNULL,
                            stderr=subprocess.DEVNULL, env=dict(os.environ, TOY_PROBE=probe, TOY_RUN_SLEEP="60"))
    waited = 0
    while waited < 30 and not (os.path.exists(probe) and open(probe).read().strip()):
        time.sleep(0.1)
        waited += 0.1
    pid = int(open(probe).read().split()[3]) if os.path.exists(probe) else 0
    overlaid = os.listdir(os.path.join(scratch, "tests"))
    proc.send_signal(signal.SIGTERM)
    proc.wait(timeout=30)
    alive = True
    for _ in range(50):
        try:
            os.kill(pid, 0)
            time.sleep(0.1)
        except OSError:
            alive = False
            break
    chk("runner/sigterm-kills-the-runner-and-clears-the-overlay", pid > 0 and overlaid and not alive
        and os.listdir(os.path.join(scratch, "tests")) == [] and not any(r["snap"] == "end" for r in box.rows("exec")),
        (pid, overlaid, alive, os.listdir(os.path.join(scratch, "tests"))))
    with score_lock(ctx):
        pass


def _st_setup(chk, tmp):
    """A runner builds what its tests import, and rebuilds it for the snapshot it replays; an
    import that still does not resolve is a test that did not run, with the reason, and never a
    failure of the test."""
    build = ["/usr/bin/python3", "-c", "import os,sys; os.makedirs('ignored', exist_ok=True); "
             "open('ignored/pkg', 'w').close(); open('ignored/built.log', 'a').write(sys.argv[1] + '\\n')"]

    def play(name, steps, unresolved="Failed to resolve import"):
        box = _Box(os.path.join(tmp, "setup-" + name), prices=_PRICES, mutants={"enabled": False})
        box.cfg["runners"][0].update(setup=steps, unresolved=unresolved)
        box.write_cfg()
        wt = box.worktree("np-a")
        box.run("plan", "np-a", "--prompt", box.prompt("np-a", wt))
        for arm in ("S-med", "O-med"):
            box.shadow("np-a", arm, {"tests/%s.toy" % arm[0].lower(): "# criterion: C1\nneeds t_boot ignored/pkg\n" + _toy(_T_ATK)})
        box.run("collect", "np-a")
        ctx = box.ctx()
        record_snap(ctx, "np-a", "g1", box.commit(wt, "green", {"game/rules.txt": "hp=10\natk=5\n"}))
        record_snap(ctx, "np-a", "g2", box.commit(wt, "docs", {"docs/note.md": "later\n"}))
        record_snap(ctx, "np-a", "m", box.commit(wt, "fix", {"game/rules.txt": "hp=10\natk=5\nmp=1\n"}))
        return box, box.run("score", "np-a")

    # Built by the setup: the importing test runs and passes.
    box, out = play("built", [{"cmd": build + ["pkg"], "if_missing": "ignored/pkg", "stamp": ["game/rules.txt"]}])
    results = {(r["snap"], r["test_id"].rsplit("::", 1)[1]) : r["result"] for r in box.rows("exec", "np-a")}
    chk("setup/runner-builds-what-its-tests-import", out.startswith("AB-SCORED") and set(results.values()) == {"pass"}
        and results.get(("g1", "t_boot")) == "pass", results)
    # g1 and g2 hold the same rules file and m another: the step ran for g1 and again for m.
    built = open(os.path.join(box.cache, "scratch", "ignored", "built.log")).read().split()
    chk("setup/reruns-when-the-snapshot's-stamp-paths-differ", built == ["pkg", "pkg"], built)
    # Not built (the optional step fails): not-run with the reason; no failure, no candidate, no
    # false positive, and the arm's other test still counts.
    box, out = play("unbuilt", [{"cmd": ["false"], "if_missing": "ignored/pkg", "optional": True}])
    boot = [r for r in box.rows("exec", "np-a") if r["test_id"].endswith("t_boot")]
    chk("setup/unresolved-import-is-not-run-with-its-reason", out.startswith("AB-SCORED") and boot
        and {r["result"] for r in boot} == {"not-run"}
        and all(r["reason"].startswith('unresolved import: Failed to resolve import "ignored/pkg"')
                and "setup step toy: `false` exit 1" in r["reason"] for r in boot)
        and {r["result"] for r in box.rows("exec", "np-a") if r["test_id"].endswith("t_atk")} == {"pass"}, boot[:1])
    q = box.rows("quality", "np-a")
    chk("setup/unresolved-import-is-no-failure-no-candidate", current_candidates(box.rows(), "np-a") == []
        and [x["not_run"] for x in q] == [1, 1] and [x["no_compile_files"] for x in q] == [0, 0]
        and [x["gap"] for x in q] == [None, None] and not os.path.isdir(os.path.join(box.mem, "tester-ab", "np-a", "fail")), q)
    # Without the pattern the same output would be a failing test, an open-fail candidate.
    box, out = play("unmatched", [{"cmd": ["false"], "if_missing": "ignored/pkg", "optional": True}], unresolved=None)
    chk("setup/the-pattern-is-what-tells-them-apart", sorted(c["type"] for c in current_candidates(box.rows(), "np-a"))
        == ["open-fail", "open-fail"])
    # A test the runner killed leaves a failure with no message: its type and captured output
    # are the failure text.
    xml = os.path.join(tmp, "killed.xml")
    with open(xml, "w") as fh:
        fh.write('<testsuite><testcase classname="c" name="hung" time="60"><failure type="test timeout"/>'
                 '<system-err>waiting for the fixture lock</system-err></testcase>'
                 '<testcase classname="c" name="dead" time="1"><failure/></testcase></testsuite>')
    cases = {c[1]: c for c in read_junit(xml)}
    chk("junit/a-killed-test-has-a-failure-text", cases["hung"][2] == "fail"
        and cases["hung"][4] == "test timeout\nwaiting for the fixture lock"
        and "killed or timed out" in cases["dead"][4], cases)


def _st_own(chk, tmp):
    """Only the tests an arm wrote are its own: new, or changed against the base tree. A test
    that was already in a file it edited is not run, counted, priced, charged or credited."""
    old = _toy(("t_keep", "hp=10", "C1"), ("t_edit", "mp=4", "C2"), ("t_gone", "hp=11", "C3"))
    narrow = [{"match": r"\.toy$", "test": r"^(?:test)\s+(t_new\S*)"}]
    box = _Box(os.path.join(tmp, "own"), prices=_PRICES, test_patterns=narrow)
    wide = [{"match": r"\.toy$", "test": r"^(?:test|flaky|ghost|needs)\s+(\S+)"}]
    box.commit(box.game, "an existing suite", {"tests/old.toy": old, "tests/two.toy": _toy(("t_a", "hp=10", "C1"), ("t_b", "hp=10", "C1"))})
    wt = box.worktree("np-a")
    box.run("plan", "np-a", "--prompt", box.prompt("np-a", wt))
    lab = {arm: label for arm, (label, _) in box.labels("np-a").items()}
    # S-med edits the existing file: one test retagged (a comment), one changed, one added.
    # t_gone already fails at the base and would be a false positive of whoever it is charged to.
    edited = "# criterion: C9\ntest t_keep hp=10\n# criterion: C2\ntest t_edit mp=5\n# criterion: C3\ntest t_gone hp=11\n" \
        + _toy(("t_new", "atk=5", "C4"))
    box.shadow("np-a", "S-med", {"tests/old.toy": edited})
    # S-high writes prose where a test should be: nothing is detected.
    box.shadow("np-a", "S-high", {"tests/prose.toy": "it should cap the attack\nand the defence\n"})
    # O-med's new file builds only where the rules hold `hp`; its two tests pass at m.
    box.shadow("np-a", "O-med", {"tests/hp.toy": "requires hp\n" + _toy(("t_h1", "atk=5", "H1"), ("t_h2", "atk=5", "H2"))})
    # O-high appends to an existing file whose tests stop holding at the end.
    box.shadow("np-a", "O-high", {"tests/two.toy": _toy(("t_a", "hp=10", "C1"), ("t_b", "hp=10", "C1"), ("t_c", "atk=5", "C6"))})
    # The replicate's three tests all stop holding at the end: two for one cause, one for another.
    box.shadow("np-a", "S-med-r", {"tests/r.toy": _toy(("t_r1", "hp=10", "R1"), ("t_r2", "hp=10", "R2"), ("t_r3", "spd=1", "R3"))})
    out = box.run("collect", "np-a")
    runs = {r["arm"]: r for r in box.rows("run", "np-a")}
    # The count taken at collect is the pattern's of that moment (here a narrow one).
    chk("own/collect-counts-own-and-existing", (runs["S-med"]["tests"], runs["S-med"]["tests_existing"]) == (1, 0), runs["S-med"])
    box.cfg["test_patterns"] = wide
    box.write_cfg()
    ctx = box.ctx()
    ref = runs["S-med"]["tests_ref"]
    chk("own/new-and-changed-tests-only", own_tests(ctx, ref, "tests/old.toy") == [("t_edit", "C2"), ("t_new", "C4")]
        and len(tests_in(ctx, "tests/old.toy", git(box.game, "show", ref + ":tests/old.toy"))) == 4,
        own_tests(ctx, ref, "tests/old.toy"))
    chk("own/no-test-detected-is-said-at-collect", runs["S-high"]["undetected"] is True and runs["S-high"]["tests"] == 0
        and runs["S-med"]["undetected"] is False and "AB-WARN np-a: 4 shadow run(s) wrote test lines in which no test" in out, out)
    record_snap(ctx, "np-a", "g1", box.commit(wt, "green", {"game/rules.txt": "hp=10\nold=bug\nmp=5\natk=5\n"}))
    record_snap(ctx, "np-a", "m", box.commit(wt, "fix", {"game/rules.txt": "hp=10\nold=bug\nmp=5\natk=5\nspd=1\n"}))
    git(box.game, "merge", "-q", "--ff-only", "slice/np-a")
    box.commit(box.game, "later work renames hp", {"game/rules.txt": "life=10\nold=bug\nmp=5\natk=5\nspd=2\n"})
    out = box.run("score", "np-a", "--end")
    ran = {(r["label"], r["test_id"].rsplit("::", 1)[1]) for r in box.rows("exec", "np-a")}
    chk("own/only-own-tests-are-replayed", {t for l, t in ran if l == lab["S-med"]} == {"t_edit", "t_new"}
