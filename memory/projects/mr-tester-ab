def _st_budget(chk, tmp):
    """An in-session replay the wall budget cuts short writes no result for the run it stopped
    or never reached, so `score` runs those at merge and finds what an unhurried replay finds."""
    box = _Box(os.path.join(tmp, "escapes-slow"), prices=_PRICES, handoff_limit=3, escapes_in_session=True, escapes_budget_s=1)
    hook, outs = _by_command(box)

    def slow(name, sha):
        if name == "g2":
            os.environ["TOY_RUN_SLEEP"] = "3"       # every suite outlasts the budget
        try:
            hook(name, sha)
        finally:
            os.environ.pop("TOY_RUN_SLEEP", None)

    _scenario(box, hook=slow)
    chk("escapes/a-run-the-budget-stopped-writes-no-result", "AB-SKIP budget" in outs["g2"]
        and box.rows("exec", "np-a") == [] and box.rows("handoff", "np-a") == [], (outs["g2"], box.rows("exec", "np-a")[:2]))
    box.run("score", "np-a")
    lab = {label: arm for arm, (label, _) in box.labels("np-a").items()}
    at_g2 = {(lab[r["label"]], r["test_id"].rsplit("::", 1)[1]): r["result"] for r in box.rows("exec", "np-a") if r["snap"] == "g2"}
    cands = sorted((lab[c["label"]], (c.get("test_id") or "claim").rsplit("::", 1)[-1], c["type"])
                   for c in current_candidates(box.rows(), "np-a"))
    chk("escapes/score-replays-what-the-budget-cut", at_g2.get(("O-high", "t_spd")) == "fail"
        and at_g2.get(("S-high", "t_spd")) == "fail" and at_g2.get(("S-med", "t_def")) == "pass"
        and not any(r.get("reason") == OUT_OF_TIME for r in box.rows("exec", "np-a")), at_g2)
    chk("escapes/candidates-equal-the-offline-ones", cands == sorted([
        ("O-high", "t_spd", "escape"), ("O-med", "t_old", "base"), ("O-med", "claim", "spec"),
        ("S-high", "t_def", "lens-caught"), ("S-high", "t_spd", "escape"), ("S-med", "t_def", "lens-caught"),
        ("S-med", "t_wrong", "open-fail"), ("S-med-r", "t_def", "lens-caught")]), cands)


