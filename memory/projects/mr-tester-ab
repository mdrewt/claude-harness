def _by_command(box, slice_="np-a", finalize=("--no-score",)):
    """A snapshot hook for _scenario that records g1, g2 and m the way a build session does."""
    outs = {}

    def hook(name, sha):
        if name == "g1":
            outs[name] = box.run("mark", slice_)
        elif name == "g2":
            outs[name] = box.run("escapes", slice_)
        else:
            outs[name] = box.run("finalize", slice_, "--repo", os.path.join(box.game, ".claude", "worktrees", slice_),
                                 "--head", sha, *finalize)
    return hook, outs


def _retro_stub(box):
    """A stand-in for mr-retro-request that addresses the sandbox and logs each call."""
    log = os.path.join(box.tmp, "retro.log")
    with open(os.path.join(box.mem, "mr-retro-request"), "w") as fh:
        fh.write("#!/bin/bash\nMEM=%s\necho \"$*\" >> %s\n" % (box.mem, log))
    return lambda: open(log).read().splitlines() if os.path.exists(log) else []


@contextlib.contextmanager
def _gh(box, merged=(), works=True, absent=False):
    """Put a `gh` first on PATH that reports the given slices' PRs as merged, or fails; or take
    every directory that holds a `gh` off PATH."""
    bin_dir = os.path.join(box.tmp, "bin-%d" % len(os.listdir(box.tmp)))
    os.makedirs(bin_dir)
    with open(os.path.join(bin_dir, "gh"), "w") as fh:
        fh.write("#!/bin/bash\n%s\ncase \" $* \" in %s *) echo '[]';; esac\n" % (
            "" if works else "echo 'gh: not logged in' >&2; exit 4",
            " ".join("*' slice/%s '*) echo '[{\"number\":1}]';;" % s for s in merged)))
    os.chmod(os.path.join(bin_dir, "gh"), 0o755)
    old = os.environ["PATH"]
    os.environ["PATH"] = bin_dir + os.pathsep + old
    if absent:
        os.environ["PATH"] = os.pathsep.join(d for d in old.split(os.pathsep)
                                             if d and not os.path.exists(os.path.join(d, "gh")))
    try:
        yield
    finally:
        os.environ["PATH"] = old


