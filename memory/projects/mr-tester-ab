# --------------------------------------------------------------------------- judge
VERDICTS = ("bug", "design-defect", "incomplete-work", "wrong-test", "not-a-defect", "not-game-code")
DEFECT = ("bug", "design-defect")
EVIDENCE = ("lens-caught", "escape", "base", "spec")     # classes with a mechanical precondition

JUDGE_HEADER = """# Judge bundle {n}

You rule on {count} items from a testing experiment. Each item is either a test that failed
against a recorded snapshot of the game's code, or a one-sentence claim about existing code or
about the spec. You are not told who wrote an item, and it does not matter.

A legitimate finding is an actual, confirmed bug or design defect in the game code. A test that
fails because the test is wrong is not one. Work that was simply not finished yet at the failing
snapshot is not one.

For every item give exactly one verdict:

- `bug`: the game code behaved wrongly against the named criterion.
- `design-defect`: the design or the spec is wrong or contradicts itself.
- `incomplete-work`: the code was not finished at that snapshot; nothing was wrong in what existed.
- `wrong-test`: the test asserts something the criterion does not require, or cannot pass.
- `not-a-defect`: the claim or the failure describes correct behaviour.
- `not-game-code`: the defect is real but lies outside the game's code and spec.
- `duplicate-of:<item id>`: the same defect as an earlier item you ruled `bug` or `design-defect`.

A `bug` or `design-defect` verdict must name the criterion and the observable wrong behaviour;
without both it is discarded. Name the criterion by its id alone. Several items may show one
defect: rule the first, and every other one `duplicate-of` it.

Everything an item needs is in this file's directory, and nothing else is there: read nothing
outside it. `tree/<slice>/` is the game's code and gating tests as the slice merged them, without
the experiment's tests. `items/<item id>/` holds the whole file a test item's test sits in.

Your whole final message is the verdicts and nothing else: a JSON array, no prose around it, no
code fence, one object per item:
`{{"id": "i001", "verdict": "...", "criterion": "...", "wrong_behaviour": "...", "severity": "minor|major"}}`.
"""


def current_candidates(rows, slice_=None):
    return [c for c in latest(of(rows, "candidate", slice_),
                              lambda r: (r["slice"], r["label"], r.get("test_id") or r.get("claim_id")))
            if c["type"] != "withdrawn"]


def redact(ctx, text, extra=()):
    """Remove what would tell the judge which arm wrote an item: paths under the cache, arm and
    model names. A model id is a model's name with its `claude-` prefix and version; any other
    word that starts with `claude-` (a repository's name in a cited path) stays."""
    for path in sorted(set(extra) | {ctx.cache}, key=len, reverse=True):
        text = text.replace(path, "[path]")
    models = "sonnet|opus|fable|haiku"
    names = sorted((re.escape(a["arm"]) for a in ctx.cfg.get("arms", [])), key=len, reverse=True)
    return re.sub(r"(?i)\b(%s|claude-(?:%s)[\w.-]*|%s)\b" % ("|".join(names), models, models), "[redacted]", text)


def test_excerpt(ctx, ref, path, name):
    """The test's own lines: from its criterion tag to the end of its body, or to the line
    before the next test."""
    text = git(ctx.game, "show", "%s:%s" % (ref, path), check=False)
    lines = text.split("\n")
    for found, _, top, end in test_spans(ctx, path, text):
        if found == name:
            return "\n".join(lines[top:min(end, top + 80)]).rstrip()
    return ""


def slice_prompt(ctx, slice_):
    try:
        with open(os.path.join(ctx.side_of(slice_), PROMPT_FILE), errors="replace") as fh:
            return fh.read()
    except OSError:
        return ""


def contracts_of(prompt):
    """The `## Contracts` section of a tester prompt, to the next heading of its level."""
    m = re.search(r"^## Contracts\b.*?(?=^## |\Z)", prompt, re.M | re.S)
    return m.group(0).rstrip()[:8000] if m else ""


def criterion_text(ctx, slice_, tag):
    """What states a criterion: its sentence in the slice's acceptance ledger (`kept_gates`),
    then the lines of the tester prompt `plan` kept that name its id.

    A ledger entry is `- [ ] <ID>: <sentence>` with its CHECK, EXPECT and EVIDENCE lines under
    it. The entry of a tag is the one with that id; else the entries whose lines name the tag
    (a test contract's own tag is named in the CHECK of the criterion it belongs to); else the
    entry whose id the tag starts with, punctuation aside (`CTL12-4-SAVE-SHAPE` is under
    `CTL12.4`). Only the sentence is shown: a CHECK line is a shell command."""
    if not tag:
        return ""
    named = re.compile(r"(?<![\w.-])%s(?![\w-])" % re.escape(tag))
    entries = re.findall(GATE_ENTRY + r"[ \t]*(.*(?:\n[ \t]+\S.*)*)", kept_gates(ctx, slice_), re.M)
    flat = lambda text: re.sub(r"[^a-z0-9]", "", text.lower())
    mine = [e for e in entries if e[0] == tag] or [e for e in entries if named.search(e[1])] \
        or sorted((e for e in entries if flat(tag).startswith(flat(e[0]))), key=lambda e: len(e[0]))[-1:]
    hits = ["%s: %s" % (e[0], e[1].split("\n")[0].strip()) for e in mine[:2]]
    hits += [l.strip() for l in slice_prompt(ctx, slice_).split("\n") if named.search(l)][:3]
    return " ".join(hits)[:1200]


def cited_lines(ctx, rows, slice_, where):
    """The lines a claim cites, as its author saw them: from the tester prompt, from the harness
    repo, else from the slice's base snapshot (the tree the testers were given; the merged
    tree's line numbers have moved)."""
    m = re.match(r"(.+?):(\d+)$", where)
    path, line = (m.group(1), int(m.group(2))) if m else (where, 1)
    text = ""
    harness = ctx.cfg.get("harness_repo") or ""
    full = os.path.normpath(os.path.join(harness, path))
    if os.path.basename(path) == PROMPT_FILE:
        text = slice_prompt(ctx, slice_)
    elif harness and full.startswith(os.path.normpath(harness) + os.sep) and os.path.isfile(full):
        with open(full, errors="replace") as fh:
            text = fh.read()
    else:
        snaps = snaps_of(rows, slice_)
        sha = snaps.get("base") or snaps.get("m")
        if sha:
            text = git(ctx.game, "show", "%s:%s" % (sha, path), check=False)
    lines = text.split("\n")
    return "\n".join(lines[max(0, line - 4):line + 3])


def judge_items(ctx, rows):
    """Everything not yet ruled on: [(ref, slice, kind, label, body text, test file or None)],
    the test file as (tests ref, path). A base claim whose test is a candidate is judged as
    that candidate."""
    judged = {r["ref"] for r in of(rows, "verdict")}
    items = []
    claim_of = {}
    for claim in of(rows, "claim"):
        claim_of[(claim["slice"], claim["label"], claim.get("test") or claim["claim_id"])] = claim
    covered = set()
    for cand in current_candidates(rows):
        slice_, label = cand["slice"], cand["label"]
        if cand["type"] == "spec":
            continue
        test = cand["test_id"]
        path, name = test.rsplit("::", 1)
        claim = claim_of.get((slice_, label, name)) if cand["type"] == "base" else None
        if claim:
            covered.add(claim["claim_id"])
        if cand["candidate_id"] in judged:
            continue
        run = next((r for r in ok_runs(rows, slice_) if r["label"] == label), None)
        if not run:
            continue
        tag = next((r["criterion_tag"] for r in of(rows, "exec", slice_)
                    if r["label"] == label and r["test_id"] == test), "")
        fails = {}
        with contextlib.suppress(OSError, ValueError):
            with open(os.path.join(ctx.side_of(slice_), "fail", "%s.%s.1.json" % (label, cand["snap_fail"]))) as fh:
                fails = json.load(fh)
        snaps = snaps_of(rows, slice_)
        body = ["kind: test", "slice: %s" % slice_,
                "criterion: %s %s" % (tag or "(untagged)", criterion_text(ctx, slice_, tag)),
                "", "### Test", "```", test_excerpt(ctx, run["tests_ref"], path, name), "```",
                "Its whole file is `items/{item}/test-file%s`; in the tree it sits in `%s/`." % (
                    os.path.splitext(path)[1], os.path.dirname(path)),
                "", "### Failure output", "```", fails.get(test, "(not kept)"), "```"]
        if claim:
            body += ["", "### The author's claim", claim["text"]]
        if cand.get("snap_pass"):
            changed = [p for _, p in changed_files(ctx.game, snaps[cand["snap_fail"]], snaps[cand["snap_pass"]])
                       if is_game_code(ctx, p)]
            diff = git(ctx.game, "diff", snaps[cand["snap_fail"]], snaps[cand["snap_pass"]], "--", *changed).split("\n")
            body += ["", "### Game-code change after which the test passes", "```diff"] + diff[:300] + (
                ["... (%d more lines)" % (len(diff) - 300)] if len(diff) > 300 else []) + ["```"]
        else:
            touched = [p for _, p in changed_files(ctx.game, snaps["base"], snaps["m"]) if is_game_code(ctx, p)]
            body += ["", "The test still fails at the merged code. The game code this slice changed, under "
                     "`tree/%s/`:" % slice_] + ["- `%s`" % p for p in touched[:40]]
        items.append((cand["candidate_id"], slice_, cand["type"], label, "\n".join(body), (run["tests_ref"], path)))
    for claim in of(rows, "claim"):
        if claim["claim_id"] in judged or claim["claim_id"] in covered:
            continue
        body = ["kind: claim (%s)" % claim["type"], "slice: %s" % claim["slice"], "", "### Claim", claim["text"],
                "", "### Cited lines (%s)" % claim["where"], "```",
                cited_lines(ctx, rows, claim["slice"], claim["where"]), "```"]
        items.append((claim["claim_id"], claim["slice"], "claim", claim["label"], "\n".join(body), None))
    return items


def sample_open(items, limit):
    """Keep at most `limit` items: every item but the still-failing tests is kept; those are cut
    to the same number per arm and slice. Returns (kept, {ref: scale})."""
    rest = [i for i in items if i[2] != "open-fail"]
    groups = {}
    for item in sorted((i for i in items if i[2] == "open-fail"), key=lambda i: sha256(i[0])):
        groups.setdefault((item[1], item[3]), []).append(item)
    room = max(0, limit - len(rest))
    per = max((len(g) for g in groups.values()), default=0)
    while per > 0 and sum(min(per, len(g)) for g in groups.values()) > room:
        per -= 1
    kept, scale = list(rest), {}
    for group in groups.values():
        for item in group[:per]:
            kept.append(item)
            scale[item[0]] = round(len(group) / min(per, len(group)), 4)
    return kept, scale


def bundle_place(ctx, n):
    """Where bundle `n` is, from the pointer `judge-pack` left: (its file, its directory)."""
    with open(os.path.join(ctx.side, "judge", "bundle-%d.where.json" % n)) as fh:
        where = json.load(fh)
    return where["bundle"], where["dir"]


def cmd_judge_pack(ctx, args):
    """The bundle is written to a directory of its own under the cache root, with the code and
    the test files its items need, and the judge is told to read nothing else. What maps an
    item to its arm (the key, the manifests, the plan output, the ledger) stays in this tool's
    directory, which neither the bundle nor the call names."""
    options(args)
    rows = read(ctx)
    judge = ctx.cfg.get("judge", {})
    items, scale = sample_open(judge_items(ctx, rows), int(judge.get("max_items", 150)))
    if not items:
        raise Skip("nothing-to-judge")
    key_dir = os.path.join(ctx.side, "judge")
    os.makedirs(key_dir, exist_ok=True)
    n = 1 + len(glob.glob(os.path.join(glob.escape(key_dir), "bundle-*.key.json")))
    out_dir = os.path.join(ctx.cache, "judge", "b%d-%s" % (n, os.urandom(6).hex()))
    os.makedirs(os.path.join(ctx.cache, "judge"), exist_ok=True)
    os.makedirs(out_dir)
    bundle = os.path.join(out_dir, "bundle.md")
    verdicts = os.path.join(key_dir, "verdicts-%d.json" % n)
    items.sort(key=lambda i: sha256("judge-%d:%s" % (n, i[0])))
    exports = [e["export"] for row in of(rows, "assignment") for e in (ctx.manifest(row["slice"]) or {}).get("labels", {}).values()]
    hide = exports + [ctx.mem]
    parts = [JUDGE_HEADER.format(n=n, count=len(items))]
    for slice_ in sorted({i[1] for i in items}):
        snaps = snaps_of(rows, slice_)
        sha = snaps.get("m") or snaps.get("base")
        if sha:
            # The top-level directories that hold game code or tests: not the repository's
            # agent definitions (a dot-directory, where model names are written), nor its docs.
            tops = sorted({p.split("/", 1)[0] for p in git(ctx.game, "ls-tree", "-r", "--name-only", sha).splitlines()
                           if "/" in p and not p.startswith(".") and (is_game_code(ctx, p) or is_test(ctx, p))})
            export_tree(ctx.game, sha, os.path.join(out_dir, "tree", slice_), tops)
        contracts = contracts_of(slice_prompt(ctx, slice_))
        if contracts:
            parts.append("\n---\n## Slice %s: what its tests were written against\n\n%s\n" % (
                slice_, redact(ctx, contracts, hide)))
    key = {}
    for i, (ref, slice_, kind, label, body, test_file) in enumerate(items):
        item_id = "i%03d" % (i + 1)
        key[item_id] = {"ref": ref, "slice": slice_, "kind": kind, "label": label, "scale": scale.get(ref, 1)}
        parts.append("\n---\n## %s\n\n%s\n" % (item_id, redact(ctx, body.replace("{item}", item_id), hide)))
        if test_file:
            dest = os.path.join(out_dir, "items", item_id, "test-file" + os.path.splitext(test_file[1])[1])
            os.makedirs(os.path.dirname(dest))
            with open(dest, "w") as fh:
                fh.write(redact(ctx, git(ctx.game, "show", "%s:%s" % test_file, check=False), hide))
    with open(bundle, "w") as fh:
        fh.write("".join(parts))
    write_json(os.path.join(key_dir, "bundle-%d.key.json" % n), key)
    write_json(os.path.join(key_dir, "bundle-%d.where.json" % n), {"bundle": bundle, "dir": out_dir})
    print("AB-JUDGE-PACK %d item(s) in %s. Issue this one call, then run: %s/mr-tester-ab judge-apply %s"
          % (len(items), bundle, ctx.mem, verdicts))
    print('Agent(subagent_type="judge", model="%s", effort="%s", description="judge bundle %d", '
          'prompt="Read %s and rule on every item exactly as it instructs.")'
          % (judge.get("model", "fable"), judge.get("effort", "high"), n, bundle))


def judge_transcript(ctx, bundle):
    """The transcript of the judge run whose first message names the bundle, or None."""
    for found in sorted(glob.glob(os.path.join(glob.escape(ctx.transcripts), "*", "*", "subagents", "agent-*.jsonl"))):
        with contextlib.suppress(OSError):
            if os.path.getmtime(found) < os.path.getmtime(bundle) - 120:
                continue
            with open(found, errors="replace") as fh:
                if bundle in fh.readline(400000):
                    return found
    return None


def said_verdicts(text):
    """The JSON array in a judge's final message, or None: the message itself, or what lies
    between its first `[` and its last `]`."""
    for cut in (text, text[text.find("["):text.rfind("]") + 1]):
        with contextlib.suppress(ValueError):
            given = json.loads(cut)
            if isinstance(given, list):
                return given
    return None


def findings(rows, slice_):
    """The findings the verdicts of a slice support, as ledger rows.

    Items the judge marked duplicates of one another are one finding, and so are tests ruled
    defects on the same criterion and the same pair of snapshots, whoever wrote them: an arm
    that writes three tests of one defect has found one defect. It is `confirmed` when an item
    in it has a mechanical precondition (a flip, or a counted commit for a spec claim),
    `pending` when the judge confirms a defect that nothing has fixed yet, `out-of-scope` when
    its only evidence is a base claim outside the slice's reach, and `withdrawn` when the
    results its items rested on no longer count."""
    verdicts = {v["ref"]: v for v in of(rows, "verdict", slice_)}
    cands = {}
    for cand in current_candidates(rows, slice_):
        cands[cand["candidate_id"]] = cand
        if cand["type"] == "spec":
            cands[cand["claim_id"]] = cand
    arm_of = {r["label"]: (r["arm"], r["role"]) for r in of(rows, "run", slice_)}
    valid = sorted(r["arm"] for r in ok_runs(rows, slice_) if r["role"] == "shadow")

    def root(ref, seen=()):
        target = verdicts[ref].get("duplicate_of")
        return root(target, seen + (ref,)) if target in verdicts and target not in seen and target != ref else ref

    clusters = {}
    for ref in sorted(verdicts):
        clusters.setdefault(root(ref), []).append(ref)
    order = {ref: i for i, ref in enumerate(verdicts)}      # the head is the item ruled first
    merged, first = {}, {}
    for head in sorted(clusters, key=order.get):
        cand, verdict = cands.get(head), verdicts[head]
        into = head
        if cand and cand.get("snap_fail") and verdict["verdict"] in DEFECT:
            into = first.setdefault((" ".join((verdict.get("criterion") or "").lower().split()),
                                     cand["snap_fail"], cand.get("snap_pass")), head)
        merged.setdefault(into, []).extend(clusters[head])
    out = []
    for head, members in sorted(merged.items()):
        members = sorted(members)
        verdict = verdicts[head]
        if verdict["verdict"] not in DEFECT + ("rejected-incomplete",):
            continue
        row = {"kind": "finding", "slice": slice_, "finding_id": "f" + sha256("%s|%s" % (slice_, head))[:8],
               "verdict": verdict["verdict"], "criterion": verdict.get("criterion"),
               "wrong_behaviour": verdict.get("wrong_behaviour"), "severity": verdict.get("severity"),
               "members": members, "found_by": [], "missed_by": [], "replicate_found": False,
               "class": None, "status": "rejected", "fix_cost_usd": None}
        if verdict["verdict"] in DEFECT:
            kinds = []
            proven, open_ = set(), set()
            for ref in members:
                cand = cands.get(ref)
                arm, role = arm_of.get(verdicts[ref]["label"], (None, None))
                if not cand and verdicts[ref]["item"] != "claim":
                    continue        # a test whose candidate was withdrawn is evidence of nothing
                kind = cand["type"] if cand else "claim"
                # A base claim counts inside the slice's reach only, with a flip or without one.
                if (cand.get("scope") if cand and cand["type"] == "base" else verdicts[ref].get("scope")) == "out":
                    kind = "out-of-scope"
                kinds.append(kind)
                if role == "replicate":
                    row["replicate_found"] = row["replicate_found"] or kind in EVIDENCE
                elif arm:
                    (proven if kind in EVIDENCE else open_).add(arm)
            hit = [k for k in EVIDENCE if k in kinds]
            if not kinds:
                row["status"] = "withdrawn"
            elif hit:
                row.update({"class": hit[0], "status": "confirmed", "found_by": sorted(proven)})
            elif "out-of-scope" in kinds:
                row.update({"class": "out-of-scope", "status": "out-of-scope", "found_by": sorted(open_)})
            else:
                claim_kind = next((c["type"] for c in of(rows, "claim", slice_) if c["claim_id"] in members), None)
                row.update({"class": claim_kind or "escape", "status": "pending", "found_by": sorted(open_)})
            row["missed_by"] = [a for a in valid if a not in row["found_by"]] if kinds else []
        old = next((r for r in reversed(of(rows, "finding", slice_)) if r["finding_id"] == row["finding_id"]), None)
        if old:
            row["fix_cost_usd"] = old.get("fix_cost_usd")
        if not old or any(old.get(k) != v for k, v in row.items()):
            out.append(row)
    return out


def cmd_judge_apply(ctx, args):
    pos, _ = options(args)
    if not pos:
        raise Skip("usage: judge-apply <verdicts.json>")
    path = pos[0]
    m = re.fullmatch(r"verdicts-(\d+)\.json", os.path.basename(path))
    if not m:
        raise Skip("verdicts file must be the verdicts-<n>.json a bundle names")
    with open(os.path.join(ctx.side, "judge", "bundle-%s.key.json" % m.group(1))) as fh:
        key = json.load(fh)
    bundle = bundle_place(ctx, int(m.group(1)))[0]
    transcript = judge_transcript(ctx, bundle)
    if not os.path.exists(path):
        # The judge has no Write tool: its verdicts are its final message, read from its
        # transcript and kept as the file this command names.
        given = said_verdicts(scan_transcript(transcript)[1]) if transcript else None
        if given is None:
            raise Skip("no verdicts: %s does not exist and no judge transcript that names %s ends in a JSON array"
                       % (path, bundle))
        write_json(path, given)
    with open(path) as fh:
        given = json.load(fh)
    if not isinstance(given, list):
        raise Skip("verdicts file is not a JSON array")
    rows = read(ctx)
    judged = {r["ref"] for r in of(rows, "verdict")}
    new, bad = [], 0
    for entry in given:
        item = key.get(entry.get("id")) if isinstance(entry, dict) else None
        if not item or item["ref"] in judged:
            continue
        verdict = str(entry.get("verdict", "")).strip()
        target = None
        said = lambda field: " ".join(str(entry.get(field) or "").split())
        if verdict.startswith("duplicate-of:"):
            target = (key.get(verdict.split(":", 1)[1].strip()) or {}).get("ref")
            if not target or target == item["ref"]:
                bad += 1
                continue
        elif verdict not in VERDICTS:
            bad += 1
            continue
        elif verdict in DEFECT and (len(said("criterion")) < 2 or len(said("wrong_behaviour")) < 8
                                    or said("criterion").lower() in ("none", "n/a", "unknown")):
            verdict = "rejected-incomplete"      # a defect verdict names its criterion and the wrong behaviour
        judged.add(item["ref"])
        claim = next((c for c in of(rows, "claim", item["slice"]) if c["claim_id"] == item["ref"]), None)
        scope = None
        if claim and claim["type"] == "base":
            scope = claim_scope(ctx, item["slice"], snaps_of(rows, item["slice"]), claim.get("where", ""))
        new.append({"kind": "verdict", "slice": item["slice"], "ref": item["ref"], "item": item["kind"], "scope": scope,
                    "label": item["label"], "scale": item.get("scale", 1), "bundle": int(m.group(1)),
                    "verdict": "duplicate" if target else verdict, "duplicate_of": target,
                    "criterion": said("criterion"), "wrong_behaviour": said("wrong_behaviour"),
                    "severity": entry.get("severity") if entry.get("severity") in ("minor", "major") else None})
    append(ctx, new)
    out = []
    for slice_ in sorted({v["slice"] for v in new}):
        out += findings(read(ctx), slice_)
    append(ctx, out)
    # The judge's own run counts toward the cap; its transcript is the one that names the bundle.
    if transcript and not any(r.get("role") == "judge" and r.get("bundle") == int(m.group(1)) for r in of(rows, "run")):
        with contextlib.suppress(Exception):
            session = os.path.basename(os.path.dirname(os.path.dirname(transcript)))
            cost = by_role(ctx, session).get(agent_id(transcript))
            if cost:
                append(ctx, [{"kind": "run", "slice": "-", "label": "judge", "arm": "judge", "role": "judge",
                              "bundle": int(m.group(1)), "status": "ok", "session": session,
                              "agent_id": cost["agent_id"], "model_observed": cost["model"],
                              "effort_observed": cost["effort"], "cost_usd": cost["cost_usd"]}])
    tally = {}
    for row in out:
        tally[row["status"]] = tally.get(row["status"], 0) + 1
    print("AB-JUDGED %d verdict(s) applied, %d unusable, %d item(s) without one; findings: %s" % (
        len(new), bad, len([k for k in key.values() if k["ref"] not in judged]),
        ", ".join("%d %s" % (n, s) for s, n in sorted(tally.items())) or "none"))
    for row in out:
        if row["status"] in ("pending", "out-of-scope"):
            print("  file as a residual: %s %s [%s] %s — %s" % (
                row["finding_id"], row["slice"], row["status"], row["criterion"], row["wrong_behaviour"]))


def cmd_fix_cost(ctx, args):
    """fix-cost <finding id> <usd>: record what fixing a finding cost."""
    pos, _ = options(args)
    if len(pos) != 2:
        raise Skip("usage: fix-cost <finding id> <usd>")
    cost = float(pos[1])
    if not 0 <= cost < 100000:
        raise Skip("fix cost out of range")
    old = next((r for r in reversed(of(read(ctx), "finding")) if r["finding_id"] == pos[0]), None)
    if not old:
        raise Skip("no such finding")
    row = {k: v for k, v in old.items() if k not in ("v", "ts")}
    row["fix_cost_usd"] = round(cost, 4)
    append(ctx, [row])
    print("AB-FIX-COST %s $%.2f" % (pos[0], cost))


# --------------------------------------------------------------------------- report
CLASSES = ("lens-caught", "escape", "base", "spec")
SCENARIOS = ("low", "central", "high")


def mean(values):
    values = list(values)
    return sum(values) / len(values) if values else 0.0


def median(values):
    values = sorted(values)
    if not values:
        return 0.0
    mid = len(values) // 2
    return values[mid] if len(values) % 2 else (values[mid - 1] + values[mid]) / 2


def interval(diffs, seed=20261113, draws=2000):
    """The 80% bootstrap interval of the mean of paired differences, resampling slices. The
    generator is seeded, so a ledger always yields the same interval."""
    import random
    diffs = list(diffs)
    if len(diffs) < 2:
        return None
    rng = random.Random(seed)
    means = sorted(mean(rng.choice(diffs) for _ in diffs) for _ in range(draws))
    return means[int(0.10 * draws)], means[int(0.90 * draws) - 1]


def sign_test(diffs):
    """Two-sided exact sign test p-value over the non-zero differences; None with none."""
    import math
    pos = sum(1 for d in diffs if d > 1e-9)
    neg = sum(1 for d in diffs if d < -1e-9)
    n = pos + neg
    if not n:
        return None
    tail = sum(math.comb(n, k) for k in range(0, min(pos, neg) + 1)) / 2 ** n
    return min(1.0, 2 * tail)


def miss_price(prices, scenario, klass, measured):
    if scenario == "low":
        return prices["lens_caught_low"]
    if klass in measured:
        return measured[klass]
    if klass == "lens-caught":
        return prices["lens_caught"]
    if scenario == "central":
        return prices["post_merge"]
    return prices["spec_high"] if klass == "spec" else prices["escape_high"]


class Stats:
    """Everything the report prints, computed from ledger rows alone."""

    def __init__(self, rows, cfg):
        self.cfg = cfg
        self.prices = cfg["prices"]
        arms = cfg.get("arms", [])
        self.arms = [a["arm"] for a in arms if a.get("role", "shadow") == "shadow"]
        copy = next((a for a in arms if a.get("role") == "replicate"), None)
        self.replicate = copy["arm"] if copy else None
        # the scored arm the replicate is a second run of
        self.twin_of = next((a["arm"] for a in arms if copy and a.get("role", "shadow") == "shadow"
                             and (a["model"], a["effort"]) == (copy["model"], copy["effort"])), None)
        self.model = {a["arm"]: a["model"] for a in arms}
        self.effort = {a["arm"]: a["effort"] for a in arms}
        self.rows = rows
        standing = {r["slice"]: r for r in of(rows, "slice")}
        self.assignment = {r["slice"]: r for r in of(rows, "assignment") if not r.get("skipped")}
        self.void = sorted(s for s, r in standing.items() if r["status"] == "void")
        self.slices = sorted(s for s, r in standing.items() if r["status"] != "void" and s in self.assignment)
        self.standing = standing
        self.runs = {}
        for run in of(rows, "run"):
            if run.get("role") in SHADOW_ROLES:
                self.runs[(run["slice"], run["arm"])] = run
        self.findings = [f for f in latest(of(rows, "finding"), lambda r: r["finding_id"]) if f["slice"] in self.slices]
        self.quality = {}
        label_arm = {(r["slice"], r["label"]): r["arm"] for r in of(rows, "run")}
        self.gaps = {(s, label_arm.get((s, l))): gap for (s, l), gap in gaps_of(rows).items()}
        for q in of(rows, "quality"):
            self.quality[(q["slice"], label_arm.get((q["slice"], q["label"])))] = q
        self.judged = {}
        for v in of(rows, "verdict"):
            cell = self.judged.setdefault((v["slice"], label_arm.get((v["slice"], v["label"]))), [0.0, 0.0])
            # A test still failing at the merged code that is no defect, and a claim the judge
            # rejects (alone, or riding on its test's base candidate), are false positives.
            if v["item"] == "open-fail" and v["verdict"] in ("wrong-test", "not-a-defect"):
                cell[0] += v.get("scale", 1)
            elif v["item"] in ("claim", "base") and v["verdict"] == "not-a-defect":
                cell[1] += 1
        self.mutants = {(m["slice"], label_arm.get((m["slice"], m["label"]))): m for m in of(rows, "mutants")}
        self.measured = {}
        for klass in CLASSES:
            costs = [f["fix_cost_usd"] for f in self.findings if f["class"] == klass and f.get("fix_cost_usd") is not None]
            if len(costs) >= 5:
                self.measured[klass] = round(mean(costs), 2)

    # -- cells -----------------------------------------------------------------------------
    def ok(self, slice_, arm):
        """Whether the arm's run on the slice is a measurement of the arm: its status is ok, its
        tests are kept, and it has no measurement gap. Every table, the Total and the decision
        take valid runs only, as the slice's standing does."""
        run = self.runs.get((slice_, arm))
        return bool(run and run.get("status") == "ok" and run.get("tests_ref") and (slice_, arm) not in self.gaps)

    def reference(self, slice_, pending):
        """The findings the scored arms found on a slice."""
        return [f for f in self.findings if f["slice"] == slice_ and f["class"] in CLASSES
                and (f["status"] == "confirmed" or (pending and f["status"] == "pending"))
                and any(a in self.arms for a in f["found_by"])]

    def hit(self, finding, arm):
        return bool(finding.get("replicate_found")) if arm == self.replicate else arm in finding["found_by"]

    def found(self, slice_, arm, pending=False):
        return [f for f in self.reference(slice_, pending) if self.hit(f, arm)]

    def missed(self, slice_, arm, pending=False):
        return [f for f in self.reference(slice_, pending) if not self.hit(f, arm)]

    def false_positives(self, slice_, arm):
        wrong, rejected = self.judged.get((slice_, arm), (0.0, 0.0))
        return wrong + rejected + self.quality.get((slice_, arm), {}).get("no_compile_files", 0)

    def run_cost(self, slice_, arm):
        return self.runs[(slice_, arm)].get("cost_usd") or 0.0

    def terms(self, slice_, arm, scenario, pending=False):
        """The Total's terms, in order: run cost, misses at their class's price, false positives,
        flaky tests, brittle breaks, bloat."""
        p, q = self.prices, self.quality.get((slice_, arm), {})
        fp = p["fp_low"] if scenario == "low" else p["fp"]
        return (self.run_cost(slice_, arm),
                sum(miss_price(p, scenario, f["class"], self.measured) for f in self.missed(slice_, arm, pending)),
                self.false_positives(slice_, arm) * fp, q.get("flaky", 0) * p["flake"],
                q.get("brittle", 0) * fp, q.get("bloat_usd", 0.0))

    def total(self, slice_, arm, scenario, pending=False):
        """Run cost, plus each miss at its class's price, plus the priced quality counts."""
        return sum(self.terms(slice_, arm, scenario, pending))

    def paired(self, arm, other, value, slices=None):
        """[value(arm) - value(other)] over the slices where both ran validly."""
        return [value(s, arm) - value(s, other) for s in (self.slices if slices is None else slices)
                if self.ok(s, arm) and self.ok(s, other)]

    def valid(self, arm, slices=None):
        return [s for s in (self.slices if slices is None else slices) if self.ok(s, arm)]

    def noise_floor(self, slices=None):
        """Mean per-slice number of confirmed findings that exactly one of the replicate and the
        arm it copies found, among all of the slice's confirmed findings: those the replicate
        alone found are in no reference set and are disagreement all the same."""
        if not self.replicate or not self.twin_of:
            return 0.0
        return mean(sum(1 for f in self.findings
                        if f["slice"] == s and f["class"] in CLASSES and f["status"] == "confirmed"
                        and (self.twin_of in f["found_by"]) != bool(f.get("replicate_found")))
                    for s in (self.slices if slices is None else slices)
                    if self.ok(s, self.twin_of) and self.ok(s, self.replicate))

    def recall(self, arms, slices=None, pending=False):
        """Share of the reference set that any of `arms` found, where all of them ran validly."""
        hit = total = 0
        for s in (self.slices if slices is None else slices):
            if not all(self.ok(s, a) for a in arms):
                continue
            for f in self.reference(s, pending):
                total += 1
                hit += any(self.hit(f, a) for a in arms)
        return (hit / total) if total else None

    def kill_rate(self, slice_, arm):
        m = self.mutants.get((slice_, arm))
        if not m or m["status"] != "ok" or not (m["caught"] + m["missed"]):
            return None
        return m["caught"] / (m["caught"] + m["missed"])

    # -- the decision rule -----------------------------------------------------------------
    def decide(self, slices=None, least=6):
        """Apply the rule to a set of slices, of which it needs `least`: six for the experiment,
        five for one tier. Returns a dict: basis (report-only | quality | cost-default), choice,
        effort, reasons."""
        slices = self.slices if slices is None else slices
        arms = [a for a in self.arms if self.valid(a, slices)]
        out = {"basis": "report-only", "choice": None, "effort": None, "reasons": []}
        if len(slices) < least or not arms:
            out["reasons"].append("%d scored slice(s), fewer than %s: no model change" % (
                len(slices), {5: "five", 6: "six"}.get(least, least)))
            return out
        cost = {a: mean(self.run_cost(s, a) for s in self.valid(a, slices)) for a in arms}
        ref = min(arms, key=lambda a: (cost[a], a))
        floor = self.noise_floor(slices)
        winners = []
        for arm in arms:
            if arm == ref:
                continue
            why = []
            for pending in (False, True):
                tag = " with pending findings counted" if pending else ""
                for scenario in SCENARIOS:
                    if mean(self.paired(arm, ref, lambda s, a: self.total(s, a, scenario, pending), slices)) >= 0:
                        why.append("its Total is not lower in the %s scenario%s" % (scenario, tag))
                bounds = interval(self.paired(arm, ref, lambda s, a: self.total(s, a, "central", pending), slices))
                if not bounds or bounds[1] >= 0:
                    why.append("the 80%% interval of the difference includes zero%s" % tag)
            lead = mean(self.paired(arm, ref, lambda s, a: len(self.found(s, a)), slices))
            if lead <= floor:
                why.append("its lead in findings (%.2f a slice) does not exceed the noise floor (%.2f)" % (lead, floor))
            if why:
                out["reasons"].append("%s does not replace %s: %s" % (arm, ref, "; ".join(why)))
            else:
                winners.append(arm)
        if winners:
            best = min(winners, key=lambda a: (mean(self.total(s, a, "central") for s in self.valid(a, slices)), a))
            out.update(basis="quality", choice=best)
            out["reasons"].append("%s replaces %s: lower Total in all three scenarios, interval excludes zero, "
                                  "holds with pending findings counted and not, lead above the noise floor" % (best, ref))
        else:
            out.update(basis="cost-default", choice=ref)
            out["reasons"].append("%s is the cheapest arm to run: a cost default, not a quality result" % ref)
        gain = self.main_effect("effort", lambda s, a: len(self.found(s, a)), slices)
        if gain is None or gain[0] <= floor:
            out["effort"] = "medium"
            out["reasons"].append("effort shows no gain in findings beyond the noise floor: set effort to medium explicitly")
        else:
            out["effort"] = self.effort[out["choice"]]
        return out

    def main_effect(self, factor, value, slices=None):
        """(mean, interval, sign-test p, n) of the per-slice difference between the mean of the
        arms at the factor's upper level (opus; high) and at its lower, over slices where all
        scored arms ran validly."""
        level = self.model if factor == "model" else self.effort
        upper = "opus" if factor == "model" else "high"
        up = [a for a in self.arms if level[a] == upper]
        down = [a for a in self.arms if level[a] != upper]
        if not up or not down:
            return None
        diffs = [mean(value(s, a) for a in up) - mean(value(s, a) for a in down)
                 for s in (self.slices if slices is None else slices) if all(self.ok(s, a) for a in up + down)]
        if not diffs:
            return None
        return mean(diffs), interval(diffs), sign_test(diffs), len(diffs)


def render_report(rows, cfg, census=()):
    """The close report as markdown: a pure function of the ledger rows, the config and the
    census rows handed in (`memory/projects/prune/trend.jsonl`, when that file exists)."""
    st = Stats(rows, cfg)
    money = lambda v: "$%.2f" % v
    span = lambda b: "n/a" if not b else "[%.2f, %.2f]" % b
    pval = lambda p: "n/a" if p is None else "%.3f" % p
    pct = lambda v: "n/a" if v is None else "%.0f%%" % (100 * v)
    out = ["# Tester A/B report", ""]
    spend = sum(r.get("cost_usd") or 0.0 for r in of(rows, "run") if r.get("role") in SHADOW_ROLES + ("judge", "port"))
    closed_rows = of(rows, "close")
    out += ["- Slices: %d scored or degraded (%d degraded), %d void." % (
        len(st.slices), sum(1 for s in st.slices if st.standing[s]["status"] == "degraded"), len(st.void)),
        "- Arm, judge and port spend: %s of a %s cap." % (money(spend), money(cfg.get("cap_arm_usd", 0))),
        "- Experiment: %s." % ("closed (%s)" % closed_rows[-1].get("reason") if closed_rows else "open"),
        "- Findings: %d confirmed, %d pending, %d out of scope, %d rejected for an incomplete verdict." % tuple(
            sum(1 for f in st.findings if f["status"] == s) for s in ("confirmed", "pending", "out-of-scope", "rejected")),
        ""]

    def arm_table(slices, pending=False):
        lines = ["| Arm | Valid runs | Run cost | Found | Missed | Recall | False pos. | Flaky | Brittle | Tests | Never ran | Lines/criterion | Total low | Total central | Total high |",
                 "|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|"]
        for arm in st.arms + ([st.replicate] if st.replicate else []):
            mine = st.valid(arm, slices)
            if not mine:
                lines.append("| %s | 0 | | | | | | | | | | | | | |" % arm)
                continue
            q = [st.quality.get((s, arm), {}) for s in mine]
            lines.append("| %s | %d | %s | %d | %d | %s | %g | %d | %d | %d | %d | %.1f | %s | %s | %s |" % (
                arm + (" (replicate)" if arm == st.replicate else ""), len(mine),
                money(mean(st.run_cost(s, arm) for s in mine)),
                sum(len(st.found(s, arm, pending)) for s in mine),
                sum(len(st.missed(s, arm, pending)) for s in mine), pct(st.recall([arm], slices, pending)),
                sum(st.false_positives(s, arm) for s in mine), sum(x.get("flaky", 0) for x in q),
                sum(x.get("brittle", 0) for x in q), sum(x.get("tests", 0) for x in q),
                sum(x.get("not_run", 0) for x in q), mean(x.get("loc_per_criterion", 0) for x in q),
                *(money(mean(st.total(s, arm, sc, pending) for s in mine)) for sc in SCENARIOS)))
        return lines

    out += ["## Arms", "", "Totals are per slice. The replicate is not in the reference set or the decision. "
            "A test that never ran (no runner fits its file, or the build never compiled it in) can find nothing.", ""]
    out += arm_table(st.slices) + ["", "With pending findings counted:", ""] + arm_table(st.slices, True) + [""]
    out += ["Tests counts the tests an arm wrote: new, or changed against the tree it was given. A test that was "
            "already in a file it edited is not run, counted or priced. Brittle counts causes: the tests of one file "
            "that fail at the default-branch head with the same failure are one break, and so is a file that no "
            "longer compiles there (%s test(s) broken in all). An arm's edit to a file that existed before it is "
            "merged into that file as the default branch has it; %d such file(s) could only be merged by force and "
            "then failed or did not build: they are no break, and no evidence that the tests in them hold either. Lines/criterion divides an arm's test lines by the slice's number of "
            "criteria, the same for every arm." % (" / ".join(
                "%s %d" % (a, sum(st.quality.get((s, a), {}).get("brittle_tests", 0) for s in st.valid(a))) for a in st.arms),
                sum(st.quality.get((s, a), {}).get("stale_files", 0) for a in st.arms for s in st.valid(a))), "",
            "Total, central scenario, by term (mean per slice):", "",
            "| Arm | Run cost | Misses | False positives | Flaky | Brittle | Bloat | Total |", "|---|---|---|---|---|---|---|---|"]
    for arm in st.arms + ([st.replicate] if st.replicate else []):
        mine = st.valid(arm)
        if mine:
            parts = [mean(st.terms(s, arm, "central")[i] for s in mine) for i in range(6)]
            out.append("| %s | %s | %s |" % (arm, " | ".join(money(v) for v in parts), money(sum(parts))))
    out.append("")
    gaps = sorted((s, arm, gap) for (s, arm), gap in st.gaps.items() if arm and s in st.assignment)
    out += ["## Measurement gaps", "",
            "An arm listed here had no test of its own run on that slice: it found nothing there because nothing "
            "of it ran, not because it looked and found the code sound. Such a run is not a valid run: it is in "
            "no table above or below and not in the decision.", ""]
    out += ["- %s %s: %s" % (s, arm, {"no-test-file": "no file under the test paths (tests inside a source file, or a report alone)",
                                      "no-test-detected": "test lines written, no test detected in them",
                                      "none-ran": "tests detected, none ran at the merged code"}[gap])
            for s, arm, gap in gaps] or ["None."]
    if gaps:
        out += ["", "Runs with a gap, by arm: %s." % ", ".join(
            "%s %d" % (a, sum(1 for _, arm, _ in gaps if arm == a)) for a in st.arms + ([st.replicate] if st.replicate else []))]
    reruns = sorted((s, arm) for (s, arm), r in st.runs.items() if r.get("status") == "rerun")
    out += ["- %s %s: ran more than once in one export; priced, not scored" % pair for pair in reruns]
    out.append("")

    out += ["## Findings by class", "", "| Class | " + " | ".join(st.arms) + " |", "|---|" + "---|" * len(st.arms)]
    got = {arm: [f["class"] for s in st.valid(arm) for f in st.found(s, arm)] for arm in st.arms}
    for name, classes in [(k, (k,)) for k in CLASSES] + [("New work only (lens-caught + escape)", CLASSES[:2])]:
        out.append("| %s | %s |" % (name, " | ".join(str(sum(1 for k in got[a] if k in classes)) for a in st.arms)))
    out.append("| Missed | %s |" % " | ".join(str(sum(len(st.missed(s, a)) for s in st.valid(a))) for a in st.arms))
    ref_all = [f for s in st.slices for f in st.reference(s, False)]
    escapes = sum(1 for f in ref_all if f["class"] == "escape")
    out += ["", "Reference set: %d finding(s); %s were escapes." % (
        len(ref_all), pct(escapes / len(ref_all) if ref_all else None)), ""]

    out += ["## Main effects and noise floor", "",
            "| Effect | Measure | Mean difference per slice | 80% interval | Sign test p | Slices |", "|---|---|---|---|---|---|"]
    for factor, label in (("model", "opus minus sonnet"), ("effort", "high minus medium")):
        for name, value in (("findings found", lambda s, a: len(st.found(s, a))),
                            ("Total, central", lambda s, a: st.total(s, a, "central"))):
            effect = st.main_effect(factor, value)
            out.append("| %s | %s | %s | %s | %s | %s |" % ((label, name) + (
                ("%.2f" % effect[0], span(effect[1]), pval(effect[2]), effect[3]) if effect else ("n/a",) * 4)))
    out += ["", "Noise floor: %s and its replicate %s disagree on %.2f confirmed finding(s) a slice (found by one of "
            "the two and not the other). A difference between arms no larger than that is not a result."
            % (st.twin_of, st.replicate, st.noise_floor()), ""]

    out += ["## Seeded defects (reported only)", "",
            "Kill rate of mutants seeded in the lines each slice changed, judged by one arm's passing tests "
            "alone. It gates nothing and is not part of the decision rule; weigh it when confirmed findings "
            "are inconclusive.", "",
            "| Arm | Slices measured | Mutants | Caught | Kill rate, pooled | Mean per slice | vs %s, 80%% interval | Not measured |" % (st.arms[0] if st.arms else "-"),
            "|---|---|---|---|---|---|---|---|"]
    for arm in st.arms + ([st.replicate] if st.replicate else []):
        rated = [s for s in st.slices if st.kill_rate(s, arm) is not None]
        caught = sum(st.mutants[(s, arm)]["caught"] for s in rated)
        seen = sum(st.mutants[(s, arm)]["caught"] + st.mutants[(s, arm)]["missed"] for s in rated)
        base_arm = st.arms[0] if st.arms else arm
        both = [s for s in rated if st.kill_rate(s, base_arm) is not None]
        diffs = [st.kill_rate(s, arm) - st.kill_rate(s, base_arm) for s in both]
        other = {}
        for s in st.slices:
            m = st.mutants.get((s, arm))
            if m and m["status"] != "ok":
                other[m["status"]] = other.get(m["status"], 0) + 1
        out.append("| %s | %d | %d | %d | %s | %s | %s | %s |" % (
            arm, len(rated), seen, caught, pct(caught / seen if seen else None),
            pct(mean(st.kill_rate(s, arm) for s in rated) if rated else None),
            "-" if arm == base_arm else span(interval(diffs)),
            ", ".join("%d %s" % (n, k) for k, n in sorted(other.items())) or "-"))
    if st.replicate and st.twin_of:
        both = [s for s in st.slices if st.kill_rate(s, st.replicate) is not None and st.kill_rate(s, st.twin_of) is not None]
        out += ["", "Noise floor: %s and %s differ by %s in kill rate a slice (%d slice(s))." % (
            st.twin_of, st.replicate,
            pct(mean(abs(st.kill_rate(s, st.replicate) - st.kill_rate(s, st.twin_of)) for s in both) if both else None), len(both))]
    measured = sorted({s for (s, _), m in st.mutants.items() if s in st.slices})
    if measured:
        out += ["", "| Slice | " + " | ".join(st.arms + ([st.replicate] if st.replicate else [])) + " |",
                "|---|" + "---|" * (len(st.arms) + bool(st.replicate))]
        for s in measured:
            out.append("| %s | %s |" % (s, " | ".join(
                pct(st.kill_rate(s, a)) if st.kill_rate(s, a) is not None else st.mutants.get((s, a), {}).get("status", "-")
                for a in st.arms + ([st.replicate] if st.replicate else []))))
    out.append("")

    def split(title, groups, least=1):
        lines = []
        for name, slices in groups:
            if len(slices) < least:
                continue
            lines += ["", "%s: %s (%d slice(s))" % (title, name, len(slices)), "",
                      "| Arm | Valid runs | Found | Missed | Total central |", "|---|---|---|---|---|"]
            for arm in st.arms:
                mine = st.valid(arm, slices)
                lines.append("| %s | %d | %d | %d | %s |" % (
                    arm, len(mine), sum(len(st.found(s, arm)) for s in mine),
                    sum(len(st.missed(s, arm)) for s in mine),
                    money(mean(st.total(s, arm, "central") for s in mine)) if mine else "n/a"))
        return lines

    by = lambda key: sorted({key(s) for s in st.slices}, key=str)
    tier = lambda s: st.assignment[s].get("tier") or "unset"
    area = lambda s: st.standing[s].get("area") or "other"
    cli = lambda s: next((r.get("cli_version") for r in of(rows, "run", s) if r.get("cli_version")), None)
    block = lambda s: "CLI %s, tester.md %s" % (cli(s), (st.assignment[s].get("tester_md_sha") or "unknown")[:8])
    derived = {r["slice"] for r in of(rows, "snap") if r["name"] == "g1" and r.get("source") == "derived"}
    leaked = {s for (s, _), r in st.runs.items() if r.get("leak")}
    out += ["## Splits", ""]
    for arm in st.arms:
        twin = [s for s in st.valid(arm) if st.runs[(s, arm)].get("twin")]
        rest = [s for s in st.valid(arm) if s not in twin]
        out.append("- %s: as the primary's twin %d slice(s), %.2f finding(s) a slice; otherwise %d slice(s), %.2f." % (
            arm, len(twin), mean(len(st.found(s, arm)) for s in twin),
            len(rest), mean(len(st.found(s, arm)) for s in rest)))
    out += split("Tier", [(t, [s for s in st.slices if tier(s) == t]) for t in by(tier)], 5)
    out += split("Area", [(a, [s for s in st.slices if area(s) == a]) for a in by(area)], 5)
    if len(by(block)) > 1:
        out += split("Block", [(b, [s for s in st.slices if block(s) == b]) for b in by(block)])
    if derived & set(st.slices):
        out += split("First-green snapshot", [("recorded by `mark`", [s for s in st.slices if s not in derived]),
                                              ("derived", [s for s in st.slices if s in derived])])
    if leaked:
        out += split("Leak", [("no shadow report reached the builder", [s for s in st.slices if s not in leaked]),
                              ("a shadow report leaked", [s for s in st.slices if s in leaked])])
    out.append("")

    decision = st.decide()
    out += ["## Prices", ""]
    for klass in CLASSES:
        if klass in st.measured:
            out.append("- %s: measured mean fix cost %s replaces the historical price %s in the central and high scenarios." % (
                klass, money(st.measured[klass]), money(miss_price(st.prices, "central", klass, {}))))
    cost = {a: mean(st.run_cost(s, a) for s in st.valid(a)) for a in st.arms if st.valid(a)}
    ref = min(cost, key=lambda a: (cost[a], a)) if cost else None
    for arm in st.arms:
        if arm == ref or not st.valid(arm) or not ref:
            continue
        other = mean(st.paired(arm, ref, lambda s, a: st.total(s, a, "central") - sum(
            miss_price(st.prices, "central", f["class"], st.measured) for f in st.missed(s, a))))
        misses = mean(st.paired(arm, ref, lambda s, a: len(st.missed(s, a))))
        if misses * other < 0:
            out.append("- %s and %s tie at a miss price of %s." % (arm, ref, money(other / -misses)))
        else:
            out.append("- %s against %s: no miss price makes them tie (%s misses %+.2f a slice, other costs %+.2f)." % (
                arm, ref, arm, misses, other))
    pairs = [(st.recall([a, b]), a, b) for i, a in enumerate(st.arms) for b in st.arms[i + 1:]
             if st.recall([a, b]) is not None]
    best = max(pairs, key=lambda p: (p[0], p[1], p[2])) if pairs else None
    if best:
        out.append("- Best pair recall: %s + %s find %s of the reference set." % (best[1], best[2], pct(best[0])))
    out.append("")

    out += ["## Decision", ""]
    if decision["choice"]:
        out.append("**%s at effort %s** (%s)." % (decision["choice"], decision["effort"], {
            "quality": "a quality result", "cost-default": "a cost default, not a quality result"}[decision["basis"]]))
    else:
        out.append("**No model change: report only.**")
    out += ["- " + r for r in decision["reasons"]]
    tiers = [(t, [s for s in st.slices if tier(s) == t]) for t in by(tier)]
    if len(tiers) > 1 and all(len(s) >= 5 for _, s in tiers):
        for name, slices in tiers:
            sub = st.decide(slices, least=5)
            out.append("- Tier %s alone: %s at effort %s (%s)." % (name, sub["choice"], sub["effort"], sub["basis"])
                       if sub["choice"] else "- Tier %s alone: report only." % name)
    elif len(tiers) > 1:
        out.append("- Tiers are not decided separately: not every tier has five scored slices.")
    loc = {a: mean(st.quality.get((s, a), {}).get("loc_per_criterion", 0) for s in st.valid(a)) for a in st.arms if st.valid(a)}
    fpr = {a: sum(st.false_positives(s, a) for s in st.valid(a))
           / max(1, sum(st.quality.get((s, a), {}).get("tests", 0) for s in st.valid(a))) for a in st.arms if st.valid(a)}
    # The size and false-positive guard is part of the decision: with too few slices to decide,
    # it proposes nothing either.
    for arm in (loc if decision["choice"] else ()):
        over = [what for what, table in (("lines per criterion", loc), ("false-positive rate", fpr))
                if table[arm] > 1.5 * median(table.values())]
        if over:
            out.append("- %s is above 1.5 times the arms' median %s: it gets a `tester.md` rule change whichever model is chosen."
                       % (arm, " and ".join(over)))
    singles = [st.recall([a]) for a in st.arms if st.recall([a]) is not None]
    if best and singles and max(singles) < 0.70 and best[0] >= 0.90:
        both = [s for s in st.slices if st.ok(s, best[1]) and st.ok(s, best[2])]

        def pair_total(s):
            union = [f for f in st.reference(s, False) if best[1] not in f["found_by"] and best[2] not in f["found_by"]]
            own = sum(st.total(s, a, "central") - sum(miss_price(st.prices, "central", f["class"], st.measured)
                                                      for f in st.missed(s, a)) for a in best[1:])
            return own + sum(miss_price(st.prices, "central", f["class"], st.measured) for f in union)
        single = min(mean(st.total(s, a, "central") for s in st.valid(a)) for a in st.arms if st.valid(a))
        if both and mean(pair_total(s) for s in both) < single:
            out.append("- PROPOSAL for the operator: no arm reaches 70%% recall and %s + %s reach %s at a lower Total "
                       "(%s a slice against %s), second run included: a permanent two-tester setup." % (
                           best[1], best[2], pct(best[0]), money(mean(pair_total(s) for s in both)), money(single)))
    model_gain = st.main_effect("model", lambda s, a: len(st.found(s, a)))
    if decision["basis"] == "cost-default" and st.model.get(decision["choice"]) != "opus" \
            and (model_gain is None or model_gain[0] <= st.noise_floor()):
        out.append("- PROPOSAL for the operator: the result is a cost default and opus showed no lead in findings beyond "
                   "the noise floor. Whether the cost default also replaces opus on hard-tier slices is the operator's "
                   "ruling; nothing applies it.")
    out.append("")

    out += ["## Recorded, not counted", ""]
    aside = [f for f in st.findings if f["status"] in ("out-of-scope", "rejected", "pending")
             or (f["status"] == "confirmed" and not any(a in st.arms for a in f["found_by"]))]
    for f in sorted(aside, key=lambda f: (f["slice"], f["finding_id"])):
        why = {"out-of-scope": "base defect outside the slice's reach; filed as a residual",
               "rejected": "verdict named no criterion or no wrong behaviour",
               "pending": "confirmed, fix not merged; counted only in the pending tables"}.get(
                   f["status"], "found by the replicate alone")
        out.append("- %s %s — %s: %s" % (f["finding_id"], f["slice"], why, f.get("wrong_behaviour") or "-"))
    if not aside:
        out.append("None.")
    adopted = latest(of(rows, "adoption"), lambda r: (r["slice"], r["candidate_id"], r["commit"]))
    out += ["", "## Tests the experiment added to the suite", "",
            "A shadow test never enters the repo. When one exposed a real defect before merge, the builder fixed the "
            "defect, was allowed at most one test for it and cited the shadow test on the fix commit. %d such adoption(s) are recorded: %d test(s) added or "
            "changed, %d test line(s) added, %d with no test, %d over the one-test limit." % (
                len(adopted), sum(len(a.get("tests", [])) for a in adopted), sum(a.get("lines_added", 0) for a in adopted),
                sum(1 for a in adopted if not a.get("tests")), sum(1 for a in adopted if a.get("over_limit"))), ""]
    out += ["- %s %s (%s): %s; %d line(s)%s" % (a["slice"], a["candidate_id"], a["commit"][:8], a.get("test_added") or "none",
                                                a.get("lines_added", 0), "; over the limit" if a.get("over_limit") else "")
            for a in sorted(adopted, key=lambda a: (a["slice"], a["candidate_id"], a["commit"]))]
    if census:
        out += ["", "## Test census trend", "",
                "The rows `mr-prune` recorded per milestone while the experiment ran, as recorded. Read beside the "
                "bloat and brittle figures above when deciding whether a per-milestone prune session is worth building.", ""]
        flat = lambda row, lead="": [x for k, v in sorted(row.items()) for x in (
            flat(v, lead + k + ".") if isinstance(v, dict) else ["%s%s=%s" % (lead, k, v)]
            if isinstance(v, (int, float) if lead else (int, float, str)) and not isinstance(v, bool)
            and k not in ("label", "commit") else [])]
        out += ["- %s @ %s: %s" % (row.get("label", "-"), str(row.get("commit", "-"))[:8], ", ".join(flat(row)) or "-")
                for row in census if isinstance(row, dict)]
    out += ["", "## Spot-check list", "",
            "Every counted finding. Its tests, failure output and fix diff are in the judge bundle that holds its items. "
            "A finding with several items is one defect: the judge called them duplicates, or they are tests ruled "
            "defects on one criterion and one pair of snapshots.", ""]
    for f in sorted(ref_all, key=lambda f: (f["slice"], f["finding_id"])):
        out.append("- %s %s [%s, %s, %s] criterion %s — %s. Found by %s; missed by %s. Items: %s." % (
            f["finding_id"], f["slice"], f["class"], f["verdict"], f.get("severity") or "unrated",
            f.get("criterion") or "-", f.get("wrong_behaviour") or "-", ", ".join(f["found_by"]),
            ", ".join(f["missed_by"]) or "none", ", ".join(f["members"])))
    if not ref_all:
        out.append("None.")
    return "\n".join(out) + "\n"


def cmd_report(ctx, args):
    _, opt = options(args, valued=("--out",))
    census = []
    with contextlib.suppress(OSError):          # read-only; no such file is no section
        with open(os.path.join(ctx.mem, "prune", "trend.jsonl"), errors="replace") as fh:
            for line in fh:
                with contextlib.suppress(ValueError):
                    census.append(json.loads(line))
    text = render_report(read(ctx), ctx.cfg, census)
    path = opt.get("out") or os.path.join(ctx.mem, "retros", "%s-tester-ab.md" % datetime.datetime.now(
        datetime.timezone.utc).strftime("%Y%m%dT%H%M"))
    os.makedirs(os.path.dirname(os.path.abspath(path)), exist_ok=True)
    with open(path, "w") as fh:
        fh.write(text)
    print("AB-REPORT %s" % path)


