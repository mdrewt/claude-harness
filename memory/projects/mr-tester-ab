                           for c in latest(box.rows("candidate", "np-a"),
                                           lambda r: (r["label"], r.get("test_id") or r.get("claim_id"))))
    want = [("O-high", "t_spd", "escape", "g2", "m"), ("O-med", "t_old", "base", "base", "m"),
            ("S-high", "t_def", "lens-caught", "g1", "g2"), ("S-high", "t_spd", "escape", "g2", "m"),
            ("S-med", "t_def", "lens-caught", "g1", "g2"), ("S-med", "t_wrong", "open-fail", "m", None),
            ("S-med-r", "t_def", "lens-caught", "g1", "g2")]
    spec = ("O-med", "claim", "spec", None, None)
    # A criterion restated as a test (t_atk: red at base, green from g1) is in no class, and a
    # test that is flaky at m is never a candidate.
    chk("score/candidates-by-class", cands() == sorted(want + [spec]), cands())
    base = next((c for c in box.rows("candidate", "np-a") if c["type"] == "base"), {})
    chk("score/base-claim-in-scope", base.get("scope") == "in" and base.get("game_diff") is True, base)
    scratch = box.ctx().scratch
    chk("score/scratch-left-as-the-snapshot", not os.path.exists(os.path.join(scratch, "tests", "s_med.toy"))
        and os.path.isfile(os.path.join(scratch, "tests", "primary.toy"))
        and "spd=7" in open(os.path.join(scratch, "game", "rules.txt")).read()
        and not os.path.exists(os.path.join(scratch, ".git")), os.listdir(scratch))
    quality_rows = {arm_of[q["label"]]: q for q in box.rows("quality", "np-a")}
    chk("quality/no-compile-flaky", quality_rows["O-high"]["no_compile_files"] == 1
        and quality_rows["O-med"]["flaky"] == 1 and quality_rows["S-med"]["flaky"] == 0
        and quality_rows["S-med"]["no_compile_files"] == 0, quality_rows.get("O-high"))
    chk("quality/size", quality_rows["S-high"]["tests"] == 4 and quality_rows["S-high"]["test_loc"] == 8
        and quality_rows["S-high"]["loc_per_criterion"] == 2.0
        and quality_rows["S-high"]["bloat_usd"] == round(8 * 12 * (4 * 4 + 150 * 0.2) / 1e6, 4)
        and quality_rows["S-high"]["runtime_ms"] == 40, quality_rows["S-high"])
    # The seeded-defect measure: the four lines the slice added to game/, each arm judged by its
    # own tests that pass at m. A file with a failing or flaky test is left out.
    muts = {arm_of[r["label"]]: (r["status"], r["generated"], r["caught"], r["missed"])
            for r in box.rows("mutants", "np-a")}
    chk("mutants/per-arm-kill-counts", muts == {
        "S-med": ("no-tests", 0, 0, 0), "S-high": ("ok", 4, 3, 1), "O-med": ("ok", 4, 2, 2),
        "O-high": ("ok", 4, 1, 3), "S-med-r": ("ok", 4, 2, 2)}, muts)
    row = (box.rows("slice", "np-a") or [{}])[-1]
    chk("slice/standing-area-cost", row.get("status") == "scored" and row.get("area") == "rust"
        and sorted(row.get("arms_ok", [])) == ["O-high", "O-med", "S-high", "S-med"]
        and row.get("added_cost_usd") == 14.0 and row.get("cumulative_added_usd") == 14.0, row)
    # Nothing is run twice.
    n = len(box.rows())
    box.run("score", "np-a")
    chk("score/reruns-nothing", len(box.rows()) == n, len(box.rows()) - n)
    # The end snapshot: an open failure stays open, brittle tests show, the spec claim's commit
    # is found.
    out = box.run("score", "np-a", "--end")
    end = git(box.game, "rev-parse", "master").strip()
    chk("score/end-records-default-branch-head", snaps_of(box.rows(), "np-a").get("end") == end
        and git(box.game, "rev-parse", "refs/mr-ab/np-a/end").strip() == end)
    chk("score/candidates-after-end", cands() == sorted(want + [spec]), cands())
    quality_rows = {arm_of[q["label"]]: q for q in latest(box.rows("quality", "np-a"), lambda r: r["label"])}
    chk("quality/brittle", quality_rows["S-high"]["brittle"] == 1 and quality_rows["S-med"]["brittle"] == 0,
        quality_rows["S-high"])
    chk("quality/not-brittle-when-the-spec-changed-the-criterion", quality_rows["O-high"]["brittle"] == 0,
        quality_rows["O-high"])
    chk("score/one-mutants-row-per-arm", len(box.rows("mutants", "np-a")) == 5)
    ctx = box.ctx()
    snaps = snaps_of(box.rows(), "np-a")
    chk("scope/untouched-file-is-out", claim_scope(ctx, "np-a", snaps, "client/ui.txt:1") == "out"
        and claim_scope(ctx, "np-a", snaps, "game/other.rs:1") == "out")
    chk("scope/file-a-touched-file-imports-is-in", claim_scope(ctx, "np-a", snaps, "game/helper.rs:1") == "in"
        and claim_scope(ctx, "np-a", snaps, "game/rules.txt") == "in")
    chk("scope/imports", imports("use crate::helper::help;\n", "helper") and imports("import {a} from './helper'", "helper")
        and not imports("// helper is nice\nlet helper = 1;\n", "helper") and not imports("use crate::helpers;", "helper"))
    chk("score/no-manifest", box.run("score", "np-z") == "AB-SKIP no-manifest\n")
    # A trailer counts only on a commit that changes a file that counts.
    spec_id = next(c["claim_id"] for c in box.rows("claim", "np-a") if c["type"] == "spec")
    box.commit(box.harness, "notes\n\nAB-Claim: cffffffff", {"notes.md": "x\n"})
    box.commit(box.game, "docs\n\nAB-Claim: ceeeeeeee", {"docs/note.md": "y\n"})
    box.commit(box.game, "fix\n\nAB-Claim: cdddddddd", {"game/other.rs": "pub fn other() -> u8 { 1 }\n"})
    box.run("score", "np-a", "--end")
    chk("spec/trailer-needs-a-counted-file", claim_commits(ctx, box.rows(), "np-a", snaps_of(box.rows(), "np-a")).keys()
        == {spec_id, "cdddddddd"}, claim_commits(ctx, box.rows(), "np-a", snaps_of(box.rows(), "np-a")))
    # A slice that changes no matching file is not mutation-scored; flips there are still flips,
    # but a flip with no game-code change between the snapshots is no candidate.
    box2 = _Box(os.path.join(tmp, "score-client"), game_code="^game/")
    _scenario(box2, rust=False)
    box2.run("score", "np-a")
    chk("mutants/client-only-slice-not-scored", box2.rows("mutants", "np-a") == []
        and len(box2.rows("exec", "np-a")) > 20)
    chk("slice/client-area", box2.rows("slice", "np-a")[-1]["area"] == "client", box2.rows("slice", "np-a"))
    # A wall budget the first arm exhausts: the arm it interrupted and those after it say so,
    # though each of the later ones would have finished in time.
    box3 = _Box(os.path.join(tmp, "score-budget"))
    box3.cfg["mutants"]["wall_budget_s"] = 1
    box3.write_cfg()
    _scenario(box3)
    os.environ["TOY_MUTANTS_SLEEP"] = "5"
    try:
        box3.run("score", "np-a")
    finally:
        del os.environ["TOY_MUTANTS_SLEEP"]
    states = [r["status"] for r in box3.rows("mutants", "np-a")]
    chk("mutants/budget-recorded", sorted(states) == ["budget"] * 4 + ["no-tests"]
        and all(r["generated"] == 0 for r in box3.rows("mutants", "np-a")), states)
    box3.cfg["mutants"]["enabled"] = False
    box3.write_cfg()


def _st_no_game_diff(chk, tmp):
    """A test that flips where only non-game files changed is not a candidate."""
    box = _Box(os.path.join(tmp, "nodiff"), game_code="^nothing/")
    _scenario(box)
    box.run("score", "np-a")
    kinds = sorted({c["type"] for c in box.rows("candidate", "np-a")})
    chk("score/flip-without-game-code-change-is-no-candidate", kinds == ["open-fail", "spec"], kinds)


def _st_ledger(chk, tmp):
    """Two concurrent writers leave a well-formed ledger."""
    box = _Box(os.path.join(tmp, "ledger"))
    code = ("import importlib.machinery, importlib.util, sys\n"
            "loader = importlib.machinery.SourceFileLoader('ab', sys.argv[1])\n"
            "ab = importlib.util.module_from_spec(importlib.util.spec_from_loader('ab', loader))\n"
            "loader.exec_module(ab)\n"
            "ctx = ab.Ctx(sys.argv[2])\n"
            "for i in range(150):\n"
            "    ab.append(ctx, [{'kind': 'exec', 'slice': sys.argv[3], 'n': i, 'pad': 'x' * 9000},\n"
            "                    {'kind': 'exec', 'slice': sys.argv[3], 'n': i, 'pad': 'y' * 9000}])\n")
    procs = [subprocess.Popen(["/usr/bin/python3", "-c", code, os.path.join(box.mem, "mr-tester-ab"), box.mem, who])
             for who in ("w1", "w2")]
    codes = [p.wait() for p in procs]
    lines = open(os.path.join(box.mem, "mr-tester-ab.jsonl")).read().split("\n")
    good = 0
    for line in lines[:-1]:
        with contextlib.suppress(ValueError):
            row = json.loads(line)
            good += len(row["pad"]) == 9000 and row["v"] == 1 and bool(row["ts"])
    chk("ledger/concurrent-writers", codes == [0, 0] and good == 600 and lines[-1] == "" and len(lines) == 601,
        (codes, good, len(lines)))
    chk("ledger/reader-skips-a-torn-line", len(read(box.ctx())) == 600)
    with open(os.path.join(box.mem, "mr-tester-ab.jsonl"), "a") as fh:
        fh.write('{"kind": "exec", "slice": "torn\n[1]\n')
    chk("ledger/reader-skips-garbage", len(read(box.ctx())) == 600)


def _st_shipped_config(chk):
    """The config beside this tool loads and has what the commands read."""
    try:
        cfg = Ctx(HERE).cfg
    except Exception as exc:
        chk("config/loads", False, exc)
        return
    arms = {a["arm"]: (a["model"], a["effort"], a["role"]) for a in cfg.get("arms", [])}
    chk("config/arms", arms == {a["arm"]: (a["model"], a["effort"], a["role"]) for a in _ARMS}, arms)
    chk("config/enabled-is-a-boolean", isinstance(cfg.get("enabled"), bool))
    chk("config/caps", 0 < cfg["step_down_usd"] < cfg["cap_arm_usd"] and cfg["cap_bump_usd"] > 0
        and set(cfg["step_down_arms"]) <= set(arms))
    compiled = True
    try:
        for pattern in cfg["test_paths"] + [cfg["game_code"], cfg["spec_paths"], cfg["mutants"]["match"]] \
                + [x for r in cfg["runners"] for x in (r["match"], r.get("exclude", ""))] \
                + [x for p in cfg["test_patterns"] for x in (p["match"], p["test"])]:
            re.compile(pattern)
    except (re.error, KeyError):
        compiled = False
    chk("config/patterns-compile", compiled)
    probe = Ctx.__new__(Ctx)
    probe.cfg = cfg
    rust = "// criterion: BT-3\n#[test]\nfn caps_damage() {}\n\n#[tokio::test]\n#[ignore]\nasync fn joins() {}\n"
    ts = "describe('x', () => {\n  // criterion: UI-2\n  it('renders the badge', () => {});\n  test.each([1])(\"n %s\", () => {});\n});\n"
    chk("config/rust-tests-found", tests_in(probe, "game-core/tests/a.rs", rust) == [("caps_damage", "BT-3"), ("joins", "")],
        tests_in(probe, "game-core/tests/a.rs", rust))
    chk("config/ts-tests-found", tests_in(probe, "client/src/a.test.ts", ts) == [("renders the badge", "UI-2")],
        tests_in(probe, "client/src/a.test.ts", ts))
    chk("config/test-paths", all(is_test(probe, p) for p in (
        "game-core/tests/a.rs", "server-module/src/battle_tests.rs", "client/src/ui/a.test.ts", "client/e2e/x.spec.ts"))
        and not is_test(probe, "game-core/src/combat/mod.rs") and is_game_code(probe, "client/src/main.ts")
        and not is_game_code(probe, "docs/x.md") and not is_game_code(probe, "client/src/a.test.ts"))
    chk("config/nextest-profile-ships", os.path.isfile(os.path.join(HERE, "mr-tester-ab.nextest.toml")))


_BATTERIES = [_st_disabled, _st_plan, _st_collect, _st_score, _st_no_game_diff, _st_ledger]
_FLOOR = 80


def selftest():
    chk = _Check()
    saved = {k: os.environ.pop(k) for k in _GIT_SCRUB + ("CLAUDE_CODE_SUBAGENT_MODEL",) if k in os.environ}
    try:
        with tempfile.TemporaryDirectory(prefix="mr-tester-ab-selftest-") as tmp:
            for battery in _BATTERIES:
                try:
                    battery(chk, tmp)
                except Exception as exc:
                    import traceback
                    chk("%s raised" % battery.__name__, False, traceback.format_exc()[-900:])
        _st_shipped_config(chk)
    finally:
        os.environ.update(saved)
    if chk.fails or chk.n < _FLOOR:
        print("TESTER-AB-SELFTEST-FAILED %d of %d (floor %d)" % (chk.fails, chk.n, _FLOOR))
        return 1
    print("TESTER-AB-SELFTEST-OK %d" % chk.n)
    return 0
# SELFTEST-END

if __name__ == "__main__":
    if sys.argv[1:] == ["--selftest"]:
        sys.exit(selftest())
    sys.exit(main(sys.argv[1:]))
