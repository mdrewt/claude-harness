def _st_reaudit(chk, tmp):
    """A slice audited again after its fixes: the later head is m, and what the earlier one's
    results supported is withdrawn."""
    box = _Box(os.path.join(tmp, "reaudit"), prices=_PRICES)
    hook, outs = _by_command(box)
    wt = _scenario(box, hook=hook)
    box.run("score", "np-a")
    lab = {arm: label for arm, (label, _) in box.labels("np-a").items()}
    first = snaps_of(box.rows(), "np-a")["m"]
    wrong = next(c for c in current_candidates(box.rows(), "np-a") if c["type"] == "open-fail")
    ctx = box.ctx()
    append(ctx, [{"kind": "verdict", "slice": "np-a", "ref": wrong["candidate_id"], "item": "open-fail", "label": wrong["label"],
                  "scale": 1, "verdict": "bug", "duplicate_of": None, "criterion": "C7", "wrong_behaviour": "zz is never set to 1"}])
    append(ctx, findings(box.rows(), "np-a"))
    chk("reaudit/pending-before", [f["status"] for f in box.rows("finding", "np-a")] == ["pending"])
    n = len(box.rows())
    same = box.run("finalize", "np-a", "--repo", wt, "--head", first, "--no-score")
    chk("reaudit/same-head-records-nothing", same == "AB-FINALIZED np-a\n" and len(box.rows()) == n)
    fixed = box.commit(wt, "fix after the audit", {"game/rules.txt": "hp=10\nold=fixed\nmp=4\natk=5\ndef=3\nspd=7\nzz=1\n"})
    out = box.run("finalize", "np-a", "--repo", wt, "--head", fixed, "--no-score")
    rows = box.rows()
    chk("reaudit/later-head-is-m", out == "AB-FINALIZED np-a\n" and snaps_of(rows, "np-a")["m"] == fixed
        and git(box.game, "rev-parse", "refs/mr-ab/np-a/m").strip() == fixed
        and not any(r["snap"] == "m" for r in execs(rows, "np-a"))
        and any(r["snap"] == "g2" for r in execs(rows, "np-a")), out)
    box.run("score", "np-a")
    rows = box.rows()
    key = (lab["S-med"], "tests/s_med.toy::t_wrong")
    now = next(c for c in current_candidates(rows, "np-a") if c["candidate_id"] == wrong["candidate_id"])
    # The test the fix turned is an escape the lenses missed, not a test still failing at merge.
    chk("reaudit/results-are-those-of-the-later-head", result_table(rows, "np-a")[key]["m"] == ["pass", "pass"]
        and (now["type"], now["snap_fail"], now["snap_pass"]) == ("escape", "g2", "m")
        and box.rows("finding", "np-a")[-1]["status"] == "confirmed" and box.rows("finding", "np-a")[-1]["class"] == "escape",
        (result_table(rows, "np-a")[key], now))
    chk("reaudit/seeded-defects-measured-at-the-later-head", sorted(m["sha"] for m in box.rows("mutants", "np-a"))
        == sorted([first] * 5 + [fixed] * 5))
    n = len(box.rows())
    box.run("score", "np-a")
    chk("reaudit/rescored-once", len(box.rows()) == n, len(box.rows()) - n)
    # A third head at which no suite builds: what rested on a pass at m is withdrawn, and so is
    # the finding whose only item it was.
    moved = box.commit(wt, "the rules move", {"game/rules.txt": None, "game/rules2.txt": "zz=1\n"})
    box.run("finalize", "np-a", "--repo", wt, "--head", moved, "--no-score")
    box.run("score", "np-a")
    rows = box.rows()
    chk("reaudit/candidate-withdrawn", [c["type"] for c in rows if c.get("kind") == "candidate"
                                        and c["candidate_id"] == wrong["candidate_id"]] == ["open-fail", "escape", "withdrawn"]
        and sorted(c["type"] for c in current_candidates(rows, "np-a")) == ["lens-caught"] * 3 + ["spec"]
        and result_table(rows, "np-a")[key]["m"] == ["no-compile", "no-compile"],
        sorted(c["type"] for c in current_candidates(rows, "np-a")))
    chk("reaudit/finding-withdrawn", [f["status"] for f in box.rows("finding", "np-a")] == ["pending", "confirmed", "withdrawn"]
        and box.rows("finding", "np-a")[-1]["missed_by"] == [] and box.rows("finding", "np-a")[-1]["found_by"] == [],
        box.rows("finding", "np-a")[-1])
    st = Stats(box.rows(), box.cfg)
    chk("reaudit/withdrawn-finding-counts-for-no-arm", st.reference("np-a", True) == [] and st.missed("np-a", "O-med", True) == [])


