        ok("T16-in-scope", v["verdict"] == "IN-SCOPE" and v["outside"] == [], json.dumps(v))
        v = scope(mem, "s-1", repo, "base", "no-such-ref")
        ok("T16-bad-ref-is-an-error", v["verdict"] == "AUDIT-ERROR", json.dumps(v))

    # Every file the eight measured parks needed is grantable: none is refused on shape.
    for p in ("server-module/src/privacy.rs", "client-wasm/src/lib.rs",
              "evals/baselines/table-schemas.json", "client/src/main.accel.test.ts",
              "client/test-util/mainBootHarness.ts", "client/src/styles.css",
              "client/e2e/ranked-forfeit.spec.ts", "client/src/input/buttons.ts",
              "client/src/ui/controlsModel.ts", "game-core/src/world.rs", "sim-harness/src/world.rs",
              "evals/baselines/content-hash.json", "client/src/net/connection.ts",
              "client/src/tactics/strings.ts", "client/src/ui/screens/index.test.ts",
              "client/src/ui/i18n/hardcodedStrings.ts", "client/src/ui/menuView.test.ts",
              "client/src/ui/i18n/resolver.test.ts", "server-module/src/trading_session.rs",
              "game-core/src/combat/battle_core_tests.rs"):
        ok("T17-measured-park-file-grantable:" + p, shape_error(p) is None, str(shape_error(p)))
    for p in ("Cargo.lock", "client/package-lock.json"):
        ok("T17-lockfile-grantable:" + p, shape_error(p) is None, str(shape_error(p)))

    # mr-disjoint holds its own canon() and DOC_SET; both copies must agree. Its overlap list is
    # the canonical spelling of the first-named slice's path.
    def dj_raw(*args):
        r = subprocess.run([os.path.join(HERE, "mr-disjoint")] + list(args), capture_output=True,
                           text=True, timeout=60,
                           env=dict(os.environ, MR_WIDEN_DIR="/nonexistent", MR_DISJOINT_NO_GRAPH="1"))
        return json.loads(r.stdout)
    for p in ("client//src/./ui/a.ts", "./client/src/ui/a.ts", "game-core/src/",
              "projects/monster-realm/client/src/ui/a.ts", "projects/monster-realm/game-core//src/",
              " client/src/ui/a.ts ", "client/src/ui/../ui/a.ts", "client/src/ui/a.ts"):
        v = dj_raw("a:" + p, "b:" + canon(p))
        ok("T23-canon-parity:" + p, v["pairs"][0]["overlap"] == [canon(p)], json.dumps(v))
    with open(os.path.join(HERE, "mr-disjoint")) as f:
        m = re.search(r"^DOC_SET=\{([^}]*)\}", f.read(), re.M)
    theirs = sorted(json.loads("[" + m.group(1) + "]")) if m else None
    ok("T23-doc-set-parity", theirs == sorted(DOC_SET), "%s vs %s" % (theirs, sorted(DOC_SET)))
    for p in DOC_SET:
        v = dj_raw("a:" + p, "b:" + p)
        ok("T23-doc-set-not-an-overlap:" + p, v["verdict"] == "SAFE", json.dumps(v))

    # The prose a run reads names this tool the way the tool works: by its `$MEM` path, and
    # subject to a spec that forbids widening. The brief stays inside mr-selfcheck's size note.
    spec_dir = os.path.join(HERE, "..", "..", "specs", "monster-realm-v2")
    with open(os.path.join(HERE, "mr-brief-template.md"), "rb") as f:
        brief = f.read()
    scope_line = [ln for ln in brief.decode().splitlines() if ln.startswith("**Scope:**")]
    ok("T24-brief-names-widen", len(scope_line) == 1
       and "`$MEM/mr-touches widen --slice <SLICE> --why" in scope_line[0], str(scope_line))
    ok("T24-brief-defers-to-a-forbidding-spec", len(scope_line) == 1
       and re.search(r"[Uu]nless your spec forbids widening", scope_line[0]), str(scope_line))
    ok("T24-brief-size", len(brief) <= 6144, str(len(brief)))
    with open(os.path.join(spec_dir, "build-loop-prompt.md")) as f:
        loop = f.read()
    ok("T24-loop-prompt-tool-path", "`$MEM/mr-touches widen`" in loop
       and "memory/projects/mr-touches" not in loop)
    ok("T24-loop-prompt-defers-to-a-forbidding-spec",
       re.search(r"unless the slice's spec forbids widening", loop))

    if fails:
        for f in fails:
            print("TOUCHES-SELFTEST-FAIL %s" % f)
        return 1
    print("TOUCHES-SELFTEST-OK %d checks" % n[0])
    return 0


def main(argv):
    if len(argv) >= 2 and argv[1] == "--selftest":
        return selftest()
    usage = ("usage: mr-touches widen --slice S --why \"<measured need>\" PATH [PATH...]"
             " | scope --slice S --repo PATH --base REF --head REF | --selftest")
    if len(argv) < 2 or argv[1] not in ("widen", "scope"):
        print(usage, file=sys.stderr)
        return 2
    opt, paths = {}, []
    rest = argv[2:]
    i = 0
    while i < len(rest):
        if rest[i] in ("--slice", "--why", "--repo", "--base", "--head") and i + 1 < len(rest):
            opt[rest[i][2:]] = rest[i + 1]
            i += 2
        elif rest[i].startswith("--"):
            print(usage, file=sys.stderr)
            return 2
        else:
            paths.append(rest[i])
            i += 1
    slice_id = opt.get("slice")
    if not SLICE_RE.match(slice_id or ""):
        print(usage, file=sys.stderr)
        return 2
    if argv[1] == "scope":
        if not all(opt.get(k) for k in ("repo", "base", "head")):
            print(usage, file=sys.stderr)
            return 2
        print(json.dumps(scope(MEM, slice_id, opt["repo"], opt["base"], opt["head"]), indent=1))
        return 0
    return widen(MEM, slice_id, opt.get("why"), paths, own_branch=cwd_branch())


if __name__ == "__main__":
    sys.exit(main(sys.argv))
