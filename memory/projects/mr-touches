def selftest():
    import io
    fails = []
    n = [0]

    def ok(name, cond, detail=""):
        n[0] += 1
        if not cond:
            fails.append("%s %s" % (name, detail))

    child = subprocess.Popen(["/bin/true"])
    child.wait()
    dead, alive = child.pid, os.getpid()

    def put_lock(mem, slice_id, touches, leader, repo="project"):
        with open(os.path.join(mem, ".harness-runner.%s.lock" % slice_id), "w") as f:
            json.dump({"slice": slice_id, "session_leader": leader, "touches": touches,
                       "repo": repo}, f)

    prs = []  # what the stand-in `gh` reports as open; fixtures mutate it

    def pr(number, head, *paths, total=None):
        return {"number": number, "headRefName": head, "files": [{"path": p} for p in paths],
                "changedFiles": len(paths) if total is None else total}

    def wt_roots(mem):
        return {r: os.path.join(mem, "wt-" + r) for r in WT_ROOTS}

    def run(mem, slice_id, why, paths, open_prs=None):
        buf = io.StringIO()
        rc = widen(mem, slice_id, why, paths, out=buf, open_prs=open_prs or (lambda repo: prs),
                   wt_roots=wt_roots(mem))
