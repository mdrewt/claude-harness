#!/usr/bin/python3
''''exec /usr/bin/python3 "$0" "$@" # '''
# ^ POLYGLOT INTERPRETER GUARD (lp-11a). `bash <this file>` would otherwise interpret the python
# source as shell and EXECUTE any backticked prose in it as commands (postmortem in mr-hold's
# header). Python reads this line as a no-op string; sh/bash re-execs the file under python3 before
# reaching any other line. Statically enforced for every python mr-* tool by mr-selfcheck.
__doc__ = """mr-touches — a running slice widens its own `touches:` when no unmerged work claims the file.

    mr-touches widen --slice S --why "<measured need>" PATH [PATH...]
        rc=0  TOUCHES-WIDENED S +<n> ...   every PATH is now in S's set (recorded, or already there)
        rc=1  TOUCHES-REFUSED S <path> — <reason>   one line per refused PATH; NOTHING is recorded
        rc=2  usage error
    mr-touches scope --slice S --repo PATH --base REF --head REF
        -> JSON: which files of the base...head diff sit outside S's set (mr-audit's scope block)
    mr-touches --selftest            -> fixtures over a temp dir; rc=0 pass, rc=1 fail

WHY THIS EXISTS. A slice's `touches:` is written at spec time, but the files a change forces are
only measurable at build time: the count and roster pins that go red once a row is added, the
exhaustive table typed off the tuple the slice extends, the subscription chain behind a new store
field. A run that measures such a file adds it here and keeps building. `touches:` protects two
things, and this tool keeps both:

  1. FILE-DISJOINT FAN-OUT. A file may be edited by one unmerged slice at a time. `widen` asks
     mr-disjoint (the overlap SSOT) whether any CLAIMANT's set covers the requested path, and
     refuses when one does. A structural path (mr-disjoint's always-serial set) is granted only
     while no other slice is unmerged. Every grant is a row mr-disjoint reads back, so a sibling
     launched later is checked against the widened set, not just the spec's.
  2. SCOPE CONTROL. Every grant carries the run's stated reason and is printed by
     `mr-gates render --format pr|park`. `scope` lists every changed file outside declared +
     widened + sibling tests + the doc set and marks each widened file test or non-test; mr-audit
     forces the diff read for a file outside the set and for any widened non-test file, so
     whoever merges reads every self-granted code change. The files that define a slice's own
     gate or steer the loop (not_grantable) are never grantable: they are in a set only when the
     spec declares them.

A REFUSED request is a hidden dependency: the run parks and the supervisor re-serializes.
`type: refactor` slices do not call this tool; their `touches:` is a measured contract
(standards/spec-driven.md §Refactor slices) and a miss there is a spec defect. A spec may forbid
widening for its slices; the brief sends the run to the spec's own rule.

PATHS ARE CANONICAL. A request is refused unless it is the one repo-relative spelling of a file
(`os.path.normpath(p) == p`, no `projects/monster-realm/` prefix); mr-disjoint canonicalises
every declared path the same way, so no second spelling of a claimed file reads as unclaimed.

CLAIMANT = any other slice of this repo whose work is not merged:
  - a `$MEM/.harness-runner.<slice>.lock` (written by mr-spawn at launch, carrying the declared
    touches and repo) whose `session_leader` pid is alive, or whose worktree
    (`<WT_ROOT>/<slice>`) still exists: the supervisor removes a merged slice's worktree and
    keeps a parked one, so a parked slice holds its files with or without a PR;
  - a slice listed in `$MEM/mr-state.json` `inflight[]` or `awaiting_merge[]` — its builder may
    have exited, but its PR is still to merge;
  - every open PR of the repo that is not this slice's own (`gh pr list`): a parked slice, a
    CI wait, an operator's branch. Its claim is the files the PR changes. A branch belongs to
    the slice with the LONGEST id it names (`slice/a-1-2` is a-1-2's, never a-1's).
A claimant's set is its lock's declared touches, its widened record and its open PR's files. A
claimant whose set cannot be known is undeclared, which collides with everything (the fan-out
rule): one with no declared touches, one whose lock is unreadable, and a PR whose file list gh
returned only in part. A readable lock with a dead leader and no worktree, in neither list and
without an open PR, is merged work and claims nothing. When the open PRs cannot be listed the
request is refused: no verdict is not a grant.

RECORD FORMAT. `$MEM/gates/<slice>.widened.jsonl`, append-only, one JSON object per granted path:
`{"ts","slice","path","why"}`. Readers: this tool, mr-disjoint (unions the paths into the named
slice's set) and mr-gates render (prints path + why).

TWO ROOTS, as in mr-gates: the code is self-locating (it runs the mr-disjoint and mr-repo-of
beside it), the SUBJECT is the machine singleton — `MEM` and `WT_ROOTS` are hardcoded so a copy
run from a slice worktree still reads the one real set of locks, records and worktrees.
`--selftest` passes explicit dirs.
"""

import datetime
import fcntl
import json
import os
import re
import subprocess
import sys
import tempfile

HARNESS = "/home/mdrewt/projects/ai-apps/claude-harness"
MEM = HARNESS + "/memory/projects"
HERE = os.path.dirname(os.path.abspath(__file__))

SLICE_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")
PROJECT_PREFIX = "projects/monster-realm/"
PR_REPO = {"harness": "mdrewt/claude-harness", "project": "mdrewt/monster-realm"}
# Where mr-spawn puts each repo's slice worktrees (its WT_ROOT); a slice's is `<root>/<slice>`.
WT_ROOTS = {"harness": HARNESS + "/.claude/worktrees",
            "project": HARNESS + "/projects/monster-realm/.claude/worktrees"}
PR_LIST_LIMIT = 1000
# mr-disjoint holds a second copy of DOC_SET and of canon(); the selftest fails when they differ.
DOC_SET = ("CHANGELOG.md", "ARCHITECTURE.md", "docs/DECISIONS.md")
# A run cannot grant itself the files that decide whether it passes or that steer the loop: the
# doctrine and tooling (operator-approved under the supervisor's Anti-reaccretion rule), the
# spec corpus, and each repo's CI, hook, task-runner, lint, build-manifest and test-runner
# configuration. One of these is in a slice's set only when its spec declares it.
NOT_GRANTABLE = (
    "standards/", "memory/", "specs/", "scripts/",
    ".github/", ".cargo/", ".config/",
    "justfile", "lefthook.yml", "AGENTS.md", "CLAUDE.md",
    "rust-toolchain.toml", "clippy.toml",
)
# The same kind of file at any depth, matched on its basename.
NOT_GRANTABLE_NAME = re.compile(
    r"^(package\.json|Cargo\.toml|tsconfig.*\.json|deny\.toml|\.gitignore|biome\.jsonc?"
    r"|\.eslintrc.*|\.eslintignore|eslint\.config\.[a-z]+"
    r"|(vite|vitest|playwright)\.config\.[a-z]+)$")
# Under evals/ only the recorded baselines are grantable: a change that moves a schema or a
# content hash re-records them, while the eval scripts, their runner and the teeth fixtures are
# the gate itself.
EVALS, EVALS_GRANTABLE = "evals/", "evals/baselines/"
# Cargo.lock and package-lock.json stay grantable: the build rewrites a lockfile when a manifest
# changes, and the manifest is in the set only by spec declaration. A lockfile is also in
# mr-disjoint's structural set (granted only while no other slice is unmerged) and is a non-test
# file, so mr-audit forces the diff read on it.
TEST_NAME = re.compile(r"(_tests?\.rs|\.(test|spec)\.[a-z]+)$")


def canon(p):
    """The one spelling mr-disjoint compares: no `projects/monster-realm/` prefix, no `//`, `/./`."""
    p = str(p).strip()
    tail = "/" if p.endswith("/") else ""
    p = os.path.normpath(p)
    if p.startswith(PROJECT_PREFIX):
        p = p[len(PROJECT_PREFIX):]
    return p + tail


def record_path(mem, slice_id):
    return os.path.join(mem, "gates", "%s.widened.jsonl" % slice_id)


def read_rows(mem, slice_id):
    rows = []
    try:
        with open(record_path(mem, slice_id), errors="replace") as f:
            for line in f:
                try:
                    d = json.loads(line)
                except ValueError:
                    continue
                if isinstance(d, dict) and d.get("path"):
                    rows.append(d)
    except OSError:
        pass
    return rows


def widened_paths(mem, slice_id):
    out = []
    for r in read_rows(mem, slice_id):
        if r["path"] not in out:
            out.append(r["path"])
    return out


def read_lock(mem, slice_id):
    try:
        with open(os.path.join(mem, ".harness-runner.%s.lock" % slice_id)) as f:
            d = json.load(f)
    except (OSError, ValueError):
        return None
    if not isinstance(d, dict):
        return None
    t = d.get("touches") or []
    if not isinstance(t, list):
        t = [x.strip() for x in str(t).split(",")]
    d["touches"] = [canon(x) for x in t if str(x).strip()]
    return d


def pid_alive(pid):
    try:
        pid = int(pid)
    except (TypeError, ValueError):
        return False
    if pid <= 0:
        return False
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def unmerged_in_state(mem):
    """{slice: entry} for mr-state.json's inflight[] and awaiting_merge[]. None = unreadable."""
    try:
        with open(os.path.join(mem, "mr-state.json")) as f:
            d = json.load(f)
    except FileNotFoundError:
        return {}
    except (OSError, ValueError):
        return None
    out = {}
    for key in ("inflight", "awaiting_merge"):
        for e in (d.get(key) or []) if isinstance(d, dict) else []:
            if isinstance(e, str):
                e = {"slice": e}
            if isinstance(e, dict) and e.get("slice"):
                out.setdefault(str(e["slice"]), e)
    return out


def gh_open_prs(pr_repo):
    """[{number, headRefName, changedFiles, files:[{path}]}] for every open PR of `pr_repo`.
    None = no answer, which includes a list that filled the limit (there may be more).

    gh returns at most the first 100 `files` of a PR; `changedFiles` is the true count, and
    claimants() reads a PR whose list is shorter than it as claiming every file."""
    try:
        r = subprocess.run(["gh", "pr", "list", "-R", pr_repo, "--state", "open",
                            "-L", str(PR_LIST_LIMIT),
                            "--json", "number,headRefName,changedFiles,files"],
                           capture_output=True, text=True, timeout=120)
        v = json.loads(r.stdout) if r.returncode == 0 else None
    except (OSError, subprocess.SubprocessError, ValueError):
        return None
    return v if isinstance(v, list) and len(v) < PR_LIST_LIMIT else None


def branch_names(head, slice_id):
    """True when branch `head` could be slice_id's: `slice/<id>`, `<id>`, `<id>-park-…`."""
    return any(t == slice_id or t.startswith(slice_id + "-") for t in str(head).split("/"))


def branch_slice(head, ids):
    """The one of `ids` that branch `head` belongs to, or None. The longest id the branch names
    wins: `slice/qf-7b-…` is qf-7b's, not qf-7's."""
    return max((n for n in ids if branch_names(head, n)), key=len, default=None)


def worktree_exists(slice_id, lock, wt_roots):
    roots = [wt_roots[lock["repo"]]] if lock.get("repo") in wt_roots else list(wt_roots.values())
    return any(os.path.isdir(os.path.join(r, slice_id)) for r in roots)


def cwd_branch():
    try:
        r = subprocess.run(["git", "rev-parse", "--abbrev-ref", "HEAD"], capture_output=True,
                           text=True, timeout=10)
        return r.stdout.strip() if r.returncode == 0 else ""
    except (OSError, subprocess.SubprocessError):
        return ""


def claimants(mem, slice_id, repo, prs, own_branch="", wt_roots=None):
    """({claimant: paths}, slice-claimant names, {claimant with no known set: why}) — see CLAIMANT.

    A claimant named by its slice id is one mr-disjoint also unions the widened record into."""
    wt_roots = WT_ROOTS if wt_roots is None else wt_roots
    locks, undeclared = {}, {}
    try:
        names = sorted(os.listdir(mem))
    except OSError:
        names = []
    for n in names:
        m = re.match(r"^\.harness-runner\.(.+)\.lock$", n)
        if not m or m.group(1) == slice_id:
            continue
        lock = read_lock(mem, m.group(1))
        if lock is None:
            # Neither its leader, its repo nor its touches can be read, so it may be a live
            # sibling holding any file.
            undeclared[m.group(1)] = "has an unreadable lock"
        elif not (lock.get("repo") and repo and lock["repo"] != repo):
            locks[m.group(1)] = lock
    out = {}
    for name, lock in locks.items():
        if pid_alive(lock.get("session_leader")) or worktree_exists(name, lock, wt_roots):
            out[name] = list(lock["touches"])
    state = unmerged_in_state(mem) or {}
    for name, e in state.items():
        if name == slice_id or name in out:
            continue
        lock = locks.get(name)
        if lock is None and (read_lock(mem, name) is not None
                             or (e.get("repo") and repo and e["repo"] != repo)):
            continue  # the other repo's slice
        t = e.get("touches") if isinstance(e.get("touches"), list) else []
        out[name] = list(lock["touches"]) if lock else [canon(x) for x in t if str(x).strip()]
    slices = set(out)
    ids = set(locks) | set(state) | {slice_id}
    for pr in prs:
        head = str(pr.get("headRefName") or "")
        name = branch_slice(head, ids)
        if name == slice_id or (own_branch and head == own_branch):
            continue
        files = [canon(f.get("path")) for f in pr.get("files") or []
                 if isinstance(f, dict) and f.get("path")]
        if name is None:
            name = "pr-%s" % pr.get("number")
        else:
            slices.add(name)
        base = out.get(name, list(locks[name]["touches"]) if name in locks else [])
        out[name] = base + files
        total = pr.get("changedFiles")
        if not isinstance(total, int) or total > len(files):
            undeclared[name] = "has an open PR whose file list is incomplete"
    for name in sorted(out):
        out[name] = list(dict.fromkeys(out[name]))
        if not out[name] and not widened_paths(mem, name):
            undeclared.setdefault(name, "declares no touches")
    return out, slices, undeclared


def covered(path, declared):
    """True when `path` already sits inside the set: a literal, a glob match, or under a dir token."""
    import fnmatch
    for d in declared:
        if path == d or path.startswith(d.rstrip("/") + "/") or fnmatch.fnmatch(path, d):
            return True
    return False


def not_grantable(path):
    return (any(path == g or path.startswith(g) for g in NOT_GRANTABLE)
            or ".claude" in path.split("/")
            or (path.startswith(EVALS) and not path.startswith(EVALS_GRANTABLE))
            or bool(NOT_GRANTABLE_NAME.match(os.path.basename(path))))


def sibling_test(path, declared):
    """A test file beside a declared code file and named after it: `pvp.rs` -> `pvp_tests.rs`,
    `main.ts` -> `main.help.test.ts`."""
    if not TEST_NAME.search(path):
        return False
    d, name = os.path.split(path)
    for c in declared:
        cd, cn = os.path.split(c)
        stem = cn.split(".")[0]
        if cd == d and stem and re.match(re.escape(stem) + r"([._-]|$)", name):
            return True
    return False


def outside_scope(changed, declared, widened):
    """The changed files no rule puts in the slice's set (the brief's Scope line, mechanically)."""
    have = [canon(p) for p in list(declared) + list(widened)]
    return [p for p in changed
            if not (covered(p, have) or p in DOC_SET or sibling_test(p, have))]


def scope(mem, slice_id, repo_path, base, head):
    """mr-audit's scope block: the base...head diff against declared + widened touches."""
    lock = read_lock(mem, slice_id)
    rows = read_rows(mem, slice_id)
    # `test` is what mr-audit keys its forced read on: a widened file that is not a test file is
    # a self-granted code change.
    v = {"slice": slice_id, "widened": [
        {"path": r["path"], "why": r.get("why", ""), "test": bool(TEST_NAME.search(r["path"]))}
        for r in rows]}
    if lock is None or not lock["touches"]:
        v.update(verdict="NO-TOUCHES", reason="no launch lock with declared touches")
        return v
    try:
        r = subprocess.run(["git", "-C", repo_path, "diff", "--name-only", "--no-renames",
                            "%s...%s" % (base, head)], capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.SubprocessError) as e:
        v.update(verdict="AUDIT-ERROR", reason=str(e)[:160])
        return v
    if r.returncode != 0:
        v.update(verdict="AUDIT-ERROR", reason="git diff failed: " + r.stderr.strip()[:120])
        return v
    changed = [ln for ln in r.stdout.splitlines() if ln]
    out = outside_scope(changed, lock["touches"], [x["path"] for x in rows])
    v.update(verdict="OUT-OF-SCOPE" if out else "IN-SCOPE", changed=len(changed),
             outside=out[:40])
    if len(out) > 40:
        v["outside_truncated"] = len(out) - 40
    return v


def shape_error(path):
    """A widen names literal files: a glob or a directory would be a blanket, not a measured need."""
    if not path or path != path.strip() or re.search(r"[\s,:]", path):
        return "not a single clean path"
    if path.startswith("/") or ".." in path.split("/"):
        return "must be repo-relative"
    if path.endswith("/") or re.search(r"[*?\[\]]", path):
        return "literal files only (no glob, no directory)"
    if os.path.normpath(path) != path or path.startswith(PROJECT_PREFIX):
        return "not the canonical repo-relative spelling (write %s)" % canon(path)
    if not_grantable(path):
        return "gate or loop-control file: never self-granted, the spec declares it"
    return None


def repo_of(paths):
    try:
        r = subprocess.run([os.path.join(HERE, "mr-repo-of"), ", ".join(paths)],
                           capture_output=True, text=True, timeout=30)
        return r.stdout.strip() or "ROUTE-ERROR"
    except (OSError, subprocess.SubprocessError):
        return "ROUTE-ERROR"


def sibling_conflicts(mem, slice_id, paths, siblings, slices):
    """{path: reason} from mr-disjoint over the request and each claimant. None = no verdict."""
    args = ["%s:%s" % (slice_id + ".widen", ",".join(paths))]
    args += ["%s:%s" % (n, ",".join(t)) for n, t in sorted(siblings.items())]
    env = dict(os.environ, MR_WIDEN_DIR=os.path.join(mem, "gates"), MR_DISJOINT_NO_GRAPH="1")
    try:
        r = subprocess.run([os.path.join(HERE, "mr-disjoint")] + args, capture_output=True,
                           text=True, timeout=60, env=env)
        v = json.loads(r.stdout)
        pairs = v["pairs"]
        structural = v["structural_hits"]
    except (OSError, subprocess.SubprocessError, ValueError, KeyError, TypeError):
        return None
    me = slice_id + ".widen"
    bad = {}
    for p in structural.get(me, []) if slices else []:
        bad[p] = "structural file while %s is unmerged" % ", ".join(sorted(slices))
    for pr in pairs:
        if me not in pr["pair"] or pr["disjoint"]:
            continue
        other = [n for n in pr["pair"] if n != me][0]
        # mr-disjoint reports the first-named slice's side of each overlap, and the request is
        # always first, so these are the requested paths themselves.
        for p in pr["overlap"]:
            bad.setdefault(p, "claimed by unmerged %s" % other)
    return bad


def widen(mem, slice_id, why, paths, out=None, open_prs=gh_open_prs, own_branch="",
          wt_roots=None):
    """`open_prs` and `wt_roots` are FUNCTION PARAMETERS, not env overrides: the CLI never passes
    them, and the selftest uses them to stand in for `gh` and for the worktree roots."""
    out = out if out is not None else sys.stdout

    def say(s):
        out.write(s + "\n")

    def refuse(reasons):
        for p, why_not in reasons:
            say("TOUCHES-REFUSED %s %s — %s" % (slice_id, p, why_not))
        return 1

    if not SLICE_RE.match(slice_id or ""):
        say("usage: bad --slice %r" % slice_id)
        return 2
    why = " ".join((why or "").split())
    paths = list(dict.fromkeys(paths))
    if not why or not paths:
        say("usage: mr-touches widen --slice S --why \"<measured need>\" PATH [PATH...]")
        return 2
    lock = read_lock(mem, slice_id)
    if lock is None:
        return refuse([(p, "no launch lock for %s (only a launched run widens)" % slice_id)
                       for p in paths])
    bad = [(p, e) for p in paths for e in [shape_error(p)] if e]
    if bad:
        return refuse(bad)
    os.makedirs(os.path.join(mem, "gates"), exist_ok=True)
    # One flock around read-siblings -> decide -> append: two runs widening at once are decided
    # one after the other, so the second sees the first's rows.
    with open(os.path.join(mem, "gates", ".widen.lock"), "a+") as lf:
        fcntl.flock(lf, fcntl.LOCK_EX)
        have = lock["touches"] + widened_paths(mem, slice_id)
        new = [p for p in paths if not covered(p, have)]
        if new:
            repo = lock.get("repo") or repo_of(lock["touches"])
            got = repo_of(lock["touches"] + new)
            if got != repo:
                return refuse([(p, "outside this slice's repo (%s, with these paths: %s)"
                                % (repo, got)) for p in new])
            if unmerged_in_state(mem) is None:
                return refuse([(p, "mr-state.json is unreadable: no verdict") for p in new])
            prs = open_prs(lock.get("pr_repo") or PR_REPO.get(repo, ""))
            if prs is None:
                return refuse([(p, "cannot list open PRs (gh): no verdict") for p in new])
            siblings, slices, undeclared = claimants(mem, slice_id, repo, prs, own_branch,
                                                     wt_roots)
            if undeclared:
                return refuse([(p, "unmerged %s (undeclared = colliding)" % "; ".join(
                    "%s %s" % kv for kv in sorted(undeclared.items()))) for p in new])
            if siblings:
                conflicts = sibling_conflicts(mem, slice_id, new, siblings, slices)
                if conflicts is None:
                    return refuse([(p, "mr-disjoint gave no verdict") for p in new])
                if conflicts:
                    return refuse(sorted(conflicts.items()))
            ts = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
            with open(record_path(mem, slice_id), "a") as f:
                for p in new:
                    f.write(json.dumps({"ts": ts, "slice": slice_id, "path": p, "why": why}) + "\n")
                f.flush()
                os.fsync(f.fileno())
    say("TOUCHES-WIDENED %s +%d%s%s" % (
        slice_id, len(new), (" " + ", ".join(new)) if new else "",
        " (already in the set: %d)" % (len(paths) - len(new)) if len(new) != len(paths) else ""))
    return 0


