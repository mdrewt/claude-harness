def selftest():
    import io
    fails = []
    n = [0]

    def ok(name, cond, detail=""):
        n[0] += 1
        if not cond:
            fails.append("%s %s" % (name, detail))

    child = subprocess.Popen(["/bin/true"])
    child.wait()
    dead, alive = child.pid, os.getpid()

    def put_lock(mem, slice_id, touches, leader, repo="project"):
        with open(os.path.join(mem, ".harness-runner.%s.lock" % slice_id), "w") as f:
            json.dump({"slice": slice_id, "session_leader": leader, "touches": touches,
                       "repo": repo}, f)

    prs = []  # what the stand-in `gh` reports as open; fixtures mutate it

    def run(mem, slice_id, why, paths, open_prs=None):
        buf = io.StringIO()
        rc = widen(mem, slice_id, why, paths, out=buf, open_prs=open_prs or (lambda repo: prs))
        return rc, buf.getvalue()

    def put_state(mem, **lists):
        with open(os.path.join(mem, "mr-state.json"), "w") as f:
            json.dump(lists, f)

    with tempfile.TemporaryDirectory(prefix="mr-touches-selftest-") as mem:
        put_lock(mem, "a-1", ["client/src/input/bindings.ts", "client/src/main.*.test.ts"], alive)

        # A lone run: every measured file is granted, pins and structural alike.
        rc, o = run(mem, "a-1", "ACCELS tuple + 5 count pins red in vitest",
                    ["client/src/input/buttons.ts", "client/src/input/router.test.ts",
                     "evals/baselines/table-schemas.json"])
        ok("T1-lone-run-granted", rc == 0 and "TOUCHES-WIDENED a-1 +3" in o, o)
        ok("T1-recorded", widened_paths(mem, "a-1") == [
            "client/src/input/buttons.ts", "client/src/input/router.test.ts",
            "evals/baselines/table-schemas.json"], str(widened_paths(mem, "a-1")))
        ok("T1-why-recorded", all(r["why"].startswith("ACCELS") for r in read_rows(mem, "a-1")))

        # Already declared (glob) or already widened: granted, no second row.
        rc, o = run(mem, "a-1", "again", ["client/src/main.help.test.ts",
                                          "client/src/input/buttons.ts"])
        ok("T2-covered-is-noop", rc == 0 and "+0" in o and len(read_rows(mem, "a-1")) == 3, o)

        # A live sibling's DECLARED file is refused, and the refusal records nothing — not even
        # the unclaimed path asked for in the same call.
        put_lock(mem, "b-1", ["client/src/ui/strings.ts", "game-core/src/"], alive)
        rc, o = run(mem, "a-1", "needs it", ["client/src/ui/strings.ts", "client/src/ui/free.ts"])
        ok("T3-sibling-declared-refused", rc == 1 and
           "TOUCHES-REFUSED a-1 client/src/ui/strings.ts — claimed by unmerged b-1" in o, o)
        ok("T3-all-or-nothing", len(read_rows(mem, "a-1")) == 3 and "free.ts" not in o, o)
        rc, o = run(mem, "a-1", "needs it", ["game-core/src/world.rs"])
        ok("T4-sibling-dir-token-refused", rc == 1 and "claimed by unmerged b-1" in o, o)

        # The sibling's WIDENED file is a claim too (both directions go through the record).
        rc, o = run(mem, "b-1", "pin", ["client/src/ui/shared.test.ts"])
        ok("T5-sibling-widens", rc == 0, o)
        rc, o = run(mem, "a-1", "pin", ["client/src/ui/shared.test.ts"])
        ok("T5-sibling-widened-refused", rc == 1 and "claimed by unmerged b-1" in o, o)
        rc, o = run(mem, "b-1", "pin", ["client/src/input/buttons.ts"])
        ok("T5-own-widened-claims-against-sibling", rc == 1 and "claimed by unmerged a-1" in o, o)

        # Unclaimed plain file beside a live sibling: granted. Structural file: refused.
        rc, o = run(mem, "a-1", "pin", ["client/src/ui/free.ts"])
        ok("T6-unclaimed-granted-beside-sibling", rc == 0 and "+1" in o, o)
        rc, o = run(mem, "a-1", "schema baseline", ["evals/baselines/content-schema.json"])
        ok("T7-structural-refused-beside-sibling", rc == 1 and "structural file while b-1 is unmerged" in o, o)

        # One file has one spelling. Every other spelling of a sibling's claim is refused before
        # the overlap check can miss it, and the refusal names the spelling to use.
        for name, p in [("T7a-double-slash", "client//src/ui/strings.ts"),
                        ("T7a-dot-segment", "client/./src/ui/strings.ts"),
                        ("T7a-dot-under-dir-token", "game-core/./src/world.rs"),
                        ("T7a-leading-dot", "./client/src/ui/strings.ts"),
                        ("T7a-project-prefix", "projects/monster-realm/client/src/ui/strings.ts")]:
            before = len(read_rows(mem, "a-1"))
            rc, o = run(mem, "a-1", "needs it", [p])
            ok(name, rc == 1 and "canonical" in o and "(write %s)" % canon(p) in o
               and len(read_rows(mem, "a-1")) == before, o)
        # A sibling whose lock spells its claim another way still holds the file.
        put_lock(mem, "b-1", ["projects/monster-realm/client/src/ui/strings.ts",
                              "game-core//src/", "client/./src/net"], alive)
        for name, p in [("T7b-sibling-prefixed", "client/src/ui/strings.ts"),
                        ("T7b-sibling-double-slash-dir", "game-core/src/world.rs"),
                        ("T7b-sibling-bare-dir", "client/src/net/store.ts")]:
            rc, o = run(mem, "a-1", "needs it", [p])
            ok(name, rc == 1 and "claimed by unmerged b-1" in o, o)

        # A dead leader's lock claims nothing; a live slice in the other repo claims nothing.
        put_lock(mem, "b-1", ["client/src/ui/strings.ts"], dead)
        put_lock(mem, "h-1", ["docs/notes.md"], alive, repo="harness")
        rc, o = run(mem, "a-1", "needs it", ["client/src/ui/strings.ts", "docs/notes.md"])
        ok("T8-dead-and-other-repo-claim-nothing", rc == 0 and "+2" in o, o)

        # Shape, repo and approval refusals.
        for name, p, frag in [
            ("T9-glob", "client/src/ui/*.test.ts", "literal files only"),
            ("T9-dir", "client/src/ui/", "literal files only"),
            ("T9-absolute", "/etc/passwd", "repo-relative"),
            ("T9-dotdot", "client/../x.ts", "repo-relative"),
            ("T9-other-repo", "docs/research/notes.md", "outside this slice's repo"),
        ] + [("T9-not-grantable:" + p, p, "never self-granted") for p in (
            "standards/spec-driven.md", ".github/workflows/ci.yml", "justfile", "lefthook.yml",
            "AGENTS.md", "client/vitest.config.ts", "client/playwright.config.ts", "evals/run.mjs",
            ".cargo/mutants.toml", "rust-toolchain.toml")]:
            before = len(read_rows(mem, "a-1"))
            rc, o = run(mem, "a-1", "x", [p])
            ok(name, rc == 1 and frag in o and len(read_rows(mem, "a-1")) == before, o)
        for p in ("memory/projects/mr-brief-template.md", "memory/projects/mr-audit",
                  "memory/projects/mr-touches", "memory/projects/mr-state.json",
                  "memory/projects/.native-supervisor-disabled", "justfile",
                  "specs/monster-realm-v2/M-trade-sessions.spec.md"):
            rc, o = run(mem, "h-1", "x", [p])
            ok("T9-not-grantable-harness:" + p, rc == 1 and "never self-granted" in o
               and not read_rows(mem, "h-1"), o)
        for p in ("memory/projects/./mr-brief-template.md",
                  "memory//projects/mr-supervisor-prompt-native.md"):
            rc, o = run(mem, "h-1", "x", [p])
            ok("T9-not-grantable-other-spelling:" + p, rc == 1 and "canonical" in o
               and not read_rows(mem, "h-1"), o)

        rc, o = run(mem, "never-launched", "x", ["client/a.ts"])
        ok("T10-no-lock-refused", rc == 1 and "no launch lock" in o, o)
        rc, o = run(mem, "a-1", "  ", ["client/a.ts"])
        ok("T10-why-required", rc == 2, o)
        rc, o = run(mem, "../a", "x", ["client/a.ts"])
        ok("T10-bad-slice", rc == 2, o)

        # mr-disjoint reads the record: a slice the supervisor names carries its widened files
        # into the fan-out verdict, and an unrecorded slice is unchanged.
        def dj(*args):
            r = subprocess.run([os.path.join(HERE, "mr-disjoint")] + list(args),
                               capture_output=True, text=True, timeout=60,
                               env=dict(os.environ, MR_WIDEN_DIR=os.path.join(mem, "gates"),
                                        MR_DISJOINT_NO_GRAPH="1"))
            return json.loads(r.stdout)
        v = dj("a-1:client/src/input/bindings.ts", "c-1:client/src/ui/free.ts")
        ok("T11-disjoint-unions-widened", v["verdict"] == "SERIAL-REQUIRED(structural)" and
           v["pairs"][0]["overlap"] == ["client/src/ui/free.ts"] and
           "client/src/ui/free.ts" in v.get("widened", {}).get("a-1", []), json.dumps(v))
        v = dj("x-1:client/src/input/bindings.ts", "c-1:client/src/ui/free.ts")
        ok("T11-disjoint-unrecorded-unchanged", v["verdict"] == "SAFE" and "widened" not in v,
           json.dumps(v))

    # `list` is what a shell caller reads.
    with tempfile.TemporaryDirectory(prefix="mr-touches-selftest-") as mem:
        put_lock(mem, "l-1", ["client/a.ts"], alive)
        run(mem, "l-1", "x", ["client/b.ts", "client/c.ts"])
        ok("T12-list", ", ".join(widened_paths(mem, "l-1")) == "client/b.ts, client/c.ts")

    # CLAIMANTS: unmerged work claims its files whether or not its builder is still running.
    with tempfile.TemporaryDirectory(prefix="mr-touches-selftest-") as mem:
        put_lock(mem, "a-1", ["client/a.ts"], alive)
        put_lock(mem, "w-1", ["client/src/pin.test.ts", "server-module/src/x.rs"], dead)
        os.makedirs(os.path.join(mem, "gates"))
        with open(record_path(mem, "w-1"), "w") as f:
            f.write(json.dumps({"path": "client/src/w-widened.test.ts", "why": "pin"}) + "\n")

        def refused(name, paths, frag, **kw):
            before = len(read_rows(mem, "a-1"))
            rc, o = run(mem, "a-1", "pin 361 -> 362", paths, **kw)
            ok(name, rc == 1 and frag in o and len(read_rows(mem, "a-1")) == before, o)

        # A dead-leader slice that is awaiting merge holds its declared and widened files, and
        # keeps the structural set serial.
        put_state(mem, inflight=[], awaiting_merge=[{"slice": "w-1", "pr": 5, "repo": "project"}])
        refused("T13-awaiting-merge-declared", ["client/src/pin.test.ts"],
                "claimed by unmerged w-1")
        refused("T13-awaiting-merge-widened", ["client/src/w-widened.test.ts"],
                "claimed by unmerged w-1")
        refused("T13-awaiting-merge-structural", ["evals/baselines/table-schemas.json"],
                "structural file while w-1 is unmerged")
        rc, o = run(mem, "a-1", "pin", ["client/src/free.test.ts"])
        ok("T13-unclaimed-granted-beside-awaiting-merge", rc == 0 and "+1" in o, o)
        put_state(mem, inflight=["w-1"], awaiting_merge=[])
        refused("T13-inflight-dead-leader", ["client/src/pin.test.ts"], "claimed by unmerged w-1")

        # An unmerged slice with no known set collides with everything; the other repo's does not.
        put_state(mem, inflight=[{"slice": "u-1", "repo": "project"}], awaiting_merge=[])
        refused("T13-undeclared-collides", ["client/src/any.ts"],
                "unmerged u-1 declares no touches")
        put_state(mem, inflight=[{"slice": "u-1", "repo": "project",
                                  "touches": ["projects/monster-realm/client/src/u.ts"]}])
        refused("T13-state-entry-touches", ["client/src/u.ts"], "claimed by unmerged u-1")
        put_state(mem, inflight=[{"slice": "hh-1", "repo": "harness"}])
        rc, o = run(mem, "a-1", "pin", ["client/src/any.ts"])
        ok("T13-other-repo-state-entry-claims-nothing", rc == 0 and "+1" in o, o)
        with open(os.path.join(mem, "mr-state.json"), "w") as f:
            f.write("{ not json")
        refused("T13-unreadable-state-no-verdict", ["client/src/z.ts"], "no verdict")

        # A dead-leader lock in neither list and without an open PR is merged work.
        put_state(mem, inflight=[], awaiting_merge=[])
        rc, o = run(mem, "a-1", "pin", ["server-module/src/x.rs"])
        ok("T13-merged-lock-claims-nothing", rc == 0 and "+1" in o, o)

        # An open PR claims the files it changes; a slice's open PR also keeps its lock's set.
        prs[:] = [{"number": 7, "headRefName": "slice/w-1",
                   "files": [{"path": "client/src/in-pr.ts"}]},
                  {"number": 9, "headRefName": "renovate/serde",
                   "files": [{"path": "Cargo.lock"}]},
                  {"number": 11, "headRefName": "slice/a-1",
                   "files": [{"path": "client/src/own.ts"}]}]
        refused("T14-open-pr-file", ["client/src/in-pr.ts"], "claimed by unmerged w-1")
        refused("T14-open-pr-slice-declared", ["client/src/pin.test.ts"],
                "claimed by unmerged w-1")
        refused("T14-open-pr-slice-structural", ["evals/baselines/content-schema.json"],
                "structural file while w-1 is unmerged")
        rc, o = run(mem, "a-1", "pin", ["client/src/own.ts"])
        ok("T14-own-pr-is-not-a-claim", rc == 0 and "+1" in o, o)
        prs[:] = [prs[1]]
        refused("T14-foreign-pr-file", ["Cargo.lock"], "claimed by unmerged pr-9")
        rc, o = run(mem, "a-1", "baseline", ["evals/baselines/content-schema.json"])
        ok("T14-foreign-pr-leaves-structural-grantable", rc == 0 and "+1" in o, o)
        refused("T14-gh-down-no-verdict", ["client/src/q.ts"], "cannot list open PRs",
                open_prs=lambda repo: None)
        prs[:] = []
        ok("T14-branch-names", branch_names("slice/qf-7b", "qf-7b")
           and branch_names("qf-8-park-20261026", "qf-8")
           and not branch_names("slice/qf-7b", "qf-7") and not branch_names("slice/uif-12", "uif-1"))

    # SCOPE: the changed files outside declared + widened + sibling tests + the doc set.
    declared = ["server-module/src/pvp.rs", "client/src/main.ts", "client/src/tactics/",
                "projects/monster-realm/client/e2e/pvp*.spec.ts"]
    got = outside_scope(
        ["server-module/src/pvp.rs", "server-module/src/pvp_tests.rs", "client/src/main.ts",
         "client/src/main.help.test.ts", "client/src/tactics/draft.ts", "client/e2e/pvp-full.spec.ts",
         "docs/DECISIONS.md", "CHANGELOG.md", "client/src/ui/widened.test.ts",
         "client/src/mainMenu.test.ts", "server-module/src/trading_tests.rs", "justfile",
         "client/src/ui/strings.ts"],
        declared, ["client/src/ui/widened.test.ts"])
    ok("T15-outside-scope", got == ["client/src/mainMenu.test.ts",
                                    "server-module/src/trading_tests.rs", "justfile",
                                    "client/src/ui/strings.ts"], str(got))
    with tempfile.TemporaryDirectory(prefix="mr-touches-selftest-") as mem:
        repo = os.path.join(mem, "repo")
        env = {k: v for k, v in os.environ.items() if not k.startswith("GIT_")}

        def git(*args):
            subprocess.run(["git", "-C", repo, "-c", "user.name=t", "-c", "user.email=t@t",
                            "-c", "commit.gpgsign=false"] + list(args),
                           check=True, capture_output=True, env=env, timeout=60)

        def commit(files, msg):
            for rel in files:
                q = os.path.join(repo, rel)
                os.makedirs(os.path.dirname(q), exist_ok=True)
                with open(q, "a") as f:
                    f.write(msg + "\n")
            git("add", "-A")
            git("commit", "-q", "-m", msg)

        os.makedirs(repo)
        git("init", "-q", "-b", "base")
        commit(["src/a.rs"], "base")
        git("checkout", "-q", "-b", "work")
        commit(["src/a.rs", "src/a_tests.rs", "src/b.rs", "src/c.rs"], "work")
        v = scope(mem, "s-1", repo, "base", "work")
        ok("T16-no-lock-is-no-measurement", v["verdict"] == "NO-TOUCHES", json.dumps(v))
        put_lock(mem, "s-1", ["src/a.rs"], dead)
        os.makedirs(os.path.join(mem, "gates"))
        with open(record_path(mem, "s-1"), "w") as f:
            f.write(json.dumps({"path": "src/b.rs", "why": "compile error E0004"}) + "\n")
        v = scope(mem, "s-1", repo, "base", "work")
        ok("T16-out-of-scope", v["verdict"] == "OUT-OF-SCOPE" and v["outside"] == ["src/c.rs"]
           and v["changed"] == 4 and v["widened"] == [{"path": "src/b.rs",
                                                       "why": "compile error E0004"}], json.dumps(v))
        put_lock(mem, "s-1", ["src/a.rs", "src/c.rs"], dead)
        v = scope(mem, "s-1", repo, "base", "work")
        ok("T16-in-scope", v["verdict"] == "IN-SCOPE" and v["outside"] == [], json.dumps(v))
        v = scope(mem, "s-1", repo, "base", "no-such-ref")
        ok("T16-bad-ref-is-an-error", v["verdict"] == "AUDIT-ERROR", json.dumps(v))

    # Every file the eight measured parks needed is grantable: none is refused on shape.
    for p in ("server-module/src/privacy.rs", "client-wasm/src/lib.rs",
              "evals/baselines/table-schemas.json", "client/src/main.accel.test.ts",
              "client/test-util/mainBootHarness.ts", "client/src/styles.css",
              "client/e2e/ranked-forfeit.spec.ts", "client/src/input/buttons.ts",
              "client/src/ui/controlsModel.ts", "game-core/src/world.rs", "sim-harness/src/world.rs",
              "evals/baselines/content-hash.json", "client/src/net/connection.ts",
              "client/src/tactics/strings.ts", "client/src/ui/screens/index.test.ts",
              "client/src/ui/i18n/hardcodedStrings.ts", "client/src/ui/menuView.test.ts",
              "client/src/ui/i18n/resolver.test.ts", "server-module/src/trading_session.rs",
              "game-core/src/combat/battle_core_tests.rs"):
        ok("T17-measured-park-file-grantable:" + p, shape_error(p) is None, str(shape_error(p)))

    if fails:
        for f in fails:
            print("TOUCHES-SELFTEST-FAIL %s" % f)
        return 1
    print("TOUCHES-SELFTEST-OK %d checks" % n[0])
    return 0


def main(argv):
    if len(argv) >= 2 and argv[1] == "--selftest":
        return selftest()
    usage = ("usage: mr-touches widen --slice S --why \"<measured need>\" PATH [PATH...]"
             " | list --slice S | scope --slice S --repo PATH --base REF --head REF | --selftest")
    if len(argv) < 2 or argv[1] not in ("widen", "list", "scope"):
        print(usage, file=sys.stderr)
        return 2
    opt, paths = {}, []
    rest = argv[2:]
    i = 0
    while i < len(rest):
        if rest[i] in ("--slice", "--why", "--repo", "--base", "--head") and i + 1 < len(rest):
            opt[rest[i][2:]] = rest[i + 1]
            i += 2
        elif rest[i].startswith("--"):
            print(usage, file=sys.stderr)
            return 2
        else:
            paths.append(rest[i])
            i += 1
    slice_id = opt.get("slice")
    if not SLICE_RE.match(slice_id or ""):
        print(usage, file=sys.stderr)
        return 2
    if argv[1] == "list":
        print(", ".join(widened_paths(MEM, slice_id)))
        return 0
    if argv[1] == "scope":
        if not all(opt.get(k) for k in ("repo", "base", "head")):
            print(usage, file=sys.stderr)
            return 2
        print(json.dumps(scope(MEM, slice_id, opt["repo"], opt["base"], opt["head"]), indent=1))
        return 0
    return widen(MEM, slice_id, opt.get("why"), paths, own_branch=cwd_branch())


if __name__ == "__main__":
    sys.exit(main(sys.argv))
