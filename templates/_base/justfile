set windows-shell := ["cmd.exe", "/c"]
# Standard command vocabulary (same across every stack = least surprise).
# Stack templates MUST override setup/lint/typecheck/test. Those bodies FAIL LOUD
# on purpose: if one runs, a stack template is missing its justfile or a recipe —
# that's a bug to fix in the template, never a silent no-op gate.

setup:
    @echo "ERROR: 'setup' was not overridden by the stack template" && exit 1

test:
    @echo "ERROR: 'test' was not overridden by the stack template" && exit 1

lint:
    @echo "ERROR: 'lint' was not overridden by the stack template" && exit 1

typecheck:
    @echo "ERROR: 'typecheck' was not overridden by the stack template" && exit 1

# Mutation testing is a REPORT, run out of band — never part of `ci`, never a
# gated score (standards/testing-tdd.md, standards/ci-cd.md). Stacks override
# this with their mutation tool.
mutate:
    @echo "mutate: no mutation tool configured for this stack (report-only)"

security:
    node scripts/check-secrets.mjs .

changelog:
    git cliff -o CHANGELOG.md

ci: lint typecheck test security
